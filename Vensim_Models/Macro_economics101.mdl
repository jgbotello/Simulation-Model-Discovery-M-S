	~		|

Magnitude of Gov Stimulus=
	30
	~	Percent [0,1,0.1]
	~		|

Maximum Hiring=
	Unemployed Labor/MAX(Min Time to Hire,2*DT)
	~	People/Year
	~		|

Min Time to Hire=
	0.1
	~	Year
	~		|

Money Growth Rate=
	3
	~	Percent/Year [-10,10,1]
	~		|

Desired Hiring=
	Expected Attrition+Adjustment for Desired Labor
	~	People/Year
	~		|

Desired Employed Labor=
	Income Devoted to Wages/Wages
	~	People
	~		|

Desired Vacancies=
	MAX(0,Expected Time to Fill Vacancies*Desired Hiring)
	~	People
	~		|

Desired Vacancy Creation=
	Desired Hiring+Adjustment for Vacancies
	~	People/Year
	~		|

Perceived Money Ratio= INTEG (
	Money Ratio Perception,
		Money Ratio)
	~	$/(Goods/Year)
	~		|

Wage Income=
	Employed Labor*Wages
	~	$/Year
	~		|

Population Growth Rate=
	3
	~	Percent/Year [-5,5,1]
	~		|

Expected Attrition=
	SMOOTH(Attrition Rate, Time to Ave Attrition )
	~	People/Year
	~		|

Expected Price= INTEG (
	Adjustment of Price Expectations,
		Initial Price)
	~	$/Good
	~		|

Expected Time to Fill Vacancies=
	SMOOTH(Time to Fill Vacancies, Time to Adjust Hiring Expectations )
	~	Year
	~		|

Share of Working Pop in Labor Pool=
	60
	~	Percent
	~		|

Employed Labor= INTEG (
	Hiring-Attrition Rate,
		Initial Labor)
	~	People
	~		|

Gov Budget=
	Switch for Endog Gov Grwth*Natural Grw Gov Budget + (1 - Switch for Endog Gov Grwth)\
		*Exog Gov Budget +Gov Stimulus
	~	$/Year
	~		|

Labor Pool=
	(Share of Working Pop in Labor Pool/Percent)*Working Population
	~	People
	~		|

Gov Consump share of Income=
	(Gov Consumption Spending/Income)*Percent
	~	Percent
	~		|

Pop Growth=
	Working Population*(Population Growth Rate/Percent)
	~	People/Year
	~		|

Gov Deficit=
	Gov Budget - Taxes
	~	$/Year
	~		|

Time to Adjust Price Expectations=
	1
	~	Year
	~		|

Time to Adjust Wage Expectations=
	3
	~	Years
	~		|

Time to Ave Attrition=
	1
	~	Years
	~		|

Gov Stimulus=
	(Exog Gov Budget*Magnitude of Gov Stimulus/Percent)*PULSE(Time to Start Stimulus, Duration of Stimulus\
		)
	~	$/Year
	~		|

Hiring=
	MIN(Maximum Hiring,Vacancies/Time to Fill Vacancies)
	~	People/Year
	~		|

Vacancy Creation=
	MAX(0,Desired Vacancy Creation)
	~	People/Year
	~		|

Vacancies= INTEG (
	Vacancy Creation-Vacancy Closure,
		Time to Fill Vacancies*(Attrition Rate + Population Growth Rate*Employed Labor/Percent\
		))
	~	People
	~		|

Vacancy Adjustment Time=
	0.5
	~	Years
	~		|

Indicated Wages=
	(Income*Beta)/Employed Labor
	~	$/(Person*Year)
	~		|

Wages= INTEG (
	Adjustment of Wage Expectations,
		Indicated Wages)
	~	$/(Person*Year)
	~		|

Initial Labor=
	1e+06
	~	People
	~		|

Initial Price=
	200
	~	$/Good
	~		|

Money Supply= INTEG (
	Growth In Money,
		Initial Money Supply)
	~	$
	~		|

Labor Adjustment Time=
	0.25
	~	Years
	~		|

Time to Fill Vacancies=
	0.5
	~	Years
	~		|

Time to Adjust Expectations WIR=
	0.5
	~	Years
	~		|

Time to Adjust Hiring Expectations=
	1
	~	Years
	~		|

Working Population= INTEG (
	Pop Growth,
		Initial Labor*(1 + Min Time to Hire/Ave Duration of Employment)/(Share of Working Pop in Labor Pool\
		/Percent))
	~	People
	~		|

Unemployed Labor=
	MAX(0,Labor Pool - Employed Labor)
	~	People
	~		|

Time to Perceive Money Ratio=
	1
	~	Years
	~		|

Unemployment Rate=
	Percent*Unemployed Labor/Labor Pool
	~	Percent
	~		|

Vacancy Closure=
	Hiring
	~	People/Year
	~		|

Capital Assets= INTEG (
	Investment-Capital Consumption-Loses,
		Initial Assets)
	~	Capital Units
	~		|

Desired Gov Share Income=
	25
	~	Percent [0,1,0.01]
	~		|

Disposable Income=
	(1-(Tax Rate/Percent))*Income
	~	$/Year
	~	The money income available to individuals employed in the production of \
		goods and services.
	|

Loss Rate=
	0
	~	Percent/Year
	~		|

Gov Borrowing=
	Savings-Private Investment
	~	$/Year
	~		|

Exog Gov Budget= INTEG (
	Chg in Gov Budget,
		Natural Grw Gov Budget)
	~	$/Year
	~		|

Gov Budget Growth Rate=
	3
	~	Percent/Year [0,10,0.5]
	~		|

Gov Consumption Spending=
	(1-(Gov Invest Share/Percent))*Gov Spending
	~	$/Year
	~		|

Gov Invest Share=
	20
	~	Percent [0,1,0.01]
	~		|

Gov Investment=
	(Gov Invest Share/Percent)*Gov Spending
	~	$/Year
	~		|

Gov Spending=
	Taxes+Gov Borrowing
	~	$/Year
	~		|

Natural Grw Gov Budget=
	(Desired Gov Share Income/Percent)*Income
	~	$/Year
	~		|

Investment=
	DELAY3((Private Investment +Gov Investment)/Asset Price,Time to Acquire Capital Assets\
		)
	~	Capital Units/Year
	~		|

Loses=
	0 + (Loss Rate/Percent)*Capital Assets*PULSE(Time to Start Loss, Duration of Losses \
		)
	~	Capital Units/Year
	~		|

Net Investment in Capital Units=
	(Investment-Capital Consumption)
	~	Capital Units/Year
	~	The amount of investment above replacement investment.
	|

Private Investment=
	MAX(0,Savings-Gov Deficit)
	~	$/Year
	~		|

Switch for Endog Gov Grwth=
	0
	~	Dimensionless [0,1]
	~		|

Taxes=
	Income*(Tax Rate/Percent)
	~	$/Year
	~		|

Duration of Losses=
	1
	~	Year
	~		|

Time to Start Loss=
	3
	~	Year
	~		|

Ave Life of Cap=
	10
	~	Years
	~		|

Capital Consumption=
	Capital Assets/Ave Life of Cap
	~	Capital Units/Year
	~		|

Initial Assets=
	1e+06
	~	Capital Units
	~		|

