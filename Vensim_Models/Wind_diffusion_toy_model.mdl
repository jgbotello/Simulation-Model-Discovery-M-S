{UTF-8}
********************************************************
	.wind diffusion model - 4
********************************************************~
		Basic Diffusion model for wind energy
	|

price production present=
	1-1*PULSE TRAIN(20, 1 , 5, 40)*PTC switch
	~	dimensionless
	~		|

annual revenue=
	estimated annual site output*(electricity price+price production incentive*price production present\
		)
	~	$
	~		|

PTC switch=
	0
	~	dimensionless [0,1,1]
	~	0 means that the PTC credit is permanently available and 1 means that the \
		PTC credit availability fluctuates from year to year
	|

Turbine Installations per Year=
	(1-fractional resistance to wind)*feasibility of wind
	~	GW / Year
	~		|

feasibility of wind=
	IF THEN ELSE(total profitable sites > 0, MIN(Potential GW wind capacity in Country X\
		,total profitable sites*((total profitable sites - (total potential GW wind capacity in Country X
	- Potential GW wind capacity in Country X) ) / total profitable sites)), 0 )
	~	GW/Year
	~		|

Potential GW wind capacity in Country X= INTEG (
	-Turbine Installations per Year,
		total potential GW wind capacity in Country X-Government demo Projects)
	~	GW [0,?]
	~		|

fractional resistance to wind=
	(1 - (Cumulative GW wind capacity in Country X/total potential GW wind capacity in Country X\
		)*(interaction rate))
	~	Dmnl [0,?]
	~	those resisting wind are those with no familiarity with the technology
	|

interaction rate=
	2
	~	dimensionless [0.01,3,0.1]
	~		|

Cumulative GW wind capacity in Country X= INTEG (
	Turbine Installations per Year,
		Government demo Projects)
	~	GW [0,?]
	~		|

Government demo Projects=
	0.005
	~	GW [0,1,0.01]
	~	government projects to kickstart industry
	|

annual maintenance cost=
	50000
	~	$ [0,200000,10000]
	~		|

annual profits=
	annual revenue-annual maintenance cost
	~	$
	~		|

annuity factor=
	(1-(1/(1+interest rate)^avg turbine lifetime))/interest rate
	~	Dmnl
	~		|

average turbine size=
	1000
	~	kW [250,3000,250]
	~		|

avg turbine lifetime=
	20
	~	Dmnl [5,40,5]
	~		|

electricity price=
	0.05
	~	$/(kW*hr) [0,0.2,0.01]
	~		|

estimated annual site output=
	average turbine size*max capacity of a wind site*hours per year
	~	kW*hr
	~		|

grants=
	0
	~	$ [0,500000,50000]
	~		|

hours per year=
	24*365
	~	hr
	~		|

interest rate=
	0.08
	~	Dmnl [0.01,0.15,0.01]
	~		|

max capacity of a wind site=
	0.5
	~	Dmnl
	~		|

price production incentive=
	0.019
	~	$/(kW*hr)
	~		|

upfront project costs=
	2e+06
	~	$
	~		|

total profitable sites=
	IF THEN ELSE( (total potential GW wind capacity in Country X * (-1) * LN((upfront project costs\
		 - grants) / (annuity factor*annual profits))) > 0 , (total potential GW wind capacity in Country X\
		 * (-1) * LN((upfront project costs - grants) / (annuity factor*annual profits)) ),\
		 0 )
	~	GW [0,?]
	~		|

total potential GW wind capacity in Country X=
	8000
	~	GW
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 50
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Year [0,?]
	~	The time step for the simulation.
	|

