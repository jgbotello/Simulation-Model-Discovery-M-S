{UTF-8}
average duration of the illness=
	10
	~	Day
	~		|

average health condition=
	0.95
	~	Dmnl
	~		|

average immunity period=
	(365*6)
	~	Day
	~		|

average incubation time=
	1
	~	Day
	~		|

average state of health services=
	0.15
	~	Dmnl
	~		|

Cholera deaths=
	(Heavily infected population*effect of the average state of health services on the fraction of cholera deaths\
		)/average duration of the illness
	~	people/Day
	~		|

cholera infections=
	(Susceptible population*indirect infection rate)
	~	people/Day
	~		|

connectedness of aquifiers=
	0.28
	~	Dmnl
	~		|

delay variable=
	14
	~	Day
	~		|

effect of prevention and sanitation on the indirect degree of infection = WITH LOOKUP\
		 (
	MAX(level of prevention, state of the sanitary infrastructure),
		([(0,0)-(1,1)],(0,1),(0.25,0.9),(0.5,0.5),(0.75,0.1),(1,0) ))
	~	Dmnl
	~		|

effect of the average state of health services on the fraction of cholera deaths = WITH LOOKUP\
		 (
	average state of health services,
		([(0,0)-(1,1)],(0,1),(0.25,0.5),(0.5,0.2),(0.75,0.05),(1,0) ))
	~	Dmnl
	~		|

effect of the fraction of infected on the fraction of contaminated water = WITH LOOKUP\
		 (
	fraction of infected,
		([(0,0)-(1,1)],(0,0),(0.125,0.5),(0.25,0.75),(0.5,0.9),(0.75,0.99),(1,1) ))
	~	Dmnl
	~		|

fraction of infected=
	(Heavily infected population+Mildly infected population+Recently infected population\
		)/(Heavily infected population+Mildly infected population+Recently infected population\
		+Recovered temporarily immune population)
	~	Dmnl
	~		|

heavily infected=
	(Recently infected population*(1-average health condition))/average incubation time
	~	people/Month
	~		|

Heavily infected population= INTEG (
	heavily infected-Cholera deaths-recovered from heavy infection,
		50)
	~	people
	~		|

indirect infection rate=
	connectedness of aquifiers*effect of prevention and sanitation on the indirect degree of infection\
		*smoothed fraction of contaminated water
	~	Dmnl
	~		|

level of prevention=
	0.1
	~	Dmnl
	~		|

lost of immunity=
	Recovered temporarily immune population/average immunity period
	~	people/Day
	~		|

mildly infected=
	(Recently infected population*average health condition)/average incubation time
	~	people/Day
	~		|

Mildly infected population= INTEG (
	mildly infected-recovered from mild infection,
		950)
	~	people
	~		|

Recently infected population= INTEG (
	cholera infections-heavily infected-mildly infected,
		1000)
	~	people
	~		|

recovered from heavy infection=
	(Heavily infected population*effect of the average state of health services on the fraction of cholera deaths\
		)/average duration of the illness
	~	people/Day
	~		|

recovered from mild infection=
	Mildly infected population/average duration of the illness
	~	people/Day
	~		|

Recovered temporarily immune population= INTEG (
	recovered from mild infection-lost of immunity,
		1.0226e+07)
	~	people
	~		|

smoothed fraction of contaminated water=
	DELAY3I(effect of the fraction of infected on the fraction of contaminated water, delay variable\
		, 0.0004)
	~	Dmnl
	~		|

state of the sanitary infrastructure=
	0.3
	~	Dmnl
	~		|

Susceptible population= INTEG (
	lost of immunity-cholera infections,
		3e+06)
	~	people
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 3600
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Day [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
V300  Do not put anything below this section - it will be ignored
