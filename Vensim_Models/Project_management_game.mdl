{UTF-8}
calculate EDT=
	IF THEN ELSE ("project completeness (pc)"<0.991,(MAX(Time,"Feasible Development Time (FDT)"\
		)-"Expected Development Time (EDT)")/1,0)
	~	
	~		|

add potential customers=
	IF THEN ELSE(delay change in discovery>0:OR:change product performance<>0,potential customers per feature\
		*change product performance,0)
	~	
	~	IF(delay_change_in_discovery>0 OR change_PP<>0)
		THEN(((product_performance_PP/normal_product_performance_npp)-1)*initial_po\
		tential_customers/dt) ELSE(0)
	|

realistic team size=
	MIN(13,MAX(7,desired team size))
	~	
	~		|

potential customers per feature=
	initial potential customers/(normal product performance/product performance per feature\
		)
	~	
	~		|

"product performance (pp)"=
	(1-switch to game)*((1-switch to change product performance)*normal product performance\
		+switch to change product performance
	*IF THEN ELSE(Discovery of Unrealistic Due Date>0,product performance in number of features\
		*product performance per feature
	,normal product performance))+switch to game*realistic product performance in number of features\
		*product performance per feature
	~	dmnl
	~	(1-switch_to_game)*((1-switch_to_change_product_performance)*normal_product\
		_performance_npp+switch_to_change_product_performance*(IF(Discovery_of_Bein\
		g_Behind_Schedule>0)THEN(product_performance_in_number_of_features*PP_per_f\
		eature)ELSE(normal_product_performance_npp)))+switch_to_game*(product_perfo\
		rmance_in_number_of_features*PP_per_feature)
	|

change product performance=
	(-Counter for Change Product Performance+0*product performance in number of features\
		+realistic product performance in number of features)/TIME STEP
	~	
	~		|

"Expected Development Time (EDT)"= INTEG (
	calculate EDT,
		"Feasible Development Time (FDT)")
	~	
	~		|

"maximum Team Size (TSmax)"=
	(1-switch to game)*"planned Team Size (pTS)"+switch to extra hiring*IF THEN ELSE(Discovery of Unrealistic Due Date\
		>0,increase team
	,0)+switch to game*(realistic team size)
	~	persons
	~		|

realistic product performance in number of features=
	MIN(15,MAX(5,product performance in number of features))
	~	
	~		|

product performance per feature=
	normal product performance/10
	~	
	~		|

"new efficiency loss (nel)"=
	efficience loss constant("team size (TS)")*"team size (TS)"*"team size (TS)"
	~	
	~		|

new tasks for higher product advantage=
	IF THEN ELSE(delay change in discovery>0:OR:change product performance<>0,change product performance\
		*task per feature*(1-"project newness (pn)"),0)
	~	
	~	IF(delay_change_in_discovery>0 OR change_PP<>0)
		THEN(change_PP*task_per_feature*(1-project_newness_pn))
		ELSE(0)
	|

"average actual productivity per person (aapp)"=
	"average productivity per person (app)"*(1-0*"efficiency loss (el)"-"new efficiency loss (nel)"\
		)
	~	task/person/week
	~		|

Counter for Change Product Performance= INTEG (
	change product performance,
		realistic product performance in number of features)
	~	
	~		|

change PDC=
	IF THEN ELSE("project completeness (pc)"<0.991,(-"Expected Development Costs (EDC)"+\
		("development costs (DC)"/MAX(1,Time))*"Feasible Development Time (FDT)")/"development time adjustment delay (dtad)"\
		,0)
	~	
	~		|

"hiring rate (hr)"=
	IF THEN ELSE("project completeness (pc)">0.991,0,(1-switch to game)*(MAX(0,(MIN("maximum Team Size (TSmax)"\
		,"desired Team Size (TS*)")-"team size (TS)"))/"hiring delay (hd)")+switch to game*\
		("maximum Team Size (TSmax)"-"team size (TS)")/"hiring delay (hd)")
	~	persons/week
	~		|

"Expected Sales Benefits (ESB)"=
	("Total Market (TM)"-"Lost Customers (LC)")*"sales price (sp)"
	~	
	~		|

current time=
	Time
	~	
	~		|

"Expected Profit (EP)"=
	"Expected Sales Benefits (ESB)"-"Expected Development Costs (EDC)"
	~	
	~		|

switch to game=
	1
	~	
	~		|

desired team size= GAME (
	10)
	~	
	~		|

"Expected Development Costs (EDC)"= INTEG (
	change PDC,
		("development costs (DC)"/MAX(1,Time))*"Feasible Development Time (FDT)")
	~	
	~		|

new undiscovered tasks for higher product advantage=
	IF THEN ELSE(delay change in discovery>0 :OR:change product performance<>0,change product performance\
		*task per feature*"project newness (pn)",0)
	~	
	~	IF (delay_change_in_discovery>0 OR change_PP <>0) \
		THEN(change_PP*task_per_feature*project_newness_pn) ELSE(0)
	|

efficience loss constant(
	[(0,0)-(20,0.0008)],(1,0.0004758),(5,0.0004758),(10,0.0004758),(11,0.0004758),(12,0.0004758\
		),(13,0.0005),(14.8624,0.000622556),(16.3914,0.000748872),(18.104,0.000793985),(20,\
		0.0008))
	~	
	~		|

task per feature=
	initial project tasks to be executed/(normal product performance/product performance per feature\
		)
	~	
	~		|

"Experienced Engineers (EE)"= INTEG (
	"assimilation rate (ar)"-end of project for experienced team,
		MAX(0,"planned Team Size (pTS)"-initial shortage of team))
	~	
	~		|

initial shortage of team=
	3.5
	~	
	~		|

change in discovery=
	IF THEN ELSE (Discovery of Unrealistic Due Date=0 :AND:"pressure to intervene (pi)"
	>"intervention threshold (it)",1/TIME STEP,0)
	~	
	~		|

initial CUO=
	0.00337655
	~	
	~	0.0033
	|

"experienced person-weeks (epw)"=
	IF THEN ELSE("project completeness (pc)">1.99,0,"Experienced Engineers (EE)")
	~	
	~		|

"rookie person-weeks (rpw)"=
	IF THEN ELSE ("project completeness (pc)">1.99,0,"Rookie Engineers (RE)")
	~	
	~		|

"development costs (DC)"=
	"labor costs rookie engineers (lcRE)"*"Total Rookie Person-Weeks (TRPW)"+"labor costs experienced engineers (lcEE)"\
		*"Total Experienced Person-Weeks (TEPW)"
	~	
	~		|

"weekly sales benefits (sb)"=
	"sales rate (sr)"*"sales price (sp)"
	~	
	~		|

"nominal sales price (nsp)"=
	41.7203
	~	
	~		|

"nominal tasks to be executed (T)"=
	100
	~	
	~		|

"rookie productivity fraction (rpf)"=
	0.6
	~	
	~		|

"expected delivery time (edt)"=
	1
	~	week
	~		|

"sales price (sp)"=
	"nominal sales price (nsp)"*(normal product performance+("product performance (pp)"-\
		normal product performance)/effect adv on price)
	~	
	~		|

"customer order rate (cor)"=
	("Total Market (TM)"-"Potential Customers (PC)")*"potential customer concentration (pcc)"\
		*"word-of-mouth factor (wom)"
	~	customers/week
	~		|

"Customers with Fulfilled Orders (CFO)"= INTEG (
	"sales rate (sr)",
		0)
	~	
	~		|

"Customers with Unfulfilled Orders (CUO)"= INTEG (
	"customer order rate (cor)"-"lost sales rate (lsr)"-"sales rate (sr)",
		initial CUO)
	~	customer
	~	0.0033
	|

"labor costs rookie engineers (lcRE)"=
	750
	~	
	~	750
	|

"Profit (P)"=
	"Sales Benefits (SB)"-"development costs (DC)"
	~	
	~		|

"desired sales rate (sr*)"=
	"Customers with Unfulfilled Orders (CUO)"/"expected delivery time (edt)"
	~	
	~		|

"Total Market (TM)"=
	"Potential Customers (PC)"+"Customers with Unfulfilled Orders (CUO)"+"Customers with Fulfilled Orders (CFO)"\
		+"Lost Customers (LC)"
	~	customers
	~		|

"lost sales rate (lsr)"=
	IF THEN ELSE("project completeness (pc)"<0.991,"desired sales rate (sr*)",0)
	~	
	~		|

"Sales Benefits (SB)"= INTEG (
	"weekly sales benefits (sb)",
		0)
	~	
	~		|

"labor costs experienced engineers (lcEE)"=
	950
	~	
	~	950
	|

"Lost Customers (LC)"= INTEG (
	"lost sales rate (lsr)",
		0)
	~	
	~		|

initial project tasks to be executed=
	"nominal tasks to be executed (T)"*normal product performance
	~	
	~	122.33
	|

"norm productivity rookie (npr)"=
	(1/("nominal time per task (tt)"+(0.21*"project newness (pn)")))*"rookie productivity fraction (rpf)"
	~	
	~		|

"sales rate (sr)"=
	IF THEN ELSE("project completeness (pc)"<0.991,0,"desired sales rate (sr*)")
	~	
	~		|

"Feasible Development Time (FDT)"= INTEG (
	"development time adjustment rate (dtar)",
		"Project Tasks in Execution (TE)"/("norm productivity experienced person (npe)"*"planned Team Size (pTS)"\
		))
	~	
	~		|

"development time adjustment rate (dtar)"=
	IF THEN ELSE("project completeness (pc)"<0.991,((Time+"development weeks still to go (wtg)"\
		)-"Feasible Development Time (FDT)"
	)/"development time adjustment delay (dtad)",0)
	~	
	~		|

effect adv on price=
	1
	~	
	~		|

"perceived personweeks remaining (ppwr)"=
	IF THEN ELSE("Project Tasks in Execution (TE)"<0.1,0,"Project Tasks in Execution (TE)"\
		/"norm productivity experienced person (npe)")
	~	week*persons
	~		|

"task finish rate (tfr)"=
	MIN("Project Tasks in Execution (TE)","team size (TS)"*"average actual productivity per person (aapp)"\
		)
	~	tasks/week
	~		|

"Rookie Engineers (RE)"= INTEG (
	+"hiring rate (hr)"-"assimilation rate (ar)"-end of project for rookies,
		0)
	~	persons
	~	11.45
	|

"efficiency loss (el)"=
	0.0004758*"team size (TS)"*"team size (TS)"
	~	
	~		|

end of project for experienced team=
	IF THEN ELSE("project completeness (pc)">0.991,"Experienced Engineers (EE)"/reallocation delay\
		,0)
	~	
	~		|

"assimilation delay (ad)"=
	20
	~	weeks
	~		|

"average productivity per person (app)"=
	("Rookie Engineers (RE)"*"norm productivity rookie (npr)"+"norm productivity experienced person (npe)"\
		*("Experienced Engineers (EE)"-"supervision time per rookie (st)"*"Rookie Engineers (RE)"\
		))/("Rookie Engineers (RE)"+"Experienced Engineers (EE)")
	~	
	~		|

"Total Experienced Person-Weeks (TEPW)"= INTEG (
	"experienced person-weeks (epw)",
		"Experienced Engineers (EE)")
	~	
	~		|

"team size (TS)"=
	"Rookie Engineers (RE)"+"Experienced Engineers (EE)"
	~	persons
	~		|

"development weeks still to go (wtg)"=
	"perceived personweeks remaining (ppwr)"/MAX("planned Team Size (pTS)","team size (TS)"\
		)
	~	weeks
	~		|

end of project for rookies=
	IF THEN ELSE("project completeness (pc)">0.991,"Rookie Engineers (RE)"/reallocation delay\
		,0)
	~	
	~		|

"supervision time per rookie (st)"=
	0.2
	~	
	~		|

"nominal time per task (tt)"=
	4.10468
	~	
	~		|

"word-of-mouth factor (wom)"=
	-0.1657*"project newness (pn)"+0.2468
	~	dmnl/week
	~	0.23-(0.23-0.1933)*(product newness factor/0.5)       0.197
	|

initial potential customers=
	10000*normal product performance
	~	
	~	14500
	|

"norm productivity experienced person (npe)"=
	1/("nominal time per task (tt)"+(0.21*"project newness (pn)"))
	~	
	~	0.2397
	|

normal product performance=
	1.45
	~	
	~		|

"project newness (pn)"=
	0.22*"product performance (pp)"
	~	dmnl
	~	0.32 = base case
	|

"development time adjustment delay (dtad)"=
	4
	~	
	~		|

add new tasks=
	new tasks for higher product advantage+new undiscovered tasks for higher product advantage
	~	
	~		|

"planned Team Size (pTS)"=
	10
	~	
	~	1.2233
	|

end profit=
	IF THEN ELSE(Time = 200,"Profit (P)", 0)
	~	
	~		|

"Potential Customers (PC)"= INTEG (
	add potential customers-"customer order rate (cor)",
		initial potential customers)
	~	customers
	~		|

"task definition rate (tdr)"=
	"Undiscovered Project Tasks (UT)"/"discovery delay of new tasks (ddt)"
	~	tasks/week
	~		|

"Undiscovered Project Tasks (UT)"= INTEG (
	new undiscovered tasks for higher product advantage-"task definition rate (tdr)",
		project tasks to be executed*"project newness (pn)")
	~	tasks
	~		|

"Scheduled Development Time (SDT)"=
	60.49
	~	weeks
	~	54 moet 't zijn voor de Base Case van 100 taken en 1 advantage, 66 in \
		calibratie case
	|

"intervention threshold (it)"=
	1e+09
	~	
	~		|

Discovery of Unrealistic Due Date= INTEG (
	change in discovery,
		0)
	~	
	~		|

reallocation delay=
	1
	~	
	~		|

product performance in number of features= GAME (
	10)
	~	
	~		|

increase team=
	0
	~	
	~		|

delay change in discovery=
	DELAY FIXED(change in discovery,TIME STEP,0)
	~	
	~		|

"Project Tasks in Execution (TE)"= INTEG (
	new tasks for higher product advantage+"task definition rate (tdr)"-"task finish rate (tfr)"\
		,
		project tasks to be executed*(1-"project newness (pn)"))
	~	tasks
	~		|

switch to extra hiring=
	1
	~	
	~		|

"assimilation rate (ar)"=
	"Rookie Engineers (RE)"/"assimilation delay (ad)"
	~	
	~		|

switch to change product performance=
	1
	~	
	~		|

"pressure to intervene (pi)"=
	"Feasible Development Time (FDT)"/"Scheduled Development Time (SDT)"
	~	
	~		|

project tasks to be executed= INTEG (
	add new tasks,
		initial project tasks to be executed)
	~	tasks
	~		|

"Total Rookie Person-Weeks (TRPW)"= INTEG (
	"rookie person-weeks (rpw)",
		"Rookie Engineers (RE)")
	~	
	~		|

"hiring delay (hd)"=
	12
	~	weeks
	~		|

"desired Team Size (TS*)"=
	"perceived personweeks remaining (ppwr)"/"time remaining (tr)"
	~	persons
	~		|

"time remaining (tr)"=
	MAX(1,"Scheduled Development Time (SDT)"-Time)
	~	weeks
	~		|

"project completeness (pc)"=
	MIN(0.999,"Project Tasks Finished (TF)"/project tasks to be executed)
	~	dmnl
	~		|

"discovery delay of new tasks (ddt)"=
	12
	~	week
	~		|

"potential customer concentration (pcc)"=
	"Potential Customers (PC)"/"Total Market (TM)"
	~	dmnl
	~		|

"Project Tasks Finished (TF)"= INTEG (
	"task finish rate (tfr)",
		0)
	~	tasks
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 120
	~	week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	week
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	week [0,?]
	~	The time step for the simulation.
	|

