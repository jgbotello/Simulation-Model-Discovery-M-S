:GRAPH customers_and_lost_customers
:TITLE customers and lost customers
:X-MIN 0
:X-MAX 135
:SCALE
:VAR "Customers with Fulfilled Orders (CFO)"
:Y-MAX 12000
:DATASET 
:VAR "Lost Customers (LC)"
:Y-MAX 12000
:DATASET 

:GRAPH pressure_to_intervene
:TITLE pressure to intervene
:SCALE
:VAR "pressure to intervene (pi)"
:Y-MIN 0.6
:Y-MAX 1.4
:DATASET 

:GRAPH profit
:TITLE profit
:SCALE
:VAR "Profit (P)"
:DATASET 

:GRAPH sales_rate_old
:TITLE sales rate old
:X-MIN 60
:X-MAX 120
:SCALE
:VAR "sales rate (sr)"
:DATASET base case v14
:VAR "sales rate (sr)"
:DATASET increase team v14
:VAR "sales rate (sr)"
:DATASET decrease advantage v14
:VAR "sales rate (sr)"
:DATASET increase team & advantage v14

:GRAPH cumulative_sales
:TITLE cumulative sales
:X-MAX 135
:SCALE
:VAR "Customers with Fulfilled Orders (CFO)"
:Y-MAX 15000
:DATASET base case v14
:VAR "Customers with Fulfilled Orders (CFO)"
:Y-MAX 15000
:DATASET increase team v14
:VAR "Customers with Fulfilled Orders (CFO)"
:Y-MAX 15000
:DATASET decrease advantage v14
:VAR "Customers with Fulfilled Orders (CFO)"
:Y-MAX 15000
:DATASET increase team & advantage v14

:GRAPH team_size
:TITLE team size
:X-MAX 80
:SCALE
:VAR "team size (TS)"
:Y-MAX 12
:DATASET base case jan 06 2010
:VAR "team size (TS)"
:Y-MAX 12
:DATASET increase team jan 06 2010
:VAR "team size (TS)"
:Y-MAX 12
:DATASET decrease adv jan 06 2010
:VAR "team size (TS)"
