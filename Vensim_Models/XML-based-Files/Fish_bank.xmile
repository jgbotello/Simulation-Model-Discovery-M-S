<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0">
	<header>
		<product version="1.0" lang="en">Vensim</product>
		<vendor>Ventana Systems, Inc.</vendor>
		<created>
		</created>
		<modified>
		</modified>
		<name>
		</name>
		<caption>
		</caption>
	</header>
	<sim_specs method="RK4" time_units="Year">
		<start> 2010</start>
		<stop> 2025</stop>
		<dt> 0.25</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="Fish">
				<units>fish</units>
				<doc></doc>
					<eqn>
					INTIAL_FISH
					</eqn>
					<inflow>
					fish hatch rate
					</inflow>
					<outflow>
					fish death rate
					</outflow>
					<outflow>
					total catch per year
					</outflow>
			</stock>
			<stock name="Ships">
				<units>ship</units>
				<doc></doc>
					<eqn>
					INITIAL_SHIPS
					</eqn>
					<inflow>
					ship building rate
					</inflow>
			</stock>
			<stock name="Total_Profits">
				<units>$</units>
				<doc></doc>
					<eqn>
					INITIAL_TOTAL_PROFITS
					</eqn>
					<inflow>
					annual profits
					</inflow>
			</stock>
			<aux name="annual_profits">
				<units>$/Year</units>
				<doc></doc>
					<eqn>
	revenues-costs					</eqn>
			</aux>
			<aux name="catch_per_ship">
				<units>fish/(Year*ship)</units>
				<doc></doc>
					<eqn>
	EFFECT_OF_DENSITY_ON_CATCH_PER_SHIP(density/NORMAL_DENSITY)					</eqn>
			</aux>
			<aux name="costs">
				<units>$/Year</units>
				<doc></doc>
					<eqn>
	Ships*UNIT_SHIP_OPERATING_COST					</eqn>
			</aux>
			<aux name="death_fraction">
				<units>1/Year</units>
				<doc></doc>
					<eqn>
	EFFECT_OF_FISH_AND_CARRYING_CAPACITY_ON_DEATH_FRACTION(Fish/CARRYING_CAPACITY)					</eqn>
			</aux>
			<aux name="density">
				<units>fish/(miles*miles)</units>
				<doc></doc>
					<eqn>
	Fish/AREA					</eqn>
			</aux>
			<aux name="fish_death_rate">
				<units>fish/Year</units>
				<doc></doc>
					<eqn>
	death_fraction*Fish					</eqn>
			</aux>
			<aux name="fish_hatch_rate">
				<units>fish/Year</units>
				<doc></doc>
					<eqn>
	Fish*HATCH_FRACTION					</eqn>
			</aux>
			<aux name="FISH_PRICE">
				<units>$/fish</units>
				<doc></doc>
					<eqn> GAME (
	20)					</eqn>
			</aux>
			<aux name="FRACTION_INVESTED">
				<units>Dmnl</units>
				<doc></doc>
					<eqn> GAME (
	0.2)					</eqn>
			</aux>
			<aux name="revenues">
				<units>$/Year</units>
				<doc></doc>
					<eqn>
	FISH_PRICE*total_catch_per_year					</eqn>
			</aux>
			<aux name="ship_building_rate">
				<units>ship/Year</units>
				<doc></doc>
					<eqn>
	MAX(0,annual_profits*FRACTION_INVESTED/SHIP_COST)					</eqn>
			</aux>
			<aux name="SHIP_COST">
				<units>$/ship</units>
				<doc></doc>
					<eqn> GAME (
	300)					</eqn>
			</aux>
			<aux name="total_catch_per_year">
				<units>fish/Year</units>
				<doc></doc>
					<eqn>
	Ships*catch_per_ship					</eqn>
			</aux>
			<aux name="UNIT_SHIP_OPERATING_COST">
				<units>$/(Year*ship)</units>
				<doc></doc>
					<eqn> GAME (
	250)					</eqn>
			</aux>
			<aux name="EFFECT_OF_DENSITY_ON_CATCH_PER_SHIP">
				<units>fish/(Year*ship)</units>
				<doc></doc>
<gf>
<xpts>0.000000,1.000000,2.000000,3.000000,4.000000,5.000000,6.000000,7.000000,8.000000,9.000000,10.000000,11.000000,12.000000</xpts>
<ypts>0.000000,5.000000,10.380000,15.880000,20.250000,22.130000,23.250000,23.750000,24.250000,24.630000,25.000000,25.350000,25.480000</ypts>
</gf>
			</aux>
			<aux name="EFFECT_OF_FISH_AND_CARRYING_CAPACITY_ON_DEATH_FRACTION">
				<units>1/Year</units>
				<doc></doc>
<gf>
<xpts>0.000000,0.100000,0.200000,0.300000,0.400000,0.500000,0.600000,0.700000,0.800000,0.900000,1.000000</xpts>
<ypts>5.220000,5.225000,5.230000,5.240000,5.255000,5.290000,5.345000,5.450000,5.665000,5.940000,6.000000</ypts>
</gf>
			</aux>
			<aux name="AREA">
				<units>miles*miles</units>
				<doc></doc>
					<eqn>
	100					</eqn>
			</aux>
			<aux name="CARRYING_CAPACITY">
				<units>fish</units>
				<doc></doc>
					<eqn>
	1200					</eqn>
			</aux>
			<aux name="HATCH_FRACTION">
				<units>1/Year</units>
				<doc></doc>
					<eqn>
	6					</eqn>
			</aux>
			<aux name="INITIAL_SHIPS">
				<units>ship</units>
				<doc></doc>
					<eqn>
	10					</eqn>
			</aux>
			<aux name="INITIAL_TOTAL_PROFITS">
				<units></units>
				<doc></doc>
					<eqn>
	0					</eqn>
			</aux>
			<aux name="INTIAL_FISH">
				<units></units>
				<doc></doc>
					<eqn>
	1000					</eqn>
			</aux>
			<aux name="NORMAL_DENSITY">
				<units>fish/(miles*miles)</units>
				<doc></doc>
					<eqn>
	1					</eqn>
			</aux>
		</variables>
	</model>
</xmile>
