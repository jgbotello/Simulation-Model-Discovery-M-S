<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0">
	<header>
		<product version="1.0" lang="en">Vensim</product>
		<vendor>Ventana Systems, Inc.</vendor>
		<created>
		</created>
		<modified>
		</modified>
		<name>
		</name>
		<caption>
		</caption>
	</header>
	<sim_specs method="RK4" time_units="Year">
		<start> 2000</start>
		<stop> 2005</stop>
		<dt> 0.015625</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="Deel_van_Werkpakket_voor_Intake">
				<units>Dmnl</units>
				<doc>De relatieve werklast voor Intake (t.o.v. de totale hoeveelheid werklast voor Intake en Afhandeling).</doc>
					<eqn>
					InitiÃ«el_deel_werkpakket_intake
					</eqn>
					<inflow>
					Verandering Deel Werkpakket Intake
					</inflow>
			</stock>
			<stock name="Dossiers_In_Behandeling">
				<units>Dossiers</units>
				<doc>Het aantal Dossiers dat op een bepaald tijdstip in Behandeling is.</doc>
					<eqn>
					InitiÃ«le_Dossiers_in_Behandeling
					</eqn>
					<inflow>
					Intake
					</inflow>
					<outflow>
					Afleggen
					</outflow>
					<outflow>
					Dossiers Uitbesteden
					</outflow>
			</stock>
			<stock name="Ervaren_Medewerkers">
				<units>Medewerkers</units>
				<doc>Het aantal Ervaren Medewerkers dat op een bepaald tijdstip in dienst is.</doc>
					<eqn>
					InitiÃ«le_Aantal_Ervaren_Medewerkers
					</eqn>
					<inflow>
					Inhuur Ervaren Medewerkers
					</inflow>
					<inflow>
					Doorstroom Medewerkers
					</inflow>
					<outflow>
					Verloop Ervaren Medewerkers
					</outflow>
			</stock>
			<stock name="Gepercipieerde_Werkdruk">
				<units>Dmnl</units>
				<doc>De werkdruk die medewerkers waarnemen.</doc>
					<eqn>
					Normale_Werkdruk
					</eqn>
					<inflow>
					Verandering in Perceptie Werkdruk
					</inflow>
			</stock>
			<stock name="Klanttevredenheid">
				<units>Dmnl</units>
				<doc>De mate waarin klanten tevreden zijn met de door SRB geleverde diensten.</doc>
					<eqn>
					Normale_Klanttevredenheid
					</eqn>
					<inflow>
					Verandering in Klanttevredenheid
					</inflow>
			</stock>
			<stock name="Medewerkertevredenheid">
				<units>Dimensionless</units>
				<doc>De mate waarin medewerkers tevreden zijn met hun werk bij SRB.</doc>
					<eqn>
					Normale_Medewerker_tevredenheid
					</eqn>
					<inflow>
					Verandering Medewerker tevredenheid
					</inflow>
			</stock>
			<stock name="Meldingen">
				<units>Dossiers</units>
				<doc>Het aantal Meldingen dat op een bepaald tijdstip op voorraad ligt.</doc>
					<eqn>
					InitiÃ«le_Nieuwe_Meldingen
					</eqn>
					<inflow>
					Nieuwe Meldingen
					</inflow>
					<outflow>
					Intake
					</outflow>
					<outflow>
					Meldingen afgewezen
					</outflow>
			</stock>
			<stock name="Nieuwe_Medewerkers">
				<units>Medewerkers</units>
				<doc>Aantal Nieuwe Medewerkers dat op een bepaald tijdstip in dienst is.</doc>
					<eqn>
					InitiÃ«le_Aantal_Nieuwe_Medewerkers
					</eqn>
					<inflow>
					Inhuur Nieuwe Medewerkers
					</inflow>
					<outflow>
					Verloop Nieuwe Medewerkers
					</outflow>
					<outflow>
					Doorstroom Medewerkers
					</outflow>
			</stock>
			<stock name="Pink_Noise">
				<units>Dimensionless</units>
				<doc>Pink Noise is first-order autocorrelated noise.  Pink noise provides a realistic noise input to
        models in which the next random shock depends in part on the previous shocks.  The user
        can specify the correlation time.  The mean is 0 and the standard deviation is specified
         by the user.</doc>
					<eqn>
					0
					</eqn>
					<inflow>
					Change in Pink Noise
					</inflow>
			</stock>
			<stock name="Totale_Expertise_Ervaren_Medewerkers">
				<units>Medewerker*Werkjaar</units>
				<doc>De totale expertise in aantal menswerkjaren voor de gehele populatie nieuwe medewerkers.</doc>
					<eqn>
					InitiÃ«le_Totale_Expertise_Ervaren_Medewerkers
					</eqn>
					<inflow>
					Toename Expertise door Ervaren Inhuur
					</inflow>
					<inflow>
					Toename Expertise door Dossierervaring Ervaren Medewerkers
					</inflow>
					<inflow>
					Toename Expertise door Doorstroom
					</inflow>
					<outflow>
					Verlies van Expertise Ervaren Medewerkers door Verloop
					</outflow>
					<outflow>
					Verouderingssnelheid Expertise Ervaren Medewerkers
					</outflow>
			</stock>
			<stock name="Totale_Expertise_Nieuwe_Medewerkers">
				<units>Medewerker*Werkjaar</units>
				<doc>De totale expertise in aantal menswerkjaren voor de gehele populatie nieuwe medewerkers</doc>
					<eqn>
					InitiÃ«le_Totale_Expertise_Nieuwe_Medewerkers
					</eqn>
					<inflow>
					Toename Expertise door Inhuur
					</inflow>
					<inflow>
					Toename Expertise door Dossierervaring
					</inflow>
					<outflow>
					Verlies van Expertise Nieuwe Medewerkers door Verloop
					</outflow>
					<outflow>
					Verouderingssnelheid Expertise Nieuwe Medewerkers
					</outflow>
					<outflow>
					Verlies van Expertise door Doorstroom
					</outflow>
			</stock>
			<stock name="Verloopperc_Ervaren_Medewerkers">
				<units>1/Jaar</units>
				<doc>Het verlooppercentage van Ervaren Medewerkers wordt bepaald door het Normale Verlooppercentage maar ook door de impact van medewerkertevredenheid</doc>
					<eqn>
					Normaal_Verloopperc_Ervaren_Medewerkers
					</eqn>
					<inflow>
					Verandering Verloopperc Ervaren Medewerkers
					</inflow>
			</stock>
			<stock name="Verloopperc_Nieuwe_Medewerkers">
				<units>1/Jaar</units>
				<doc>Het verlooppercentage van Nieuwe Medewerkers wordt bepaald door het Normale Verlooppercentage maar ook door de impact van medewerkertevredenheid</doc>
					<eqn>
					Normaal_Verloopperc_Nieuwe_Medewerkers
					</eqn>
					<inflow>
					Verandering Verloopperc Nieuwe Medewerkers
					</inflow>
			</stock>
			<aux name="Aantal_Nieuwe_Medewerkers_per_Ervaren_Medewerkers">
				<units>Dmnl</units>
				<doc>Een verhoudingsgetal dat aangeeft hoeveel nieuwe medewerkers ingewerkt moeten worden door één ervaren medewerker.</doc>
					<eqn>
	Nieuwe_Medewerkers/Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Actueel_Percentage_Ervaren_Medewerkers_met_Verloopplannen">
				<units>1/Jaar</units>
				<doc>Het percentage van Ervaren Medewerkers met verloopplannen wordt bepaald door een normaal verlooppercentage en door de tevredenheid.</doc>
					<eqn>
	Normaal_Verloopperc_Ervaren_Medewerkers*Effect_van_Tevredenheid_op_Verloop					</eqn>
			</aux>
			<aux name="Actueel_Percentage_Nieuwe_Medewerkers_met_Verloopplannen">
				<units>1/Jaar</units>
				<doc>Het percentage van Nieuwe Medewerkers met verloopplannen wordt bepaald door een normaal verlooppercentage en door de tevredenheid.</doc>
					<eqn>
	Normaal_Verloopperc_Nieuwe_Medewerkers*Effect_van_Tevredenheid_op_Verloop					</eqn>
			</aux>
			<aux name="Actuele_Doorlooptijd_Afhandeling">
				<units>Weken</units>
				<doc>De actuele verblijftijd van dossiers in behandeling, gemiddeld gezien.</doc>
					<eqn>
	(Dossiers_In_Behandeling/(Afleggen+Dossiers_Uitbesteden))*Aantal_weken_per_jaar					</eqn>
			</aux>
			<aux name="Actuele_Doorlooptijd_Intake">
				<units>Weken</units>
				<doc>De actuele verblijftijd van dossiers inintake, gemiddeld gezien.</doc>
					<eqn>
	(Meldingen/Intake)*Aantal_weken_per_jaar					</eqn>
			</aux>
			<aux name="Actuele_Klanttevredenheid">
				<units>Dmnl</units>
				<doc>De mate van Klanttevredenheid die bepaald wordt door een exogene variabele, de doorlooptijd en de expertise van medewerkers.</doc>
					<eqn>
	Gewicht_Exogene_Variabele*Bijdrage_Exogene_Variabele_in_Klanttevredenheid+Gewicht_Doorlooptijd*Bijdrage_Doorlooptijd_in_Klanttevredenheid+Gewicht_Expertise*Bijdrage_Expertise_in_Klanttevredenheid					</eqn>
			</aux>
			<aux name="Actuele_Medewerker_tevredenheid">
				<units>Dmnl</units>
				<doc>De mate van Medewerkertevredenheid die bepaald wordt door de gepercipieerde werkdruk en de fit tussen (inhoud) dossiers en interesses van medewerkers.</doc>
					<eqn>
	Gewicht_van_Werkdruk_op_Tevredenheid*Effect_van_Werkdruk_op_Tevredenheid+Gewicht_van_Fit_Dossiers_op_Tevredenheid*Effect_van_Fit_Dossiers_op_Tevredenheid+Gewicht_van_Opleidingen_op_Tevredenheid*Effect_van_Opleidingen_op_Tevredenheid					</eqn>
			</aux>
			<aux name="Afleggen">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Dossiers dat per jaar afgelegd wordt.</doc>
					<eqn>
	Min((Dossiers_In_Behandeling/Minimale_Afhandelingstijd),Beschikbare_Capaciteit_voor_Afhandeling_in_Dossiers)					</eqn>
			</aux>
			<aux name="Beschikbaarheidspercentage_Ervaren_Medewerkers">
				<units>Dmnl</units>
				<doc>Het percentage dat aangeeft hoeveel netto tijd ervaren medewerkers beschikbaar zijn om aan dossiers te werken.</doc>
					<eqn>
	MAX(0,(Beschikbaarheidspercentage_Exclusief_Vakantie_en_Normaal_Ziekteverzuim-Opleidingen_en_Zittingen_Ervaren_Medewerkers
-Effect_Werkdruk_op_Ziekteverzuim))					</eqn>
			</aux>
			<aux name="Beschikbaarheidspercentage_Nieuwe_Medewerkers">
				<units>Dmnl</units>
				<doc>Het percentage dat aangeeft hoeveel netto tijd nieuwe medewerkers beschikbaar zijn om aan dossiers te werken.</doc>
					<eqn>
	MAX(0,(Beschikbaarheidspercentage_Exclusief_Vakantie_en_Normaal_Ziekteverzuim-Effect_Werkdruk_op_Ziekteverzuim-Opleidingen_en_Zittingen_Nieuwe_Medewerkers))					</eqn>
			</aux>
			<aux name="Beschikbare_Cap_Ervaren_Medewerkers_voor_Afhandeling">
				<units>FTE/Jaar</units>
				<doc>Aantal Ervaren Medewerkers (in FTE's per jaar) dat zich bezighoudt met Afhandeling.</doc>
					<eqn>
	Beschikbare_Capaciteit_Ervaren_Medewerkers*(1-Per_Cap_Toewijzing_Intake_Ervaren_Medewerkers)					</eqn>
			</aux>
			<aux name="Beschikbare_Cap_Ervaren_Medewerkers_voor_Intake">
				<units>FTE/Jaar</units>
				<doc>Aantal Ervaren Medewerkers (in FTE's per jaar) dat zich bezighoudt met Intake.</doc>
					<eqn>
	Min(Beschikbare_Capaciteit_Ervaren_Medewerkers,(Deel_van_Werkpakket_voor_Intake*(Beschikbare_Capaciteit_Nieuwe_Medewerkers+Beschikbare_Capaciteit_Ervaren_Medewerkers)*Nadruk_Ervaren_Medewerkers_voor_Intake))					</eqn>
			</aux>
			<aux name="Beschikbare_Cap_Nieuwe_Medewerkers_voor_Afhandeling">
				<units>FTE/Jaar</units>
				<doc>Aantal Nieuwe Medewerkers (in FTE's per jaar) dat zich bezighoudt met Afhandeling.</doc>
					<eqn>
	Beschikbare_Capaciteit_Nieuwe_Medewerkers*(1-Per_Cap_Toewijzing_Intake_Nieuwe_Medewerkers)					</eqn>
			</aux>
			<aux name="Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake">
				<units>FTE/Jaar</units>
				<doc>Aantal Nieuwe Medewerkers (in FTE's per jaar) dat zich bezighoudt met Intake.</doc>
					<eqn>
	Min(Beschikbare_Capaciteit_Nieuwe_Medewerkers,(Deel_van_Werkpakket_voor_Intake*(Beschikbare_Capaciteit_Nieuwe_Medewerkers+Beschikbare_Capaciteit_Ervaren_Medewerkers)*(1-Nadruk_Ervaren_Medewerkers_voor_Intake)))					</eqn>
			</aux>
			<aux name="Beschikbare_Capaciteit_Ervaren_Medewerkers">
				<units>FTE/Jaar</units>
				<doc>Netto Beschikbare Capaciteit Ervaren Medewerkers (exclusief vergadertijd, ziekte, vakantie, opleiding e.d.).</doc>
					<eqn>
	Totale_capaciteit_Ervaren_Medewerkers*Beschikbaarheidspercentage_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Beschikbare_Capaciteit_Nieuwe_Medewerkers">
				<units>FTE/Jaar</units>
				<doc>Netto Beschikbare Capaciteit Nieuwe Medewerkers (exclusief vergadertijd, ziekte, vakantie, opleiding e.d.).</doc>
					<eqn>
	Totale_Capaciteit_Nieuwe_Medewerkers*Beschikbaarheidspercentage_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Beschikbare_Capaciteit_voor_Afhandeling_in_Dossiers">
				<units>Dossiers/Jaar</units>
				<doc>Aantal Dossiers in Afhandeling die Nieuwe en Ervaren Medewerkers per jaar kunnen verwerken op basis van hun Beschikbare Capaciteit.</doc>
					<eqn>
	Beschikbare_Capaciteit_voor_Afhandeling_in_Tijdseenheden/(Gemiddelde_Werkinhoud_Dossier/Omrekenfactor_van_Week_naar_FTE)					</eqn>
			</aux>
			<aux name="Beschikbare_Capaciteit_voor_Afhandeling_in_Tijdseenheden">
				<units>FTE/Jaar</units>
				<doc>Totale capaciteit van zowel Nieuwe als Ervaren Medewerkers (in FTE's per jaar) die beschikbaar is voor Afhandeling.</doc>
					<eqn>
	Beschikbare_Cap_Ervaren_Medewerkers_voor_Afhandeling+Beschikbare_Cap_Nieuwe_Medewerkers_voor_Afhandeling					</eqn>
			</aux>
			<aux name="Beschikbare_Capaciteit_voor_Intake_in_Dossiers">
				<units>Dossiers/Jaar</units>
				<doc>Aantal Dossiers in Intake die Nieuwe en Ervaren Medewerkers per jaar kunnen verwerken op basis van hun Beschikbare Capaciteit.</doc>
					<eqn>
	Beschikbare_Capaciteit_voor_Intake_in_Tijdseenheden/(Gemiddelde_Werkinhoud_Intake/Omrekenfactor_van_Week_naar_FTE)					</eqn>
			</aux>
			<aux name="Beschikbare_Capaciteit_voor_Intake_in_Tijdseenheden">
				<units>FTE/Jaar</units>
				<doc>Totale capaciteit van zowel Nieuwe als Ervaren Medewerkers (in FTE's per jaar) die beschikbaar is voor Intake.</doc>
					<eqn>
	Beschikbare_Cap_Ervaren_Medewerkers_voor_Intake+Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake					</eqn>
			</aux>
			<aux name="Bijdrage_Doorlooptijd_in_Klanttevredenheid">
				<units>Dmnl</units>
				<doc>Het verschil tussen de totale actuele doorlooptijd en de referentiedoorlooptijd van de klant als percentage van de referentiedoorlooptijd van de klant.</doc>
					<eqn>
	MAX(0, Min(((Referentiedoorlooptijd_van_Klant-Totale_Actuele_Doorlooptijd)/Referentiedoorlooptijd_van_Klant), 1))					</eqn>
			</aux>
			<aux name="Bijdrage_Expertise_in_Klanttevredenheid">
				<units>Dmnl</units>
				<doc>De gemiddelde expertise van medewerkers die door klanten opgemerkt wordt t.o.v. de gemiddelde expertise van ervaren medewerkers die klanten graag zouden willen hebben.</doc>
					<eqn>
	MAX(0, Min(((Gemiddelde_Expertise-Referentie_Expertise_van_Klant)/Referentie_Expertise_van_Klant), 1))					</eqn>
			</aux>
			<aux name="Change_in_Pink_Noise">
				<units>1/Jaar</units>
				<doc>Change in the pink noise value; Pink noise is a first order exponential smoothing delay of the white
         noise input.</doc>
					<eqn> (White_Noise - Pink_Noise)/Noise_Correlation_Time					</eqn>
			</aux>
			<aux name="Doorstroom_Medewerkers">
				<units>Medewerkers/Jaar</units>
				<doc>Het aantal Nieuwe Medewerkers dat per jaar doorstroomt naar Ervaren Medewerkers.</doc>
					<eqn>
	Nieuwe_Medewerkers/Groeitijd_tot_Ervaren_Medewerker					</eqn>
			</aux>
			<aux name="Dossiers_door_Ervaren_Medewerkers">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Dossiers dat per jaar door Ervaren Medewerkers wordt afgelegd.</doc>
					<eqn>
	(1-Perc_van_Afhandelcap_door_Nieuwe_Medewerkers)*Afleggen					</eqn>
			</aux>
			<aux name="Dossiers_door_Nieuwe_Medewerkers">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Dossiers dat per jaar door Nieuwe Medewerkers wordt afgelegd.</doc>
					<eqn>
	Afleggen*Perc_van_Afhandelcap_door_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Dossiers_Uitbesteden">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Dossiers dat per jaar in weggewerkt wordt.</doc>
					<eqn>
	MAX(0, (Dossiers_In_Behandeling*Aantal_weken_per_jaar/Grens_voor_Uitbesteding)-Afleggen)					</eqn>
			</aux>
			<aux name="Druk_op_Aannamebeleid">
				<units>Dimensionless</units>
				<doc>De druk om mensen aan te nemen wordt groter naarmate de gepercipieerde werkdruk groter is dan de managementnorm.</doc>
					<eqn>
	Gepercipieerde_Werkdruk/Managementnorm_Werkdruk					</eqn>
			</aux>
			<aux name="Effect_van_Fit_Dossiers_op_Tevredenheid">
				<units>Dmnl</units>
				<doc>Het percentage van de intakecapaciteit dat door Ervaren Medewerkers wordt ingevuld en dus het percentage van de Intake waarvoor een juiste fit wordt gevonden.</doc>
					<eqn>
	1-Perc_van_Intakecap_door_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Effect_van_Opleidingen_op_Tevredenheid">
				<units>Dmnl</units>
				<doc>Het gemiddelde percentage van de totale beschikbare capaciteit dat medewerkers aan opleidingen en zittingen mogen besteden.</doc>
					<eqn>
	Tabel_voor_Effect_van_Opleidingen_op_Tevredenheid((Opleidingen_en_Zittingen_Ervaren_Medewerkers+Opleidingen_en_Zittingen_Nieuwe_Medewerkers
)/2)					</eqn>
			</aux>
			<aux name="Effect_van_Tevredenheid_op_Verloop">
				<units>Dimensionless</units>
				<doc>Het Verloop is een functie van het quotient van de Medewerkertevredenheid en de Normale Medewerkertevredenheid.</doc>
					<eqn>
	Tabel_voor_Effect_van_Tevredenheid_op_Verloop(Medewerkertevredenheid/Normale_Medewerker_tevredenheid)					</eqn>
			</aux>
			<aux name="Effect_van_Werkdruk_op_Gewenst_Medewerkerniveau">
				<units>1/Jaar</units>
				<doc>Bij een reactief aannamebeleid is het effect van werkdruk op gewenst medewerkerniveau een nonlineaire functie van de werkdruk.</doc>
					<eqn>
	Switch_voor_Reactief_Aannamebeleid*Tabel_voor_Effect_van_Werkdruk_op_Aannamebeleid(Druk_op_Aannamebeleid) + (1-Switch_voor_Reactief_Aannamebeleid
	)*Exogene_Druk_op_Personeelsgroei					</eqn>
			</aux>
			<aux name="Effect_van_Werkdruk_op_Tevredenheid">
				<units>Dmnl</units>
				<doc>De Medewerkertevredenheid is een functie van het quotient van de gepercipieerde werkdruk en de gewenste werkdruk.</doc>
					<eqn>
	Tabel_voor_Effect_van_Werkdruk_op_Tevredenheid(Gepercipieerde_Werkdruk/Gewenste_Werkdruk_Medewerker)					</eqn>
			</aux>
			<aux name="Effect_Werkdruk_op_Ziekteverzuim">
				<units>Dmnl</units>
				<doc>Het percentage ziekteverzuim, dat veroorzaakt wordt door de gepercipieerde werkdruk.</doc>
					<eqn>
	Tabel_voor_Effect_Werkdruk_op_Ziekteverzuim(Gepercipieerde_Werkdruk)					</eqn>
			</aux>
			<aux name="Exogene_Druk_op_Personeelsgroei">
				<units>1/Jaar</units>
				<doc>Exogene druk op personeelsgroei is gebaseerd op het BU Plan en kan eventueel als test aangepast worden met een bepaalde grootte (pulse).</doc>
					<eqn>
	Groei_volgens_BU_Plan(Time-2000)*(1+Pulse_Inhuur)					</eqn>
			</aux>
			<aux name="Exogene_Expertise_Inhuur_Ervaren_Medewerkers">
				<units>Werkjaar</units>
				<doc>Mogeljkheid om test inputs lost te laten op het model, zoals step, pulse, sine wave, en random noise.</doc>
					<eqn>
	 Expertise_Inhuur_Nieuwe_Medewerkers*Input					</eqn>
			</aux>
			<aux name="Exponent_Leercurve">
				<units>Dimensionless</units>
				<doc>De exponent in de leercurve. Berekend op basis van de sterkte van de leercurve.</doc>
					<eqn>
	LN(1+Sterkte_Leercurve)/LN(2)					</eqn>
			</aux>
			<aux name="Exponent_Leercurve_Ervaren">
				<units>Dimensionless</units>
				<doc>De exponent in de leercurve. Berekend op basis van de sterkte van de leercurve.</doc>
					<eqn>
	LN(1+Sterkte_Leercurve_Ervaren)/LN(2)					</eqn>
			</aux>
			<aux name="Gemiddelde_Doorlooptijd_Afhandeling">
				<units>Jaar</units>
				<doc>Gemiddelde Doorlooptijd Afhandeling die bepaald wordt door de Beschikbare Capaciteit voor Afhandeling en het aantal Dossiers in Behandeling.</doc>
					<eqn>
	MAX(Minimale_Afhandelingstijd,Dossiers_In_Behandeling/Beschikbare_Capaciteit_voor_Afhandeling_in_Dossiers)					</eqn>
			</aux>
			<aux name="Gemiddelde_Doorlooptijd_Intake">
				<units>Jaar</units>
				<doc>Gemiddelde Doorlooptijd Intake die bepaald wordt door de Beschikbare Capaciteit voor Intake en het aantal Meldingen dat op voorraad ligt.</doc>
					<eqn>
	MAX(Minimale_Intaketijd,Meldingen/Beschikbare_Capaciteit_voor_Intake_in_Dossiers)					</eqn>
			</aux>
			<aux name="Gemiddelde_Expertise">
				<units>Werkjaar</units>
				<doc>Gemiddelde Expertise van alle medewerkers (zowel nieuw als ervaren).</doc>
					<eqn>
	(Nieuwe_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers+Ervaren_Medewerkers*Gemiddelde_Expertise_Ervaren_Medewerkers)/(Nieuwe_Medewerkers+Ervaren_Medewerkers)					</eqn>
			</aux>
			<aux name="Gemiddelde_Expertise_Ervaren_Inhuur">
				<units>Werkjaar</units>
				<doc>hoeveel expertise ervaren medewerkers met zich meebrengen, exogeen bepaald</doc>
					<eqn>
	Exogene_Expertise_Inhuur_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Gemiddelde_Expertise_Ervaren_Medewerkers">
				<units>Werkjaar</units>
				<doc>De gemiddelde expertise van ervaren medewerkers</doc>
					<eqn>
	Totale_Expertise_Ervaren_Medewerkers/Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Gemiddelde_Expertise_Nieuwe_Inhuur">
				<units>Werkjaar</units>
				<doc>De hoeveelheid expertise die nieuwe medewerkers met zich meebrengen, exogeen bepaald.</doc>
					<eqn>
	Exogene_Expertise_Inhuur_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Gemiddelde_Expertise_Nieuwe_Medewerkers">
				<units>Werkjaar</units>
				<doc>De gemiddelde expertise van nieuwe medewerkers</doc>
					<eqn>
	Totale_Expertise_Nieuwe_Medewerkers/Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Gemiddelde_verblijftijd_Ervaren_Medewerkers">
				<units>Jaar</units>
				<doc>De gemiddelde verblijftijd van Ervaren Medewerkers (deze tijd wordt beeindigd of door verloop).</doc>
					<eqn>
	Ervaren_Medewerkers/Verloop_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Gemiddelde_verblijftijd_Nieuwe_Medewerkers">
				<units>Jaar</units>
				<doc>De gemiddelde verblijftijd van Nieuwe Medewerkers (deze tijd wordt beeindigd of door doorstroom naar Ervaren Medewerkers of door verloop).</doc>
					<eqn>
	Nieuwe_Medewerkers/(Doorstroom_Medewerkers+Verloop_Nieuwe_Medewerkers)					</eqn>
			</aux>
			<aux name="Gewenst_Aantal_Medewerkers">
				<units>Medewerkers/Jaar</units>
				<doc>Het Gewenst Aantal Medewerkers is gebaseerd op het actuele aantal medewerkers en naar boven of beneden aangepast op basis van de druk op aannamebeleid.</doc>
					<eqn>
	Totaal_Actueel_Aantal_Medewerkers*Effect_van_Werkdruk_op_Gewenst_Medewerkerniveau+(Verloop_Ervaren_Medewerkers+Verloop_Nieuwe_Medewerkers
	)*(1-Switch_voor_Reactief_Aannamebeleid)					</eqn>
			</aux>
			<aux name="Groei_Dossiers">
				<units>1/Jaar</units>
				<doc>Groei Dossiers komt overeen met gegevens uit het BU Plan maar kan ook bepaald worden door een Exogene Groeivoet vanaf een bepaalde Starttijd.</doc>
					<eqn>
	STEP(Exogene_Groeivoet,Starttijd_Groei)+Groei_volgens_BU_Plan(Time-2000)					</eqn>
			</aux>
			<aux name="Inhuur_Ervaren_Medewerkers">
				<units>Medewerkers/Jaar</units>
				<doc>Het aantal Ervaren Medewerkers dat per jaar aangenomen wordt.</doc>
					<eqn>
	MAX(0,DELAY3(Verloop_Ervaren_Medewerkers-Doorstroom_Medewerkers,Inhuurtijd_Ervaren_Medewerkers))					</eqn>
			</aux>
			<aux name="Inhuur_Nieuwe_Medewerkers">
				<units>Medewerkers/Jaar</units>
				<doc>Het aantal Nieuwe Medewerkers dat per jaar in dienst treedt.</doc>
					<eqn>
	MAX(0,DELAY3((Gewenst_Aantal_Medewerkers-(Totaal_Actueel_Aantal_Medewerkers/dimensie_variabele)) , Inhuurtijd_Nieuwe_Medewerkers))					</eqn>
			</aux>
			<aux name="InitiÃ«le_Aantal_Ervaren_Medewerkers">
				<units></units>
				<doc></doc>
					<eqn>
	Initiële_Totale_Aantal_Medewerkers*(1-Perc_Initiële_Aantal_Nieuwe_Medewerkers)					</eqn>
			</aux>
			<aux name="InitiÃ«le_Aantal_Nieuwe_Medewerkers">
				<units></units>
				<doc></doc>
					<eqn>
	Initiële_Totale_Aantal_Medewerkers*Perc_Initiële_Aantal_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="InitiÃ«le_Dossiers_in_Behandeling">
				<units></units>
				<doc></doc>
					<eqn>
	(Groei_Dossiers*(Basisaanbod_Dossiers/2)*Referentiedoorlooptijd_Afhandeling/Aantal_weken_per_jaar)					</eqn>
			</aux>
			<aux name="InitiÃ«le_Nieuwe_Meldingen">
				<units></units>
				<doc></doc>
					<eqn>
	(Groei_Dossiers*Basisaanbod_Dossiers*Referentiedoorlooptijd_Intake/Aantal_weken_per_jaar)*0+Initiële_Dossiers_in_Behandeling*1					</eqn>
			</aux>
			<aux name="Input">
				<units>Dimensionless</units>
				<doc>Input is een dimensieloze variabele die verschillende input-patronen kan testen, zoals een step, pulse, sine wave, en random noise.</doc>
					<eqn>
	1+STEP(Step_Height,Step_Time)+
	(Pulse_Quantity/TIME_STEP)*PULSE(Pulse_Time,TIME_STEP)+
	RAMP(Ramp_Slope,Ramp_Start_Time,Ramp_End_Time)+(STEP(1, Exponential_Growth_Time)*(exp(Exponential_Growth_Rate*(Time - Exponential_Growth_Time))-1))+
	Sine_Amplitude*SIN(2*3.14159*Time/Sine_Period)+
	  	STEP(1,Noise_Start_Time)*Pink_Noise					</eqn>
			</aux>
			<aux name="Intake">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Dossiers dat per jaar in Behandeling wordt genomen.</doc>
					<eqn>
	MAX(0,Min(Meldingen/Minimale_Intaketijd,Beschikbare_Capaciteit_voor_Intake_in_Dossiers))					</eqn>
			</aux>
			<aux name="Intake_door_Ervaren_Medewerkers">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Meldingen dat per jaar door Ervaren Medewerkers wordt verwerkt (Intake).</doc>
					<eqn>
	Intake*(1-Perc_van_Intakecap_door_Nieuwe_Medewerkers)					</eqn>
			</aux>
			<aux name="Intake_door_Nieuwe_Medewerkers">
				<units>Dossiers/Jaar</units>
				<doc>Het aantal Meldingen dat per jaar door Nieuwe Medewerkers wordt verwerkt (Intake).</doc>
					<eqn>
	Intake*Perc_van_Intakecap_door_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Nieuwe_Meldingen">
				<units>Dossiers/Jaar</units>
				<doc>Aantal Nieuwe Meldingen dat per jaar binnen komt.</doc>
					<eqn>
	Basisaanbod_Dossiers*Groei_Dossiers					</eqn>
			</aux>
			<aux name="Normale_Snelheid_van_Leren_Ervaren_Medewerkers">
				<units>Dmnl</units>
				<doc>De normale snelheid waarmee medewerkers leren heeft een constante waarde van 100 en kan worden verhoogd als zij opleidingen volgen en kan worden verlaagd als zij heel veel nieuwe medewerkers moeten inwerken/coachen.</doc>
					<eqn>
	100*(1-(1-Tabel_voor_Effect_Coaching_op_Leersnelheid_Ervaren_Medewerkers(Aantal_Nieuwe_Medewerkers_per_Ervaren_Medewerkers
	))+0.5*(Opleidingen_en_Zittingen_Ervaren_Medewerkers))					</eqn>
			</aux>
			<aux name="Normale_Snelheid_van_Leren_Nieuwe_Medewerkers">
				<units>Dmnl</units>
				<doc>De normale snelheid waarmee medewerkers leren heeft een constante waarde van 100 en kan worden verhoogd als zij opleidingen volgen en als zij door veel ervaren medewerkers ingewerkt/gecoacht kunnen worden.</doc>
					<eqn>
	100*(1+0.5*Opleidingen_en_Zittingen_Nieuwe_Medewerkers+Tabel_voor_Effect_Coaching_op_Leersnelheid_Nieuwe_Medewerkers(Aantal_Nieuwe_Medewerkers_per_Ervaren_Medewerkers))					</eqn>
			</aux>
			<aux name="Onderhanden_Dossiers_(exclusief_Meldingen)_per_Medewerker">
				<units>Dossiers/Medewerker</units>
				<doc>Het gemiddelde aantal dossiers (alleen Dossiers in Behandeling) dat elke medewerker onderhanden heeft.</doc>
					<eqn>
	Dossiers_In_Behandeling/Totaal_Actueel_Aantal_Medewerkers					</eqn>
			</aux>
			<aux name="Onderhanden_Dossiers_per_Medewerker">
				<units>Dossiers/Medewerker</units>
				<doc>Het gemiddelde aantal dossiers (zowel Meldingen als Dossiers in Behandeling) dat elke medewerker onderhanden heeft.</doc>
					<eqn>
	(Dossiers_In_Behandeling+Meldingen)/Totaal_Actueel_Aantal_Medewerkers					</eqn>
			</aux>
			<aux name="Output_per_Medewerker">
				<units>Dossiers/(Jaar*Medewerker)</units>
				<doc>De output die per medewerker gerealiseerd wordt.</doc>
					<eqn>
	Afleggen/Totaal_Actueel_Aantal_Medewerkers					</eqn>
			</aux>
			<aux name="Per_Cap_Toewijzing_Intake_Ervaren_Medewerkers">
				<units>Dimensionless</units>
				<doc>Het Percentage van de totale capaciteit van Ervaren Medewerkers dat besteed mag worden aan Intake.</doc>
					<eqn>
	Beschikbare_Cap_Ervaren_Medewerkers_voor_Intake/Beschikbare_Capaciteit_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Per_Cap_Toewijzing_Intake_Nieuwe_Medewerkers">
				<units>Dimensionless</units>
				<doc>Het Percentage van de totale capaciteit van Nieuwe Medewerkers dat besteed mag worden aan Intake.</doc>
					<eqn>
	Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake/Beschikbare_Capaciteit_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Perc_Uitbesteding">
				<units>1/Jaar</units>
				<doc>Het percentage van de Dossiers in Behandeling dat per jaar uitbesteed wordt.</doc>
					<eqn>
	Dossiers_Uitbesteden/Dossiers_In_Behandeling					</eqn>
			</aux>
			<aux name="Perc_van_Afhandelcap_door_Nieuwe_Medewerkers">
				<units>Dimensionless</units>
				<doc>Het Percentage van de totale Afhandelcapaciteit dat door Nieuwe Medewerkers wordt ingevuld.</doc>
					<eqn>
	Beschikbare_Cap_Nieuwe_Medewerkers_voor_Afhandeling/Beschikbare_Capaciteit_voor_Afhandeling_in_Tijdseenheden					</eqn>
			</aux>
			<aux name="Perc_van_Intakecap_door_Nieuwe_Medewerkers">
				<units>Dimensionless</units>
				<doc>Het Percentage van de totale Intakecapaciteit dat door Nieuwe Medewerkers wordt ingevuld.</doc>
					<eqn>
	Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake/Beschikbare_Capaciteit_voor_Intake_in_Tijdseenheden					</eqn>
			</aux>
			<aux name="Productiviteit_Ervaren_Medewerkers">
				<units>Dossiers/(Jaar*Medewerker)</units>
				<doc>Productiviteit wordt bepaald door een standaard leercurve die doorlopen wordt via een cumulatieve hoeveelheid werkervaring.</doc>
					<eqn>
	Referentieproductiviteit_Ervaren_Medewerkers*(Gemiddelde_Expertise_Ervaren_Medewerkers/"Referentie-Expertise_Ervaren_medewerkers")^Exponent_Leercurve_Ervaren					</eqn>
			</aux>
			<aux name="Productiviteit_Nieuwe_Medewerkers">
				<units>Dossiers/(Jaar*Medewerker)</units>
				<doc>Productiviteit wordt bepaald door een standaard leercurve die doorlopen wordt via een cumulatieve hoeveelheid werkervaring.</doc>
					<eqn>
	Referentieproductiviteit_Nieuwe_Medewerkers*(Gemiddelde_Expertise_Nieuwe_Medewerkers/"Referentie-Expertise_Nieuwe_Medewerkers")^Exponent_Leercurve					</eqn>
			</aux>
			<aux name="Pulse_Inhuur">
				<units>Dmnl</units>
				<doc>Met Pulse Inhuur kan getest worden wat er met het systeem gebeurt als een bepaald aantal Medewerkers tegelijkertijd aangenomen wordt op een zeker tijdstip.</doc>
					<eqn>
	Pulse_Inhuur_Omvang*PULSE( Pulse_Inhuur_Starttijd,TIME_STEP)					</eqn>
			</aux>
			<aux name="Referentie-Expertise_Ervaren_medewerkers">
				<units>Werkjaar</units>
				<doc>Het referentieniveau van Expertise dat past bij de Referentieproductiviteit.</doc>
					<eqn>
	Initiële_Totale_Expertise_Ervaren_Medewerkers/Initiële_Aantal_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Referentieproductiviteit_Ervaren_Medewerkers">
				<units>Dossiers/(Jaar*Medewerker)</units>
				<doc>De Productiviteit die bereikt is als de Gemiddelde Expertise het referentienivo bereikt.</doc>
					<eqn>
	Tabel_voor_Effect_Medewerkertevredenheid_op_Referentieproductiviteit_Ervaren_Medewerkers(Medewerkertevredenheid)					</eqn>
			</aux>
			<aux name="Referentieproductiviteit_Nieuwe_Medewerkers">
				<units>Dossiers/(Jaar*Medewerker)</units>
				<doc>De Productiviteit die bereikt is als de Gemiddelde Expertise het referentienivo bereikt.</doc>
					<eqn>
	Tabel_voor_Effect_Medewerkertevredenheid_op_Referentieproductiviteit(Medewerkertevredenheid)					</eqn>
			</aux>
			<aux name="Relatieve_Verouderingssnelheid_Expertise_Ervaren_Medewerkers">
				<units>1/Jaar</units>
				<doc>Bestaande kennis veroudert of wordt vergeten.</doc>
					<eqn>
	Normale_Veroudering_Expertise_Ervaren_Medewerkers + STEP(Verandering_Veroudering_Expertise_Ervaren_Medewerkers,Verouderingstijd_Expertise_Ervaren_Medewerkers)					</eqn>
			</aux>
			<aux name="Relatieve_Verouderingssnelheid_Expertise_Nieuwe_Medewerkers">
				<units>1/Jaar</units>
				<doc>Bestaande kennis veroudert of wordt vergeten.</doc>
					<eqn>
	Normale_Veroudering_Expertise_Nieuwe_Medewerkers + STEP(Verandering_Veroudering_Expertise_Nieuwe_Medewerkers,Verouderingstijd_Expertise_Nieuwe_Medewerkers)					</eqn>
			</aux>
			<aux name="Sterkte_Leercurve">
				<units>Dimensionless</units>
				<doc>De fractionele toename in productiviteit als expertise verdubbelt.</doc>
					<eqn>
	0.25-(((Normale_Snelheid_van_Leren_Nieuwe_Medewerkers-Snelheid_van_Leren_door_Nieuwe_Medewerkers)/Normale_Snelheid_van_Leren_Nieuwe_Medewerkers
	)*0.25)					</eqn>
			</aux>
			<aux name="Sterkte_Leercurve_Ervaren">
				<units>Dimensionless</units>
				<doc>De fractionele toename in productiviteit als expertise verdubbelt.</doc>
					<eqn>
	0.25-(((Normale_Snelheid_van_Leren_Ervaren_Medewerkers-Snelheid_van_Leren_door_Ervaren_Medewerkers)/Normale_Snelheid_van_Leren_Ervaren_Medewerkers)*0.25)					</eqn>
			</aux>
			<aux name="Toename_Expertise_door_Doorstroom">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>De expertise van ervaren medewerkers neemt toe doordat nieuwe medewerkers doorstromen en ervaren worden en hun expertise meenemen.</doc>
					<eqn>
	Doorstroom_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers*1.5					</eqn>
			</aux>
			<aux name="Toename_Expertise_door_Dossierervaring">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Expertise groeit na inhuur vooral door ervaring in het afhandelen van dossiers.</doc>
					<eqn>
	Werkjaren_gewerkt_aan_dossiers_Nieuwe_Medewerkers+Werkjaren_gewerkt_aan_Intake_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Toename_Expertise_door_Dossierervaring_Ervaren_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Expertise groeit na inhuur vooral door ervaring in het afhandelen van dossiers.</doc>
					<eqn>
	Werkjaren_gewerkt_aan_dossiers_Ervaren_Medewerkers+Werkjaren_gewerkt_aan_Intake_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Toename_Expertise_door_Ervaren_Inhuur">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>De snelheid waarmee ervaren medewerkers expertise toevoegen aan de pool van expertise</doc>
					<eqn>
	Inhuur_Ervaren_Medewerkers*Gemiddelde_Expertise_Ervaren_Inhuur					</eqn>
			</aux>
			<aux name="Toename_Expertise_door_Inhuur">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>De snelheid waarmee nieuwe medewerkers expertise toevoegen aan de pool van Totale Expertise</doc>
					<eqn>
	Inhuur_Nieuwe_Medewerkers*Gemiddelde_Expertise_Nieuwe_Inhuur					</eqn>
			</aux>
			<aux name="Totaal_Actueel_Aantal_Medewerkers">
				<units>Medewerkers</units>
				<doc></doc>
					<eqn>
	Nieuwe_Medewerkers+Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Totale_Actuele_Doorlooptijd">
				<units>Weken</units>
				<doc>Tijd die nodig is om een dossier geheel af te handelen (som van doorlooptijd Intake en doorlooptijd Afhandeling).</doc>
					<eqn>
	Actuele_Doorlooptijd_Afhandeling+Actuele_Doorlooptijd_Intake					</eqn>
			</aux>
			<aux name="Totale_capaciteit_Ervaren_Medewerkers">
				<units>FTE/Jaar</units>
				<doc>Totale Capaciteit van Ervaren Medewerkers uitgedrukt in FTE's per jaar.</doc>
					<eqn>
	Productiviteit_Ervaren_Medewerkers*Ervaren_Medewerkers*((Basiswerkinhoud_Dossiers)/Omrekenfactor_van_Week_naar_FTE
	)					</eqn>
			</aux>
			<aux name="Totale_Capaciteit_Nieuwe_Medewerkers">
				<units>FTE/Jaar</units>
				<doc>Totale Capaciteit van Nieuwe Medewerkers uitgedrukt in FTE's per jaar.</doc>
					<eqn>
	Productiviteit_Nieuwe_Medewerkers*Nieuwe_Medewerkers*((Basiswerkinhoud_Dossiers)/Omrekenfactor_van_Week_naar_FTE)					</eqn>
			</aux>
			<aux name="Totale_Referentiedoorlooptijd">
				<units>Weken</units>
				<doc>Hoelang een dossier normaal gesproken in intake EN behandeling zou mogen zijn, gemiddeld.</doc>
					<eqn>
	Referentiedoorlooptijd_Afhandeling+Referentiedoorlooptijd_Intake					</eqn>
			</aux>
			<aux name="Verandering_Deel_Werkpakket_Intake">
				<units>1/Jaar</units>
				<doc>De verandering van de relatieve werklast voor Intake (t.o.v. de totale hoeveelheid werklast voor Intake en Afhandeling).</doc>
					<eqn>
	(Werkpakket_Intake/(Werkpakket_Intake+Werkpakket_Afhandeling)-Deel_van_Werkpakket_voor_Intake)/Aanpassingtijd_Capaciteitsinzet_Intake					</eqn>
			</aux>
			<aux name="Verandering_in_Klanttevredenheid">
				<units>1/Jaar</units>
				<doc>De mate waarin de klanttevredenheid verandert per jaar.</doc>
					<eqn>
	(Actuele_Klanttevredenheid-Klanttevredenheid)/Aanpassingstijd_Klanttevredenheid					</eqn>
			</aux>
			<aux name="Verandering_in_Perceptie_Werkdruk">
				<units>1/Jaar</units>
				<doc>Verandering van de werkdruk die waargenomen wordt door medewerkers.</doc>
					<eqn>
	((Werkdrukindicator/Normale_Werkdruk)-Gepercipieerde_Werkdruk)/Perceptieinterval_Werkdruk					</eqn>
			</aux>
			<aux name="Verandering_Medewerker_tevredenheid">
				<units>1/Jaar</units>
				<doc>De mate waarin de medewerkertevredenheid verandert per jaar.</doc>
					<eqn>
	(Actuele_Medewerker_tevredenheid-Medewerkertevredenheid)/Aanpassingstijd_Medewerker_tevredenheid					</eqn>
			</aux>
			<aux name="Verandering_Verloopperc_Ervaren_Medewerkers">
				<units>1/(Jaar*Jaar)</units>
				<doc>De verandering van het verlooppercentage van ervaren medewerkers per jaar.</doc>
					<eqn>
	(Actueel_Percentage_Ervaren_Medewerkers_met_Verloopplannen-Verloopperc_Ervaren_Medewerkers)/Aanpassingstijd_Verloopperc					</eqn>
			</aux>
			<aux name="Verandering_Verloopperc_Nieuwe_Medewerkers">
				<units>1/(Jaar*Jaar)</units>
				<doc>De verandering van het verlooppercentage van nieuwe medewerkers per jaar.</doc>
					<eqn>
	(Actueel_Percentage_Nieuwe_Medewerkers_met_Verloopplannen-Verloopperc_Nieuwe_Medewerkers)/Aanpassingstijd_Verloopperc					</eqn>
			</aux>
			<aux name="Verlies_van_Expertise_door_Doorstroom">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>De totale expertise van nieuwe medewerkers vermindert doordat nieuwe medewerkers doorstromen en ervaren worden en hun expertise meenemen.</doc>
					<eqn>
	Doorstroom_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers*1.5					</eqn>
			</aux>
			<aux name="Verlies_van_Expertise_Ervaren_Medewerkers_door_Verloop">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Medewerkers die vertrekken nemen hun expertise met zich mee.</doc>
					<eqn>
	Verloop_Ervaren_Medewerkers*Gemiddelde_Expertise_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Verlies_van_Expertise_Nieuwe_Medewerkers_door_Verloop">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Medewerkers die vertrekken nemen hun expertise met zich mee.</doc>
					<eqn>
	Verloop_Nieuwe_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Verloop_Ervaren_Medewerkers">
				<units>Medewerkers/Jaar</units>
				<doc>Het aantal Ervaren Medewerkers dat per jaar verloopt.</doc>
					<eqn>
	Verloopperc_Ervaren_Medewerkers*Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Verloop_Nieuwe_Medewerkers">
				<units>Medewerkers/Jaar</units>
				<doc>Het aantal Nieuwe Medewerkers dat per jaar verloopt.</doc>
					<eqn>
	Verloopperc_Nieuwe_Medewerkers*Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Verouderingssnelheid_Expertise_Ervaren_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>De hoeveelheid expertise die de populatie ervaren medewerkers kwijtraakt per periode.</doc>
					<eqn>
	Totale_Expertise_Ervaren_Medewerkers*Relatieve_Verouderingssnelheid_Expertise_Ervaren_Medewerkers					</eqn>
			</aux>
			<aux name="Verouderingssnelheid_Expertise_Nieuwe_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>De hoeveelheid expertise die de populatie nieuwe medewerkers kwijtraakt per periode</doc>
					<eqn>
	Totale_Expertise_Nieuwe_Medewerkers*Relatieve_Verouderingssnelheid_Expertise_Nieuwe_Medewerkers					</eqn>
			</aux>
			<aux name="Werkdrukindicator">
				<units>Dmnl</units>
				<doc>Hoeveel werk er is t.o.v. hoeveel capaciteit er is om het af te handelen in deze tijdsperiode</doc>
					<eqn>
	Totale_Actuele_Doorlooptijd/Totale_Referentiedoorlooptijd					</eqn>
			</aux>
			<aux name="Werkjaren_gewerkt_aan_dossiers_Ervaren_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Het gemiddeld aantal werkjaren dat aan Dossiers gewerkt is door Ervaren Medewerkers per jaar.</doc>
					<eqn>
	Dossiers_door_Ervaren_Medewerkers*(Gemiddelde_Werkinhoud_Dossier/Omrekenfactor_van_Week_naar_Werkjaar)					</eqn>
			</aux>
			<aux name="Werkjaren_gewerkt_aan_dossiers_Nieuwe_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Het gemiddeld aantal werkjaren dat aan Dossiers gewerkt is door Nieuwe Medewerkers per jaar.</doc>
					<eqn>
	Dossiers_door_Nieuwe_Medewerkers*(Gemiddelde_Werkinhoud_Dossier/Omrekenfactor_van_Week_naar_Werkjaar)					</eqn>
			</aux>
			<aux name="Werkjaren_gewerkt_aan_Intake_Ervaren_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Het gemiddeld aantal werkjaren dat aan Intake gewerkt is door Ervaren Medewerkers per jaar.</doc>
					<eqn>
	Intake_door_Ervaren_Medewerkers*(Gemiddelde_Werkinhoud_Intake/Omrekenfactor_van_Week_naar_Werkjaar)					</eqn>
			</aux>
			<aux name="Werkjaren_gewerkt_aan_Intake_Nieuwe_Medewerkers">
				<units>Medewerker*Werkjaar/Jaar</units>
				<doc>Het gemiddeld aantal werkjaren dat aan Intake gewerkt is door Nieuwe Medewerkers per jaar.</doc>
					<eqn>
	Intake_door_Nieuwe_Medewerkers*(Gemiddelde_Werkinhoud_Intake/Omrekenfactor_van_Week_naar_Werkjaar)					</eqn>
			</aux>
			<aux name="Werkpakket_Afhandeling">
				<units>Weken</units>
				<doc>De gemiddelde hoeveelheid werk (in weken) die verzet moet worden om de voorraad Dossiers in Behandeling te verwerken.</doc>
					<eqn>
	Dossiers_In_Behandeling*Gemiddelde_Werkinhoud_Dossier					</eqn>
			</aux>
			<aux name="Werkpakket_Intake">
				<units>Weken</units>
				<doc>De gemiddelde hoeveelheid werk (in weken) die verzet moet worden om de voorraad Meldingen te verwerken.</doc>
					<eqn>
	Meldingen*Gemiddelde_Werkinhoud_Intake					</eqn>
			</aux>
			<aux name="White_Noise">
				<units>Dimensionless</units>
				<doc>White noise input to the pink noise process.</doc>
					<eqn> Noise_Standard_Deviation*((24*Noise_Correlation_Time/TIME_STEP)^0.5*(RANDOM_0_1() - 0.5
))					</eqn>
			</aux>
