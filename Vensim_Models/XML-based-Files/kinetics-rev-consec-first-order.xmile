<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0">
	<header>
		<product version="1.0" lang="en">Vensim</product>
		<vendor>Ventana Systems, Inc.</vendor>
		<created>
		</created>
		<modified>
		</modified>
		<name>
		</name>
		<caption>
		</caption>
	</header>
	<sim_specs method="RK4" time_units="Second">
		<start> 0</start>
		<stop> 10</stop>
		<dt> 0.01</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="A">
				<units></units>
				<doc></doc>
					<eqn>
					1000
					</eqn>
					<inflow>
					rrxn1
					</inflow>
					<outflow>
					frxn1
					</outflow>
			</stock>
			<stock name="B">
				<units></units>
				<doc></doc>
					<eqn>
					0
					</eqn>
					<inflow>
					frxn1
					</inflow>
					<inflow>
					rrxn2
					</inflow>
					<outflow>
					frxn2
					</outflow>
					<outflow>
					rrxn1
					</outflow>
			</stock>
			<stock name="C">
				<units></units>
				<doc></doc>
					<eqn>
					0
					</eqn>
					<inflow>
					frxn2
					</inflow>
					<outflow>
					rrxn2
					</outflow>
			</stock>
			<aux name="frxn1">
				<units></units>
				<doc></doc>
					<eqn>
	k1*A					</eqn>
			</aux>
			<aux name="frxn2">
				<units></units>
				<doc></doc>
					<eqn>
	k3*B					</eqn>
			</aux>
			<aux name="rrxn1">
				<units></units>
				<doc></doc>
					<eqn>
	k2*B					</eqn>
			</aux>
			<aux name="rrxn2">
				<units></units>
				<doc></doc>
					<eqn>
	k4*C					</eqn>
			</aux>
			<aux name="k1">
				<units></units>
				<doc></doc>
					<eqn>
	1					</eqn>
			</aux>
			<aux name="k2">
				<units></units>
				<doc></doc>
					<eqn>
	1					</eqn>
			</aux>
			<aux name="k3">
				<units></units>
				<doc></doc>
					<eqn>
	1					</eqn>
			</aux>
			<aux name="k4">
				<units></units>
				<doc></doc>
					<eqn>
	1					</eqn>
			</aux>
		</variables>
	</model>
</xmile>
