				<units></units>
				<doc></doc>
					<eqn>
	1					</eqn>
			</aux>
			<aux name="c">
				<units></units>
				<doc></doc>
					<eqn>
	0					</eqn>
			</aux>
			<aux name="d">
				<units></units>
				<doc></doc>
					<eqn>
	0					</eqn>
