{UTF-8}
Aggressive= INTEG (
	feralization-pacification,
		100)
	~	
	~		|

calming influence=
	RANDOM NORMAL( outlook-0.05 {min} , outlook+0.05{max} , outlook {mean} , 0.005{stdev}\
		 , 1011{seed} )
	~	 [?,?,1e-05]
	~		|

coping factor=
	0
	~	 [0,1,0.01]
	~		|

feralization=
	provocation*(Aggressive*Passive) + stewing*Passive
	~	
	~		|

outlook=
	0
	~	 [-0.05,0.05,0.001]
	~		|

pacification=
	calming influence*(Aggressive*Passive) + coping factor*Aggressive
	~	
	~		|

Passive= INTEG (
	pacification-feralization,
		100)
	~	
	~		|

provocation=
	0
	~	 [0,0.005,1e-06]
	~		|

stewing=
	0
	~	 [0,1,0.01]
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 10
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Month [0,?]
	~	The time step for the simulation.
	|

