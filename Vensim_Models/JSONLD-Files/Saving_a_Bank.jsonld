{"@type":"XMILEModel","modelId":"Saving_a_Bank","sourceFile":"Saving_a_Bank.xmile","simSpecs":{"method":"RK4","time_units":"Week","start":"0","stop":"52","dt":"0.0078125"},"variables":[{"type":"stock","name":"estimated_underlying_asset_value","units":"EURO","eqn":"initial_estimated_underlying_asset_value","inflows":["underlying asset increase"],"outflows":["underlying asset loss"]},{"type":"stock","name":"stock_market_value","units":"EURO","eqn":"initial_stock_market_value","inflows":["stock market value increase"],"outflows":["stock market value loss"]},{"type":"aux","name":"average_bank_client's_fear_and_uncertainty","units":"Dmnl","eqn":"smoothed_market_fear_and_uncertainty"},{"type":"aux","name":"average_stickiness_of_deposits_and_loans","units":"Week","eqn":"GAME ( 4)"},{"type":"aux","name":"degree_of_external_climate_of_fear","units":"Dmnl","eqn":"GAME ( 2)"},{"type":"aux","name":"external_shock_real_value_loss","units":"1/Week","eqn":"STEP(size_of_the_external_underlying_asset_shock,10) - STEP(size_of_the_external_underlying_asset_shock,11)"},{"type":"aux","name":"financial_intervention","units":"EURO/Week","eqn":"MAX(0,(fraction_initial_guaranteed*initial_estimated_underlying_asset_value - estimated_underlying_asset_value)/action_delay) * policy_switch"},{"type":"aux","name":"fraction_initial_guaranteed","units":"Dmnl","eqn":"GAME ( 0.5)"},{"type":"aux","name":"instant_market_fear_and_uncertainty","units":"Dmnl","eqn":"MIN(stock_market_value_loss/(stock_market_value/market_loss_delay*stock_market_fear_factor) * degree_of_external_climate_of_fear,1)"},{"type":"aux","name":"liquid_deposits_and_loans_loss_fraction","units":"","eqn":"average_bank_client's_fear_and_uncertainty/average_stickiness_of_deposits_and_loans"},{"type":"aux","name":"perceived_overvaluation","units":"Dmnl","eqn":"MAX((stock_market_value-estimated_underlying_asset_value)/stock_market_value,0)"},{"type":"aux","name":"perceived_undervaluation","units":"Dmnl","eqn":"MAX((estimated_underlying_asset_value-stock_market_value)/stock_market_value,0)"},{"type":"aux","name":"policy_switch","units":"Dmnl","eqn":"GAME ( 0)"},{"type":"aux","name":"size_of_the_external_underlying_asset_shock","units":"Dmnl","eqn":"GAME ( 0.35)"},{"type":"aux","name":"smoothed_market_fear_and_uncertainty","units":"Dmnl","eqn":"DELAY3I(instant_market_fear_and_uncertainty, uncertainty_and_fear_delay, initial_market_fear_and_uncertainty)"},{"type":"aux","name":"stock_market_fear_factor","units":"Dmnl","eqn":"GAME ( 0.25)"},{"type":"aux","name":"stock_market_value_increase","units":"EURO/Week","eqn":"MAX(stock_market_value * perceived_undervaluation/market_increase_delay,0)"},{"type":"aux","name":"stock_market_value_loss","units":"EURO/Week","eqn":"MAX(stock_market_value * (perceived_overvaluation/market_loss_delay),0)"},{"type":"aux","name":"underlying_asset_increase","units":"EURO/Week","eqn":"average_profitability*estimated_underlying_asset_value + financial_intervention"},{"type":"aux","name":"underlying_asset_loss","units":"EURO/Week","eqn":"MAX((liquid_deposits_and_loans_loss_fraction*fraction_of_asset_loss_to_deposit_loss+external_shock_real_value_loss)*estimated_underlying_asset_value ,0)"},{"type":"aux","name":"action_delay","units":"Week","eqn":"1"},{"type":"aux","name":"average_profitability","units":"1/Week","eqn":"0.002"},{"type":"aux","name":"fraction_of_asset_loss_to_deposit_loss","units":"Dmnl","eqn":"1"},{"type":"aux","name":"initial_estimated_underlying_asset_value","units":"EURO","eqn":"25"},{"type":"aux","name":"initial_market_fear_and_uncertainty","units":"Dmnl","eqn":"0"},{"type":"aux","name":"initial_stock_market_value","units":"EURO","eqn":"24.6"},{"type":"aux","name":"market_increase_delay","units":"Week","eqn":"4"},{"type":"aux","name":"market_loss_delay","units":"Week","eqn":"1"},{"type":"aux","name":"uncertainty_and_fear_delay","units":"Week","eqn":"2"}]}