{"@type":"XMILEModel","modelId":"Accounting_dynamics","sourceFile":"Accounting_dynamics.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"35","dt":"0.03125"},"variables":[{"type":"stock","name":"Accum_Capital_Productivity","units":"","eqn":"5972","inflows":["incr accum capital productivity"],"outflows":["decr accum capital productivity"]},{"type":"stock","name":"av_sales","units":"","eqn":"sales","inflows":[],"outflows":[]},{"type":"stock","name":"cume_Investment","units":"","eqn":"initial_cume_Investment","inflows":["depreciable asset starts"],"outflows":[]},{"type":"stock","name":"Cume_RD","units":"","eqn":"0","inflows":["rd depreciation"],"outflows":[]},{"type":"stock","name":"Depreciable_Assets_Completed","units":"","eqn":"813","inflows":["depreciable asset completion"],"outflows":["depreciation"]},{"type":"stock","name":"Depreciable_Assets_in_Process","units":"","eqn":"initial_depreciable_assets_in_process","inflows":["depreciable asset starts"],"outflows":["depreciable asset completion"]},{"type":"stock","name":"Financial_Assets","units":"","eqn":"0","inflows":["incr financial assets"],"outflows":["decr financial assets"]},{"type":"stock","name":"Potential_Capital_Improvement","units":"","eqn":"Depreciable_Assets_Completed*initial_potential_capital_improvement*capital_productivity","inflows":["incr capital improvement"],"outflows":["decr potential capital improvement"]},{"type":"stock","name":"RD_Capital","units":"","eqn":"initial_RD_capital","inflows":["incr RD capital"],"outflows":["rd depreciation"]},{"type":"stock","name":"RD_in_Process","units":"","eqn":"initial_rd_pipeline","inflows":["RD starts"],"outflows":["incr RD capital"]},{"type":"aux","name":"av_capital_productivity","units":"","eqn":"Accum_Capital_Productivity/Depreciable_Assets_Completed"},{"type":"aux","name":"av_potential_improvement","units":"","eqn":"zidz(Potential_Capital_Improvement,Depreciable_Assets_Completed)"},{"type":"aux","name":"capital_productivity","units":"","eqn":"av_capital_productivity+effect_rgdp_growth"},{"type":"aux","name":"cash_flow","units":"","eqn":"gross_cash_flow-depreciable_asset_completion-RD"},{"type":"aux","name":"decr_accum_capital_productivity","units":"","eqn":"depreciation*av_capital_productivity"},{"type":"aux","name":"decr_fa_dividends","units":"","eqn":"gross_cash_flow*frac_cf_to_dividend"},{"type":"aux","name":"decr_fa_from_stock_repurchase","units":"","eqn":"gross_cash_flow*frac_cf_to_stock_repurch"},{"type":"aux","name":"decr_financial_assets","units":"","eqn":"depreciable_asset_starts+decr_fa_dividends+decr_fa_from_stock_repurchase"},{"type":"aux","name":"decr_potential_capital_improvement","units":"","eqn":"depreciation*av_potential_improvement+Accum_Capital_Productivity*av_potential_improvement*capital_productivity_adjust"},{"type":"aux","name":"depletion_effect","units":"","eqn":"(cume_Investment/initial_cume_Investment)^depletion_effect_exponent"},{"type":"aux","name":"depreciable_asset_completion","units":"","eqn":"Depreciable_Assets_in_Process/investment_completion_time"},{"type":"aux","name":"depreciable_asset_starts","units":"","eqn":"(max(gross_cash_flow,0)*ploughback_fraction)*effect_cap_prod_plough_back"},{"type":"aux","name":"depreciable_assets","units":"","eqn":"Depreciable_Assets_Completed"},{"type":"aux","name":"depreciation","units":"","eqn":"DELAY3I(depreciable_asset_completion, av_life_asset, Depreciable_Assets_Completed/av_life_asset )"},{"type":"aux","name":"effect_cap_prod_plough_back","units":"","eqn":"2*exp(100*(expected_return-0.1)*ploughback_exponent)/(1+exp(100*(expected_return-0.1)*ploughback_exponent))"},{"type":"aux","name":"effect_RD_capital_productivity","units":"","eqn":"(RD_Capital/initial_RD_capital)^rd_exponent"},{"type":"aux","name":"effect_rgdp_growth","units":"","eqn":"if_then_else(Time > 25,0,smooth(rdgp_exponent*(0),rgdp_smooth_time))"},{"type":"aux","name":"expected_capital_productivity","units":"","eqn":"marginal_capital_productivity"},{"type":"aux