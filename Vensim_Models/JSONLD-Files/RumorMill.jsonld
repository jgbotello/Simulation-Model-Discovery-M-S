{"@type":"XMILEModel","modelId":"RumorMill","sourceFile":"RumorMill.xmile","simSpecs":{"method":"RK4","time_units":"Hour","start":"0","stop":"50","dt":"0.015625"},"variables":[{"type":"stock","name":"Gullibles","units":"","eqn":"999","inflows":[],"outflows":["Mongerization"]},{"type":"stock","name":"Loyalists","units":"","eqn":"0","inflows":["Coming to Senses"],"outflows":[]},{"type":"stock","name":"Rumor_Mongerers","units":"","eqn":"1","inflows":["Mongerization"],"outflows":["Coming to Senses"]},{"type":"aux","name":"Coming_to_Senses","units":"","eqn":"Rationality_rate*Rumor_Mongerers"},{"type":"aux","name":"Mongerization","units":"","eqn":"Spreading_probability*(Gullibles*Rumor_Mongerers)"},{"type":"aux","name":"Total_Population","units":"","eqn":"Rumor_Mongerers+Loyalists+Gullibles"},{"type":"aux","name":"Rationality_rate","units":"","eqn":"0.5"},{"type":"aux","name":"Spreading_probability","units":"","eqn":"0.001"}]}