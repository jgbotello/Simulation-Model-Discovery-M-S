{"@type":"XMILEModel","modelId":"Goats_and_grass","sourceFile":"Goats_and_grass.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"20","dt":"0.5"},"variables":[{"type":"stock","name":"Goats","units":"","eqn":"Initial_Goats","inflows":["Goat Births"],"outflows":["Goats Deaths"]},{"type":"stock","name":"Grass","units":"","eqn":"Initial_Grass","inflows":["Grass Growth"],"outflows":["Grass Deaths"]},{"type":"aux","name":"Average_Goat_Lifespan","units":"","eqn":"GAME ( 10)"},{"type":"aux","name":"Goat_Births","units":"","eqn":"Grass/Grass_per_Goat_Birth"},{"type":"aux","name":"Goats_Deaths","units":"","eqn":"Max(Goats/Average_Goat_Lifespan, (Goats - Grass/Grass_Eaten_per_Goat)/2)"},{"type":"aux","name":"Grass_Deaths","units":"","eqn":"Min(Goats*Grass_Eaten_per_Goat + Grass_per_Goat_Birth*Goat_Births,Grass)"},{"type":"aux","name":"Grass_Eaten_per_Goat","units":"","eqn":"GAME ( 100)"},{"type":"aux","name":"Grass_Growth","units":"","eqn":"Grass*Grass_Growth_Rate"},{"type":"aux","name":"Grass_Growth_Rate","units":"","eqn":"GAME ( 0.1)"},{"type":"aux","name":"Grass_per_Goat_Birth","units":"","eqn":"GAME ( 15000)"},{"type":"aux","name":"Initial_Goats","units":"","eqn":"100"},{"type":"aux","name":"Initial_Grass","units":"","eqn":"100000"}]}