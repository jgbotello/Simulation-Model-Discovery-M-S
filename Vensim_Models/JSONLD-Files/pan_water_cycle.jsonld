{"@type":"XMILEModel","modelId":"pan_water_cycle","sourceFile":"pan_water_cycle.xmile","simSpecs":{"method":"RK4","time_units":"Minute","start":"0","stop":"10","dt":"1"},"variables":[{"type":"stock","name":"water_in_air","units":"","eqn":"0","inflows":["evaporation"],"outflows":["condensation","water vapor leak"]},{"type":"stock","name":"water_in_pan","units":"","eqn":"100","inflows":["precipitation"],"outflows":["evaporation"]},{"type":"stock","name":"water_on_cover","units":"","eqn":"0","inflows":["condensation"],"outflows":["precipitation"]},{"type":"aux","name":"condensation","units":"","eqn":"k_1*water_in_air"},{"type":"aux","name":"evaporation","units":"","eqn":"water_temperature*amount_of_evaporation_per_degree"},{"type":"aux","name":"precipitation","units":"","eqn":"k_2*water_on_cover"},{"type":"aux","name":"total_water","units":"","eqn":"water_in_air+water_in_pan+water_on_cover"},{"type":"aux","name":"amount_of_evaporation_per_degree","units":"","eqn":"0.05"},{"type":"aux","name":"k_1","units":"","eqn":"0.5"},{"type":"aux","name":"k_2","units":"","eqn":"0.5"},{"type":"aux","name":"water_temperature","units":"","eqn":"100"},{"type":"aux","name":"water_vapor_leak","units":"","eqn":"0"}]}