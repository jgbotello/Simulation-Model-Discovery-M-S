{"@type":"XMILEModel","modelId":"MalariaEpidModel","sourceFile":"MalariaEpidModel.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"100","dt":"1"},"variables":[{"type":"stock","name":"Healthy_Mosquitos","units":"","eqn":"1000","inflows":["Mosquito Births"],"outflows":["Mosquito Dies","Mosquito Infection"]},{"type":"stock","name":"Healthy_Villagers","units":"","eqn":"100","inflows":["Births","Recover"],"outflows":["Healthy Dies","Infected"]},{"type":"stock","name":"Infected_Mosquitos","units":"","eqn":"10","inflows":["Mosquito Infection"],"outflows":["Infected Mosquito Dies"]},{"type":"stock","name":"Sick_Villagers","units":"","eqn":"0","inflows":["Infected"],"outflows":["Recover","Sick Dies"]},{"type":"aux","name":"Births","units":"","eqn":"Birth_Rate*Humans"},{"type":"aux","name":"Healthy_Dies","units":"","eqn":"Healthy_Villagers*Death_Rate"},{"type":"aux","name":"Humans","units":"","eqn":"Healthy_Villagers+Sick_Villagers"},{"type":"aux","name":"Infected","units":"","eqn":"Bite_Rate*Healthy_Villagers*Infections_Transmission_Proability*(Infected_Mosquitos/Mosquitos)"},{"type":"aux","name":"Infected_Mosquito_Dies","units":"","eqn":"Infected_Mosquitos*Mosquito_Death_Rate"},{"type":"aux","name":"Mosquito_Births","units":"","eqn":"Mosquitos*Mosquito_Birth_Rate"},{"type":"aux","name":"Mosquito_Dies","units":"","eqn":"Healthy_Mosquitos*Mosquito_Death_Rate"},{"type":"aux","name":"Mosquito_Infection","units":"","eqn":"(Sick_Villagers/(Humans+1))*Healthy_Mosquitos*Bite_Rate"},{"type":"aux","name":"Mosquitos","units":"","eqn":"Healthy_Mosquitos+Infected_Mosquitos"},{"type":"aux","name":"Recover","units":"","eqn":"Sick_Villagers*Recovery_Rate"},{"type":"aux","name":"Sick_Dies","units":"","eqn":"(Malaria_Death_Rate+Death_Rate)*Sick_Villagers"},{"type":"aux","name":"Birth_Rate","units":"","eqn":"0.05"},{"type":"aux","name":"Bite_Rate","units":"","eqn":"0.6"},{"type":"aux","name":"Death_Rate","units":"","eqn":"0.02"},{"type":"aux","name":"Infections_Transmission_Proability","units":"","eqn":"0.9"},{"type":"aux","name":"Malaria_Death_Rate","units":"","eqn":"0.5"},{"type":"aux","name":"Mosquito_Birth_Rate","units":"","eqn":"0.202"},{"type":"aux","name":"Mosquito_Death_Rate","units":"","eqn":"0.2"},{"type":"aux","name":"Recovery_Rate","units":"","eqn":"0.25"}]}