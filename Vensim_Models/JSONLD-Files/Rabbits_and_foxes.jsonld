{"@type":"XMILEModel","modelId":"Rabbits_and_foxes","sourceFile":"Rabbits_and_foxes.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"50","dt":"0.25"},"variables":[{"type":"stock","name":"Estimated_Rabbit_Population","units":"Rabbit","eqn":"initial_rabbit_population","inflows":["rabbit births"],"outflows":["rabbit deaths"]},{"type":"stock","name":"Fox_Population","units":"Fox","eqn":"initial_fox_population","inflows":["fox births"],"outflows":["fox deaths"]},{"type":"aux","name":"additional_foxes","units":"","eqn":"GAME ( 0)"},{"type":"aux","name":"fox_births","units":"Fox/Year","eqn":"Fox_Population * fox_birth_rate + additional_foxes"},{"type":"aux","name":"fox_consumption_of_rabbits","units":"Rabbit/Year","eqn":"Fox_Population * fox_food_requirements * fox_rabbit_consumption_lookup(rabbit_crowding)"},{"type":"aux","name":"fox_deaths","units":"Fox/Year","eqn":"Fox_Population / average_fox_life * fox_mortality_lookup(fox_food_availability) + MIN(healthy_foxes_shot, Fox_Population-Fox_Population / average_fox_life * fox_mortality_lookup(fox_food_availability))"},{"type":"aux","name":"fox_food_availability","units":"Dmnl","eqn":"fox_consumption_of_rabbits/(MAX(Fox_Population,1) * fox_food_requirements)"},{"type":"aux","name":"healthy_foxes_shot","units":"Fox/Year","eqn":"GAME ( 0)"},{"type":"aux","name":"initial_fox_population","units":"Fox","eqn":"GAME ( 0)"},{"type":"aux","name":"rabbit_births","units":"Rabbit/Year","eqn":"Estimated_Rabbit_Population * rabbit_birth_rate +\"Up/Down_Estimated_Rabbit_Population\""},{"type":"aux","name":"rabbit_crowding","units":"Dmnl","eqn":"Estimated_Rabbit_Population/carrying_capacity"},{"type":"aux","name":"rabbit_deaths","units":"Rabbit/Year","eqn":"MAX(Estimated_Rabbit_Population / average_rabbit_life * effect_of_crowding_on_deaths_lookup(rabbit_crowding), fox_consumption_of_rabbits)"},{"type":"aux","name":"Up/Down_Estimated_Rabbit_Population","units":"Rabbit/Year","eqn":"GAME ( 0)"},{"type":"aux","name":"effect_of_crowding_on_deaths_lookup","units":"Dmnl","eqn":""},{"type":"aux","name":"fox_mortality_lookup","units":"Dmnl","eqn":""},{"type":"aux","name":"fox_rabbit_consumption_lookup","units":"Dmnl","eqn":""},{"type":"aux","name":"average_fox_life","units":"Year","eqn":"4"},{"type":"aux","name":"average_rabbit_life","units":"Year","eqn":"2"},{"type":"aux","name":"carrying_capacity","units":"Rabbit","eqn":"500"},{"type":"aux","name":"fox_birth_rate","units":"1/Year","eqn":"0.25"},{"type":"aux","name":"fox_food_requirements","units":"Rabbit/(Fox*Year)","eqn":"25"},{"type":"aux","name":"initial_rabbit_population","units":"Rabbit","eqn":"500"},{"type":"aux","name":"rabbit_birth_rate","units":"1/Year","eqn":"2"}]}