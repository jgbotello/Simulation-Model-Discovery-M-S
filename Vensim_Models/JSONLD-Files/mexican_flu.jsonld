{"@type":"XMILEModel","modelId":"mexican_flu","sourceFile":"mexican_flu.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"48","dt":"0.25"},"variables":[{"type":"stock","name":"immune_population_region_1","units":"persons","eqn":"initial_value_immune_population_region_1","inflows":["susceptible to immune population flow region 1"],"outflows":[]},{"type":"stock","name":"immune_population_region_2","units":"persons","eqn":"initial_value_immune_population_region_2","inflows":["susceptible to immune population flow region 2"],"outflows":[]},{"type":"stock","name":"infected_population_region_1","units":"persons","eqn":"initial_value_infected_population_region_1","inflows":["infections region 1"],"outflows":["recoveries region 1"]},{"type":"stock","name":"infected_population_region_2","units":"persons","eqn":"initial_value_infected_population_region_2","inflows":["infections region 2"],"outflows":["recoveries region 2"]},{"type":"stock","name":"recovered_population_region_1","units":"persons","eqn":"initial_value_recovered_population_region_1","inflows":["recoveries region 1"],"outflows":[]},{"type":"stock","name":"recovered_population_region_2","units":"persons","eqn":"0","inflows":["recoveries region 2"],"outflows":[]},{"type":"stock","name":"susceptible_population_region_1","units":"persons","eqn":"initial_value_susceptible_population_region_1","inflows":[],"outflows":["infections region 1","susceptible to immune population flow region 1"]},{"type":"stock","name":"susceptible_population_region_2","units":"persons","eqn":"initial_value_susceptible_population_region_2","inflows":[],"outflows":["infections region 2","susceptible to immune population flow region 2"]},{"type":"aux","name":"infection_fraction_region_1","units":"percent","eqn":"infected_population_region_1/total_population_region_1*100"},{"type":"aux","name":"infection_fraction_region_2","units":"Dmnl","eqn":"infected_population_region_2/total_population_region_2*100"},{"type":"aux","name":"infections_region_1","units":"persons/Month","eqn":"susceptible_population_region_1*contact_rate_region_1*infection_rate_region_1*infection_fraction_region_1/100 + susceptible_population_region_1*interregional_contact_rate*infection_rate_region_1*infection_fraction_region_2/100"},{"type":"aux","name":"infections_region_2","units":"persons/Month","eqn":"susceptible_population_region_2*contact_rate_region_2*infection_rate_region_2*infection_fraction_region_2 /100 + susceptible_population_region_2*interregional_contact_rate*infection_rate_region_2*infection_fraction_region_1/100"},{"type":"aux","name":"normal_immune_population_fraction_region_1","units":"Dmnl","eqn":"WITH LOOKUP ( Time, ([(0,0)-(60,1)],(0,0.3),(6,0.7),(12,0.3),(18,0.7),(24,0.3),(30,0.7),(36,0.3),(42,0.7),(48,0.3) ))"},{"type":"aux","name":"normal_immune_population_fraction_region_2","units":"Dmnl","eqn":"WITH LOOKUP ( Time, ([(0,0)-(60,1)],(0,0.3),(6,0.1),(12,0.3),(18,0.1),(24,0.3),(30,0.1),(36,0.3),(42,0.1),(48,0.3) ))"},{"type":"aux","name":"normal_immune_population_region_1","units":"persons","eqn":"normal_immune_population_fraction_region_1*total_population_region_1"},{"type":"aux","name":"normal_immune_population_region_2","units":"persons","eqn":"normal_immune_population_fraction_region_2*total_population_region_2"},{"type":"aux","name":"recoveries_region_1","units":"persons/Month","eqn":"infected_population_region_1/recovering_time"},{"type":"aux","name":"recoveries_region_2","units":"persons/Month","eqn":"infected_population_region_2/recovering_time"},{"type":"aux","name":"susceptible_to_immune_population_flow_region_1","units":"persons/Month","eqn":"IF_THEN_ELSE((normal_immune_population_region_1-immune_population_region_1)/susceptible_to_immune_population_delay_time_region_1>0, MIN((normal_immune_population_region_1-immune_population_region_1)/susceptible_to_immune_population_delay_time_region_1,susceptible_population_region_1/susceptible_to_immune_population_delay_time_region_1), MIN((normal_immune_population_region_1-immune_population_region_1)/susceptible_to_immune_population_delay_time_region_1,immune_population_region_1/susceptible_to_immune_population_delay_time_region_1))"},{"type":"aux","name":"susceptible_to_immune_population_flow_region_2","units":"persons/Month","eqn":"IF_THEN_ELSE((normal_immune_population_region_2-immune_population_region_2)/susceptible_to_immune_population_delay_time_region_2 >0, MIN((normal_immune_population_region_2-immune_population_region_2)/susceptible_to_immune_population_delay_time_region_2,susceptible_population_region_2/susceptible_to_immune_population_delay_time_region_2 ), MIN((normal_immune_population_region_2-immune_population_region_2)/susceptible_to_immune_population_delay_time_region_2,immune_population_region_2/susceptible_to_immune_population_delay_time_region_2 ))"},{"type":"aux","name":"total_population_region_1","units":"persons","eqn":"infected_population_region_1+recovered_population_region_1+susceptible_population_region_1+immune_population_region_1"},{"type":"aux","name":"total_population_region_2","units":"persons","eqn":"infected_population_region_2+recovered_population_region_2+susceptible_population_region_2+immune_population_region_2"},{"type":"aux","name":"contact_rate_region_1","units":"contacts/(person*Month)","eqn":"50"},{"type":"aux","name":"contact_rate_region_2","units":"contacts/(person*Month)","eqn":"100"},{"type":"aux","name":"infection_rate_region_1","units":"persons/contacts","eqn":"0.1"},{"type":"aux","name":"infection_rate_region_2","units":"persons/contacts","eqn":"0.15"},{"type":"aux","name":"initial_value_immune_population_region_1","units":"persons","eqn":"2.7e+08"},{"type":"aux","name":"initial_value_immune_population_region_2","units":"persons","eqn":"1e+09"},{"type":"aux","name":"initial_value_infected_population_region_1","units":"persons","eqn":"10"},{"type":"aux","name":"initial_value_infected_population_region_2","units":"persons","eqn":"10"},{"type":"aux","name":"initial_value_recovered_population_region_1","units":"persons","eqn":"0"},{"type":"aux","name":"initial_value_recovered_population_region_2","units":"persons","eqn":"0"},{"type":"aux","name":"initial_value_susceptible_population_region_1","units":"persons","eqn":"3.3e+08"},{"type":"aux","name":"initial_value_susceptible_population_region_2","units":"persons","eqn":"2e+09"},{"type":"aux","name":"interregional_contact_rate","units":"contacts/(person*Month)","eqn":"0.1"},{"type":"aux","name":"recovering_time","units":"Month","eqn":"0.5"},{"type":"aux","name":"susceptible_to_immune_population_delay_time_region_1","units":"Month","eqn":"1"},{"type":"aux","name":"susceptible_to_immune_population_delay_time_region_2","units":"Month","eqn":"1"}]}