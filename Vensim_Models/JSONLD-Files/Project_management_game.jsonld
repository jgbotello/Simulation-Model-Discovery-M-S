{"@type":"XMILEModel","modelId":"Project_management_game","sourceFile":"Project_management_game.xmile","simSpecs":{"method":"RK4","time_units":"week","start":"0","stop":"120","dt":"0.125"},"variables":[{"type":"stock","name":"Counter_for_Change_Product_Performance","units":"","eqn":"realistic_product_performance_in_number_of_features","inflows":["change product performance"],"outflows":[]},{"type":"stock","name":"Customers_with_Fulfilled_Orders_(CFO)","units":"","eqn":"0","inflows":["\"sales rate (sr)\""],"outflows":[]},{"type":"stock","name":"Customers_with_Unfulfilled_Orders_(CUO)","units":"customer","eqn":"initial_CUO","inflows":["\"customer order rate (cor)\""],"outflows":["\"lost sales rate (lsr)\"","\"sales rate (sr)\""]},{"type":"stock","name":"delay_change_in_discovery","units":"","eqn":"delay_change_in_discovery= DELAY_FIXED(change_in_discovery,TIME_STEP,0)","inflows":[],"outflows":[]},{"type":"stock","name":"Discovery_of_Unrealistic_Due_Date","units":"","eqn":"0","inflows":["change in discovery"],"outflows":[]},{"type":"stock","name":"Expected_Development_Costs_(EDC)","units":"","eqn":"(\"development_costs_(DC)\"/MAX(1,Time))*\"Feasible_Development_Time_(FDT)\"","inflows":["change PDC"],"outflows":[]},{"type":"stock","name":"Expected_Development_Time_(EDT)","units":"","eqn":"\"Feasible_Development_Time_(FDT)\"","inflows":["calculate EDT"],"outflows":[]},{"type":"stock","name":"Experienced_Engineers_(EE)","units":"","eqn":"MAX(0,\"planned_Team_Size_(pTS)\"-initial_shortage_of_team)","inflows":["\"assimilation rate (ar)\""],"outflows":["end of project for experienced team"]},{"type":"stock","name":"Feasible_Development_Time_(FDT)","units":"","eqn":"\"Project_Tasks_in_Execution_(TE)\"/(\"norm_productivity_experienced_person_(npe)\"*\"planned_Team_Size_(pTS)\")","inflows":["\"development time adjustment rate (dtar)\""],"outflows":[]},{"type":"stock","name":"Lost_Customers_(LC)","units":"","eqn":"0","inflows":["\"lost sales rate (lsr)\""],"outflows":[]},{"type":"stock","name":"Potential_Customers_(PC)","units":"customers","eqn":"initial_potential_customers","inflows":["add potential customers"],"outflows":["\"customer order rate (cor)\""]},{"type":"stock","name":"Project_Tasks_Finished_(TF)","units":"tasks","eqn":"0","inflows":["\"task finish rate (tfr)\""],"outflows":[]},{"type":"stock","name":"Project_Tasks_in_Execution_(TE)","units":"tasks","eqn":"project_tasks_to_be_executed*(1-\"project_newness_(pn)\")","inflows":["new tasks for higher product advantage","\"task definition rate (tdr)\""],"outflows":["\"task finish rate (tfr)\""]},{"type":"stock","name":"project_tasks_to_be_executed","units":"tasks","eqn":"initial_project_tasks_to_be_executed","inflows":["add new tasks"],"outflows":[]},{"type":"stock","name":"Rookie_Engineers_(RE)","units":"persons","eqn":"0","inflows":["\"hiring rate (hr)\""],"outflows":["\"assimilation rate (ar)\"","end of project for rookies"]},{"type":"stock","name":"Sales_Benefits_(SB)","units":"","eqn":"0","inflows":["\"weekly sales benefits (sb)\""],"outflows":[]},{"type":"stock","name":"Total_Experienced_Person-Weeks_(TEPW)","units":"","eqn":"\"Experienced_Engineers_(EE)\"","inflows":["\"experienced person-weeks (epw)\""],"outflows":[]},{"type":"stock","name":"Total_Rookie_Person-Weeks_(TRPW)","units":"","eqn":"\"Rookie_Engineers_(RE)\"","inflows":["\"rookie person-weeks (rpw)\""],"outflows":[]},{"type":"stock","name":"Undiscovered_Project_Tasks_(UT)","units":"tasks","eqn":"project_tasks_to_be_executed*\"project_newness_(pn)\"","inflows":["new undiscovered tasks for higher product advantage"],"outflows":["\"task definition rate (tdr)\""]},{"type":"aux","name":"add_new_tasks","units":"","eqn":"new_tasks_for_higher_product_advantage+new_undiscovered_tasks_for_higher_product_advantage"},{"type":"aux","name":"add_potential_customers","units":"","eqn":"IF_THEN_ELSE(delay_change_in_discovery>0:OR:change_product_performance<>0,potential_customers_per_feature*change_product_performance,0)"},{"type":"aux","name":"assimilation_rate_(ar)","units":"","eqn":"\"Rookie_Engineers_(RE)\"/\"assimilation_delay_(ad)\""},{"type":"aux","name":"average_actual_productivity_per_person_(aapp)","units":"task/(person*week)","eqn":"\"average_productivity_per_person_(app)\"*(1-0*\"efficiency_loss_(el)\"-\"new_efficiency_loss_(nel)\")"},{"type":"aux","name":"average_productivity_per_person_(app)","units":"","eqn":"(\"Rookie_Engineers_(RE)\"*\"norm_productivity_rookie_(npr)\"+\"norm_productivity_experienced_person_(npe)\"*(\"Experienced_Engineers_(EE)\"-\"supervision_time_per_rookie_(st)\"*\"Rookie_Engineers_(RE)\"))/(\"Rookie_Engineers_(RE)\"+\"Experienced_Engineers_(EE)\")"},{"type":"aux","name":"calculate_EDT","units":"","eqn":"IF_THEN_ELSE (\"project_completeness_(pc)\"<0.991,(MAX(Time,\"Feasible_Development_Time_(FDT)\")-\"Expected_Development_Time_(EDT)\")/1,0)"},{"type":"aux","name":"change_in_discovery","units":"","eqn":"IF_THEN_ELSE (Discovery_of_Unrealistic_Due_Date=0 :AND:\"pressure_to_intervene_(pi)\" >\"intervention_threshold_(it)\",1/TIME_STEP,0)"},{"type":"aux","name":"change_PDC","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\"<0.991,(-\"Expected_Development_Costs_(EDC)\"+(\"development_costs_(DC)\"/MAX(1,Time))*\"Feasible_Development_Time_(FDT)\")/\"development_time_adjustment_delay_(dtad)\",0)"},{"type":"aux","name":"change_product_performance","units":"","eqn":"(-Counter_for_Change_Product_Performance+0*product_performance_in_number_of_features+realistic_product_performance_in_number_of_features)/TIME_STEP"},{"type":"aux","name":"current_time","units":"","eqn":"Time"},{"type":"aux","name":"customer_order_rate_(cor)","units":"customers/week","eqn":"(\"Total_Market_(TM)\"-\"Potential_Customers_(PC)\")*\"potential_customer_concentration_(pcc)\"*\"word-of-mouth_factor_(wom)\""},{"type":"aux","name":"desired_sales_rate_(sr*)","units":"","eqn":"\"Customers_with_Unfulfilled_Orders_(CUO)\"/\"expected_delivery_time_(edt)\""},{"type":"aux","name":"desired_team_size","units":"","eqn":"GAME ( 10)"},{"type":"aux","name":"desired_Team_Size_(TS*)","units":"persons","eqn":"\"perceived_personweeks_remaining_(ppwr)\"/\"time_remaining_(tr)\""},{"type":"aux","name":"development_costs_(DC)","units":"","eqn":"\"labor_costs_rookie_engineers_(lcRE)\"*\"Total_Rookie_Person-Weeks_(TRPW)\"+\"labor_costs_experienced_engineers_(lcEE)\"*\"Total_Experienced_Person-Weeks_(TEPW)\""},{"type":"aux","name":"development_time_adjustment_rate_(dtar)","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\"<0.991,((Time+\"development_weeks_still_to_go_(wtg)\")-\"Feasible_Development_Time_(FDT)\" )/\"development_time_adjustment_delay_(dtad)\",0)"},{"type":"aux","name":"development_weeks_still_to_go_(wtg)","units":"weeks","eqn":"\"perceived_personweeks_remaining_(ppwr)\"/MAX(\"planned_Team_Size_(pTS)\",\"team_size_(TS)\")"},{"type":"aux","name":"efficiency_loss_(el)","units":"","eqn":"0.0004758*\"team_size_(TS)\"*\"team_size_(TS)\""},{"type":"aux","name":"end_of_project_for_experienced_team","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\">0.991,\"Experienced_Engineers_(EE)\"/reallocation_delay,0)"},{"type":"aux","name":"end_of_project_for_rookies","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\">0.991,\"Rookie_Engineers_(RE)\"/reallocation_delay,0)"},{"type":"aux","name":"end_profit","units":"","eqn":"IF_THEN_ELSE(Time = 200,\"Profit_(P)\", 0)"},{"type":"aux","name":"Expected_Profit_(EP)","units":"","eqn":"\"Expected_Sales_Benefits_(ESB)\"-\"Expected_Development_Costs_(EDC)\""},{"type":"aux","name":"Expected_Sales_Benefits_(ESB)","units":"","eqn":"(\"Total_Market_(TM)\"-\"Lost_Customers_(LC)\")*\"sales_price_(sp)\""},{"type":"aux","name":"experienced_person-weeks_(epw)","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\">1.99,0,\"Experienced_Engineers_(EE)\")"},{"type":"aux","name":"hiring_rate_(hr)","units":"persons/week","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\">0.991,0,(1-switch_to_game)*(MAX(0,(MIN(\"maximum_Team_Size_(TSmax)\",\"desired_Team_Size_(TS*)\")-\"team_size_(TS)\"))/\"hiring_delay_(hd)\")+switch_to_game*(\"maximum_Team_Size_(TSmax)\"-\"team_size_(TS)\")/\"hiring_delay_(hd)\")"},{"type":"aux","name":"initial_potential_customers","units":"","eqn":"10000*normal_product_performance"},{"type":"aux","name":"initial_project_tasks_to_be_executed","units":"","eqn":"\"nominal_tasks_to_be_executed_(T)\"*normal_product_performance"},{"type":"aux","name":"lost_sales_rate_(lsr)","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\"<0.991,\"desired_sales_rate_(sr*)\",0)"},{"type":"aux","name":"maximum_Team_Size_(TSmax)","units":"persons","eqn":"(1-switch_to_game)*\"planned_Team_Size_(pTS)\"+switch_to_extra_hiring*IF_THEN_ELSE(Discovery_of_Unrealistic_Due_Date>0,increase_team ,0)+switch_to_game*(realistic_team_size)"},{"type":"aux","name":"new_efficiency_loss_(nel)","units":"","eqn":"efficience_loss_constant(\"team_size_(TS)\")*\"team_size_(TS)\"*\"team_size_(TS)\""},{"type":"aux","name":"new_tasks_for_higher_product_advantage","units":"","eqn":"IF_THEN_ELSE(delay_change_in_discovery>0:OR:change_product_performance<>0,change_product_performance*task_per_feature*(1-\"project_newness_(pn)\"),0)"},{"type":"aux","name":"new_undiscovered_tasks_for_higher_product_advantage","units":"","eqn":"IF_THEN_ELSE(delay_change_in_discovery>0 :OR:change_product_performance<>0,change_product_performance*task_per_feature*\"project_newness_(pn)\",0)"},{"type":"aux","name":"norm_productivity_experienced_person_(npe)","units":"","eqn":"1/(\"nominal_time_per_task_(tt)\"+(0.21*\"project_newness_(pn)\"))"},{"type":"aux","name":"norm_productivity_rookie_(npr)","units":"","eqn":"(1/(\"nominal_time_per_task_(tt)\"+(0.21*\"project_newness_(pn)\")))*\"rookie_productivity_fraction_(rpf)\""},{"type":"aux","name":"perceived_personweeks_remaining_(ppwr)","units":"persons*week","eqn":"IF_THEN_ELSE(\"Project_Tasks_in_Execution_(TE)\"<0.1,0,\"Project_Tasks_in_Execution_(TE)\"/\"norm_productivity_experienced_person_(npe)\")"},{"type":"aux","name":"potential_customer_concentration_(pcc)","units":"dmnl","eqn":"\"Potential_Customers_(PC)\"/\"Total_Market_(TM)\""},{"type":"aux","name":"potential_customers_per_feature","units":"","eqn":"initial_potential_customers/(normal_product_performance/product_performance_per_feature)"},{"type":"aux","name":"pressure_to_intervene_(pi)","units":"","eqn":"\"Feasible_Development_Time_(FDT)\"/\"Scheduled_Development_Time_(SDT)\""},{"type":"aux","name":"product_performance_(pp)","units":"dmnl","eqn":"(1-switch_to_game)*((1-switch_to_change_product_performance)*normal_product_performance+switch_to_change_product_performance *IF_THEN_ELSE(Discovery_of_Unrealistic_Due_Date>0,product_performance_in_number_of_features*product_performance_per_feature ,normal_product_performance))+switch_to_game*realistic_product_performance_in_number_of_features*product_performance_per_feature"},{"type":"aux","name":"product_performance_in_number_of_features","units":"","eqn":"GAME ( 10)"},{"type":"aux","name":"product_performance_per_feature","units":"","eqn":"normal_product_performance/10"},{"type":"aux","name":"Profit_(P)","units":"","eqn":"\"Sales_Benefits_(SB)\"-\"development_costs_(DC)\""},{"type":"aux","name":"project_completeness_(pc)","units":"dmnl","eqn":"MIN(0.999,\"Project_Tasks_Finished_(TF)\"/project_tasks_to_be_executed)"},{"type":"aux","name":"project_newness_(pn)","units":"dmnl","eqn":"0.22*\"product_performance_(pp)\""},{"type":"aux","name":"realistic_product_performance_in_number_of_features","units":"","eqn":"MIN(15,MAX(5,product_performance_in_number_of_features))"},{"type":"aux","name":"realistic_team_size","units":"","eqn":"MIN(13,MAX(7,desired_team_size))"},{"type":"aux","name":"rookie_person-weeks_(rpw)","units":"","eqn":"IF_THEN_ELSE (\"project_completeness_(pc)\">1.99,0,\"Rookie_Engineers_(RE)\")"},{"type":"aux","name":"sales_price_(sp)","units":"","eqn":"\"nominal_sales_price_(nsp)\"*(normal_product_performance+(\"product_performance_(pp)\"-normal_product_performance)/effect_adv_on_price)"},{"type":"aux","name":"sales_rate_(sr)","units":"","eqn":"IF_THEN_ELSE(\"project_completeness_(pc)\"<0.991,0,\"desired_sales_rate_(sr*)\")"},{"type":"aux","name":"task_definition_rate_(tdr)","units":"tasks/week","eqn":"\"Undiscovered_Project_Tasks_(UT)\"/\"discovery_delay_of_new_tasks_(ddt)\""},{"type":"aux","name":"task_finish_rate_(tfr)","units":"tasks/week","eqn":"MIN(\"Project_Tasks_in_Execution_(TE)\",\"team_size_(TS)\"*\"average_actual_productivity_per_person_(aapp)\")"},{"type":"aux","name":"task_per_feature","units":"","eqn":"initial_project_tasks_to_be_executed/(normal_product_performance/product_performance_per_feature)"},{"type":"aux","name":"team_size_(TS)","units":"persons","eqn":"\"Rookie_Engineers_(RE)\"+\"Experienced_Engineers_(EE)\""},{"type":"aux","name":"time_remaining_(tr)","units":"weeks","eqn":"MAX(1,\"Scheduled_Development_Time_(SDT)\"-Time)"},{"type":"aux","name":"Total_Market_(TM)","units":"customers","eqn":"\"Potential_Customers_(PC)\"+\"Customers_with_Unfulfilled_Orders_(CUO)\"+\"Customers_with_Fulfilled_Orders_(CFO)\"+\"Lost_Customers_(LC)\""},{"type":"aux","name":"weekly_sales_benefits_(sb)","units":"","eqn":"\"sales_rate_(sr)\"*\"sales_price_(sp)\""},{"type":"aux","name":"word-of-mouth_factor_(wom)","units":"dmnl/week","eqn":"-0.1657*\"project_newness_(pn)\"+0.2468"},{"type":"aux","name":"efficience_loss_constant","units":"","eqn":""},{"type":"aux","name":"assimilation_delay_(ad)","units":"weeks","eqn":"20"},{"type":"aux","name":"development_time_adjustment_delay_(dtad)","units":"","eqn":"4"},{"type":"aux","name":"discovery_delay_of_new_tasks_(ddt)","units":"week","eqn":"12"},{"type":"aux","name":"effect_adv_on_price","units":"","eqn":"1"},{"type":"aux","name":"expected_delivery_time_(edt)","units":"week","eqn":"1"},{"type":"aux","name":"hiring_delay_(hd)","units":"weeks","eqn":"12"},{"type":"aux","name":"increase_team","units":"","eqn":"0"},{"type":"aux","name":"initial_CUO","units":"","eqn":"0.00337655"},{"type":"aux","name":"initial_shortage_of_team","units":"","eqn":"3.5"},{"type":"aux","name":"intervention_threshold_(it)","units":"","eqn":"1e+09"},{"type":"aux","name":"labor_costs_experienced_engineers_(lcEE)","units":"","eqn":"950"},{"type":"aux","name":"labor_costs_rookie_engineers_(lcRE)","units":"","eqn":"750"},{"type":"aux","name":"nominal_sales_price_(nsp)","units":"","eqn":"41.7203"},{"type":"aux","name":"nominal_tasks_to_be_executed_(T)","units":"","eqn":"100"},{"type":"aux","name":"nominal_time_per_task_(tt)","units":"","eqn":"4.10468"},{"type":"aux","name":"normal_product_performance","units":"","eqn":"1.45"},{"type":"aux","name":"planned_Team_Size_(pTS)","units":"","eqn":"10"},{"type":"aux","name":"reallocation_delay","units":"","eqn":"1"},{"type":"aux","name":"rookie_productivity_fraction_(rpf)","units":"","eqn":"0.6"},{"type":"aux","name":"Scheduled_Development_Time_(SDT)","units":"weeks","eqn":"60.49"},{"type":"aux","name":"supervision_time_per_rookie_(st)","units":"","eqn":"0.2"},{"type":"aux","name":"switch_to_change_product_performance","units":"","eqn":"1"},{"type":"aux","name":"switch_to_extra_hiring","units":"","eqn":"1"},{"type":"aux","name":"switch_to_game","units":"","eqn":"1"}]}