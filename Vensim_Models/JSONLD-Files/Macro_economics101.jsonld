{"@type":"XMILEModel","modelId":"Macro_economics101","sourceFile":"Macro_economics101.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"20","dt":"0.0078125"},"variables":[{"type":"stock","name":"Book_Value_of_Capital_Assets","units":"$","eqn":"Initial_Assets*Asset_Price","inflows":["Financial Investment"],"outflows":["Capital Depreciation","Book Losses"]},{"type":"stock","name":"Capital_Assets","units":"Capital_Units","eqn":"Initial_Assets","inflows":["Investment"],"outflows":["Capital Consumption","Loses"]},{"type":"stock","name":"Cumulative_Investment","units":"Capital_Units","eqn":"Reference_Investment","inflows":["New Investment"],"outflows":[]},{"type":"stock","name":"Cumulative_Production","units":"Goods","eqn":"Reference_Production","inflows":["New Production"],"outflows":[]},{"type":"stock","name":"Employed_Labor","units":"People","eqn":"Initial_Labor","inflows":["Hiring"],"outflows":["Attrition Rate"]},{"type":"stock","name":"Exog_Gov_Budget","units":"$/Year","eqn":"Natural_Grw_Gov_Budget","inflows":["Chg in Gov Budget"],"outflows":[]},{"type":"stock","name":"Expected_Asset_Income_Ratio","units":"$/(Capital_Units*Year)","eqn":"Asset_Income_Ratio","inflows":["Adjustment of Asset Income Ratio Expectations"],"outflows":[]},{"type":"stock","name":"Expected_Asset_Price","units":"$/Capital_Unit","eqn":"Initial_Asset_Price","inflows":["Adjustment of Asset Price Expectations"],"outflows":[]},{"type":"stock","name":"Expected_Chg_in_Asset_Income_Ratio","units":"Fraction/Year","eqn":"0","inflows":["Expectations Adjustment Asset Inc Ratio"],"outflows":[]},{"type":"stock","name":"Expected_Chg_in_Return_on_Capital","units":"Fraction/Year","eqn":"0","inflows":["Expectations Adjustment Return on Capital"],"outflows":[]},{"type":"stock","name":"Expected_Chg_in_Wages_Income_Ratio","units":"Fraction/Year","eqn":"0","inflows":["Expectations Adjustment Wages Income Ratio"],"outflows":[]},{"type":"stock","name":"Expected_Chg_in_Wealth","units":"Fraction/Year","eqn":"0","inflows":["Expectations Adjustment Wealth"],"outflows":[]},{"type":"stock","name":"Expected_Fraction_of_Income_Devoted_to_Wages","units":"Fraction","eqn":"Initial_Fraction_of_Income_Devoted_to_Wages","inflows":["Adjust of Fract of Income Devoted to Wages"],"outflows":[]},{"type":"stock","name":"Expected_Money_Inflation","units":"Fraction/Year","eqn":"0","inflows":["Expectations Adjustment Money Inflation"],"outflows":[]},{"type":"stock","name":"Expected_Price","units":"$/Good","eqn":"Initial_Price","inflows":["Adjustment of Price Expectations"],"outflows":[]},{"type":"stock","name":"Expected_Production_Trend","units":"Fraction/Year","eqn":"0","inflows":["Perception of Production Trend"],"outflows":[]},{"type":"stock","name":"Expected_Return_on_Capital","units":"Fraction/Year","eqn":"Desired_Return_on_Capital","inflows":["Adjustment of Expected Return on Capital"],"outflows":[]},{"type":"stock","name":"Expected_Wealth","units":"$/Person","eqn":"Initial_Wealth/Working_Population","inflows":["Adjustment of Expected Wealth"],"outflows":[]},{"type":"stock","name":"Money_Supply","units":"$","eqn":"Initial_Money_Supply","inflows":["Growth In Money"],"outflows":[]},{"type":"stock","name":"Normal_Savings_Fraction","units":"Dimensionless","eqn":"Initial_Savings_Rate/Percent","inflows":["Adjustment of Normal Savings Rate"],"outflows":[]},{"type":"stock","name":"Perceived_Asset_Income_Ratio","units":"$/(Capital_Units*Year)","eqn":"Asset_Income_Ratio","inflows":["Perception of Asset Income Ratio"],"outflows":[]},{"type":"stock","name":"Perceived_Money_Ratio","units":"Year*$/Goods","eqn":"Money_Ratio","inflows":["Money Ratio Perception"],"outflows":[]},{"type":"stock","name":"Perceived_Production","units":"Goods/Year","eqn":"Production","inflows":["Production Perception"],"outflows":[]},{"type":"stock","name":"Perceived_Return_on_Capital","units":"Fraction/Year","eqn":"Desired_Return_on_Capital","inflows":["Perception of Return on Capital"],"outflows":[]},{"type":"stock","name":"Perceived_Wages_Income_Ratio","units":"Dimensionless","eqn":"Wages_Income_Ratio","inflows":["Wages Income Ratio Perception"],"outflows":[]},{"type":"stock","name":"Perceived_Wealth","units":"$/Person","eqn":"Initial_Wealth/Working_Population","inflows":["Perception of Wealth"],"outflows":[]},{"type":"stock","name":"Real_Book_Value_of_Capital_Assets","units":"Starting_$","eqn":"Initial_Assets*Asset_Price/Initial_$","inflows":["Real Financial Investment"],"outflows":["Real Capital Depreciation","Real Book Losses"]},{"type":"stock","name":"Reference_Money_Ratio","units":"Year*$/Goods","eqn":"Money_Ratio","inflows":["Adjustment of Money Ratio Expectations"],"outflows":[]},{"type":"stock","name":"Reference_Production_for_Trend","units":"Goods/Year","eqn":"Production","inflows":["Adjustment of Production Expectations"],"outflows":[]},{"type":"stock","name":"Reference_Wages_Income_Ratio","units":"Dimensionless","eqn":"Wages_Income_Ratio","inflows":["Adjustment for Reference Wages Income Ratio"],"outflows":[]},{"type":"stock","name":"Vacancies","units":"People","eqn":"Time_to_Fill_Vacancies*(Attrition_Rate + Population_Growth_Rate*Employed_Labor/Percent)","inflows":["Vacancy Creation"],"outflows":["Vacancy Closure"]},{"type":"stock","name":"Wages","units":"$/(Person*Year)","eqn":"Indicated_Wages","inflows":["Adjustment of Wage Expectations"],"outflows":[]},{"type":"stock","name":"Working_Population","units":"People","eqn":"Initial_Labor*(1 + Min_Time_to_Hire/Ave_Duration_of_Employment)/(Share_of_Working_Pop_in_Labor_Pool/Percent)","inflows":["Pop Growth"],"outflows":[]},{"type":"aux","name":"Adjust_of_Fract_of_Income_Devoted_to_Wages","units":"Fraction/Year","eqn":"(Fraction_of_Income_Devoted_to_Wages - Expected_Fraction_of_Income_Devoted_to_Wages)/Time_to_Adjust_Wage_Income_Expectations"},{"type":"aux","name":"Adjustment_for_Desired_Labor","units":"People/Year","eqn":"(Desired_Employed_Labor-Employed_Labor)/Labor_Adjustment_Time"},{"type":"aux","name":"Adjustment_for_Reference_Wages_Income_Ratio","units":"Dimensionless/Year","eqn":"(Perceived_Wages_Income_Ratio-Reference_Wages_Income_Ratio)/Time_Horizon_to_Assess_Wages_Income_Ratio"},{"type":"aux","name":"Adjustment_for_Vacancies","units":"People/Year","eqn":"(Desired_Vacancies-Vacancies)/Vacancy_Adjustment_Time"},{"type":"aux","name":"Adjustment_of_Asset_Income_Ratio_Expectations","units":"$/(Capital_Units*Year*Year)","eqn":"(Perceived_Asset_Income_Ratio-Expected_Asset_Income_Ratio)/Time_Horizon_to_Assess_Asset_Income_Ratio"},{"type":"aux","name":"Adjustment_of_Asset_Price_Expectations","units":"$/(Year*Capital_Unit)","eqn":"(Asset_Price-Expected_Asset_Price)/Time_to_Adjust_Asset_Price_Expectations"},{"type":"aux","name":"Adjustment_of_Expected_Return_on_Capital","units":"Fraction/(Year*Year)","eqn":"(Perceived_Return_on_Capital - Expected_Return_on_Capital)/Time_Horizon_to_Assess_Capital_Returns"},{"type":"aux","name":"Adjustment_of_Expected_Wealth","units":"$/(Person*Year)","eqn":"(Perceived_Wealth - Expected_Wealth)/Time_Horizon_to_Assess_Wealth"},{"type":"aux","name":"Adjustment_of_Money_Ratio_Expectations","units":"$/Goods","eqn":"(Perceived_Money_Ratio - Reference_Money_Ratio)/Time_Horizon_to_Assess_Inflation"},{"type":"aux","name":"Adjustment_of_Normal_Savings_Rate","units":"Dimensionless/Year","eqn":"(Constrained_Savings_Fraction - Normal_Savings_Fraction)/Time_to_Adjust_Savings_Norms"},{"type":"aux","name":"Adjustment_of_Price_Expectations","units":"$/(Years*Good)","eqn":"(Price - Expected_Price)/Time_to_Adjust_Price_Expectations"},{"type":"aux","name":"Adjustment_of_Production_Expectations","units":"Goods/(Year*Year)","eqn":"(Perceived_Production - Reference_Production_for_Trend)/Time_Horizon_to_Assess_Production_Changes"},{"type":"aux","name":"Adjustment_of_Wage_Expectations","units":"$/(Person*Year*Year)","eqn":"(Indicated_Wages - Wages)/Time_to_Adjust_Wage_Expectations"},{"type":"aux","name":"Applied_Labor","units":"Person*Years","eqn":"Employed_Labor*Work_Effort"},{"type":"aux","name":"Asset_Earnings","units":"$/Year","eqn":"Asset_Income - Capital_Depreciation - Asset_Taxes"},{"type":"aux","name":"Asset_Income","units":"$/Year","eqn":"Income - Wage_Income"},{"type":"aux","name":"Asset_Income_Ratio","units":"$/(Capital_Units*Year)","eqn":"Asset_Income/Capital_Assets"},{"type":"aux","name":"Asset_Income_Ratiox","units":"Dimensionless","eqn":"Asset_Income/Income"},{"type":"aux","name":"Asset_Price","units":"$/Capital_Unit","eqn":"Expected_Asset_Price*Effect_of_Asset_Income_Ratio_on_Asset_Price*Effect_of_Money_Inflation_on_Price*Effect_of_Wage_Income_Ratio_on_Price"},{"type":"aux","name":"Asset_Price_Inflation","units":"$/Starting_$","eqn":"Initial_$*Asset_Price/Initial_Asset_Price"},{"type":"aux","name":"Asset_Taxes","units":"$/Year","eqn":"(Tax_Rate/Percent)*Asset_Income"},{"type":"aux","name":"Attrition_Rate","units":"People/Year","eqn":"Employed_Labor/Ave_Duration_of_Employment"},{"type":"aux","name":"Book_Losses","units":"$/Year","eqn":"0 +( Loss_Rate/Percent)*Book_Value_of_Capital_Assets*PULSE(Time_to_Start_Loss, Duration_of_Losses )"},{"type":"aux","name":"Capital_Assets_per_Capita","units":"Capital_Units/Person","eqn":"Capital_Assets/Working_Population"},{"type":"aux","name":"Capital_Consumption","units":"Capital_Units/Year","eqn":"Capital_Assets/Ave_Life_of_Cap"},{"type":"aux","name":"Capital_Depreciation","units":"$/Year","eqn":"Book_Value_of_Capital_Assets/Ave_Life_of_Cap"},{"type":"aux","name":"Change_in_Asset_Income_Ratio","units":"Fraction/Year","eqn":"(Perceived_Asset_Income_Ratio - Expected_Asset_Income_Ratio)/Expected_Asset_Income_Ratio/Time_Horizon_to_Assess_Asset_Income_Ratio"},{"type":"aux","name":"Change_in_Return_on_Capital","units":"Fraction/Year","eqn":"(Perceived_Return_on_Capital-Expected_Return_on_Capital)/ABS(Expected_Return_on_Capital)/Time_Horizon_to_Assess_Capital_Returns"},{"type":"aux","name":"Change_in_Wages_Income_Ratio","units":"Fraction/Year","eqn":"(Perceived_Wages_Income_Ratio-Reference_Wages_Income_Ratio)/Reference_Wages_Income_Ratio/Time_Horizon_to_Assess_Wages_Income_Ratio"},{"type":"aux","name":"Change_in_Wealth","units":"Fraction/Year","eqn":"(Perceived_Wealth-Expected_Wealth)/Expected_Wealth/Time_Horizon_to_Assess_Wealth"},{"type":"aux","name":"Chg_in_Gov_Budget","units":"$/(Year*Year)","eqn":"((Gov_Budget_Growth_Rate+Switch_to_Include_Money_Growth_in_Gov_Budget*Expected_Money_Inflation_Rate)/Percent)*Exog_Gov_Budget"},{"type":"aux","name":"Constrained_Savings_Fraction","units":"Dimensionless","eqn":"MIN(Maximum_Savings_Fraction,Savings_Fraction)"},{"type":"aux","name":"Consumption","units":"$/Year","eqn":"(1-Savings_Fraction)*Disposable_Income"},{"type":"aux","name":"Current_Net_Investment_in_Capital_Units","units":"Capital_Units/Year","eqn":"((Private_Investment +Gov_Investment)/Asset_Price)-Capital_Consumption"},{"type":"aux","name":"Depreciation_Fraction","units":"Fraction/Year","eqn":"1/Ave_Life_of_Cap"},{"type":"aux","name":"Desired_Employed_Labor","units":"People","eqn":"Income_Devoted_to_Wages/Wages"},{"type":"aux","name":"Desired_Hiring","units":"People/Year","eqn":"Expected_Attrition+Adjustment_for_Desired_Labor"},{"type":"aux","name":"Desired_Vacancies","units":"People","eqn":"MAX(0,Expected_Time_to_Fill_Vacancies*Desired_Hiring)"},{"type":"aux","name":"Desired_Vacancy_Creation","units":"People/Year","eqn":"Desired_Hiring+Adjustment_for_Vacancies"},{"type":"aux","name":"Disposable_Income","units":"$/Year","eqn":"(1-(Tax_Rate/Percent))*Income"},{"type":"aux","name":"DT","units":"Year","eqn":"TIME_STEP"},{"type":"aux","name":"Effect_of_Asset_Income_Ratio_on_Asset_Price","units":"Dimensionless","eqn":"2*(Max_Asset_Inc_Ratio_Eff_on_Asset_Price-1)/(1+exp(-(Expected_Chg_in_Asset_Income_Ratio)*Sens_of_Asset_Price_to_Asset_Income_Ratio))+(2- Max_Asset_Inc_Ratio_Eff_on_Asset_Price)"},{"type":"aux","name":"Effect_of_Experience_on_Tech_Pdty","units":"Dimensionless","eqn":"1/(Cumulative_Production/Reference_Production)^Learning_from_Experience"},{"type":"aux","name":"Effect_of_Investment_on_Tech_Pdty","units":"Dimensionless","eqn":"1/(Cumulative_Investment/Reference_Investment)^Learning_from_Investment"},{"type":"aux","name":"Effect_of_Money_Inflation_on_Price","units":"Dimensionless","eqn":"2*(Max_Inflation_Eff_on_Price-1)/(1+exp(-(Expected_Money_Inflation)*Sens_of_Price_to_Inflation))+(2-Max_Inflation_Eff_on_Price)"},{"type":"aux","name":"Effect_of_Returns_on_Savings","units":"Dimensionless","eqn":"2*(Max_Effect_of_Return_on_Savings-1)/(1+exp((-Expected_Chg_in_Return_on_Capital)*Sensitivity_of_Return_on_Savings))+( 2-Max_Effect_of_Return_on_Savings)"},{"type":"aux","name":"Effect_of_Wage_Income_Ratio_on_Price","units":"Dimensionless","eqn":"2*(Max_Wages_Income_Ratio_Eff_on_Price-1)/(1+exp(-(Expected_Chg_in_Wages_Income_Ratio)*Sens_of_Price_to_Wages_Income_Ratio))+(2-Max_Wages_Income_Ratio_Eff_on_Price)"},{"type":"aux","name":"Effect_of_Wealth_on_Savings","units":"Dimensionless","eqn":"2*(Max_Effect_of_Wealth_on_Savings-1)/(1+exp((Expected_Chg_in_Wealth)*Sensitivity_of_Wealth_on_Savings))+( 2-Max_Effect_of_Wealth_on_Savings)"},{"type":"aux","name":"Effective_Savings_Rate","units":"Percent","eqn":"Percent*(Private_Investment + Gov_Investment)/Income"},{"type":"aux","name":"Expectations_Adjustment_Asset_Inc_Ratio","units":"Fraction/(Year*Year)","eqn":"(Change_in_Asset_Income_Ratio-Expected_Chg_in_Asset_Income_Ratio)/Time_to_Adjust_Expectations_AIR"},{"type":"aux","name":"Expectations_Adjustment_Money_Inflation","units":"Fraction/(Year*Year)","eqn":"(Money_Inflation - Expected_Money_Inflation)/Time_to_Adjust_Expectations_MI"},{"type":"aux","name":"Expectations_Adjustment_Return_on_Capital","units":"Fraction/(Year*Year)","eqn":"(Change_in_Return_on_Capital - Expected_Chg_in_Return_on_Capital)/Time_to_Adjust_Expectations_ROC"},{"type":"aux","name":"Expectations_Adjustment_Wages_Income_Ratio","units":"Fraction/(Year*Year)","eqn":"(Change_in_Wages_Income_Ratio-Expected_Chg_in_Wages_Income_Ratio)/Time_to_Adjust_Expectations_WIR"},{"type":"aux","name":"Expectations_Adjustment_Wealth","units":"Fraction/(Year*Year)","eqn":"(Change_in_Wealth - Expected_Chg_in_Wealth)/Time_to_Adjust_Expectations_Wealth"},{"type":"aux","name":"Expected_Attrition","units":"People/Year","eqn":"SMOOTH(Attrition_Rate, Time_to_Ave_Attrition )"},{"type":"aux","name":"Expected_Money_Inflation_Rate","units":"Percent/Year","eqn":"Expected_Money_Inflation*Percent"},{"type":"aux","name":"Expected_Percent_Chg_in_AIR","units":"Percent/Year","eqn":"Percent*Expected_Chg_in_Asset_Income_Ratio"},{"type":"aux","name":"Expected_Percent_Chg_in_Returns","units":"Percent/Year","eqn":"Percent*Expected_Chg_in_Return_on_Capital"},{"type":"aux","name":"Expected_Percent_Chg_in_Wealth","units":"Percent/Year","eqn":"Percent*Expected_Chg_in_Wealth"},{"type":"aux","name":"Expected_Percent_Chg_in_WIR","units":"Percent/Year","eqn":"Percent*Expected_Chg_in_Wages_Income_Ratio"},{"type":"aux","name":"Expected_Time_to_Fill_Vacancies","units":"Year","eqn":"SMOOTH(Time_to_Fill_Vacancies, Time_to_Adjust_Hiring_Expectations )"},{"type":"aux","name":"Financial_Investment","units":"$/Year","eqn":"DELAY3((Private_Investment +Gov_Investment),Time_to_Acquire_Capital_Assets)"},{"type":"aux","name":"Fraction_of_Income_Devoted_to_Wages","units":"Fraction","eqn":"Wage_Income/Income"},{"type":"aux","name":"Gov_Borrowing","units":"$/Year","eqn":"Savings-Private_Investment"},{"type":"aux","name":"Gov_Borrowing_as_Share_of_Income","units":"Percent","eqn":"(Gov_Borrowing/Income)*Percent"},{"type":"aux","name":"Gov_Budget","units":"$/Year","eqn":"Switch_for_Endog_Gov_Grwth*Natural_Grw_Gov_Budget + (1 - Switch_for_Endog_Gov_Grwth)*Exog_Gov_Budget +Gov_Stimulus"},{"type":"aux","name":"Gov_Consump_share_of_Income","units":"Percent","eqn":"(Gov_Consumption_Spending/Income)*Percent"},{"type":"aux","name":"Gov_Consumption_Spending","units":"$/Year","eqn":"(1-(Gov_Invest_Share/Percent))*Gov_Spending"},{"type":"aux","name":"Gov_Deficit","units":"$/Year","eqn":"Gov_Budget - Taxes"},{"type":"aux","name":"Gov_Investment","units":"$/Year","eqn":"(Gov_Invest_Share/Percent)*Gov_Spending"},{"type":"aux","name":"Gov_Spending","units":"$/Year","eqn":"Taxes+Gov_Borrowing"},{"type":"aux","name":"Gov_Spending_Share_of_Income","units":"Percent","eqn":"(Gov_Spending/Income)*Percent"},{"type":"aux","name":"Gov_Stimulus","units":"$/Year","eqn":"(Exog_Gov_Budget*Magnitude_of_Gov_Stimulus/Percent)*PULSE(Time_to_Start_Stimulus, Duration_of_Stimulus)"},{"type":"aux","name":"Growth_In_Money","units":"$/Year","eqn":"((Money_Growth_Rate/Percent) + Temporary_Shift_in_Money_Growth_Rate)*Money_Supply"},{"type":"aux","name":"Hiring","units":"People/Year","eqn":"MIN(Maximum_Hiring,Vacancies/Time_to_Fill_Vacancies)"},{"type":"aux","name":"Income","units":"$/Year","eqn":"Production*Price"},{"type":"aux","name":"Income_Devoted_to_Wages","units":"$/Year","eqn":"Beta*Income"},{"type":"aux","name":"Income_per_Capita","units":"$/(Person*Year)","eqn":"Income/Working_Population"},{"type":"aux","name":"Indicated_Wages","units":"$/(Person*Year)","eqn":"(Income*Beta)/Employed_Labor"},{"type":"aux","name":"Initial_Money_Supply","units":"$","eqn":"Employed_Labor*Initial_Per_Worker_Money_Supply"},{"type":"aux","name":"Initial_Wealth","units":"$","eqn":"Capital_Assets*Asset_Price"},{"type":"aux","name":"Investment","units":"Capital_Units/Year","eqn":"DELAY3((Private_Investment +Gov_Investment)/Asset_Price,Time_to_Acquire_Capital_Assets)"},{"type":"aux","name":"Investment_per_Capita","units":"Capital_Units/(Person*Year)","eqn":"Investment/Working_Population"},{"type":"aux","name":"Labor_Pool","units":"People","eqn":"(Share_of_Working_Pop_in_Labor_Pool/Percent)*Working_Population"},{"type":"aux","name":"Learning_from_Experience","units":"Dimensionless","eqn":"ln(1 - Learning_Strength_from_Experience)/ln(2)"},{"type":"aux","name":"Learning_from_Investment","units":"Dimensionless","eqn":"ln(1 - Learning_Strength_from_Investment)/ln(2)"},{"type":"aux","name":"Loses","units":"Capital_Units/Year","eqn":"0 + (Loss_Rate/Percent)*Capital_Assets*PULSE(Time_to_Start_Loss, Duration_of_Losses )"},{"type":"aux","name":"Maximum_Hiring","units":"People/Year","eqn":"Unemployed_Labor/MAX(Min_Time_to_Hire,2*DT)"},{"type":"aux","name":"Money_Inflation","units":"Fraction/Year","eqn":"(Perceived_Money_Ratio - Reference_Money_Ratio)/Reference_Money_Ratio/Time_Horizon_to_Assess_Inflation"},{"type":"aux","name":"Money_Inflation_Rate","units":"Percent/Year","eqn":"Money_Inflation*Percent"},{"type":"aux","name":"Money_Ratio","units":"Year*$/Goods","eqn":"Money_Supply/Production"},{"type":"aux","name":"Money_Ratio_Perception","units":"$/Goods","eqn":"(Money_Ratio - Perceived_Money_Ratio)/Time_to_Perceive_Money_Ratio"},{"type":"aux","name":"Money_Velocity","units":"Dimensionless/Year","eqn":"Income/Money_Supply"},{"type":"aux","name":"Natural_Grw_Gov_Budget","units":"$/Year","eqn":"(Desired_Gov_Share_Income/Percent)*Income"},{"type":"aux","name":"Net_Investment","units":"$/Year","eqn":"Net_Investment_in_Capital_Units*Asset_Price"},{"type":"aux","name":"Net_Investment_in_Capital_Units","units":"Capital_Units/Year","eqn":"(Investment-Capital_Consumption)"},{"type":"aux","name":"Net_Investment_per_Capita","units":"$/(Person*Year)","eqn":"Net_Investment/Working_Population"},{"type":"aux","name":"New_Investment","units":"Capital_Units/Year","eqn":"Investment"},{"type":"aux","name":"New_Production","units":"Goods/Year","eqn":"Production"},{"type":"aux","name":"Nominal_Wealth","units":"$","eqn":"Asset_Price*Capital_Assets"},{"type":"aux","name":"Normal_Savings_Rate","units":"Percent","eqn":"Normal_Savings_Fraction*Percent"},{"type":"aux","name":"Per_Capital_Nom_Wealth","units":"$/Person","eqn":"Nominal_Wealth/Working_Population"},{"type":"aux","name":"Percent_Change_in_WIR","units":"Percent/Year","eqn":"Percent*Change_in_Wages_Income_Ratio"},{"type":"aux","name":"Percent_Chg_in_AIR","units":"Percent/Year","eqn":"Percent*Change_in_Asset_Income_Ratio"},{"type":"aux","name":"Percent_Chg_in_Returns","units":"Percent/Year","eqn":"Percent*Change_in_Return_on_Capital"},{"type":"aux","name":"Percent_Chg_in_Wealth","units":"Percent/Year","eqn":"Percent*Change_in_Wealth"},{"type":"aux","name":"Perception_of_Asset_Income_Ratio","units":"$/(Capital_Units*Year*Year)","eqn":"(Asset_Income_Ratio-Perceived_Asset_Income_Ratio)/Time_to_Perceive_Asset_Income_Ratio"},{"type":"aux","name":"Perception_of_Production_Trend","units":"Fraction/(Year*Year)","eqn":"(Production_Trend - Expected_Production_Trend)/Time_to_Perceive_Production_Trend"},{"type":"aux","name":"Perception_of_Return_on_Capital","units":"Fraction/(Year*Year)","eqn":"(Return_on_Capital - Perceived_Return_on_Capital)/Time_to_Perceive_Capital_Returns"},{"type":"aux","name":"Perception_of_Wealth","units":"$/(Person*Year)","eqn":"(Per_Capital_Nom_Wealth - Perceived_Wealth)/Time_to_Perceive_Wealth"},{"type":"aux","name":"Pop_Growth","units":"People/Year","eqn":"Working_Population*(Population_Growth_Rate/Percent)"},{"type":"aux","name":"Price","units":"$/Good","eqn":"Expected_Price*Effect_of_Money_Inflation_on_Price*Effect_of_Wage_Income_Ratio_on_Price"},{"type":"aux","name":"Price_Inflation","units":"$/Starting_$","eqn":"Initial_$*Price/Initial_Price"},{"type":"aux","name":"Private_Investment","units":"$/Year","eqn":"MAX(0,Savings-Gov_Deficit)"},{"type":"aux","name":"Prod_to_Labor_Ratio","units":"Goods/(Person*Year)","eqn":"Production/Employed_Labor"},{"type":"aux","name":"Production","units":"Goods/Year","eqn":"Technology*((Applied_Labor/Ref_Labor)^Beta)*((Capital_Assets/Ref_Capital)^(1-Beta))"},{"type":"aux","name":"Production_per_Capita","units":"Goods/(Person*Year)","eqn":"Production/Working_Population"},{"type":"aux","name":"Production_Perception","units":"Goods/(Year*Year)","eqn":"(Production - Perceived_Production)/Time_to_Perceive_Production"},{"type":"aux","name":"Production_Trend","units":"Fraction/Year","eqn":"(Perceived_Production - Reference_Production_for_Trend)/Reference_Production_for_Trend/Time_Horizon_to_Assess_Production_Changes"},{"type":"aux","name":"Real_Asset_Income","units":"Starting_$/Year","eqn":"Asset_Income/Asset_Price_Inflation"},{"type":"aux","name":"Real_Asset_Taxes","units":"Starting_$/Year","eqn":"(Tax_Rate/Percent)*Real_Asset_Income"},{"type":"aux","name":"Real_Book_Losses","units":"Starting_$/Year","eqn":"0 + (Loss_Rate/Percent)*Real_Book_Value_of_Capital_Assets*PULSE(Time_to_Start_Loss, Duration_of_Losses )"},{"type":"aux","name":"Real_Capital_Depreciation","units":"Starting_$/Year","eqn":"Real_Book_Value_of_Capital_Assets/Ave_Life_of_Cap"},{"type":"aux","name":"Real_Earnings","units":"Starting_$/Year","eqn":"Real_Asset_Income - Real_Capital_Depreciation - Real_Asset_Taxes"},{"type":"aux","name":"Real_Financial_Investment","units":"Starting_$/Year","eqn":"DELAY3((Private_Investment +Gov_Investment)/Asset_Price_Inflation,Time_to_Acquire_Capital_Assets)"},{"type":"aux","name":"Real_Per_Capita_Wealth","units":"Starting_$/Person","eqn":"Per_Capital_Nom_Wealth/Asset_Price_Inflation"},{"type":"aux","name":"Real_Return_on_Capital","units":"Fraction/Year","eqn":"Real_Earnings/Real_Book_Value_of_Capital_Assets"},{"type":"aux","name":"Real_Return_on_Capital_Percent","units":"Percent/Year","eqn":"Real_Return_on_Capital*Percent"},{"type":"aux","name":"Real_Total_Return_on_Capital","units":"Fraction/Year","eqn":"Real_Asset_Income/Real_Book_Value_of_Capital_Assets"},{"type":"aux","name":"Real_Wages","units":"Starting_$/(Person*Year)","eqn":"Wages/Price_Inflation"},{"type":"aux","name":"Real_Wealth","units":"Starting_$","eqn":"Nominal_Wealth/Asset_Price_Inflation"},{"type":"aux","name":"Ref_Capital","units":"Capital_Units","eqn":"Initial_Assets"},{"type":"aux","name":"Ref_Labor","units":"Person*Years","eqn":"Initial_Labor*Work_Effort"},{"type":"aux","name":"Return_on_Capital","units":"Fraction/Year","eqn":"(Asset_Earnings/Book_Value_of_Capital_Assets)"},{"type":"aux","name":"Return_on_Capital_Percent","units":"Percent/Year","eqn":"Return_on_Capital*Percent"},{"type":"aux","name":"Savings","units":"$/Year","eqn":"Savings_Fraction*Disposable_Income"},{"type":"aux","name":"Savings_Fraction","units":"Dimensionless","eqn":"Normal_Savings_Fraction*Effect_of_Wealth_on_Savings*Effect_of_Returns_on_Savings"},{"type":"aux","name":"Savings_per_Capita","units":"$/(Person*Year)","eqn":"Savings/Working_Population"},{"type":"aux","name":"Savings_Rate","units":"Percent","eqn":"Savings_Fraction*Percent"},{"type":"aux","name":"Taxes","units":"$/Year","eqn":"Income*(Tax_Rate/Percent)"},{"type":"aux","name":"Technology","units":"Goods/Year","eqn":"Initial_Technology_Productivity*Effect_of_Experience_on_Tech_Pdty*Effect_of_Investment_on_Tech_Pdty"},{"type":"aux","name":"Temporary_Shift_in_Money_Growth_Rate","units":"Fraction/Year","eqn":"(Temporary_Change_in_Money_Growth_Rate/Percent)*PULSE(Time_to_Start_Change_in_Money_Growth_Rate, Duration_of_Change_in_Money_Growth_Rate )"},{"type":"aux","name":"Total_Return_on_Capital","units":"Fraction/Year","eqn":"(Asset_Income/Book_Value_of_Capital_Assets)"},{"type":"aux","name":"Unemployed_Labor","units":"People","eqn":"MAX(0,Labor_Pool - Employed_Labor)"},{"type":"aux","name":"Unemployment_Rate","units":"Percent","eqn":"Percent*Unemployed_Labor/Labor_Pool"},{"type":"aux","name":"Vacancy_Closure","units":"People/Year","eqn":"Hiring"},{"type":"aux","name":"Vacancy_Creation","units":"People/Year","eqn":"MAX(0,Desired_Vacancy_Creation)"},{"type":"aux","name":"Wage_Income","units":"$/Year","eqn":"Employed_Labor*Wages"},{"type":"aux","name":"Wage_Ratio","units":"Dimensionless","eqn":"Wages/Indicated_Wages"},{"type":"aux","name":"Wages_Income_Ratio","units":"Dimensionless","eqn":"Wage_Income/Income"},{"type":"aux","name":"Wages_Income_Ratio_Perception","units":"Dimensionless/Year","eqn":"(Wages_Income_Ratio - Perceived_Wages_Income_Ratio)/Time_to_Perceive_Wages_Income_Ratio"},{"type":"aux","name":"Ave_Duration_of_Employment","units":"Years","eqn":"5"},{"type":