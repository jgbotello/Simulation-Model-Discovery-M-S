{"@type":"XMILEModel","modelId":"Boston_energy","sourceFile":"Boston_energy.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"365","dt":"1"},"variables":[{"type":"stock","name":"Conventional_Energy","units":"","eqn":"0","inflows":["Conventional Energy Rat"],"outflows":[]},{"type":"stock","name":"Distance_Traveled_per_Day","units":"","eqn":"32.8","inflows":[],"outflows":[]},{"type":"stock","name":"Electric_Energy","units":"","eqn":"0","inflows":["Electric Energy Rate"],"outflows":[]},{"type":"stock","name":"Food_Stored","units":"","eqn":"100000","inflows":[],"outflows":["Food Consumption per Day"]},{"type":"stock","name":"Human_Energy_Provided","units":"","eqn":"0","inflows":["Human Energy per Day"],"outflows":[]},{"type":"stock","name":"Hybrid_Energy","units":"","eqn":"0","inflows":["Hybrid Energy Rate"],"outflows":[]},{"type":"stock","name":"Number_of_people_who_drive_cars","units":"","eqn":"population * 2/6","inflows":[],"outflows":[]},{"type":"stock","name":"Number_of_People_who_use_the_MBTA_Subway","units":"","eqn":"Initial_MBTA_Users","inflows":["People who like the MBTA"],"outflows":["People who don't like the MBTA"]},{"type":"stock","name":"population","units":"","eqn":"987700","inflows":["birth rate"],"outflows":["death rate"]},{"type":"stock","name":"Total","units":"","eqn":"1","inflows":["Conventional Fraction","Electric Fraction","Hybrid Fraction"],"outflows":[]},{"type":"stock","name":"Total_Electricity","units":"","eqn":"0","inflows":["Energy from Electricity"],"outflows":[]},{"type":"stock","name":"Total_Energy","units":"","eqn":"0","inflows":["Building Energy"],"outflows":[]},{"type":"stock","name":"Total_Energy_from_Cars","units":"","eqn":"0","inflows":["conventional elec","elec elec","hybrid elec"],"outflows":[]},{"type":"stock","name":"Total_Energy_from_Oil","units":"","eqn":"0","inflows":["Energy from Oil"],"outflows":[]},{"type":"stock","name":"Total_Food_Consumed","units":"kg","eqn":"0","inflows":["Food Consumption per D