{"@type":"XMILEModel","modelId":"sociology101","sourceFile":"sociology101.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"10","dt":"0.125"},"variables":[{"type":"stock","name":"Aggressive","units":"","eqn":"100","inflows":["feralization"],"outflows":["pacification"]},{"type":"stock","name":"Passive","units":"","eqn":"100","inflows":["pacification"],"outflows":["feralization"]},{"type":"aux","name":"calming_influence","units":"","eqn":"RANDOM_NORMAL( outlook-0.05 {min} , outlook+0.05{max} , outlook {mean} , 0.005{stdev} , 1011{seed} )"},{"type":"aux","name":"feralization","units":"","eqn":"provocation*(Aggressive*Passive) + stewing*Passive"},{"type":"aux","name":"pacification","units":"","eqn":"calming_influence*(Aggressive*Passive) + coping_factor*Aggressive"},{"type":"aux","name":"coping_factor","units":"","eqn":"0"},{"type":"aux","name":"outlook","units":"","eqn":"0"},{"type":"aux","name":"provocation","units":"","eqn":"0"},{"type":"aux","name":"stewing","units":"","eqn":"0"}]}