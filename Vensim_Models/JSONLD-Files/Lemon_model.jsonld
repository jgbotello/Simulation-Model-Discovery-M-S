{"@type":"XMILEModel","modelId":"Lemon_model","sourceFile":"Lemon_model.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"365","dt":"1"},"variables":[{"type":"stock","name":"Total_Car_Quality","units":"Quality","eqn":"Normal_Quality*Initial_Cars_in_Lot","inflows":["Increase in Car Quality"],"outflows":["Decrease in Car Quality"]},{"type":"stock","name":"Used_Cars_in_Lot","units":"Cars","eqn":"Initial_Cars_in_Lot","inflows":["Cars Sold to Lot"],"outflows":["Car Bought from Lot"]},{"type":"aux","name":"Average_Car_Quality","units":"Quality/Car","eqn":"Total_Car_Quality/Used_Cars_in_Lot"},{"type":"aux","name":"Buy_Price","units":"Dollars/Car","eqn":"GAME ( Normal_Buy_Price)"},{"type":"aux","name":"Car_Bought_from_Lot","units":"Cars/Year","eqn":"Cars_Sold"},{"type":"aux","name":"Cars_Sold","units":"Cars/Year","eqn":"Normal_Cars_Sold*(Average_Car_Quality/Normal_Quality)*(Normal_Sell_Price/Sell_Price)"},{"type":"aux","name":"Cars_Sold_to_Lot","units":"Cars/Year","eqn":"0.8*50"},{"type":"aux","name":"Decrease_in_Car_Quality","units":"Quality/Year","eqn":"Average_Car_Quality*Car_Bought_from_Lot"},{"type":"aux","name":"Increase_in_Car_Quality","units":"Quality/Year","eqn":"Cars_Sold_to_Lot*Quality_Per_Car_Sold"},{"type":"aux","name":"Normal_Cars_Sold","units":"Cars/Year","eqn":"0.8*50"},{"type":"aux","name":"Normal_Sell_Price","units":"Dollars/Car","eqn":"Normal_Buy_Price*1.2"},{"type":"aux","name":"Quality_Per_Car_Sold","units":"Quality/Car","eqn":"Normal_Quality*(Buy_Price/Normal_Buy_Price)"},{"type":"aux","name":"Sell_Price","units":"Dollars/Car","eqn":"GAME ( Normal_Sell_Price)"},{"type":"aux","name":"Initial_Cars_in_Lot","units":"Cars","eqn":"2000"},{"type":"aux","name":"Normal_Buy_Price","units":"Dollars/Car","eqn":"15000"},{"type":"aux","name":"Normal_Quality","units":"Quality/Car","eqn":"1"}]}