{"@type":"XMILEModel","modelId":"BunnyComparison","sourceFile":"BunnyComparison.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"30","dt":"0.25"},"variables":[{"type":"stock","name":"bunnies","units":"","eqn":"2","inflows":["bunnification"],"outflows":[]},{"type":"stock","name":"bunnies_0","units":"","eqn":"2","inflows":["bunnification 0"],"outflows":[]},{"type":"aux","name":"bunnification","units":"","eqn":"birf_rate*bunnies*(1-bunnies/carrying_capacity)"},{"type":"aux","name":"bunnification_0","units":"","eqn":"birf_rate_0*bunnies_0 - competition*bunnies_0*(bunnies_0-1)/2"},{"type":"aux","name":"birf_rate","units":"","eqn":"0.5"},{"type":"aux","name":"birf_rate_0","units":"","eqn":"0.5"},{"type":"aux","name":"carrying_capacity","units":"","eqn":"1000"},{"type":"aux","name":"competition","units":"","eqn":"0.0002"}]}