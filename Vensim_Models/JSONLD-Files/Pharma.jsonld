{"@type":"XMILEModel","modelId":"Pharma","sourceFile":"Pharma.xmile","simSpecs":{"method":"RK4","time_units":"Hour","start":"0","stop":"48","dt":"0.25"},"variables":[{"type":"stock","name":"Medicine_in_Intestines","units":"","eqn":"0","inflows":["Intake"],"outflows":["absorption"]},{"type":"stock","name":"Plasma_Level","units":"","eqn":"0","inflows":["absorption"],"outflows":["excretion"]},{"type":"aux","name":"absorption","units":"","eqn":"Absorption_rate_constant*Medicine_in_Intestines"},{"type":"aux","name":"Dosage","units":"","eqn":"dosage_per_day/doses_per_day"},{"type":"aux","name":"Every_?_hours","units":"","eqn":"24/doses_per_day"},{"type":"aux","name":"excretion","units":"","eqn":"Excretion_rate_constant*Plasma_Level"},{"type":"aux","name":"Excretion_rate_constant","units":"","eqn":"0.693/\"Half-life\""},{"type":"aux","name":"Intake","units":"","eqn":"Dosage*PULSE_TRAIN( Start_Time {start} , TIME_STEP {duration} , \"Every_?_hours\" {repeattime} , End_Time {end} )/TIME_STEP"},{"type":"aux","name":"Medicinal_Level","units":"","eqn":"800/1"},{"type":"aux","name":"Plasma_Concentration","units":"","eqn":"Plasma_Level/Blood_Volume"},{"type":"aux","name":"Toxic_Level","units":"","eqn":"1000/1"},{"type":"aux","name":"Absorption_rate_constant","units":"","eqn":"0.25"},{"type":"aux","name":"Blood_Volume","units":"","eqn":"4.6"},{"type":"aux","name":"dosage_per_day","units":"","eqn":"6000"},{"type":"aux","name":"doses_per_day","units":"","eqn":"1"},{"type":"aux","name":"End_Time","units":"","eqn":"48"},{"type":"aux","name":"Half-life","units":"","eqn":"6"},{"type":"aux","name":"Start_Time","units":"","eqn":"0"}]}