{"@type":"XMILEModel","modelId":"AdvancedSIR","sourceFile":"AdvancedSIR.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"50","dt":"0.015625"},"variables":[{"type":"stock","name":"Infecteds","units":"","eqn":"1","inflows":["infection"],"outflows":["infecteds die","recovery"]},{"type":"stock","name":"Recovereds","units":"","eqn":"0","inflows":["recovery"],"outflows":["lose immunity","recovereds die"]},{"type":"stock","name":"Susceptibles","units":"","eqn":"999","inflows":["births","lose immunity"],"outflows":["infection","susceptibles die"]},{"type":"aux","name":"births","units":"","eqn":"birth_rate*Susceptibles"},{"type":"aux","name":"infecteds_die","units":"","eqn":"death_rate*Infecteds"},{"type":"aux","name":"infection","units":"","eqn":"infection_probability*(Susceptibles*Infecteds)"},{"type":"aux","name":"lose_immunity","units":"","eqn":"LoI_fraction*Recovereds"},{"type":"aux","name":"recovereds_die","units":"","eqn":"(0.5*death_rate)*Recovereds"},{"type":"aux","name":"recovery","units":"","eqn":"recovery_rate*Infecteds"},{"type":"aux","name":"susceptibles_die","units":"","eqn":"(0.25*death_rate)*Susceptibles"},{"type":"aux","name":"Total_Population","units":"","eqn":"Infecteds+Recovereds+Susceptibles"},{"type":"aux","name":"birth_rate","units":"","eqn":"0.159"},{"type":"aux","name":"death_rate","units":"","eqn":"0.086"},{"type":"aux","name":"infection_probability","units":"","eqn":"0.002"},{"type":"aux","name":"LoI_fraction","units":"","eqn":"0"},{"type":"aux","name":"recovery_rate","units":"","eqn":"0.1"}]}