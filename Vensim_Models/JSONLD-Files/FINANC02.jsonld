{"@type":"XMILEModel","modelId":"FINANC02","sourceFile":"FINANC02.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"5","dt":"0.015625"},"variables":[{"type":"stock","name":"Accounts_Receivable","units":"$","eqn":"billings / (1/average_payable_delay + fractional_loss_rate)","inflows":["billings"],"outflows":["cash receipts","losses"]},{"type":"stock","name":"Average_Orders","units":"Gadget/Year","eqn":"orders_received","inflows":["time to average orders"],"outflows":[]},{"type":"stock","name":"Awaiting_Billing","units":"$","eqn":"price * production * billing_processing_time","inflows":["price"],"outflows":["billings"]},{"type":"stock","name":"Backlog","units":"Gadget","eqn":"desired_backlog","inflows":["orders received"],"outflows":["production"]},{"type":"stock","name":"Book_Value","units":"$","eqn":"0","inflows":["new investment"],"outflows":["tax depreciation"]},{"type":"stock","name":"Capacity","units":"Gadget/Year","eqn":"desired_capacity","inflows":["investment"],"outflows":["reductions"]},{"type":"stock","name":"Customers","units":"Person","eqn":"initial_customers","inflows":["completions"],"outflows":[]},{"type":"stock","name":"Debt","units":"$","eqn":"0","inflows":["borrowing"],"outflows":["principal repayment"]},{"type":"stock","name":"New_Backlog","units":"Gadget","eqn":"new_orders*normal_delivery_delay","inflows":["new orders"],"outflows":["new shipments"]},{"type":"stock","name":"Potential_Customers","units":"Person","eqn":"1e+07","inflows":[],"outflows":["committals"]},{"type":"stock","name":"Product_In_Use","units":"Gadget","eqn":"Customers*product_per_customer","inflows":["new shipments","replacement shipments"],"outflows":["replacement orders"]},{"type":"stock","name":"Replacement_Backlog","units":"Gadget","eqn":"replacement_orders*normal_delivery_delay","inflows":["replacement orders"],"outflows":["replacement shipments"]},{"type":"stock","name":"Waiting_Customers","units":"Person","eqn":"New_Backlog/product_per_customer","inflows":["committals"],"outflows":["completions"]},{"type":"aux","name":"backlog_correction","units":"Gadget/Year","eqn":"(Backlog-desired_backlog)/time_to_correct_backlog"},{"type":"aux","name":"billings","units":"$/Year","eqn":"Awaiting_Billing/billing_processing_time"},{"type":"aux","name":"borrowing","units":"$/Year","eqn":"new_investment * debt_financing_fraction"},{"type":"aux","name":"capacity_adjustment","units":"Gadget/(Year*Year)","eqn":"(desired_capacity - Capacity)/time_to_adjust_capacity"},{"type":"aux","name":"cash_receipts","units":"$/Year","eqn":"Accounts_Receivable/average_payable_delay"},{"type":"aux","name":"committals","units":"Person/Year","eqn":"customer_with_non_customer_contacts * sales_fraction"},{"type":"aux","name":"completions","units":"Person/Year","eqn":"new_shipments/product_per_customer"},{"type":"aux","name":"customer_prevalence","units":"Dmnl","eqn":"Customers/total_market"},{"type":"aux","name":"customer_with_non_customer_contacts","units":"Person/Year","eqn":"non_customer_contacts * customer_prevalence"},{"type":"aux","name":"delivery_delay","units":"Year","eqn":"Backlog/production"},{"type":"aux","name":"desired_backlog","units":"Gadget","eqn":"Average_Orders* target_delivery_delay"},{"type":"aux","name":"desired_capacity","units":"Gadget/Year","eqn":"desired_production"},{"type":"aux","name":"desired_production","units":"Gadget/Year","eqn":"Average_Orders + backlog_correction"},{"type":"aux","name":"direct_costs","units":"$/Year","eqn":"production * variable_production_cost"},{"type":"aux","name":"gross_income","units":"$/Year","eqn":"billings"},{"type":"aux","name":"interest_payments","units":"$/Year","eqn":"Debt * interest_rate"},{"type":"aux","name":"investment","units":"Gadget/(Year*Year)","eqn":"capacity_adjustment + replacement_investment"},{"type":"aux","name":"losses","units":"$/Year","eqn":"Accounts_Receivable * fractional_loss_rate"},{"type":"aux","name":"net_cash_flow","units":"$/Year","eqn":"cash_receipts + borrowing - new_investment - direct_costs - interest_payments - principal_repayment - taxes"},{"type":"aux","name":"net_income","units":"$/Year","eqn":"taxable_income - taxes"},{"type":"aux","name":"new_investment","units":"$/Year","eqn":"investment * capacity_cost"},{"type":"aux","name":"new_orders","units":"Gadget/Year","eqn":"committals * product_per_customer"},{"type":"aux","name":"new_shipments","units":"Gadget/Year","eqn":"total_shipments * New_Backlog/ total_backlog"},{"type":"aux","name":"non_customer_contacts","units":"Person/Year","eqn":"Potential_Customers * contact_rate"},{"type":"aux","name":"npv_cash_flow","units":"$","eqn":"NPV(net_cash_flow,discount_rate,0,1)"},{"type":"aux","name":"npv_income","units":"$","eqn":"NPV(net_income,discount_rate,0,1)"},{"type":"aux","name":"orders_received","units":"Gadget/Year","eqn":"total_orders"},{"type":"aux","name":"potential_production","units":"Gadget/Year","eqn":"Capacity"},{"type":"aux","name":"principal_repayment","units":"$/Year","eqn":"Debt/debt_retirement_time"},{"type":"aux","name":"production","units":"Gadget/Year","eqn":"MIN(desired_production,potential_production)"},{"type":"aux","name":"reductions","units":"Gadget/(Year*Year)","eqn":"Capacity/capacity_life"},{"type":"aux","name":"replacement_investment","units":"Gadget/(Year*Year)","eqn":"reductions"},{"type":"aux","name":"replacement_orders","units":"Gadget/Year","eqn":"Product_In_Use/average_life_product"},{"type":"aux","name":"replacement_shipments","units":"Gadget/Year","eqn":"total_shipments *Replacement_Backlog/ total_backlog"},{"type":"aux","name":"tax_depreciation","units":"$/Year","eqn":"Book_Value/tax_depreciation_time"},{"type":"aux","name":"taxable_income","units":"$/Year","eqn":"gross_income - direct_costs - losses - interest_payments - tax_depreciation"},{"type":"aux","name":"taxes","units":"$/Year","eqn":"taxable_income * tax_rate"},{"type":"aux","name":"total_backlog","units":"Gadget","eqn":"New_Backlog + Replacement_Backlog"},{"type":"aux","name":"total_market","units":"Person","eqn":"ACTIVE INITIAL(Potential_Customers +Waiting_Customers + Customers, Potential_Customers)"},{"type":"aux","name":"total_orders","units":"Gadget/Year","eqn":"new_orders + replacement_orders"},{"type":"aux","name":"total_shipments","units":"Gadget/Year","eqn":"production"},{"type":"aux","name":"average_life_product","units":"Year","eqn":"2"},{"type":"aux","name":"average_payable_delay","units":"Year","eqn":"0.09"},{"type":"aux","name":"billing_processing_time","units":"Year","eqn":"0.04"},{"type":"aux","name":"capacity_cost","units":"$*Year/Gadget","eqn":"0.5"},{"type":"aux","name":"capacity_life","units":"Year","eqn":"2"},{"type":"aux","name":"contact_rate","units":"1/Year","eqn":"500"},{"type":"aux","name":"debt_financing_fraction","units":"Dmnl","eqn":"0.6"},{"type":"aux","name":"debt_retirement_time","units":"Year","eqn":"3"},{"type":"aux","name":"discount_rate","units":"1/Year","eqn":"0.12"},{"type":"aux","name":"fractional_loss_rate","units":"1/Year","eqn":"0.06"},{"type":"aux","name":"initial_customers","units":"Person","eqn":"100000"},{"type":"aux","name":"interest_rate","units":"1/Year","eqn":"0.12"},{"type":"aux","name":"normal_delivery_delay","units":"Year","eqn":"0.125"},{"type":"aux","name":"price","units":"$/Gadget","eqn":"1"},{"type":"aux","name":"product_per_customer","units":"Gadget/Person","eqn":"1"},{"type":"aux","name":"sales_fraction","units":"Dmnl","eqn":"0.005"},{"type":"aux","name":"target_delivery_delay","units":"Year","eqn":"0.125"},{"type":"aux","name":"tax_depreciation_time","units":"Year","eqn":"2"},{"type":"aux","name":"tax_rate","units":"Dmnl","eqn":"0.4"},{"type":"aux","name":"time_to_adjust_capacity","units":"Year","eqn":"1"},{"type":"aux","name":"time_to_average_orders","units":"Year","eqn":"0.25"},{"type":"aux","name":"time_to_correct_backlog","units":"Year","eqn":"0.5"},{"type":"aux","name":"variable_production_cost","units":"$/Gadget","eqn":"0.6"}]}