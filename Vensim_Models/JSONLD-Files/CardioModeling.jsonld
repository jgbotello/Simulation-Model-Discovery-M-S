{"@type":"XMILEModel","modelId":"CardioModeling","sourceFile":"CardioModeling.xmile","simSpecs":{"method":"RK4","time_units":"Second","start":"0","stop":"50","dt":"0.25"},"variables":[{"type":"stock","name":"Aorta","units":"","eqn":"100","inflows":[],"outflows":[]},{"type":"stock","name":"Body_Tissues","units":"","eqn":"5000","inflows":["Arterial Flow"],"outflows":["Venous Flow"]},{"type":"stock","name":"Heart_Ventricle","units":"","eqn":"60","inflows":[],"outflows":[]},{"type":"aux","name":"Arterial_Flow","units":"","eqn":"(Mean_Arterial_Pressure*3.14*Arterial_Radius^4)/(8*Arterial_Length*Viscosity)"},{"type":"aux","name":"Cardiac_Output","units":"Second","eqn":"PULSE_TRAIN(Heartrate,TIME_STEP , Heartrate ,1000)*Stroke_Volume/(TIME_STEP)"},{"type":"aux","name":"Mean_Arterial_Pressure","units":"","eqn":"Diastolic_Pressure+(Systolic_Pressure-Diastolic_Pressure)/3"},{"type":"aux","name":"Venous_Flow","units":"","eqn":"(Venus_Pressure*3.14*Venus_Radius^4)/(8*Venous_Length*Viscosity)"},{"type":"aux","name":"Arterial_Length","units":"","eqn":"1000"},{"type":"aux","name":"Arterial_Radius","units":"","eqn":"6.2"},{"type":"aux","name":"Diastolic_Pressure","units":"","eqn":"80"},{"type":"aux","name":"Heartrate","units":"","eqn":"5"},{"type":"aux","name":"Stroke_Volume","units":"","eqn":"70"},{"type":"aux","name":"Systolic_Pressure","units":"","eqn":"120"},{"type":"aux","name":"Venous_Length","units":"","eqn":"10"},{"type":"aux","name":"Venus_Pressure","units":"","eqn":"10"},{"type":"aux","name":"Venus_Radius","units":"","eqn":"3.45"},{"type":"aux","name":"Viscosity","units":"","eqn":"4"}]}