{UTF-8}
state=
	if then else( pc income corrected for interest payments > state 0,  
	if then else( pc income corrected for interest payments > state 1, 
	if then else( pc income corrected for interest payments > state 2,
	if then else( pc income corrected for interest payments > state 3,
	if then else( pc income corrected for interest payments > state 4,
	if then else( pc income corrected for interest payments > state 5,  
	if then else( pc income corrected for interest payments > state 6,  
	if then else( pc income corrected for interest payments > state 7, 7, 7), 6), 5), 4)\
		, 3), 2), 1), 0)
	~	
	~		|

state 0=
	-300
	~	
	~		|

state 1=
	-100
	~	
	~		|

state 2=
	100
	~	
	~		|

state 3=
	299
	~	
	~		|

change in education=
	(target education-education relative to optimum)/education investment delay
	~	dmnl/Year
	~		|

state 5=
	500
	~	
	~		|

state 6=
	700
	~	
	~		|

state 7=
	1000
	~	
	~		|

state 4=
	380
	~	
	~		|

show reset button=
	min(if then else(Time = FINAL TIME, 1, 0 ) + if then else(state = 7, 1, 0 ) , 1)
	~	
	~		|

change in health=
	(target health-health relative to optimum)/health investment delay
	~	dmnl/Year
	~		|

roads relative to optimum= INTEG (
	change in roads,
		0.3)
	~	dmnl
	~		|

education relative to optimum= INTEG (
	change in education,
		0.3)
	~	dmnl
	~		|

change in roads=
	(target roads-roads relative to optimum)/roads investment delay
	~	dmnl/Year
	~		|

health relative to optimum= INTEG (
	change in health,
		0.3)
	~	dmnl
	~		|

capital investment=
	per capita savings*effect of investment environment on capital investment*cost effectiveness of capital investment
	~	dmnl/Year
	~		|

effect of roads on investment environment=
	resources effect table(roads relative to optimum)
	~	dmnl
	~		|

pc income corrected for interest payments=
	per capita income-interest payment on debt
	~	$/Year
	~		~	:SUPPLEMENTARY 
	|

interest payment on debt=
	debt per capita*interest rate
	~	$/Year
	~		|

interest rate=
	interest rate table(debt over gdp ratio)
	~	dmnl/Year
	~		|

effect of health on investment environment=
	resources effect table(health relative to optimum)
	~	dmnl
	~		|

effect of investment environment on capital investment=
	relative investment environment^elasticity of investment to environment
	~	dmnl
	~		|

investment environment=
	(effect of education on investment environment+effect of health on investment environment\
		+effect of roads on investment environment)/3
	~	dmnl
	~		|

target roads=
	desired budget for roads*cost effectiveness of resource investments
	~	dmnl
	~		|

per capita income=
	INITIAL pc income*capital per capita^elasticity of income to capital*total factor productivity
	~	$/Year
	~		|

total desired budget per capita=
	desired budget for education+desired budget for health+desired budget for roads
	~	$/Year
	~		|

relative investment environment=
	investment environment/initial investment environment
	~	dmnl
	~		|

surplus or deficit=
	government development budget per capita-total desired budget per capita
	~	$/Year
	~	IF THEN ELSE(Time<10+TIME STEP, BUD D 0, 0)+
		IF THEN ELSE(Time>10 :AND: Time<20+TIME STEP, BUD D 10,0)+
		IF THEN ELSE(Time>20 :AND: Time<30+TIME STEP, BUD D 20,0)+
		IF THEN ELSE(Time>30 :AND: Time<40+TIME STEP, BUD D 30,0)+
		IF THEN ELSE(Time>40 , BUD D 40,0)
	|

target education=
	desired budget for education*cost effectiveness of resource investments
	~	dmnl
	~		|

target health=
	desired budget for health*cost effectiveness of resource investments
	~	dmnl
	~		|

effect of education on investment environment=
	resources effect table(education relative to optimum)
	~	dmnl
	~		|

per capita savings=
	per capita income*propensity to save
	~	$/Year
	~		|

total factor productivity=
	education relative to optimum^elasticity of productivity to education*health relative to optimum\
		^elasticity of productivity to health*roads relative to optimum^elasticity of productivity to roads
	~	dmnl
	~		|

desired budget for roads= GAME (
	30)
	~	$/Year
	~		|

desired budget for health= GAME (
	30)
	~	$/Year
	~		|

desired budget for education= GAME (
	30)
	~	$/Year
	~		|

borrowing=
	if then else(surplus or deficit<0, -surplus or deficit,0)
	~	$/Year
	~		|

cost effectiveness of capital investment=
	0.001
	~	dmnl/$
	~		|

cost effectiveness of resource investments=
	0.01
	~	Year/$
	~		|

debt per capita= INTEG (
	borrowing-paying back,
		0)
	~	$
	~		|

debt over gdp ratio=
	debt per capita/per capita income
	~	Year
	~		|

elasticity of productivity to education=
	0.275
	~	dmnl
	~		|

education investment delay=
	15
	~	Year
	~		|

elasticity of investment to environment=
	3
	~	dmnl
	~		|

government development budget per capita=
	per capita income*tax rate-interest payment on debt
	~	$/Year
	~		|

elasticity of productivity to health=
	0.225
	~	dmnl
	~		|

health investment delay=
	7
	~	Year
	~		|

initial investment environment= INITIAL(
	investment environment)
	~	dmnl
	~		|

initial capital per capita=
	0.3
	~	dmnl
	~		|

INITIAL pc income=
	1000
	~	$/Year
	~		|

interest rate table(
	[(0,0)-(5,0.3)],(0,0.01),(0.5,0.01),(1,0.025),(2,0.085),(3,0.125),(4,0.15))
	~	dmnl/Year
	~		|

capital per capita= INTEG (
	capital investment-capital depreciation,
		initial capital per capita)
	~	dmnl
	~		|

capital depreciation=
	capital per capita/capital depreciation time
	~	dmnl/Year
	~		|

capital depreciation time=
	25
	~	Year
	~		|

elasticity of income to capital=
	0.3
	~	dmnl
	~		|

paying back=
	if then else(surplus or deficit>0 :AND: debt per capita>0, surplus or deficit,0)
	~	$/Year
	~		|

propensity to save=
	0.04
	~	dmnl
	~		|

elasticity of productivity to roads=
	0.2
	~	dmnl
	~		|

roads investment delay=
	3
	~	Year
	~		|

resources effect table(
	[(0,0)-(1,1)],(0.15,0),(0.3,0.6),(0.33,0.7),(0.36,0.75),(0.4,0.8),(0.449541,0.842105\
		),(0.501529,0.885965),(0.565749,0.921053),(0.629969,0.947368),(0.685015,0.964912),(\
		0.749235,0.97807),(1,1))
	~	dmnl
	~		|

tax rate=
	0.3
	~	dmnl
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2060
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2010
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Year [0,?]
	~	The time step for the simulation.
	|

