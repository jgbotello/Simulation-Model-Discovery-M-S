{UTF-8}
Average Goat Lifespan= GAME (
	10)
	~	
	~		|

Grass Deaths=
	Min(Goats*Grass Eaten per Goat + Grass per Goat Birth*Goat Births,Grass)
	~	
	~		|

Goats Deaths=
	Max(Goats/Average Goat Lifespan, (Goats - Grass/Grass Eaten per Goat)/2)
	~	
	~		|

Goat Births=
	Grass/Grass per Goat Birth
	~	
	~		|

Goats= INTEG (
	Goat Births-Goats Deaths,
		Initial Goats)
	~	
	~		|

Grass= INTEG (
	Grass Growth-Grass Deaths,
		Initial Grass)
	~	
	~		|

Grass Eaten per Goat= GAME (
	100)
	~	
	~		|

Grass Growth=
	Grass*Grass Growth Rate
	~	
	~		|

Grass Growth Rate= GAME (
	0.1)
	~	
	~		|

Grass per Goat Birth= GAME (
	15000)
	~	
	~		|

Initial Goats=
	100
	~	
	~		|

Initial Grass=
	100000
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.5
	~	Year [0,?]
	~	The time step for the simulation.
	|

