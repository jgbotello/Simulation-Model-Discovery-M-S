{UTF-8}
Accum Capital Productivity= INTEG (
	incr accum capital productivity-decr accum capital productivity,
		5972)
	~	
	~		|

Depreciable Assets Completed= INTEG (
	depreciable asset completion-depreciation,
		813)
	~	
	~		|

effect rgdp growth=
	if then else(Time > 25,0,smooth(rdgp exponent*(0),rgdp smooth time))
	~	
	~		|

av life asset=
	9
	~	
	~		|

Financial Assets= INTEG (
	incr financial assets-decr financial assets,
		0)
	~	
	~		|

depreciation=
	DELAY3I(depreciable asset completion, av life asset, Depreciable Assets Completed/av life asset\
		 )
	~	
	~		|

cogs pct=
	0.34
	~	
	~		|

rental expense pct=
	0.0241
	~	
	~		|

sga pct=
	0.3697
	~	
	~		|

expected return=
	smooth3I(expected cash flow-1/av life asset,expected ROI smooth time,0.11)
	~	
	~		|

expected capital productivity=
	marginal capital productivity
	~	
	~		|

investment coverage=
	depreciable asset completion/baseline investment coverage
	~	
	~		|

Depreciable Assets in Process= INTEG (
	depreciable asset starts-depreciable asset completion,
		initial depreciable assets in process)
	~	
	~		|

incr capital improvement=
	depreciable asset completion*potential improvement per unit*marginal capital productivity
	~	
	~		|

cash flow=
	gross cash flow-depreciable asset completion-RD
	~	
	~		|

incr accum capital productivity=
	depreciable asset completion*marginal capital productivity+Accum Capital Productivity
	*av potential improvement*capital productivity adjust
	~	
	~		|

RD in Process= INTEG (
	RD starts-incr RD capital,
		initial rd pipeline)
	~	
	~		|

initial cume Investment=
	30000
	~	
	~		|

initial depreciable assets in process=
	2036
	~	
	~		|

cume Investment= INTEG (
	depreciable asset starts,
		initial cume Investment)
	~	
	~		|

decr accum capital productivity=
	depreciation*av capital productivity
	~	
	~		|

baseline investment coverage=
	1000
	~	
	~		|

decr potential capital improvement=
	depreciation*av potential improvement+Accum Capital Productivity*av potential improvement\
		*capital productivity adjust
	~	
	~		|

initial rd pipeline=
	1447
	~	
	~		|

depletion effect=
	(cume Investment/initial cume Investment)^depletion effect exponent
	~	
	~		|

effect RD capital productivity=
	(RD Capital/initial RD capital)^rd exponent
	~	
	~		|

initial RD capital=
	217
	~	
	~		|

depreciable asset starts=
	(max(gross cash flow,0)*ploughback fraction)*effect cap prod plough back
	~	
	~		|

depreciable assets=
	Depreciable Assets Completed
	~	
	~		|

marginal capital productivity=
	(base capital productivity*effect RD capital productivity*depletion effect*exp(investment coverage
	*capital productivity exponent))
	~	
	~		|

rd exponent=
	0.4706
	~	
	~		|

depletion effect exponent=
	-7.479
	~	
	~		|

rgdp smooth time=
	1
	~	
	~		|

Potential Capital Improvement= INTEG (
	incr capital improvement-decr potential capital improvement,
		Depreciable Assets Completed*initial potential capital improvement*capital productivity\
		)
	~	
	~		|

incr RD capital=
	DELAY3(RD starts, RD completion time)
	~	
	~		|

sales growth smoothed=
	smooth(sales growth,5)
	~	
	~		|

RD Capital= INTEG (
	incr RD capital-rd depreciation,
		initial RD capital)
	~	
	~		|

Cume RD= INTEG (
	rd depreciation,
		0)
	~	
	~		|

RD=
	gross cash flow*rd pct
	~	
	~		|

rd pct=
	0.2698
	~	
	~		|

frac cf to stock repurch=
	0.2
	~	
	~		|

frac cf to dividend=
	0.2
	~	
	~		|

decr fa from stock repurchase=
	gross cash flow*frac cf to stock repurch
	~	
	~		|

decr fa dividends=
	gross cash flow*frac cf to dividend
	~	
	~		|

decr financial assets=
	depreciable asset starts+decr fa dividends+decr fa from stock repurchase
	~	
	~		|

incr fa from new debt=
	0
	~	
	~		|

incr financial assets=
	gross cash flow+incr fa from stock sales+incr fa from new debt
	~	
	~		|

incr fa from stock sales=
	0
	~	
	~		|

ploughback fraction=
	0.039
	~	
	~		|

effect cap prod plough back=
	2*exp(100*(expected return-0.1)*ploughback exponent)/(1+exp(100*(expected return-0.1\
		)*ploughback exponent))
	~	
	~		|

expected reurn scaled=
	expected return*100
	~	
	~		|

rd depreciation=
	DELAY3(incr RD capital, rd life)
	~	
	~		|

capital productivity=
	av capital productivity+effect rgdp growth
	~	
	~		|

expected cash flow=
	expected capital productivity*(1-expected cogs-expected sga pct)
	~	
	~		|

net cash flow=
	incr financial assets-decr financial assets
	~	
	~		|

rental expense=
	sales*rental expense pct
	~	
	~		|

gross cash flow=
	operating profit-rental expense
	~	
	~		|

av sales= INTEG (
	(sales-av sales)/1,
		sales)
	~	
	~		|

sales growth=
	(sales-av sales)/av sales
	~	
	~		|

RD starts=
	RD
	~	
	~		|

Depreciable Assets in Process driving=
	2000
	~	
	~		|

