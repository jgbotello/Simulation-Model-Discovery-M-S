RD completion time=
	3.638
	~	
	~		|

av capital productivity=
	Accum Capital Productivity/Depreciable Assets Completed
	~	
	~		|

capital productivity exponent=
	-1.176
	~	
	~		|

potential improvement per unit=
	12.92
	~	
	~		|

expected cogs=
	cogs pct
	~	
	~		|

expected ROI smooth time=
	2
	~	
	~		|

expected sga pct=
	sga pct
	~	
	~		|

depreciable asset completion=
	Depreciable Assets in Process/investment completion time
	~	
	~		|

gross profit=
	sales*(1-cogs pct)
	~	
	~		|

initial potential investment2=
	5
	~	
