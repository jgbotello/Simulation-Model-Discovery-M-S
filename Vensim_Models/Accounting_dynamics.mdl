	2000
	~	
	~		|

Potential Capital driving=
	2000
	~	
	~		|

RD driving=
	0.3
	~	
	~		|

sales=
	Depreciable Assets Completed*capital productivity
	~	
	~		|

initial potential capital improvement=
	0.413
	~	
	~		|

capital productivity adjust=
	0.2
	~	
	~		|

av potential improvement=
	zidz(Potential Capital Improvement,Depreciable Assets Completed)
	~	
	~		|

initil gross investment completed= INITIAL(
	Depreciable Assets Completed)
	~	
	~		|

rdgp exponent=
	0
	~	
