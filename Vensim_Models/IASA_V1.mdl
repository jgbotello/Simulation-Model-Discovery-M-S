{UTF-8}
AC = WITH LOOKUP (
	vAC,
		([(0,0)-(5,0.1)],(0,0),(1,0.01) ))
	~	
	~	ACCESO A CREDITOS: Se refiere a si el productor ha tenido en los ultimos 3 \
		años acceso a un credito para la agricultura. Donde 0=no y 1 =si.
	|

AS = WITH LOOKUP (
	vAS,
		([(0,0)-(10,0.1)],(0,0.03),(1,0.02),(2,0.01),(3,0) ))
	~	 [0,0.03]
	~	PROGRAMAS DE ASISTENCIA SOCIAL: Se refiere a los programas de asistencia \
		social que se tienen en la familia agricola.\!\!
	|

CA = WITH LOOKUP (
	vCA+Efecto de CC,
		([(0,0)-(5,1)],(0,0),(1,0.02),(2,0.04),(3,0.06),(4,0.08) ))
	~	puntos
	~	CONSERVACION DE AGUA: Se refiere a la cantidad de prácticas que realiza el \
		productor en el agroecosistema para conservar agua, ya sea para cultivos o \
		animales.
	|

RP = WITH LOOKUP (
	vRP,
		([(0,0)-(20,0.1)],(0,0.04),(1,0.03),(2,0.03),(3,0.03),(4,0.02),(5,0.02),(6,0.02),(7\
		,0.01),(8,0.01),(9,0.01),(10,0),(11,0),(12,0) ))
	~	 [0,0.04]
	~	RENTA DE PASTO: Se refiere a los meses del año que se renta pasto para el \
		ganado del agroecosistema.
	|

CC = WITH LOOKUP (
	vCC,
		([(0,0)-(4,0.1)],(0,0),(1,0.01),(2,0.02),(3,0.03),(4,0.04) ))
	~	 [0,0.03]
	~	CURSOS DE CAPACITACIÓN: Número de cursos de capacitacion a los que ha \
		asistido el productor. Donde: 0=0cursos, 1=1curso, 2=2cursos y 3 =mas de 2 \
		cursos.\!\!\!
	|

CCFC2=
	CC+FC 2
	~	
	~		|

CS = WITH LOOKUP (
	vCS+Efecto de CC,
		([(0,0)-(5,0.08)],(0,0),(1,0.02),(2,0.04),(3,0.06),(4,0.08) ))
	~	puntos
	~	CONSERVACION DE SUELO: Se refiere a la cantidad de prácticas que realiza \
		el productor para la conservación y recuperación del suelo en el \
		agroecosistema. Donde: 0= 0practicas realizadas, 1=1pc y 2 =2pc.
	|

DC = WITH LOOKUP (
	vDC,
		([(0,0)-(6,0.03)],(0,0),(1,0.01),(2,0.02),(3,0.03),(4,0.03),(5,0.03) ))
	~	puntos
	~	DIVERSIDAD DE CULTIVOS: Número de cultivos diferentes que se manejan \
		dentro del agroecosistema.
	|

DCH = WITH LOOKUP (
	vDCH,
		([(0,0)-(2,0.1)],(0,0),(1,0.05) ))
	~	 [0,0.05]
	~	DESEOS DE LOS HEREDEROS DE CONTINUAR CON LA AGRICULTURA: se refiere a los \
		deseos de los herederos de las tierras, de continuar trabajando en el \
		agroecosistema. Donde: 0=no y 1=si.
	|

DCP = WITH LOOKUP (
	vDCP,
		([(0,0)-(2,0.1)],(0,0),(1,0.03) ))
	~	 [0,0.03]
	~	DESEOS DEL PRODUCTOR DE CONTINUAR CON LA AGRICULTURA: Se refiere a si el \
		productor tiene deseos de continnuar con la agricultura. Donde 0=no y 1=si.
	|

DG = WITH LOOKUP (
	vDG,
		([(0,0)-(6,0.03)],(0,0),(1,0.01),(2,0.02),(3,0.03),(4,0.03),(5,0.03) ))
	~	puntos [0,3]
	~	DIVERSIDAD GANADERA: Se refiere a cuantas especies diferentes de ganado \
		maneja el productor dentro del agroecosistema.
	|

vCA=
	1
	~	
	~		|

vCC=
	3
	~	
	~		|

vCS=
	1
	~	
	~		|

EE = WITH LOOKUP (
	vEE,
		([(0,0)-(3,0.1)],(0,0),(1,0.02),(2,0.04) ))
	~	 [0,0.04]
	~	EMPLEO EXTRAFINCA: Nos dice si el responsable del agroecosistema o algun \
		otro familiar renta su mano de obra. Donde: 0=no, 1=no pero recibe divisas \
		de algun familiar aue ya no vive con el, 2=si.
	|

vDCH=
	1
	~	
	~		|

EG = WITH LOOKUP (
	vEG,
		([(0,0)-(2,0.1)],(0,0),(1,0.04) ))
	~	 [0,0.04]
	~	FAMILIARES CON ENFERMEDADES GRAVES: Se refiere a la presencia de alguna \
		enfermedad grave en algun familiar que represente gastos elevados y \
		permanantes para su cuidado, así como tiempo, lo que pudiera limitar el \
		tiempo dedicado a la atencion del agroecosistema. Donde: 0=precencia de \
		enfermedad y 1=familiares saludables.
	|

EIA = WITH LOOKUP (
	vEIA,
		([(0,0)-(20,0.1)],(0,0),(1,0),(2,0.01),(3,0.01),(4,0.02),(5,0.02),(6,0.03),(7,0.03)\
		,(8,0.03),(9,0.04),(10,0.04),(11,0.04),(12,0.04) ))
	~	
	~	ESTACIONALIDAD DEL INGRESO AGRICOLA: Meses del año que se cuenta con \
		ingresos económicos por la venta de productos del agroecosistema.
	|

EM = WITH LOOKUP (
	vEM,
		([(0,0)-(20,0.1)],(0,0),(1,0.01),(2,0.01),(3,0.01),(4,0.01),(5,0.01),(6,0.01),(7,0.02\
		),(8,0.02),(9,0.02),(10,0.03),(11
		,0.03),(12,0.03),(13,0.04),(14,0.04),(15,0.04),(16,0.04),(17,0.04),(18,0.05) ))
	~	 [0,0.04]
	~	ESCOLARIDAD MÁXIMA EN EL AGROECOSISTEMA: Se refiere al maximo años de \
		estudio en alguno de los familiares.
	|

vEG=
	0
	~	
	~		|

ER=
	vER+"Increm. Edad"
	~	 [20,90]
	~	EDAD DEL RESPONSABLE: En años
	|

vEM=
	6
	~	
	~		|

ES = WITH LOOKUP (
	vES,
		([(0,0)-(5,0.1)],(0,0),(1,0),(2,0.02),(3,0.03),(4,0.04) ))
	~	puntos
	~	EROSION DE SUELO: se refiere al grado de erosion del suelo en un  ciclo \
		agricola (2009). Donde: 0=presencia de carcabas, 1= presencia de escalones \
		consolidados de erosion, 2=escalones incipientes de erosión, 3=erosion \
		laminar y 4=Sin erosion. más FC
	|

ESFC=
	ES+FC
	~	
	~		|

EsR = WITH LOOKUP (
	vEsR,
		([(0,0)-(10,0.1)],(0,0),(1,0.01),(2,0.01),(3,0.01),(4,0.01),(5,0.01),(6,0.01),(7,0.02\
		),(8,0.02),(9,0.02) ))
	~	 [0,0.02]
	~	ESCOLARIDAD DEL RESPONSABLE: Se refiere a los años de estudio del \
		responsable del agroecosistema.\!\!
	|

F = WITH LOOKUP (
	vF,
		([(0,0)-(5,0.1)],(0,0),(1,0.01),(2,0.02),(3,0.03) ))
	~	puntos
	~	USO DE FERTILIZANTES: Se refiere al tipo de fertilizante usado en el \
		agroecosistema: quimico, organico o mixto. Donde 0=ningun fertilizante, \
		1=quimico, 2=organico y 3=mixta.
	|

vGS=
	1
	~	
	~		|

vNIA=
	3
	~	
	~		|

vOP=
	2
	~	
	~		|

GS = WITH LOOKUP (
	vGS,
		([(0,0)-(2,0.1)],(0,0),(1,0.03) ))
	~	 [0,0.03]
	~	GRADO DE SATISFACCIÓN POR TRABAJAR EN AGRICULTURA: Se refiere a si esta o \
		no contento el productor con lo que ha logrado hacer y como ha subsistido \
		por  trabajar sus tierras agricolas. Donde: 0=no y 1=si
	|

"I. S. A."=
	CA+CS+DC+DG+ESFC+F+P+TP+UAG
	~	
	~	Indice de sustentabilidad ambiental (indice primario), dentros del indice \
		agregado de sustentabilidad.
	|

"I. S. E."=
	EE+EIA+NIA+PC+PG+RP+SAFC0
	~	
	~	Índice de Sustentabilidad Economica del Agroecosistema.
	|

vPP=
	1
	~	
	~		|

"I. S. S."=
	AC+AS+CCFC2+OP+VP
	~	
	~	Índice de Sustentabilidad Social del Agroecosistema
	|

vSA=
	1
	~	
	~		|

vSB=
	3
	~	
	~		|

NIA = WITH LOOKUP (
	vNIA+eCS+eCA,
		([(0,0)-(5,0.1)],(0,0),(1,0.01),(2,0.02),(3,0.03) ))
	~	
	~	NIVEL DE INGRESOS POR AGRICULTURA: Salarios minimos por agricultura. \
		donde: 0=menos de 1 salario minimo, 1=1 s.m, 2=2 s.m. y 3=a mas  de 2 s.m.
	|

OP = WITH LOOKUP (
	vOP,
		([(0,0)-(5,0.1)],(0,0),(1,0.02),(2,0.04) ))
	~	 [0,0.04]
	~	ORGANIZACION CON OTROS PRODUCTORES: Se refiere a si el productor esta o \
		estuvo en alguna organizacion de productores formal o informal. Donde: \
		0=no, 1=pertenecio pero no más y 2=si.
	|

P = WITH LOOKUP (
	vPP,
		([(0,0)-(5,1)],(0,0),(1,0.01),(2,0.02),(3,0.03) ))
	~	cantidad
	~	USO DE PLAGUICIDAS EN CULTIVOS: Se refiere a la intensidad de uso de \
		pesticidas en cultivos, con referencia a las indicaciones del producto. \
		Donde: 0=ninguno, 1=alto, 2=medio y 3=bajo.
	|

PC = WITH LOOKUP (
	vPC+ ePC,
		([(0,0)-(3,0.1)],(0,0),(1,0.01),(2,0.02) ))
	~	 [0,0.02]
	~	PERDIDAS EN CULTIVOS: Se refiere a la proporcion de la produccion de los \
		cultivos que se estima se pierde por diferentes factores. Donde:   0=mas \
		de 25%, 1=de 15 a 25% y 2=de 5 a 15%.\!\!
	|

PG = WITH LOOKUP (
	vPG,
		([(0,0)-(3,0.1)],(0,0),(1,0.01),(2,0.02) ))
	~	 [0,0.02]
	~	PERDIDAS EN GANADERIA: Se refiere a la proporcion de la produccion \
		ganadera que se estima se pierde por diferentes factores. Donde: 0=mas de \
		25%, 1=de 15 a 25% y 2=de 5 a 15%.\!\!
	|

vPC=
	2
	~	
	~		|

vER=
	75
	~	
	~		|

SA = WITH LOOKUP (
	vSA,
		([(0,0)-(5,0.1)],(0,0),(1,0.01),(2,0.02),(3,0.03),(4,0.04) ))
	~	cantidad [0,6]
	~	SEGURIDAD ALIMENTARIA: Se refiere a la proporción de los alimentos \
		consumidos que se producen dentro del agroecosistema. Donde: 0=menos de \
		20% , 1= del 21 al 40%, 2=del 41 al 60%, 3=del 61 al 80% y 4= más del \
		80%.\!\!\!
	|

SAFC0=
	SA+FC0
	~	
	~		|

SB = WITH LOOKUP (
	vSB,
		([(0,0)-(5,0.1)],(0,0),(1,0.01),(2,0.02),(3,0.03),(4,0.04) ))
	~	 [0,0.04]
	~	ACCESO A SERVICIOS BASICOS: Se refiere al acceso a servicios basicos para \
		la vida digna, como salud, educacion, agua potable, seguridad, \
		esparcimiento, libertad, etc.
	|

TP = WITH LOOKUP (
	vTP,
		([(0,0)-(4,0.1)],(0,0),(1,0.01),(2,0.02),(3,0.03),(4,0.04) ))
	~	puntos
	~	TIPO DE POTREROS: Se refiere al tipo de vegetacion y cobertura de los \
		potreros donde pastorea el ganado del agroecosistema. Donde: 0=baja \
		cobertura de herbaceas nativas, 1=gramanativa, 2=pasto mejorado, \
		3=silvopastoreo, y 4=agrosilvopastoril.\!\!
	|

UAG = WITH LOOKUP (
	vUAG,
		([(0,0)-(4,0.1)],(0,0),(1,0.01),(2,0.02) ))
	~	puntos
	~	USO DE AGROQUIMICOS EN GANADERIA: Se refiere al uso de agroquímicos \
		diversos directamente sobre el ganado. Donde:0=alto, 1=medio y 2=bajo.
	|

vAC=
	1
	~	
	~		|

vAS=
	3
	~	
	~		|

vEIA=
	10
	~	
	~		|

vPG=
	1
	~	
	~		|

vDG=
	1
	~	
	~		|

vDC=
	0
	~	
	~		|

vEsR=
	5
	~	
	~		|

vDCP=
	1
	~	
	~		|

vF=
	3
	~	
	~		|

vEE=
	2
	~	
	~		|

vVP=
	2
	~	
	~		|

VP = WITH LOOKUP (
	vVP,
		([(0,0)-(5,0.1)],(0,0),(1,0.02),(2,0.03) ))
	~	 [0,0.03]
	~	VENTA DE PRODUCTOS AGRICOLAS: Se refiere a quie vende los productor del \
		agroecosistema. Donde: 0=no vende, 1=intermediario y 2=al consumidor.
	|

vES=
	3
	~	
	~		|

vRP=
	0
	~	
	~		|

vTP=
	3
	~	
	~		|

vUAG=
	0
	~	
	~		|

Cambio de responsable=
	IF THEN ELSE(DCH=0.05:AND:ER>=80,0.05, 0 )
	~	
	~		|

eCA=
	CA+Efecto de CC
	~	
	~	Efecto de la Conservación de Agua sobre el Ingreso Agrícola
	|

ECR=
	IF THEN ELSE(Cambio de responsable>0.001,(Cambio de responsable-Ram),0)
	~	
	~	EFECTO DEL CAMBIO DE RESPONSABLE: Asumiendo que pasa a ser responsable \
		alguien más joven. Esta en funcion a la edad del nuevo responsable.
	|

eCS=
	CS+Efecto de CC
	~	
	~	Efecto de la Conservación de Suelo sobre el Ingreso Agrícola
	|

Efecto de CC=
	IF THEN ELSE(CC>=0.02, RAMP(0.004,1 , 100) , 0 )
	~	
	~		|

ePC=
	IF THEN ELSE(CA>=0.02:AND:CS>=0.02, RAMP(0.004,1 , 100) , 0)
	~	
	~	EFECTO DE PRACTICAS DE CONSERVACION SOBRE PERDIDA DE CULTIVOS
	|

ERV = WITH LOOKUP (
	ER,
		([(30,0)-(200,0.1)],(30,0.05),(31,0.05),(32,0.05),(33,0.05),(34,0.05),(35,0.05),(36\
		,0.05),(37,0.05),(38,0.05),(39,0.05),(40,0.05),(41,0.04),(42,0.04),(43,0.04),(44,0.04\
		),(45,0.04),(46,0.04),(47,0.04),(48,0.04),(49,0.04),(50,0.04),(51,0.03),(52,0.03),(\
		53,0.03),(54,0.03),(55,0.03),(56,0.03),(57,0.03),(58,0.03),(59,0.03),(60,0.03),(61,\
		0.02),(62,0.02),(63,0.02),(64,0.02),(65,0.02),(66,0.02),(67,0.02),(68,0.02),(69,0.02\
		),(70,0.02),(71,0.01),(71,0.01),(72,0.01),(73,0.01),(74,0.01),(75,0.01),(76,0.01),(\
		77,0.01),(78,0.01),(79,0.01),(80,0.01),(81,0),(82,0),(83,0),(84,0),(85,0),(86,0),(87\
		,0),(88,0),(89,0),(90,0),(91,0),(91,0),(93,0),(94,0),(95,0),(96,0),(97,0),(98,0),(99\
		,0),(100,0),(101,0),(102,0),(103,0),(104,0),(105,0
		),(106,0),(107,0),(108,0),(109,0),(110,0),(111,0),(112,0),(113,0) ))
	~	
	~		|

FC=
	0.01
	~	puntos
	~	FACTOR DE CORRECCIÓN DE EROSION DE SUELO: Donde: segun los resultados de \
		campo, los valores de los factores de correccion de la erosion de la \
		variable Erosion del suelo: Erosion activa: -0.01; Erosion estabilizada: \
		0.00; y Recuperacin de suelos: +0.01.
	|

FC 2=
	0.01
	~	 [0,0.01]
	~	FACTOR DE CORRECCION DE CURSOS DE CAPACITACIÓN: Valores de los factores de \
		correccion de la variable Asistencia a Cursos de Capacitacion: Asistio un \
		familiar que no toma decisiones: -0.01; Asistio un responsable; Asistio el \
		responsable y un familiar joven +0.01
	|

FC0=
	0.01
	~	
	~	FACTOR DE CORRECCIÓN DE SEGURIDAD ALIMENTARIA: Valores de los factores de \
		correccion de la variable Seguridad Alimentaria: Baja (relacion p/c \
		inferior a 0.33) : -0.01; Media (relacion p/c entre 0.33 y 0.66): 0.00; y \
		: Alta (relacion p/c mayor de 0.66): +0.01
	|

"I. S. H."=
	DCH+DCP+EG+EM+ERV+EsR+GS+SB+ECR
	~	 [0,0.3]
	~	Índice de Sustentabilidad Humana del Agroecosistema
	|

IASA=
	IF THEN ELSE(ER>=81:AND:DCH=0, 0 , "I. S. A."+"I. S. E."+"I. S. H."+"I. S. S." +ECR)
	~	
	~	Indice de Sustentabilidad Agricola del Agroecosistema, que nos da el grado \
		de suetentabilidad del agroecosistema, resultado de la adicion de los \
		indices Ambiental, Económico, Social y Humano.
	|

"Increm. Edad"=
	RAMP(1,1,100)
	~	
	~		|

Ram=
	RAMP(0.001,12,100)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

