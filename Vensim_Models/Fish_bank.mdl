{UTF-8}
annual profits=
	revenues-costs
	~	$/Year
	~		|

AREA=
	100
	~	miles*miles
	~		|

CARRYING CAPACITY=
	1200
	~	fish
	~		|

catch per ship=
	EFFECT OF DENSITY ON CATCH PER SHIP(density/NORMAL DENSITY)
	~	fish/ship/Year
	~		|

costs=
	Ships*UNIT SHIP OPERATING COST
	~	$/Year
	~		|

death fraction=
	EFFECT OF FISH AND CARRYING CAPACITY ON DEATH FRACTION(Fish/CARRYING CAPACITY)
	~	1/Year
	~		|

density=
	Fish/AREA
	~	fish/(miles*miles)
	~		|

EFFECT OF DENSITY ON CATCH PER SHIP(
	[(0,0)-(12,26)],(0,0),(1,5),(2,10.38),(3,15.88),(4,20.25),(5,22.13),(6,23.25),(7,23.75\
		),(8,24.25),(9,24.63),(10,25),(11,25.35),(12,25.48))
	~	fish/ship/Year
	~		|

EFFECT OF FISH AND CARRYING CAPACITY ON DEATH FRACTION(
	[(0,4)-(1,8)],(0,5.22),(0.1,5.225),(0.2,5.23),(0.3,5.24),(0.4,5.255),(0.5,5.29),(0.6\
		,5.345),(0.7,5.45),(0.8,5.665),(0.9,5.94),(1,6))
	~	1/Year
	~		|

Fish= INTEG (
	fish hatch rate-fish death rate-total catch per year,
		INTIAL FISH)
	~	fish
	~		|

fish death rate=
	death fraction*Fish
	~	fish/Year
	~		|

fish hatch rate=
	Fish*HATCH FRACTION
	~	fish/Year
	~		|

FISH PRICE= GAME (
	20)
	~	$/fish
	~		|

FRACTION INVESTED= GAME (
	0.2)
	~	Dmnl
	~		|

HATCH FRACTION=
	6
	~	1/Year
	~		|

INITIAL SHIPS=
	10
	~	ship
	~		|

INITIAL TOTAL PROFITS=
	0
	~	
	~		|

INTIAL FISH=
	1000
	~	
	~		|

NORMAL DENSITY=
	1
	~	fish/(miles*miles)
	~		|

revenues=
	FISH PRICE*total catch per year
	~	$/Year
	~		|

ship building rate=
	MAX(0,annual profits*FRACTION INVESTED/SHIP COST)
	~	ship/Year
	~		|

SHIP COST= GAME (
	300)
	~	$/ship
	~		|

Ships= INTEG (
	ship building rate,
		INITIAL SHIPS)
	~	ship
	~		|

total catch per year=
	Ships*catch per ship
	~	fish/Year
	~		|

Total Profits= INTEG (
	annual profits,
		INITIAL TOTAL PROFITS)
	~	$
	~		|

UNIT SHIP OPERATING COST= GAME (
	250)
	~	$/ship/Year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2025
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2010
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Year [0,?]
	~	The time step for the simulation.
	|

