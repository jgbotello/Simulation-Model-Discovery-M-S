{UTF-8}
Potential Sales Opportunities= INTEG (
	new opportunity due to innovation-premature outflow-sales,
		INI)
	~	Selling acts
	~		|

BETA=
	0.04+ShortTermFix*STEP(0.01, 61)-ShortTermFix*STEP(0.01, 90)
	~	Dmnl
	~		|

ISSUEOUTFLOW=
	3
	~	Selling acts/Month
	~		|

premature outflow=
	ButtonMaturity*STEP(MIN(ISSUEOUTFLOW,Potential Sales Opportunities), 60)+ButtonDecline\
		*STEP(MIN(ISSUEOUTFLOW,Potential Sales Opportunities), 90)
	~	Selling acts/Month
	~		|

profit per period=
	sales*PRODUCT PRICE-IF THEN ELSE(Time>=60 :AND: Time<=90, ShortTermFix*CostShortTermFix\
		, 0)-IF THEN ELSE(Time>=90, LongTermFix*CostLongTermFix, 0)
	~	Euro/Month
	~		|

new opportunity due to innovation=
	IF THEN ELSE(LongTermFix :AND: Time>102, INNOVATION BOOST, 0)
	~	Selling acts/Month
	~		|

ALPHA=
	0.001-ButtonGrowth*STEP(0.0005, 30)+ButtonGrowth*STEP(0.0005, 54)
	~	Dmnl
	~		|

ButtonDecline=
	0
	~	Dmnl
	~		|

ButtonGrowth=
	0
	~	Dmnl
	~		|

ButtonMaturity=
	0
	~	Dmnl
	~		|

CostLongTermFix=
	42
	~	Euro
	~		|

CostShortTermFix=
	32
	~	Euro
	~		|

ShortTermFix=
	0
	~	Dmnl
	~		|

INNOVATION BOOST=
	20
	~	Selling acts/Month
	~		|

LongTermFix=
	0
	~	Dmnl
	~		|

PRODUCT PRICE=
	10
	~	Euro/Selling acts
	~		|

REPORTING TIME=
	1
	~	1/Month
	~		|

sales=
	(ALPHA*Potential Sales Opportunities+(BETA/INI)*Potential Sales Opportunities*Total Sales\
		)*REPORTING TIME
	~	Selling acts/Month
	~		|

Total Profit= INTEG (
	profit per period,
		0)
	~	Euro
	~		~	:SUPPLEMENTARY 
	|

INI=
	1000
	~	Selling acts
	~		|

Total Sales= INTEG (
	sales,
		0)
	~	Selling acts
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Paramaters
	|

FINAL TIME  = 120
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
