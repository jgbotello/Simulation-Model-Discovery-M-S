{"backgroundInformation":"You've just been elected as Prime Minister of Blendia for the next 50 years! Blendia is an imaginary island located off the western cost of Africa. Your job is to help promote the sustainable growth of its economy by minimizing debt and interest payments.","@type":"XMILEModel","modelId":"National_development_game","sourceFile":"National_development_game.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"2010","stop":"2060","dt":"0.0625"},"variables":[{"type":"stock","name":"capital_per_capita","units":"dmnl","eqn":"initial_capital_per_capita","inflows":["capital investment"],"outflows":["capital depreciation"]},{"type":"stock","name":"debt_per_capita","units":"$","eqn":"0","inflows":["borrowing"],"outflows":["paying back"]},{"type":"stock","name":"education_relative_to_optimum","units":"dmnl","eqn":"0.3","inflows":["change in education"],"outflows":[]},{"type":"stock","name":"health_relative_to_optimum","units":"dmnl","eqn":"0.3","inflows":["change in health"],"outflows":[]},{"type":"stock","name":"roads_relative_to_optimum","units":"dmnl","eqn":"0.3","inflows":["change in roads"],"outflows":[]},{"type":"aux","name":"borrowing","units":"$/Year","eqn":"if_then_else(surplus_or_deficit<0, -surplus_or_deficit,0)"},{"type":"aux","name":"capital_depreciation","units":"dmnl/Year","eqn":"capital_per_capita/capital_depreciation_time"},{"type":"aux","name":"capital_investment","units":"dmnl/Year","eqn":"per_capita_savings*effect_of_investment_environment_on_capital_investment*cost_effectiveness_of_capital_investment"},{"type":"aux","name":"change_in_education","units":"dmnl/Year","eqn":"(target_education-education_relative_to_optimum)/education_investment_delay"},{"type":"aux","name":"change_in_health","units":"dmnl/Year","eqn":"(target_health-health_relative_to_optimum)/health_investment_delay"},{"type":"aux","name":"change_in_roads","units":"dmnl/Year","eqn":"(target_roads-roads_relative_to_optimum)/roads_investment_delay"},{"type":"aux","name":"debt_over_gdp_ratio","units":"Year","eqn":"debt_per_capita/per_capita_income"},{"type":"aux","name":"desired_budget_for_education","units":"$/Year","eqn":"GAME ( 30)"},{"type":"aux","name":"desired_budget_for_health","units":"$/Year","eqn":"GAME ( 30)"},{"type":"aux","name":"desired_budget_for_roads","units":"$/Year","eqn":"GAME ( 30)"},{"type":"aux","name":"effect_of_education_on_investment_environment","units":"dmnl","eqn":"resources_effect_table(education_relative_to_optimum)"},{"type":"aux","name":"effect_of_health_on_investment_environment","units":"dmnl","eqn":"resources_effect_table(health_relative_to_optimum)"},{"type":"aux","name":"effect_of_investment_environment_on_capital_investment","units":"dmnl","eqn":"relative_investment_environment^elasticity_of_investment_to_environment"},{"type":"aux","name":"effect_of_roads_on_investment_environment","units":"dmnl","eqn":"resources_effect_table(roads_relative_to_optimum)"},{"type":"aux","name":"government_development_budget_per_capita","units":"$/Year","eqn":"per_capita_income*tax_rate-interest_payment_on_debt"},{"type":"aux","name":"interest_payment_on_debt","units":"$/Year","eqn":"debt_per_capita*interest_rate"},{"type":"aux","name":"interest_rate","units":"dmnl/Year","eqn":"interest_rate_table(debt_over_gdp_ratio)"},{"type":"aux","name":"investment_environment","units":"dmnl","eqn":"(effect_of_education_on_investment_environment+effect_of_health_on_investment_environment+effect_of_roads_on_investment_environment)/3"},{"type":"aux","name":"paying_back","units":"$/Year","eqn":"if_then_else(surplus_or_deficit>0 :AND: debt_per_capita>0, surplus_or_deficit,0)"},{"type":"aux","name":"pc_income_corrected_for_interest_payments","units":"$/Year","eqn":"per_capita_income-interest_payment_on_debt"},{"type":"aux","name":"per_capita_income","units":"$/Year","eqn":"INITIAL_pc_income*capital_per_capita^elasticity_of_income_to_capital*total_factor_productivity"},{"type":"aux","name":"per_capita_savings","units":"$/Year","eqn":"per_capita_income*propensity_to_save"},{"type":"aux","name":"relative_investment_environment","units":"dmnl","eqn":"investment_environment/initial_investment_environment"},{"type":"aux","name":"show_reset_button","units":"","eqn":"min(if_then_else(Time = FINAL_TIME, 1, 0 ) + if_then_else(state = 7, 1, 0 ) , 1)"},{"type":"aux","name":"state","units":"","eqn":"if_then_else( pc_income_corrected_for_interest_payments > state_0, if_then_else( pc_income_corrected_for_interest_payments > state_1, if_then_else( pc_income_corrected_for_interest_payments > state_2, if_then_else( pc_income_corrected_for_interest_payments > state_3, if_then_else( pc_income_corrected_for_interest_payments > state_4, if_then_else( pc_income_corrected_for_interest_payments > state_5, if_then_else( pc_income_corrected_for_interest_payments > state_6, if_then_else( pc_income_corrected_for_interest_payments > state_7, 7, 7), 6), 5), 4), 3), 2), 1), 0)"},{"type":"aux","name":"surplus_or_deficit","units":"$/Year","eqn":"government_development_budget_per_capita-total_desired_budget_per_capita"},{"type":"aux","name":"target_education","units":"dmnl","eqn":"desired_budget_for_education*cost_effectiveness_of_resource_investments"},{"type":"aux","name":"target_health","units":"dmnl","eqn":"desired_budget_for_health*cost_effectiveness_of_resource_investments"},{"type":"aux","name":"target_roads","units":"dmnl","eqn":"desired_budget_for_roads*cost_effectiveness_of_resource_investments"},{"type":"aux","name":"total_desired_budget_per_capita","units":"$/Year","eqn":"desired_budget_for_education+desired_budget_for_health+desired_budget_for_roads"},{"type":"aux","name":"total_factor_productivity","units":"dmnl","eqn":"education_relative_to_optimum^elasticity_of_productivity_to_education*health_relative_to_optimum^elasticity_of_productivity_to_health*roads_relative_to_optimum^elasticity_of_productivity_to_roads"},{"type":"aux","name":"interest_rate_table","units":"dmnl/Year","eqn":""},{"type":"aux","name":"resources_effect_table","units":"dmnl","eqn":""},{"type":"aux","name":"capital_depreciation_time","units":"Year","eqn":"25"},{"type":"aux","name":"cost_effectiveness_of_capital_investment","units":"dmnl/$","eqn":"0.001"},{"type":"aux","name":"cost_effectiveness_of_resource_investments","units":"Year/$","eqn":"0.01"},{"type":"aux","name":"education_investment_delay","units":"Year","eqn":"15"},{"type":"aux","name":"elasticity_of_income_to_capital","units":"dmnl","eqn":"0.3"},{"type":"aux","name":"elasticity_of_investment_to_environment","units":"dmnl","eqn":"3"},{"type":"aux","name":"elasticity_of_productivity_to_education","units":"dmnl","eqn":"0.275"},{"type":"aux","name":"elasticity_of_productivity_to_health","units":"dmnl","eqn":"0.225"},{"type":"aux","name":"elasticity_of_productivity_to_roads","units":"dmnl","eqn":"0.2"},{"type":"aux","name":"health_investment_delay","units":"Year","eqn":"7"},{"type":"aux","name":"initial_capital_per_capita","units":"dmnl","eqn":"0.3"},{"type":"aux","name":"INITIAL_pc_income","units":"$/Year","eqn":"1000"},{"type":"aux","name":"propensity_to_save","units":"dmnl","eqn":"0.04"},{"type":"aux","name":"roads_investment_delay","units":"Year","eqn":"3"},{"type":"aux","name":"state_0","units":"","eqn":"-300"},{"type":"aux","name":"state_1","units":"","eqn":"-100"},{"type":"aux","name":"state_2","units":"","eqn":"100"},{"type":"aux","name":"state_3","units":"","eqn":"299"},{"type":"aux","name":"state_4","units":"","eqn":"380"},{"type":"aux","name":"state_5","units":"","eqn":"500"},{"type":"aux","name":"state_6","units":"","eqn":"700"},{"type":"aux","name":"state_7","units":"","eqn":"1000"},{"type":"aux","name":"tax_rate","units":"dmnl","eqn":"0.3"}]}