{
  "@type": "XMILEModel",
  "modelId": "URBAN",
  "sourceFile": "URBAN.xmile",
  "simSpecs": {
    "method": "RK4",
    "time_units": "year",
    "start": "0",
    "stop": "250",
    "dt": "1"
  },
  "variables": [
    {
      "type": "stock",
      "name": "Attract_Migr_Mult_Perc",
      "units": "dimensionless",
      "eqn": "1",
      "inflows": [
        "attract migr mult perc table"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Declining_Industry",
      "units": "production_unit",
      "eqn": "100",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Labor",
      "units": "worker",
      "eqn": "14000",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Labor_Arrival_Mult_Perc",
      "units": "dimensionless",
      "eqn": "1",
      "inflows": [
        "labor arrival mult perc tab"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Labor_Mob_Mult_Perc",
      "units": "dimensionless",
      "eqn": "1",
      "inflows": [
        "labor mob mult perc time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Labor_Ratio_Perc",
      "units": "dimensionless",
      "eqn": "1",
      "inflows": [
        "labor ratio perception time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Manager_Prof_Arriv_Mult_Perc",
      "units": "dimensionless",
      "eqn": "1",
      "inflows": [
        "manager prof arriv mult perc time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Manager_Professional",
      "units": "worker",
      "eqn": "3900",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Mature_Business",
      "units": "production_unit",
      "eqn": "1000",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "New_Enterprise",
      "units": "production_unit",
      "eqn": "200",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "New_Enterprise_Average",
      "units": "production_unit",
      "eqn": "New_Enterprise* (1-new_enterprise_growth_rate_initial* new_enterprise_average_time)",
      "inflows": [
        "new enterprise average time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Premium_Housing",
      "units": "housing_unit",
      "eqn": "5000",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Premium_Housing_Average",
      "units": "housing_unit",
      "eqn": "Premium_Housing*(1-premium_housing_growth_rate_init* premium_housing_averate_time)",
      "inflows": [
        "premium housing averate time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Tax_Ratio_Needed_Perc",
      "units": "dimensionless",
      "eqn": "tax_ratio_needed",
      "inflows": [
        "tax ratio needed perception time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Underemp_Housing",
      "units": "housing_unit",
      "eqn": "1100",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Underemp_Mob_Mult_Perc",
      "units": "dimensionless",
      "eqn": "1",
      "inflows": [
        "underemp mob mult perc time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Underemp_to_Labor_Perc",
      "units": "worker/year",
      "eqn": "75",
      "inflows": [
        "underemp to labor perc time"
      ],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Underemployed",
      "units": "worker",
      "eqn": "1200",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Worker_Housing",
      "units": "housing_unit",
      "eqn": "21000",
      "inflows": [],
      "outflows": []
    },
    {
      "type": "stock",
      "name": "Worker_Housing_Average",
      "units": "housing_unit",
      "eqn": "Worker_Housing* (1-worker_housing_growth_rate_initial* worker_housing_average_time)",
      "inflows": [
        "worker housing average time"
      ],
      "outflows": []
    },
    {
      "type": "aux",
      "name": "assessed_value",
      "units": "THOU_$",
      "eqn": "(housing_assessed_value+business_assessed_value)"
    },
    {
      "type": "aux",
      "name": "attract_migr_mult",
      "units": "dimensionless",
      "eqn": "underemp_arr_mob_mult* underemp_housing_mult* public_expenditure_mult* underemp_job_mult* underemp_hous_prog_mult* attract_migr_factor"
    },
    {
      "type": "aux",
      "name": "business_assessed_value",
      "units": "THOU_$",
      "eqn": "new_enterprise_assessed_value*New_Enterprise+ maturre_business_assessed_value*Mature_Business+ declining_industry_assessed_value*Declining_Industry"
    },
    {
      "type": "aux",
      "name": "business_decline_mult",
      "units": "dimensionless",
      "eqn": "business_decline_mult_tab( 1.44*LN(enterprise_multiplier))"
    },
    {
      "type": "aux",
      "name": "declining_industry_demise",
      "units": "production_unit/year",
      "eqn": "(declining_industry_demise_norm* Declining_Industry*declining_industry_demise_mult)+ declining_industry_demolition_program"
    },
    {
      "type": "aux",
      "name": "declining_industry_demise_mult",
      "units": "dimensionless",
      "eqn": "declining_industry_from_enterprise_mult* declining_industry_from_land_mult* declining_industry_decline_factor"
    },
    {
      "type": "aux",
      "name": "declining_industry_demolition_program",
      "units": "production_unit/year",
      "eqn": "declining_industry_demolition_rate*Declining_Industry* IF_THEN_ELSE(Time >= SWITCH_TIME_7,1,0)"
    },
    {
      "type": "aux",
      "name": "declining_industry_demolition_rate",
      "units": "fraction/year",
      "eqn": "GAME(0)"
    },
    {
      "type": "aux",
      "name": "declining_industry_from_enterprise_mult",
      "units": "dimensionless",
      "eqn": "declining_industry_from_enterprise_mult_tab( 1.44*LN(enterprise_multiplier))"
    },
    {
      "type": "aux",
      "name": "declining_industry_from_land_mult",
      "units": "dimensionless",
      "eqn": "declining_industry_from_land_mult_tab( land_fraction_occupied)"
    },
    {
      "type": "aux",
      "name": "enterprise_decline_mult",
      "units": "dimensionless",
      "eqn": "enterprise_decline_mult_tab( 1.44*LN(enterprise_multiplier))"
    },
    {
      "type": "aux",
      "name": "enterprise_growth_mult",
      "units": "dimensionless",
      "eqn": "enterprise_growth_mult_tab( new_enterprise_growth_rate)"
    },
    {
      "type": "aux",
      "name": "enterprise_labor_job_mult",
      "units": "dimensionless",
      "eqn": "enterprise_labor_job_mult_tab(Labor_Ratio_Perc)"
    },
    {
      "type": "aux",
      "name": "enterprise_land_mult",
      "units": "dimensionless",
      "eqn": "enterprise_land_mult_tab(land_fraction_occupied)"
    },
    {
      "type": "aux",
      "name": "enterprise_manager_prof_job_mult",
      "units": "dimensionless",
      "eqn": "enterprise_manager_prof_job_mult_tab( manager_job_ratio)"
    },
    {
      "type": "aux",
      "name": "enterprise_multiplier",
      "units": "dimensionless",
      "eqn": "enterprise_manager_prof_job_mult* enterprise_land_mult* enterprise_labor_job_mult* enterprise_tax_mult* enterprise_growth_mult* enterprise_factor"
    },
    {
      "type": "aux",
      "name": "enterprise_tax_mult",
      "units": "dimensionless",
      "eqn": "enterprise_tax_mult_tab(1.44*LN(tax_ratio))"
    },
    {
      "type": "aux",
      "name": "housing_assessed_value",
      "units": "THOU_$",
      "eqn": "premium_housing_assessed_value*Premium_Housing+ worker_housing_assessed_value*Worker_Housing+ underemp_housing_assessed_value*Underemp_Housing"
    },
    {
      "type": "aux",
      "name": "housing_units_total",
      "units": "housing_unit",
      "eqn": "Premium_Housing+Worker_Housing+Underemp_Housing"
    },
    {
      "type": "aux",
      "name": "labor_arrival",
      "units": "worker/year",
      "eqn": "labor_arrival_normal*Labor* Labor_Arrival_Mult_Perc"
    },
    {
      "type": "aux",
      "name": "labor_arrival_housing_mult",
      "units": "dimensionless",
      "eqn": "labor_arrival_housing_mult_tab( labor_housing_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_arrival_jobs_mult",
      "units": "dimensionless",
      "eqn": "labor_arrival_jobs_mult_tab(labor_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_arrival_mult",
      "units": "dimensionless",
      "eqn": "labor_arrival_jobs_mult*labor_arrival_underemp_mult* labor_arrival_tax_mult*labor_arrival_housing_mult* labor_arrival_factor"
    },
    {
      "type": "aux",
      "name": "labor_arrival_tax_mult",
      "units": "dimensionless",
      "eqn": "labor_arrival_tax_mult_tab(1.44*LN(tax_ratio))"
    },
    {
      "type": "aux",
      "name": "labor_arrival_underemp_mult",
      "units": "dimensionless",
      "eqn": "labor_arrival_underemp_mult_Tab(labor_underemp_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_birth",
      "units": "worker/year",
      "eqn": "Labor*labor_birth_rate"
    },
    {
      "type": "aux",
      "name": "labor_construction_ratio",
      "units": "dimensionless",
      "eqn": "labor_construction_ratio_tab(labor_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_daparture_mult",
      "units": "dimensionless",
      "eqn": "labor_daparture_mult_tab(1.44*LN(labor_arrival_mult))"
    },
    {
      "type": "aux",
      "name": "labor_departure",
      "units": "worker/year",
      "eqn": "labor_daparture_normal*Labor*labor_daparture_mult"
    },
    {
      "type": "aux",
      "name": "labor_desired_construct",
      "units": "worker",
      "eqn": "premium_housing_construct_desired* premium_housing_constr_lab+ worker_housing_const_des* worker_housing_constr_lab+ new_enterprise_construction_desired* new_enterprise_constr_lab+ low_cost_housing_constr_des* low_cost_housing_constr_lab"
    },
    {
      "type": "aux",
      "name": "labor_desired_industry",
      "units": "worker",
      "eqn": "New_Enterprise*new_enterprise_labor+ Mature_Business*mature_business_labor+ Declining_Industry*declining_industry_labor"
    },
    {
      "type": "aux",
      "name": "labor_edu_mult",
      "units": "dimensionless",
      "eqn": "labor_edu_mult_tab(tax_per_cap_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_housing_ratio",
      "units": "dimensionless",
      "eqn": "(Labor*labor_family_size)/(Worker_Housing* worker_housing_pop_density)"
    },
    {
      "type": "aux",
      "name": "labor_jobs",
      "units": "worker",
      "eqn": "labor_desired_construct+labor_desired_industry"
    },
    {
      "type": "aux",
      "name": "labor_layoff_frac",
      "units": "fraction/year",
      "eqn": "labor_layoff_frac_Tab(labor_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_mob_mult",
      "units": "dimensionless",
      "eqn": "manage_supply_mult*manage_labor_mult* labor_edu_mult*labor_mob_fact"
    },
    {
      "type": "aux",
      "name": "labor_ratio",
      "units": "dimensionless",
      "eqn": "Labor/labor_jobs"
    },
    {
      "type": "aux",
      "name": "labor_supply_mult",
      "units": "dimensionless",
      "eqn": "labor_supply_mult_tab(labor_ratio)"
    },
    {
      "type": "aux",
      "name": "labor_to_manager",
      "units": "worker/year",
      "eqn": "labor_to_manager_norm*Labor* Labor_Mob_Mult_Perc+labor_training_prog"
    },
    {
      "type": "aux",
      "name": "labor_to_underemp",
      "units": "worker/year",
      "eqn": "Labor*labor_layoff_frac"
    },
    {
      "type": "aux",
      "name": "labor_training_prog",
      "units": "worker/year",
      "eqn": "LABOR_TRAINING_RATE*Labor* IF_THEN_ELSE(Time >= SWITCH_TIME_2,1,0)"
    },
    {
      "type": "aux",
      "name": "labor_underemp_ratio",
      "units": "dimensionless",
      "eqn": "Labor/Underemployed"
    },
    {
      "type": "aux",
      "name": "labor_unedermp_mult",
      "units": "dimensionless",
      "eqn": "labor_underemp_mult_tab(labor_underemp_ratio)"
    },
    {
      "type": "aux",
      "name": "land_fraction_occupied",
      "units": "fraction",
      "eqn": "(housing_units_total*land_per_house+ production_units_total*land_per_production_unit)/ TOTAL_LAND_AREA"
    },
    {
      "type": "aux",
      "name": "low_cost_hous_prog",
      "units": "housing_unit/year",
      "eqn": "low_cost_housing_constr_des*labor_construction_ratio"
    },
    {
      "type": "aux",
      "name": "low_cost_housing_constr_des",
      "units": "housing_unit/year",
      "eqn": "low_cost_housing_prog_coeff*Underemployed*worker_housing_land_mult* IF_THEN_ELSE(Time >= SWITCH_TIME_10,1,0)"
    },
    {
      "type": "aux",
      "name": "low_cost_housing_prog_coeff",
      "units": "housing_unit/(year*worker)",
      "eqn": "GAME(0)"
    },
    {
      "type": "aux",
      "name": "manage_labor_mult",
      "units": "dimensionless",
      "eqn": "manage_labor_mult_tab(manager_labor_ratio)"
    },
    {
      "type": "aux",
      "name": "manage_supply_mult",
      "units": "dimensionless",
      "eqn": "manage_supply_mult_tab(manager_job_ratio)"
    },
    {
      "type": "aux",
      "name": "manager_job_ratio",
      "units": "dimensionless",
      "eqn": "Manager_Professional/Manager_Prof_Jobs"
    },
    {
      "type": "aux",
      "name": "manager_labor_ratio",
      "units": "dimensionless",
      "eqn": "Manager_Professional/Labor"
    },
    {
      "type": "aux",
      "name": "manager_prof_arriv_hous_mult",
      "units": "dimensionless",
      "eqn": "manager_prof_arriv_housing_mult_tab (manager_prof_hous_ratio)"
    },
    {
      "type": "aux",
      "name": "manager_prof_arriv_job_mult",
      "units": "dimensionless",
      "eqn": "manager_prof_arriv_job_mult_tab(manager_job_ratio)"
    },
    {
      "type": "aux",
      "name": "manager_prof_arriv_mult",
      "units": "dimensionless",
      "eqn": "manager_prof_arriv_job_mult* manager_prof_arriv_pop_mult* manager_prof_arriv_tax_mult* manager_prof_arriv_hous_mult* manager_prof_arriv_factor"
    },
    {
      "type": "aux",
      "name": "manager_prof_arriv_pop_mult",
      "units": "dimensionless",
      "eqn": "manager_prof_arriv_pop_mult_tab( manager_prof_ratio)"
    },
    {
      "type": "aux",
      "name": "manager_prof_arriv_tax_mult",
      "units": "dimensionless",
      "eqn": "manager_prof_arriv_tax_mult_tab( 1.44*LN(tax_ratio))"
    },
    {
      "type": "aux",
      "name": "manager_prof_arrivals",
      "units": "worker/year",
      "eqn": "manager_prof_arrival_norm*Manager_Professional* Manager_Prof_Arriv_Mult_Perc"
    },
    {
      "type": "aux",
      "name": "manager_prof_birth",
      "units": "worker/year",
      "eqn": "Manager_Professional*manager_prof_birth_rate"
    },
    {
      "type": "aux",
      "name": "manager_prof_depart",
      "units": "worker/year",
      "eqn": "manager_prof_depart_norm*Manager_Professional* manager_prof_depart_mult"
    },
    {
      "type": "aux",
      "name": "manager_prof_depart_mult",
      "units": "dimensionless",
      "eqn": "manager_prof_depart_mult_tab(1.44*LN(manager_prof_arriv_mult))"
    },
    {
      "type": "aux",
      "name": "manager_prof_hous_ratio",
      "units": "dimensionless",
      "eqn": "(Manager_Professional*manager_prof_family_size)/ (Premium_Housing*premium_housing_pop_dens)"
    },
    {
      "type": "aux",
      "name": "Manager_Prof_Jobs",
      "units": "worker",
      "eqn": "(New_Enterprise*new_enterprise_management)+ (Mature_Business*mature_business_management)+ (Declining_Industry*declining_industry_management)"
    },
    {
      "type": "aux",
      "name": "manager_prof_ratio",
      "units": "dimensionless",
      "eqn": "Manager_Professional/(Labor+Underemployed)"
    },
    {
      "type": "aux",
      "name": "mature_business_decline",
      "units": "production_unit/year",
      "eqn": "mature_business_decline_norm*Mature_Business* business_decline_mult"
    },
    {
      "type": "aux",
      "name": "NEW_ENTERPRISE_CONSTR_RATE",
      "units": "fraction/year",
      "eqn": "GAME(0)"
    },
    {
      "type": "aux",
      "name": "new_enterprise_Construction",
      "units": "production_unit/year",
      "eqn": "new_enterprise_construction_desired* labor_construction_ratio"
    },
    {
      "type": "aux",
      "name": "new_enterprise_construction_desired",
      "units": "production_unit/year",
      "eqn": "new_enterprise_construction_norm* (new_enterprise_construction_factor*New_Enterprise+ mature_business_construction_factor*Mature_Business+ declining_industry_construction_factor*Declining_Industry)* enterprise_multiplier+new_enterprise_construction_program"
    },
    {
      "type": "aux",
      "name": "new_enterprise_construction_program",
      "units": "production_unit/year",
      "eqn": "NEW_ENTERPRISE_CONSTR_RATE*production_units_total* enterprise_land_mult* IF_THEN_ELSE(Time >= SWITCH_TIME_6,1,0)"
    },
    {
      "type": "aux",
      "name": "new_enterprise_decline",
      "units": "production_unit/year",
      "eqn": "new_enterprise_decline_normal*New_Enterprise* enterprise_decline_mult"
    },
    {
      "type": "aux",
      "name": "new_enterprise_growth_rate",
      "units": "fraction/year",
      "eqn": "(New_Enterprise-New_Enterprise_Average)/ (New_Enterprise_Average*new_enterprise_average_time)"
    },
    {
      "type": "aux",
      "name": "percent_underemp",
      "units": "Dmnl",
      "eqn": "100 * Underemployed*underemp_family_size/population"
    },
    {
      "type": "aux",
      "name": "population",
      "units": "person",
      "eqn": "Manager_Professional*manager_prof_family_size+ Labor*labor_family_size+ Underemployed*underemp_family_size"
    },
    {
      "type": "aux",
      "name": "premium_housing_adeq_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_adeq_mult_tab(manager_prof_hous_ratio)"
    },
    {
      "type": "aux",
      "name": "premium_housing_const_prog",
      "units": "housing_unit/year",
      "eqn": "premium_housing_construction_ratio* Premium_Housing*premium_housing_land_mult* IF_THEN_ELSE(Time >= SWITCH_TIME_3,1,0)"
    },
    {
      "type": "aux",
      "name": "premium_housing_construct_desired",
      "units": "housing_unit/year",
      "eqn": "(premium_housing_construction_norm* Premium_Housing*premium_housing_mult)+ premium_housing_const_prog"
    },
    {
      "type": "aux",
      "name": "premium_housing_contruction",
      "units": "housing_unit/year",
      "eqn": "premium_housing_construct_desired* labor_construction_ratio"
    },
    {
      "type": "aux",
      "name": "premium_housing_enterprise_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_enterprise_mult_tab( new_enterprise_growth_rate)"
    },
    {
      "type": "aux",
      "name": "premium_housing_growth_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_growth_mult_tab( premium_housing_growth_rate)"
    },
    {
      "type": "aux",
      "name": "premium_housing_growth_rate",
      "units": "fraction/year",
      "eqn": "(Premium_Housing-Premium_Housing_Average)/ (Premium_Housing_Average*premium_housing_averate_time)"
    },
    {
      "type": "aux",
      "name": "premium_housing_land_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_land_mult_tab(land_fraction_occupied)"
    },
    {
      "type": "aux",
      "name": "premium_housing_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_adeq_mult* premium_housing_land_mult* premium_housing_pop_mult* premium_housing_tax_mult* premium_housing_enterprise_mult* premium_housing_growth_mult* premium_housing_factor"
    },
    {
      "type": "aux",
      "name": "premium_housing_obsolescence",
      "units": "housing_unit/year",
      "eqn": "premium_housing_obsolescense_normal* Premium_Housing*premium_housing_obsolescense_mult"
    },
    {
      "type": "aux",
      "name": "premium_housing_obsolescense_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_obsolescense_mult_tab( 1.44*LN(premium_housing_mult))"
    },
    {
      "type": "aux",
      "name": "premium_housing_pop_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_pop_mult_tab(manager_prof_ratio)"
    },
    {
      "type": "aux",
      "name": "premium_housing_tax_mult",
      "units": "dimensionless",
      "eqn": "premium_housing_tax_mult_tab(1.44*LN(tax_ratio))"
    },
    {
      "type": "aux",
      "name": "production_units_total",
      "units": "production_unit",
      "eqn": "New_Enterprise+Mature_Business+Declining_Industry"
    },
    {
      "type": "aux",
      "name": "public_expenditure_mult",
      "units": "dimensionless",
      "eqn": "public_exp_mult_tab(tax_per_cap_ratio)"
    },
    {
      "type": "aux",
      "name": "slum_housing_abandoned_mult",
      "units": "dimensionless",
      "eqn": "slum_housing_abandomed_mult_tab( underemp_housing_ratio)"
    },
    {
      "type": "aux",
      "name": "slum_housing_demolition",
      "units": "housing_unit/year",
      "eqn": "(slum_housing_demolition_norm* Underemp_Housing*slum_housing_demolition_mult)+ slum_housing_demolition_program"
    },
    {
      "type": "aux",
      "name": "slum_housing_demolition_mult",
      "units": "dimensionless",
      "eqn": "slum_housing_abandoned_mult* slum_housing_land_mult* slum_housing_demolitin_factor"
    },
    {
      "type": "aux",
      "name": "slum_housing_demolition_program",
      "units": "housing_unit/year",
      "eqn": "SLUM_HOUSING_DEMOLITION_RATE*Underemp_Housing* IF_THEN_ELSE(Time >= SWITCH_TIME_5,1,0)"
    },
    {
      "type": "aux",
      "name": "SLUM_HOUSING_DEMOLITION_RATE",
      "units": "fraction/year",
      "eqn": "GAME(0)"
    },
    {
      "type": "aux",
      "name": "slum_housing_land_mult",
      "units": "dimensionless",
      "eqn": "slum_housing_land_mult_tab(land_fraction_occupied)"
    },
    {
      "type": "aux",
      "name": "tax_assessment_indicated",
      "units": "$/(year*THOU_$)",
      "eqn": "tax_needed/assessed_value"
    },
    {
      "type": "aux",
      "name": "tax_collection_mult",
      "units": "dimensionless",
      "eqn": "tax_collection_mult_tab(labor_underemp_ratio)"
    },
    {
      "type": "aux",
      "name": "tax_collections",
      "units": "$/year",
      "eqn": "assessed_value*tax_assessment_norm*tax_ratio"
    },
    {
      "type": "aux",
      "name": "tax_needed",
      "units": "$/year",
      "eqn": "(tax_spending_per_manager*manager_prof_family_size* Manager_Professional+ tax_spending_per_labor*labor_family_size*Labor+ tax_spending_per_underemp*underemp_family_size*Underemployed)* tax_collection_mult"
    },
    {
      "type": "aux",
      "name": "tax_per_cap_ratio",
      "units": "dimensionless",
      "eqn": "((tax_collections/population)+tax_per_cap_subsidy)/ tax_per_cap_norm"
    },
    {
      "type": "aux",
      "name": "tax_per_cap_subsidy",
      "units": "$/(year*person)",
      "eqn": "tax_per_cap_subsidy_size* IF_THEN_ELSE(Time >= SWITCH_TIME_8,1,0)"
    },
    {
      "type": "aux",
      "name": "tax_ratio",
      "units": "dimensionless",
      "eqn": "tax_ratio_table(1.44*LN(Tax_Ratio_Needed_Perc))"
    },
    {
      "type": "aux",
      "name": "tax_ratio_needed",
      "units": "dimensionless",
      "eqn": "tax_assessment_indicated/tax_assessment_norm"
    },
    {
      "type": "aux",
      "name": "underemp_arr_mob_mult",
      "units": "dimensionless",
      "eqn": "underemp_arr_mob_mult_tab(underemp_mobility)"
    },
    {
      "type": "aux",
      "name": "underemp_births",
      "units": "worker/year",
      "eqn": "Underemployed*underemp_birth_rate"
    },
    {
      "type": "aux",
      "name": "underemp_departures",
      "units": "worker/year",
      "eqn": "underemp_departures_norm*Underemployed* underemp_departures_mult"
    },
    {
      "type": "aux",
      "name": "underemp_departures_mult",
      "units": "dimensionless",
      "eqn": "underemp_depart_mult_tab(1.44*LN(attract_migr_mult))"
    },
    {
      "type": "aux",
      "name": "underemp_edu_mult",
      "units": "dimensionless",
      "eqn": "underemp_edu_mult_tab(tax_per_cap_ratio)"
    },
    {
      "type": "aux",
      "name": "underemp_fract_working",
      "units": "fraction",
      "eqn": "underemp_fract_working_tab(underemp_ratio)"
    },
    {
      "type": "aux",
      "name": "underemp_hous_prog_mult",
      "units": "dimensionless",
      "eqn": "underemp_hous_prog_mult_tab(underemp_hous_prog_rate)"
    },
    {
      "type": "aux",
      "name": "underemp_hous_prog_rate",
      "units": "housing_unit/(year*worker)",
      "eqn": "low_cost_hous_prog/Underemployed"
    },
    {
      "type": "aux",
      "name": "underemp_housing_mult",
      "units": "dimensionless",
      "eqn": "underemp_hous_mult_table(underemp_housing_ratio)"
    },
    {
      "type": "aux",
      "name": "underemp_housing_ratio",
      "units": "dimensionless",
      "eqn": "(Underemployed*underemp_family_size)/ (Underemp_Housing*underemp_pop_density)"
    },
    {
      "type": "aux",
      "name": "underemp_job_mult",
      "units": "dimensionless",
      "eqn": "underemp_job_mult_tab(underemp_ratio)"
    },
    {
      "type": "aux",
      "name": "underemp_job_program_coeff",
      "units": "dimensionless",
      "eqn": "GAME(0)"
    },
    {
      "type": "aux",
      "name": "underemp_mob_mult",
      "units": "dimensionless",
      "eqn": "labor_supply_mult*labor_unedermp_mult* underemp_edu_mult*underemp_mob_factor"
    },
    {
      "type": "aux",
      "name": "underemp_mobility",
      "units": "fraction/year",
      "eqn": "Underemp_to_Labor_Perc/Underemployed"
    },
    {
      "type": "aux",
      "name": "underemp_ratio",
      "units": "dimensionless",
      "eqn": "Underemployed/underemployed_jobs"
    },
    {
      "type": "aux",
      "name": "underemp_to_labor",
      "units": "worker/year",
      "eqn": "(underemp_mobility_norm* underemp_working*Underemp_Mob_Mult_Perc)+ underemp_training_prog"
    },
    {
      "type": "aux",
      "name": "underemp_to_labor_net",
      "units": "worker/year",
      "eqn": "underemp_to_labor-labor_to_underemp"
    },
    {
      "type": "aux",
      "name": "underemp_training_prog",
      "units": "worker/year",
      "eqn": "underemp_training_rate*Underemployed* IF_THEN_ELSE(Time >= SWITCH_TIME_1,1,0)"
    },
    {
      "type": "aux",
      "name": "underemp_training_rate",
      "units": "fraction/year",
      "eqn": "GAME(0)"
    },
    {
      "type": "aux",
      "name": "underemp_working",
      "units": "worker",
      "eqn": "Underemployed*underemp_fract_working"
    },
    {
      "type": "aux",
      "name": "underemployed_arrivals",
      "units": "worker/year",
      "eqn": "(Underemployed+Labor)* UNDEREMP_ARRIVALS_NORMAL*Attract_Migr_Mult_Perc"
    },
    {
      "type": "aux",
      "name": "underemployed_crowding",
      "units": "Dmnl",
      "eqn": "100*underemp_housing_ratio"
    },
    {
      "type": "aux",
      "name": "underemployed_job_program",
      "units": "worker",
      "eqn": "underemp_job_program_coeff*Underemployed* IF_THEN_ELSE(Time >= SWITCH_TIME_9,1,0)"
    },
    {
      "type": "aux",
      "name": "underemployed_jobs",
      "units": "worker",
      "eqn": "labor_jobs*underemployed_labor_job_ratio+ underemployed_job_program"
    },
    {
      "type": "aux",
      "name": "underemployed_labor_job_ratio",
      "units": "dimensionless",
      "eqn": "underemployed_labor_job_ratio_tab(labor_ratio)"
    },
    {
      "type": "aux",
      "name": "unemployment_rate",
      "units": "Dmnl",
      "eqn": "100 * (1 - (labor_jobs + underemployed_jobs + Manager_Prof_Jobs)/ (Labor + Manager_Professional + Underemployed))"
    },
    {
      "type": "aux",
      "name": "worker_housing_adequacy_mult",
      "units": "dimensionless",
      "eqn": "worker_housing_adequacy_mult_tab(labor_housing_ratio)"
    },
    {
      "type": "aux",
      "name": "worker_housing_const_des",
      "units": "housing_unit/year",
      "eqn": "(worker_housing_const_norm*Worker_Housing* worker_housing_mult)+worker_housing_const_prog"
    },
    {
      "type": "aux",
      "name": "worker_housing_const_prog",
      "units": "housing_unit/year",
      "eqn": "WORKER_HOUSING_CONSTR_RATIO*housing_units_total* worker_housing_land_mult* IF_THEN_ELSE(Time >= SWITCH_TIME_4,1,0)"
    },
    {
      "type": "aux",
      "name": "worker_housing_construction",
      "units": "housing_unit/year",
      "eqn": "worker_housing_const_des* labor_construction_ratio"
    },
    {
      "type": "aux",
      "name": "worker_housing_enterprise_mult",
      "units": "dimensionless",
      "eqn": "worker_housing_enterprise_mult_tab( new_enterprise_growth_rate)"
    },
    {
      "type": "aux",
      "name": "worker_housing_growth_mult",
      "units": "dimensionless",
      "eqn": "worker_housing_growth_mult_tab( worker_housing_growth_rate)"
    },
    {
      "type": "aux",
      "name": "worker_housing_growth_rate",
      "units": "fraction/year",
      "eqn": "(Worker_Housing-Worker_Housing_Average)/ (Worker_Housing_Average*worker_housing_average_time)"
    },
    {
      "type": "aux",
      "name": "worker_housing_land_mult",
      "units": "dimensionless",
      "eqn": "worker_housing_land_mult_tab( land_fraction_occupied)"
    },
    {
      "type": "aux",
      "name": "worker_housing_mult",
      "units": "dimensionless",
      "eqn": "worker_housing_adequacy_mult* worker_housing_land_mult* worker_housing_underemp_mult* worker_housing_tax_mult* worker_housing_enterprise_mult* worker_housing_growth_mult* worker_housing_factor"
    },
    {
      "type": "aux",
      "name": "worker_housing_obsolescence",
      "units": "housing_unit/year",
      "eqn": "worker_housing_obsolescense_norm* Worker_Housing*worker_housing_obsolescense_mult"
    },
    {
      "type": "aux",
      "name": "worker_housing_obsolescense_mult",
      "units": "dimensionless",
      "eqn": "worker_housing_obsolescense_mult_tab( 1.44*LN(worker_housing_mult))"
    },
