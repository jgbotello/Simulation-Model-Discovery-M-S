{"backgroundInformation":"This is a simulation done for a homework with data provided by the exercise book for continuous system dynamics provided for the EPA 1321 course in TU Deft. It describes the spread and causes of a Cholera epidemy in Zimbabwe.","@type":"XMILEModel","modelId":"Cholera_zimbabwe","sourceFile":"Cholera_zimbabwe.xmile","simSpecs":{"method":"RK4","time_units":"Day","start":"0","stop":"3600","dt":"0.25"},"variables":[{"type":"stock","name":"Heavily_infected_population","units":"people","eqn":"50","inflows":["heavily infected"],"outflows":["Cholera deaths","recovered from heavy infection"]},{"type":"stock","name":"Mildly_infected_population","units":"people","eqn":"950","inflows":["mildly infected"],"outflows":["recovered from mild infection"]},{"type":"stock","name":"Recently_infected_population","units":"people","eqn":"1000","inflows":["cholera infections"],"outflows":["heavily infected","mildly infected"]},{"type":"stock","name":"Recovered_temporarily_immune_population","units":"people","eqn":"1.0226e+07","inflows":["recovered from mild infection"],"outflows":["lost of immunity"]},{"type":"stock","name":"Susceptible_population","units":"people","eqn":"3e+06","inflows":["lost of immunity"],"outflows":["cholera infections"]},{"type":"aux","name":"average_immunity_period","units":"Day","eqn":"(365*6)"},{"type":"aux","name":"Cholera_deaths","units":"people/Day","eqn":"(Heavily_infected_population*effect_of_the_average_state_of_health_services_on_the_fraction_of_cholera_deaths)/average_duration_of_the_illness"},{"type":"aux","name":"cholera_infections","units":"people/Day","eqn":"(Susceptible_population*indirect_infection_rate)"},{"type":"aux","name":"effect_of_prevention_and_sanitation_on_the_indirect_degree_of_infection","units":"Dmnl","eqn":"WITH LOOKUP ( MAX(level_of_prevention, state_of_the_sanitary_infrastructure), ([(0,0)-(1,1)],(0,1),(0.25,0.9),(0.5,0.5),(0.75,0.1),(1,0) ))"},{"type":"aux","name":"effect_of_the_average_state_of_health_services_on_the_fraction_of_cholera_deaths","units":"Dmnl","eqn":"WITH LOOKUP ( average_state_of_health_services, ([(0,0)-(1,1)],(0,1),(0.25,0.5),(0.5,0.2),(0.75,0.05),(1,0) ))"},{"type":"aux","name":"effect_of_the_fraction_of_infected_on_the_fraction_of_contaminated_water","units":"Dmnl","eqn":"WITH LOOKUP ( fraction_of_infected, ([(0,0)-(1,1)],(0,0),(0.125,0.5),(0.25,0.75),(0.5,0.9),(0.75,0.99),(1,1) ))"},{"type":"aux","name":"fraction_of_infected","units":"Dmnl","eqn":"(Heavily_infected_population+Mildly_infected_population+Recently_infected_population)/(Heavily_infected_population+Mildly_infected_population+Recently_infected_population+Recovered_temporarily_immune_population)"},{"type":"aux","name":"heavily_infected","units":"people/Month","eqn":"(Recently_infected_population*(1-average_health_condition))/average_incubation_time"},{"type":"aux","name":"indirect_infection_rate","units":"Dmnl","eqn":"connectedness_of_aquifiers*effect_of_prevention_and_sanitation_on_the_indirect_degree_of_infection*smoothed_fraction_of_contaminated_water"},{"type":"aux","name":"lost_of_immunity","units":"people/Day","eqn":"Recovered_temporarily_immune_population/average_immunity_period"},{"type":"aux","name":"mildly_infected","units":"people/Day","eqn":"(Recently_infected_population*average_health_condition)/average_incubation_time"},{"type":"aux","name":"recovered_from_heavy_infection","units":"people/Day","eqn":"(Heavily_infected_population*effect_of_the_average_state_of_health_services_on_the_fraction_of_cholera_deaths)/average_duration_of_the_illness"},{"type":"aux","name":"recovered_from_mild_infection","units":"people/Day","eqn":"Mildly_infected_population/average_duration_of_the_illness"},{"type":"aux","name":"smoothed_fraction_of_contaminated_water","units":"Dmnl","eqn":"DELAY3I(effect_of_the_fraction_of_infected_on_the_fraction_of_contaminated_water, delay_variable, 0.0004)"},{"type":"aux","name":"average_duration_of_the_illness","units":"Day","eqn":"10"},{"type":"aux","name":"average_health_condition","units":"Dmnl","eqn":"0.95"},{"type":"aux","name":"average_incubation_time","units":"Day","eqn":"1"},{"type":"aux","name":"average_state_of_health_services","units":"Dmnl","eqn":"0.15"},{"type":"aux","name":"connectedness_of_aquifiers","units":"Dmnl","eqn":"0.28"},{"type":"aux","name":"delay_variable","units":"Day","eqn":"14"},{"type":"aux","name":"level_of_prevention","units":"Dmnl","eqn":"0.1"},{"type":"aux","name":"state_of_the_sanitary_infrastructure","units":"Dmnl","eqn":"0.3"}]}