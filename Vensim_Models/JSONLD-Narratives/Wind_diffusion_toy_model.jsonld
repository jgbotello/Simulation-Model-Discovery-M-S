{"backgroundInformation":"This is a toy model of wind energy diffusion based on the Bass diffusion model; it has been created for use by MIT's Sustainable Energy class.","@type":"XMILEModel","modelId":"Wind_diffusion_toy_model","sourceFile":"Wind_diffusion_toy_model.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"0","stop":"50","dt":"0.25"},"variables":[{"type":"stock","name":"Cumulative_GW_wind_capacity_in_Country_X","units":"GW","eqn":"Government_demo_Projects","inflows":["Turbine Installations per Year"],"outflows":[]},{"type":"stock","name":"Potential_GW_wind_capacity_in_Country_X","units":"GW","eqn":"total_potential_GW_wind_capacity_in_Country_X-Government_demo_Projects","inflows":[],"outflows":["Turbine Installations per Year"]},{"type":"aux","name":"annual_profits","units":"$","eqn":"annual_revenue-annual_maintenance_cost"},{"type":"aux","name":"annual_revenue","units":"$","eqn":"estimated_annual_site_output*(electricity_price+price_production_incentive*price_production_present)"},{"type":"aux","name":"annuity_factor","units":"Dmnl","eqn":"(1-(1/(1+interest_rate)^avg_turbine_lifetime))/interest_rate"},{"type":"aux","name":"estimated_annual_site_output","units":"kW*hr","eqn":"average_turbine_size*max_capacity_of_a_wind_site*hours_per_year"},{"type":"aux","name":"feasibility_of_wind","units":"GW/Year","eqn":"IF_THEN_ELSE(total_profitable_sites > 0, MIN(Potential_GW_wind_capacity_in_Country_X,total_profitable_sites*((total_profitable_sites - (total_potential_GW_wind_capacity_in_Country_X - Potential_GW_wind_capacity_in_Country_X) ) / total_profitable_sites)), 0 )"},{"type":"aux","name":"fractional_resistance_to_wind","units":"Dmnl","eqn":"(1 - (Cumulative_GW_wind_capacity_in_Country_X/total_potential_GW_wind_capacity_in_Country_X)*(interaction_rate))"},{"type":"aux","name":"hours_per_year","units":"hr","eqn":"24*365"},{"type":"aux","name":"price_production_present","units":"dimensionless","eqn":"1-1*PULSE_TRAIN(20, 1 , 5, 40)*PTC_switch"},{"type":"aux","name":"total_profitable_sites","units":"GW","eqn":"IF_THEN_ELSE( (total_potential_GW_wind_capacity_in_Country_X * (-1) * LN((upfront_project_costs - grants) / (annuity_factor*annual_profits))) > 0 , (total_potential_GW_wind_capacity_in_Country_X * (-1) * LN((upfront_project_costs - grants) / (annuity_factor*annual_profits)) ), 0 )"},{"type":"aux","name":"Turbine_Installations_per_Year","units":"GW/Year","eqn":"(1-fractional_resistance_to_wind)*feasibility_of_wind"},{"type":"aux","name":"annual_maintenance_cost","units":"$","eqn":"50000"},{"type":"aux","name":"average_turbine_size","units":"kW","eqn":"1000"},{"type":"aux","name":"avg_turbine_lifetime","units":"Dmnl","eqn":"20"},{"type":"aux","name":"electricity_price","units":"$/(kW*hr)","eqn":"0.05"},{"type":"aux","name":"Government_demo_Projects","units":"GW","eqn":"0.005"},{"type":"aux","name":"grants","units":"$","eqn":"0"},{"type":"aux","name":"interaction_rate","units":"dimensionless","eqn":"2"},{"type":"aux","name":"interest_rate","units":"Dmnl","eqn":"0.08"},{"type":"aux","name":"max_capacity_of_a_wind_site","units":"Dmnl","eqn":"0.5"},{"type":"aux","name":"price_production_incentive","units":"$/(kW*hr)","eqn":"0.019"},{"type":"aux","name":"PTC_switch","units":"dimensionless","eqn":"0"},{"type":"aux","name":"total_potential_GW_wind_capacity_in_Country_X","units":"GW","eqn":"8000"},{"type":"aux","name":"upfront_project_costs","units":"$","eqn":"2e+06"}]}