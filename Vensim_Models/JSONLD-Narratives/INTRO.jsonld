{"backgroundInformation":"This is the only model in the sample directory itself.  It is closely related to the workforce inventory model described in Tutorial 2.  In this model there is a fixed workforce and a loop through overtime, morale and productivity that causes the model to oscillate.","@type":"XMILEModel","modelId":"INTRO","sourceFile":"INTRO.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"100","dt":"0.125"},"variables":[{"type":"stock","name":"Average_Worker_Hours","units":"Hour/Month","eqn":"normal_workweek","inflows":["change in hours worked"],"outflows":[]},{"type":"stock","name":"Workforce","units":"Person","eqn":"target_production/normal_productivity","inflows":["net hires"],"outflows":[]},{"type":"aux","name":"change_in_hours_worked","units":"Hour/(Month*Month)","eqn":"(required_worker_hours-Average_Worker_Hours) / delay_in_adding_or_removing_overtime_hours"},{"type":"aux","name":"desired_workforce","units":"Person","eqn":"ZIDZ( target_production, productivity)"},{"type":"aux","name":"morale","units":"Dmnl","eqn":"morale_lookup(Average_Worker_Hours/normal_workweek)"},{"type":"aux","name":"net_hires","units":"Person/Month","eqn":"(desired_workforce-Workforce)/time_to_hire_or_layoff"},{"type":"aux","name":"production","units":"Widget/Month","eqn":"Workforce * required_worker_hours * productivity / normal_workweek"},{"type":"aux","name":"productivity","units":"Widget/(Month*Person)","eqn":"normal_productivity*effect_of_morale_on_productivity_lookup(morale)"},{"type":"aux","name":"required_worker_hours","units":"Hour/Month","eqn":"ZIDZ(target_production, Workforce*productivity) * normal_workweek"},{"type":"aux","name":"sales","units":"Widget/Month","eqn":"IF_THEN_ELSE(Time > 20,120,100)"},{"type":"aux","name":"target_production","units":"Widget/Month","eqn":"sales"},{"type":"aux","name":"effect_of_morale_on_productivity_lookup","units":"Dmnl","eqn":""},{"type":"aux","name":"morale_lookup","units":"Dmnl","eqn":""},{"type":"aux","name":"delay_in_adding_or_removing_overtime_hours","units":"Month","eqn":"3"},{"type":"aux","name":"normal_productivity","units":"Widget/(Month*Person)","eqn":"1"},{"type":"aux","name":"normal_workweek","units":"Hour/Month","eqn":"40"},{"type":"aux","name":"time_to_hire_or_layoff","units":"Month","eqn":"6"}]}