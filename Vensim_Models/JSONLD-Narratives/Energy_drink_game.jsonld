{"backgroundInformation":"Simple game in which -- depending on the position of your product (an energy drink) on its life cycle -- you have to take no, short-term, or long-term action when performance is decreasing.","@type":"XMILEModel","modelId":"Energy_drink_game","sourceFile":"Energy_drink_game.xmile","simSpecs":{"method":"RK4","time_units":"Month","start":"0","stop":"120","dt":"1"},"variables":[{"type":"stock","name":"Potential_Sales_Opportunities","units":"Selling_acts","eqn":"INI","inflows":["new opportunity due to innovation"],"outflows":["premature outflow","sales"]},{"type":"stock","name":"Total_Profit","units":"Euro","eqn":"0","inflows":["profit per period"],"outflows":[]},{"type":"stock","name":"Total_Sales","units":"Selling_acts","eqn":"0","inflows":["sales"],"outflows":[]},{"type":"aux","name":"ALPHA","units":"Dmnl","eqn":"0.001-ButtonGrowth*STEP(0.0005, 30)+ButtonGrowth*STEP(0.0005, 54)"},{"type":"aux","name":"BETA","units":"Dmnl","eqn":"0.04+ShortTermFix*STEP(0.01, 61)-ShortTermFix*STEP(0.01, 90)"},{"type":"aux","name":"new_opportunity_due_to_innovation","units":"Selling_acts/Month","eqn":"IF_THEN_ELSE(LongTermFix :AND: Time>102, INNOVATION_BOOST, 0)"},{"type":"aux","name":"premature_outflow","units":"Selling_acts/Month","eqn":"ButtonMaturity*STEP(MIN(ISSUEOUTFLOW,Potential_Sales_Opportunities), 60)+ButtonDecline*STEP(MIN(ISSUEOUTFLOW,Potential_Sales_Opportunities), 90)"},{"type":"aux","name":"profit_per_period","units":"Euro/Month","eqn":"sales*PRODUCT_PRICE-IF_THEN_ELSE(Time>=60 :AND: Time<=90, ShortTermFix*CostShortTermFix, 0)-IF_THEN_ELSE(Time>=90, LongTermFix*CostLongTermFix, 0)"},{"type":"aux","name":"sales","units":"Selling_acts/Month","eqn":"(ALPHA*Potential_Sales_Opportunities+(BETA/INI)*Potential_Sales_Opportunities*Total_Sales)*REPORTING_TIME"},{"type":"aux","name":"ButtonDecline","units":"Dmnl","eqn":"0"},{"type":"aux","name":"ButtonGrowth","units":"Dmnl","eqn":"0"},{"type":"aux","name":"ButtonMaturity","units":"Dmnl","eqn":"0"},{"type":"aux","name":"CostLongTermFix","units":"Euro","eqn":"42"},{"type":"aux","name":"CostShortTermFix","units":"Euro","eqn":"32"},{"type":"aux","name":"INI","units":"Selling_acts","eqn":"1000"},{"type":"aux","name":"INNOVATION_BOOST","units":"Selling_acts/Month","eqn":"20"},{"type":"aux","name":"ISSUEOUTFLOW","units":"Selling_acts/Month","eqn":"3"},{"type":"aux","name":"LongTermFix","units":"Dmnl","eqn":"0"},{"type":"aux","name":"PRODUCT_PRICE","units":"Euro/Selling_acts","eqn":"10"},{"type":"aux","name":"REPORTING_TIME","units":"1/Month","eqn":"1"},{"type":"aux","name":"ShortTermFix","units":"Dmnl","eqn":"0"}]}