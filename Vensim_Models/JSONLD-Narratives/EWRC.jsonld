{"backgroundInformation":"This is a model of action based on weather forecast.","@type":"XMILEModel","modelId":"EWRC","sourceFile":"EWRC.xmile","simSpecs":{"method":"RK4","time_units":"Day","start":"0","stop":"365","dt":"1"},"variables":[{"type":"stock","name":"Continental_Relief_Item_Storage","units":"tent","eqn":"0","inflows":["Stockpile Supply"],"outflows":["Continental Relief Item Rate"]},{"type":"stock","name":"Counter","units":"Dmnl","eqn":"0","inflows":["Counter Rate"],"outflows":[]},{"type":"stock","name":"Credibility_In_Early_Warning_System","units":"credibility","eqn":"0","inflows":["Credibility Rate"],"outflows":[]},{"type":"stock","name":"Decision_to_act_Counter","units":"","eqn":"0","inflows":["Decision Rate"],"outflows":[]},{"type":"stock","name":"Event_Generator","units":"Dmnl","eqn":"1","inflows":[],"outflows":["Event"]},{"type":"stock","name":"Event_Occured","units":"","eqn":"0","inflows":["Event"],"outflows":[]},{"type":"stock","name":"Flooded_Households","units":"house","eqn":"0","inflows":["Flooding"],"outflows":["House Refurbishment"]},{"type":"stock","name":"Forecast_Lead_Time","units":"Day","eqn":"60","inflows":[],"outflows":["Countdown to Event"]},{"type":"stock","name":"House_Refurbishment","units":"house/Day","eqn":"House_Refurbishment= DELAY_FIXED( Flooded_Households/Time_to_Dry, Time_to_Dry, 0)","inflows":[],"outflows":[]},{"type":"stock","name":"Households_at_Risk","units":"house","eqn":"People_at_Risk/HH_Size","inflows":[],"outflows":["Flooding","House Refurbishment"]},{"type":"stock","name":"HQ_Budget","units":"$","eqn":"300000","inflows":["Funding Rate"],"outflows":["Operating Expense","Relief Item Acquisition"]},{"type":"stock","name":"Local_Relief_Items","units":"tent","eqn":"0","inflows":["Local Relief Item Rate"],"outflows":["Item Provision Rate"]},{"type":"stock","name":"People_at_Risk","units":"people","eqn":"10000","inflows":["People Returning"],"outflows":["Event Displacing People"]},{"type":"stock","name":"People_Needing_Relief_Items","units":"people","eqn":"0","inflows":["Event Displacing People"],"outflows":["Illness","People Item Supply"]},{"type":"stock","name":"People_Receiving_Items","units":"people","eqn":"0","inflows":["People Item Supply"],"outflows":["People Returning"]},{"type":"stock","name":"Regional_Relief_Item_Storage","units":"tent","eqn":"0","inflows":["Continental Relief Item Rate"],"outflows":["Local Relief Item Rate"]},{"type":"stock","name":"Relief_Items_Available","units":"tent","eqn":"1","inflows":["Early Warning Relief Items","Item Provision Rate"],"outflows":[]},{"type":"stock","name":"Sick_People","units":"","eqn":"0","inflows":["Illness"],"outflows":[]},{"type":"aux","name":"Change_in_probability_due_to_unusual_conditions","units":"Dmnl","eqn":"RANDOM_NORMAL( 0.8, 1 , 0.9, 0.1, 0.6) * 10 / Forecast_Lead_Time"},{"type":"aux","name":"Continental_Relief_Item_Rate","units":"tent/Day","eqn":"Continental_Relief_Item_Storage/Reg_Transp_Delay"},{"type":"aux","name":"Countdown_to_Event","units":"1","eqn":"IF_THEN_ELSE(Time < 49, 1, 0)"},{"type":"aux","name":"Counter_Rate","units":"Dmnl","eqn":"IF_THEN_ELSE(People_Item_Supply>0, 1, 0)"},{"type":"aux","name":"Credibility_Rate","units":"credibility","eqn":"IF_THEN_ELSE(Decision_to_act_Counter > 0, Intervention * Event_Occured , 0)"},{"type":"aux","name":"Decision_Rate","units":"","eqn":"Decision_to_Act"},{"type":"aux","name":"Decision_to_Act","units":"Dmnl","eqn":"IF_THEN_ELSE( (Forecast_Warning = 1 :AND: (People_at_Risk * Expected_Cost_Per_Person/HQ_Budget) < 1), 1, 0)"},{"type":"aux","name":"Donations","units":"","eqn":"50*Credibility_In_Early_Warning_System"},{"type":"aux","name":"Early_Warning_Prepared_Items","units":"tent/Day","eqn":"IF_THEN_ELSE(Relief_Items_Available- (People_Receiving_Items/People_per_Item) > 0 :AND: Counter < 1, Relief_Items_Available /Time_early_items, 0)"},{"type":"aux","name":"Early_Warning_Relief_Items","units":"tent/Day","eqn":"IF_THEN_ELSE( Time < 60 :AND: Decision_to_Act = 1, Item_Provision, 0)"},{"type":"aux","name":"Event","units":"","eqn":"IF_THEN_ELSE(Time = 60, 1, 0)"},{"type":"aux","name":"Event_Displacing_People","units":"people/Day","eqn":"IF_THEN_ELSE(Time > 10, Flooding*HH_Size, 0)"},{"type":"aux","name":"Flooding","units":"house/Day","eqn":"IF_THEN_ELSE(Event > 0.5, Households_at_Risk * Event * 0.8, 0)"},{"type":"aux","name":"Forecast_Warning","units":"","eqn":"IF_THEN_ELSE(Magnitude_Comparison = 1 :AND: Probability_Comparison = 1, 1, 0)"},{"type":"aux","name":"Forecasted_Probability","units":"Dmnl","eqn":"Change_in_probability_due_to_unusual_conditions + Probability_on_a_normal_day"},{"type":"aux","name":"Funding_Rate","units":"","eqn":"Donations * Event_Occured"},{"type":"aux","name":"Illness","units":"","eqn":"People_Needing_Relief_Items * 0.01"},{"type":"aux","name":"Interpretation","units":"Dmnl","eqn":"Forecast_Magnitude ( Time)"},{"type":"aux","name":"Intervention","units":"","eqn":"IF_THEN_ELSE((People_Receiving_Items - People_Needing_Relief_Items) > 200 , 1 , -1)"},{"type":"aux","name":"Item_Provision_Rate","units":"tent/Day","eqn":"IF_THEN_ELSE(People_Needing_Relief_Items>10 :AND: Local_Relief_Items>0, Labor_Capacity / Time_per_Item_Provision,0)"},{"type":"aux","name":"Labor_Capacity","units":"people","eqn":"External_Labor +Local_Labor"},{"type":"aux","name":"Local_Relief_Item_Rate","units":"tent/Day","eqn":"Regional_Relief_Item_Storage/Local_Transp_Delay"},{"type":"aux","name":"Magnitude_Comparison","units":"Dmnl","eqn":"IF_THEN_ELSE( Interpretation > Event_Magnitude_Threshold, 1, 0)"},{"type":"aux","name":"Maintenance_Cost","units":"","eqn":"(10*Continental_Relief_Item_Storage+9*Local_Relief_Items+8*Regional_Relief_Item_Storage+5*External_Labor+2.5*Local_Labor) * 0.001"},{"type":"aux","name":"Operating_Expense","units":"","eqn":"Maintenance_Cost"},{"type":"aux","name":"People_Item_Supply","units":"people/Day","eqn":"IF_THEN_ELSE( People_Needing_Relief_Items > 0, (Early_Warning_Prepared_Items + Item_Provision_Rate)*People_per_Item, 0)"},{"type":"aux","name":"People_Returning","units":"people/Day","eqn":"IF_THEN_ELSE(People_Receiving_Items >0, HH_Size*House_Refurbishment, 0)"},{"type":"aux","name":"Probability_Comparison","units":"Dmnl","eqn":"IF_THEN_ELSE(Forecasted_Probability > Acceptable_Prob_Threshold, 1, 0)"},{"type":"aux","name":"Relief_Item_Acquisition","units":"$","eqn":"(Early_Warning_Relief_Items * Usual_Cost ) + ( Stockpile_Supply * Urgent_Cost)"},{"type":"aux","name":"Stockpile_Supply","units":"tent/Day","eqn":"IF_THEN_ELSE( HQ_Budget > 50000, HQ_Budget*0.01 * Event_Occured, 0)"},{"type":"aux","name":"Forecast_Magnitude","units":"Dmnl","eqn":""},{"type":"aux","name":"Acceptable_Prob_Threshold","units":"Dmnl","eqn":"0.5"},{"type":"aux","name":"Event_Magnitude_Threshold","units":"Dmnl","eqn":"0.7"},{"type":"aux","name":"Expected_Cost_Per_Person","units":"$","eqn":"0"},{"type":"aux","name":"External_Labor","units":"people","eqn":"5"},{"type":"aux","name":"HH_Size","units":"people/house","eqn":"5"},{"type":"aux","name":"Item_Provision","units":"tent","eqn":"15"},{"type":"aux","name":"Local_Labor","units":"people","eqn":"10"},{"type":"aux","name":"Local_Transp_Delay","units":"Day","eqn":"7"},{"type":"aux","name":"People_per_Item","units":"people/tent","eqn":"5"},{"type":"aux","name":"Probability_on_a_normal_day","units":"Dmnl","eqn":"0.05"},{"type":"aux","name":"Reg_Transp_Delay","units":"Day","eqn":"21"},{"type":"aux","name":"Time_early_items","units":"Day","eqn":"1"},{"type":"aux","name":"Time_per_Item_Provision","units":"Day/tent","eqn":"1.5"},{"type":"aux","name":"Time_to_Dry","units":"Day","eqn":"165"},{"type":"aux","name":"Urgent_Cost","units":"","eqn":"15"},{"type":"aux","name":"Usual_Cost","units":"","eqn":"5"}]}