{"backgroundInformation":"A case study of balanced scorecard development using system dynamics","@type":"XMILEModel","modelId":"Balanced_scorecard","sourceFile":"Balanced_scorecard.xmile","simSpecs":{"method":"RK4","time_units":"Year","start":"2000","stop":"2005","dt":"0.015625"},"variables":[{"type":"stock","name":"Deel_van_Werkpakket_voor_Intake","units":"Dmnl","eqn":"InitiÃ«el_deel_werkpakket_intake","inflows":["Verandering Deel Werkpakket Intake"],"outflows":[]},{"type":"stock","name":"Dossiers_In_Behandeling","units":"Dossiers","eqn":"InitiÃ«le_Dossiers_in_Behandeling","inflows":["Intake"],"outflows":["Afleggen","Dossiers Uitbesteden"]},{"type":"stock","name":"Ervaren_Medewerkers","units":"Medewerkers","eqn":"InitiÃ«le_Aantal_Ervaren_Medewerkers","inflows":["Inhuur Ervaren Medewerkers","Doorstroom Medewerkers"],"outflows":["Verloop Ervaren Medewerkers"]},{"type":"stock","name":"Gepercipieerde_Werkdruk","units":"Dmnl","eqn":"Normale_Werkdruk","inflows":["Verandering in Perceptie Werkdruk"],"outflows":[]},{"type":"stock","name":"Klanttevredenheid","units":"Dmnl","eqn":"Normale_Klanttevredenheid","inflows":["Verandering in Klanttevredenheid"],"outflows":[]},{"type":"stock","name":"Medewerkertevredenheid","units":"Dimensionless","eqn":"Normale_Medewerker_tevredenheid","inflows":["Verandering Medewerker tevredenheid"],"outflows":[]},{"type":"stock","name":"Meldingen","units":"Dossiers","eqn":"InitiÃ«le_Nieuwe_Meldingen","inflows":["Nieuwe Meldingen"],"outflows":["Intake","Meldingen afgewezen"]},{"type":"stock","name":"Nieuwe_Medewerkers","units":"Medewerkers","eqn":"InitiÃ«le_Aantal_Nieuwe_Medewerkers","inflows":["Inhuur Nieuwe Medewerkers"],"outflows":["Verloop Nieuwe Medewerkers","Doorstroom Medewerkers"]},{"type":"stock","name":"Pink_Noise","units":"Dimensionless","eqn":"0","inflows":["Change in Pink Noise"],"outflows":[]},{"type":"stock","name":"Totale_Expertise_Ervaren_Medewerkers","units":"Medewerker*Werkjaar","eqn":"InitiÃ«le_Totale_Expertise_Ervaren_Medewerkers","inflows":["Toename Expertise door Ervaren Inhuur","Toename Expertise door Dossierervaring Ervaren Medewerkers","Toename Expertise door Doorstroom"],"outflows":["Verlies van Expertise Ervaren Medewerkers door Verloop","Verouderingssnelheid Expertise Ervaren Medewerkers"]},{"type":"stock","name":"Totale_Expertise_Nieuwe_Medewerkers","units":"Medewerker*Werkjaar","eqn":"InitiÃ«le_Totale_Expertise_Nieuwe_Medewerkers","inflows":["Toename Expertise door Inhuur","Toename Expertise door Dossierervaring"],"outflows":["Verlies van Expertise Nieuwe Medewerkers door Verloop","Verouderingssnelheid Expertise Nieuwe Medewerkers","Verlies van Expertise door Doorstroom"]},{"type":"stock","name":"Verloopperc_Ervaren_Medewerkers","units":"1/Jaar","eqn":"Normaal_Verloopperc_Ervaren_Medewerkers","inflows":["Verandering Verloopperc Ervaren Medewerkers"],"outflows":[]},{"type":"stock","name":"Verloopperc_Nieuwe_Medewerkers","units":"1/Jaar","eqn":"Normaal_Verloopperc_Nieuwe_Medewerkers","inflows":["Verandering Verloopperc Nieuwe Medewerkers"],"outflows":[]},{"type":"aux","name":"Aantal_Nieuwe_Medewerkers_per_Ervaren_Medewerkers","units":"Dmnl","eqn":"Nieuwe_Medewerkers/Ervaren_Medewerkers"},{"type":"aux","name":"Actueel_Percentage_Ervaren_Medewerkers_met_Verloopplannen","units":"1/Jaar","eqn":"Normaal_Verloopperc_Ervaren_Medewerkers*Effect_van_Tevredenheid_op_Verloop"},{"type":"aux","name":"Actueel_Percentage_Nieuwe_Medewerkers_met_Verloopplannen","units":"1/Jaar","eqn":"Normaal_Verloopperc_Nieuwe_Medewerkers*Effect_van_Tevredenheid_op_Verloop"},{"type":"aux","name":"Actuele_Doorlooptijd_Afhandeling","units":"Weken","eqn":"(Dossiers_In_Behandeling/(Afleggen+Dossiers_Uitbesteden))*Aantal_weken_per_jaar"},{"type":"aux","name":"Actuele_Doorlooptijd_Intake","units":"Weken","eqn":"(Meldingen/Intake)*Aantal_weken_per_jaar"},{"type":"aux","name":"Actuele_Klanttevredenheid","units":"Dmnl","eqn":"Gewicht_Exogene_Variabele*Bijdrage_Exogene_Variabele_in_Klanttevredenheid+Gewicht_Doorlooptijd*Bijdrage_Doorlooptijd_in_Klanttevredenheid+Gewicht_Expertise*Bijdrage_Expertise_in_Klanttevredenheid"},{"type":"aux","name":"Actuele_Medewerker_tevredenheid","units":"Dmnl","eqn":"Gewicht_van_Werkdruk_op_Tevredenheid*Effect_van_Werkdruk_op_Tevredenheid+Gewicht_van_Fit_Dossiers_op_Tevredenheid*Effect_van_Fit_Dossiers_op_Tevredenheid+Gewicht_van_Opleidingen_op_Tevredenheid*Effect_van_Opleidingen_op_Tevredenheid"},{"type":"aux","name":"Afleggen","units":"Dossiers/Jaar","eqn":"Min((Dossiers_In_Behandeling/Minimale_Afhandelingstijd),Beschikbare_Capaciteit_voor_Afhandeling_in_Dossiers)"},{"type":"aux","name":"Beschikbaarheidspercentage_Ervaren_Medewerkers","units":"Dmnl","eqn":"MAX(0,(Beschikbaarheidspercentage_Exclusief_Vakantie_en_Normaal_Ziekteverzuim-Opleidingen_en_Zittingen_Ervaren_Medewerkers -Effect_Werkdruk_op_Ziekteverzuim))"},{"type":"aux","name":"Beschikbaarheidspercentage_Nieuwe_Medewerkers","units":"Dmnl","eqn":"MAX(0,(Beschikbaarheidspercentage_Exclusief_Vakantie_en_Normaal_Ziekteverzuim-Effect_Werkdruk_op_Ziekteverzuim-Opleidingen_en_Zittingen_Nieuwe_Medewerkers))"},{"type":"aux","name":"Beschikbare_Cap_Ervaren_Medewerkers_voor_Afhandeling","units":"FTE/Jaar","eqn":"Beschikbare_Capaciteit_Ervaren_Medewerkers*(1-Per_Cap_Toewijzing_Intake_Ervaren_Medewerkers)"},{"type":"aux","name":"Beschikbare_Cap_Ervaren_Medewerkers_voor_Intake","units":"FTE/Jaar","eqn":"Min(Beschikbare_Capaciteit_Ervaren_Medewerkers,(Deel_van_Werkpakket_voor_Intake*(Beschikbare_Capaciteit_Nieuwe_Medewerkers+Beschikbare_Capaciteit_Ervaren_Medewerkers)*Nadruk_Ervaren_Medewerkers_voor_Intake))"},{"type":"aux","name":"Beschikbare_Cap_Nieuwe_Medewerkers_voor_Afhandeling","units":"FTE/Jaar","eqn":"Beschikbare_Capaciteit_Nieuwe_Medewerkers*(1-Per_Cap_Toewijzing_Intake_Nieuwe_Medewerkers)"},{"type":"aux","name":"Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake","units":"FTE/Jaar","eqn":"Min(Beschikbare_Capaciteit_Nieuwe_Medewerkers,(Deel_van_Werkpakket_voor_Intake*(Beschikbare_Capaciteit_Nieuwe_Medewerkers+Beschikbare_Capaciteit_Ervaren_Medewerkers)*(1-Nadruk_Ervaren_Medewerkers_voor_Intake)))"},{"type":"aux","name":"Beschikbare_Capaciteit_Ervaren_Medewerkers","units":"FTE/Jaar","eqn":"Totale_capaciteit_Ervaren_Medewerkers*Beschikbaarheidspercentage_Ervaren_Medewerkers"},{"type":"aux","name":"Beschikbare_Capaciteit_Nieuwe_Medewerkers","units":"FTE/Jaar","eqn":"Totale_Capaciteit_Nieuwe_Medewerkers*Beschikbaarheidspercentage_Nieuwe_Medewerkers"},{"type":"aux","name":"Beschikbare_Capaciteit_voor_Afhandeling_in_Dossiers","units":"Dossiers/Jaar","eqn":"Beschikbare_Capaciteit_voor_Afhandeling_in_Tijdseenheden/(Gemiddelde_Werkinhoud_Dossier/Omrekenfactor_van_Week_naar_FTE)"},{"type":"aux","name":"Beschikbare_Capaciteit_voor_Afhandeling_in_Tijdseenheden","units":"FTE/Jaar","eqn":"Beschikbare_Cap_Ervaren_Medewerkers_voor_Afhandeling+Beschikbare_Cap_Nieuwe_Medewerkers_voor_Afhandeling"},{"type":"aux","name":"Beschikbare_Capaciteit_voor_Intake_in_Dossiers","units":"Dossiers/Jaar","eqn":"Beschikbare_Capaciteit_voor_Intake_in_Tijdseenheden/(Gemiddelde_Werkinhoud_Intake/Omrekenfactor_van_Week_naar_FTE)"},{"type":"aux","name":"Beschikbare_Capaciteit_voor_Intake_in_Tijdseenheden","units":"FTE/Jaar","eqn":"Beschikbare_Cap_Ervaren_Medewerkers_voor_Intake+Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake"},{"type":"aux","name":"Bijdrage_Doorlooptijd_in_Klanttevredenheid","units":"Dmnl","eqn":"MAX(0, Min(((Referentiedoorlooptijd_van_Klant-Totale_Actuele_Doorlooptijd)/Referentiedoorlooptijd_van_Klant), 1))"},{"type":"aux","name":"Bijdrage_Expertise_in_Klanttevredenheid","units":"Dmnl","eqn":"MAX(0, Min(((Gemiddelde_Expertise-Referentie_Expertise_van_Klant)/Referentie_Expertise_van_Klant), 1))"},{"type":"aux","name":"Change_in_Pink_Noise","units":"1/Jaar","eqn":"(White_Noise - Pink_Noise)/Noise_Correlation_Time"},{"type":"aux","name":"Doorstroom_Medewerkers","units":"Medewerkers/Jaar","eqn":"Nieuwe_Medewerkers/Groeitijd_tot_Ervaren_Medewerker"},{"type":"aux","name":"Dossiers_door_Ervaren_Medewerkers","units":"Dossiers/Jaar","eqn":"(1-Perc_van_Afhandelcap_door_Nieuwe_Medewerkers)*Afleggen"},{"type":"aux","name":"Dossiers_door_Nieuwe_Medewerkers","units":"Dossiers/Jaar","eqn":"Afleggen*Perc_van_Afhandelcap_door_Nieuwe_Medewerkers"},{"type":"aux","name":"Dossiers_Uitbesteden","units":"Dossiers/Jaar","eqn":"MAX(0, (Dossiers_In_Behandeling*Aantal_weken_per_jaar/Grens_voor_Uitbesteding)-Afleggen)"},{"type":"aux","name":"Druk_op_Aannamebeleid","units":"Dimensionless","eqn":"Gepercipieerde_Werkdruk/Managementnorm_Werkdruk"},{"type":"aux","name":"Effect_van_Fit_Dossiers_op_Tevredenheid","units":"Dmnl","eqn":"1-Perc_van_Intakecap_door_Nieuwe_Medewerkers"},{"type":"aux","name":"Effect_van_Opleidingen_op_Tevredenheid","units":"Dmnl","eqn":"Tabel_voor_Effect_van_Opleidingen_op_Tevredenheid((Opleidingen_en_Zittingen_Ervaren_Medewerkers+Opleidingen_en_Zittingen_Nieuwe_Medewerkers )/2)"},{"type":"aux","name":"Effect_van_Tevredenheid_op_Verloop","units":"Dimensionless","eqn":"Tabel_voor_Effect_van_Tevredenheid_op_Verloop(Medewerkertevredenheid/Normale_Medewerker_tevredenheid)"},{"type":"aux","name":"Effect_van_Werkdruk_op_Gewenst_Medewerkerniveau","units":"1/Jaar","eqn":"Switch_voor_Reactief_Aannamebeleid*Tabel_voor_Effect_van_Werkdruk_op_Aannamebeleid(Druk_op_Aannamebeleid) + (1-Switch_voor_Reactief_Aannamebeleid )*Exogene_Druk_op_Personeelsgroei"},{"type":"aux","name":"Effect_van_Werkdruk_op_Tevredenheid","units":"Dmnl","eqn":"Tabel_voor_Effect_van_Werkdruk_op_Tevredenheid(Gepercipieerde_Werkdruk/Gewenste_Werkdruk_Medewerker)"},{"type":"aux","name":"Effect_Werkdruk_op_Ziekteverzuim","units":"Dmnl","eqn":"Tabel_voor_Effect_Werkdruk_op_Ziekteverzuim(Gepercipieerde_Werkdruk)"},{"type":"aux","name":"Exogene_Druk_op_Personeelsgroei","units":"1/Jaar","eqn":"Groei_volgens_BU_Plan(Time-2000)*(1+Pulse_Inhuur)"},{"type":"aux","name":"Exogene_Expertise_Inhuur_Ervaren_Medewerkers","units":"Werkjaar","eqn":"Expertise_Inhuur_Nieuwe_Medewerkers*Input"},{"type":"aux","name":"Exponent_Leercurve","units":"Dimensionless","eqn":"LN(1+Sterkte_Leercurve)/LN(2)"},{"type":"aux","name":"Exponent_Leercurve_Ervaren","units":"Dimensionless","eqn":"LN(1+Sterkte_Leercurve_Ervaren)/LN(2)"},{"type":"aux","name":"Gemiddelde_Doorlooptijd_Afhandeling","units":"Jaar","eqn":"MAX(Minimale_Afhandelingstijd,Dossiers_In_Behandeling/Beschikbare_Capaciteit_voor_Afhandeling_in_Dossiers)"},{"type":"aux","name":"Gemiddelde_Doorlooptijd_Intake","units":"Jaar","eqn":"MAX(Minimale_Intaketijd,Meldingen/Beschikbare_Capaciteit_voor_Intake_in_Dossiers)"},{"type":"aux","name":"Gemiddelde_Expertise","units":"Werkjaar","eqn":"(Nieuwe_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers+Ervaren_Medewerkers*Gemiddelde_Expertise_Ervaren_Medewerkers)/(Nieuwe_Medewerkers+Ervaren_Medewerkers)"},{"type":"aux","name":"Gemiddelde_Expertise_Ervaren_Inhuur","units":"Werkjaar","eqn":"Exogene_Expertise_Inhuur_Ervaren_Medewerkers"},{"type":"aux","name":"Gemiddelde_Expertise_Ervaren_Medewerkers","units":"Werkjaar","eqn":"Totale_Expertise_Ervaren_Medewerkers/Ervaren_Medewerkers"},{"type":"aux","name":"Gemiddelde_Expertise_Nieuwe_Inhuur","units":"Werkjaar","eqn":"Exogene_Expertise_Inhuur_Ervaren_Medewerkers"},{"type":"aux","name":"Gemiddelde_Expertise_Nieuwe_Medewerkers","units":"Werkjaar","eqn":"Totale_Expertise_Nieuwe_Medewerkers/Nieuwe_Medewerkers"},{"type":"aux","name":"Gemiddelde_verblijftijd_Ervaren_Medewerkers","units":"Jaar","eqn":"Ervaren_Medewerkers/Verloop_Ervaren_Medewerkers"},{"type":"aux","name":"Gemiddelde_verblijftijd_Nieuwe_Medewerkers","units":"Jaar","eqn":"Nieuwe_Medewerkers/(Doorstroom_Medewerkers+Verloop_Nieuwe_Medewerkers)"},{"type":"aux","name":"Gewenst_Aantal_Medewerkers","units":"Medewerkers/Jaar","eqn":"Totaal_Actueel_Aantal_Medewerkers*Effect_van_Werkdruk_op_Gewenst_Medewerkerniveau+(Verloop_Ervaren_Medewerkers+Verloop_Nieuwe_Medewerkers )*(1-Switch_voor_Reactief_Aannamebeleid)"},{"type":"aux","name":"Groei_Dossiers","units":"1/Jaar","eqn":"STEP(Exogene_Groeivoet,Starttijd_Groei)+Groei_volgens_BU_Plan(Time-2000)"},{"type":"aux","name":"Inhuur_Ervaren_Medewerkers","units":"Medewerkers/Jaar","eqn":"MAX(0,DELAY3(Verloop_Ervaren_Medewerkers-Doorstroom_Medewerkers,Inhuurtijd_Ervaren_Medewerkers))"},{"type":"aux","name":"Inhuur_Nieuwe_Medewerkers","units":"Medewerkers/Jaar","eqn":"MAX(0,DELAY3((Gewenst_Aantal_Medewerkers-(Totaal_Actueel_Aantal_Medewerkers/dimensie_variabele)) , Inhuurtijd_Nieuwe_Medewerkers))"},{"type":"aux","name":"InitiÃ«le_Aantal_Ervaren_Medewerkers","units":"","eqn":"Initiële_Totale_Aantal_Medewerkers*(1-Perc_Initiële_Aantal_Nieuwe_Medewerkers)"},{"type":"aux","name":"InitiÃ«le_Aantal_Nieuwe_Medewerkers","units":"","eqn":"Initiële_Totale_Aantal_Medewerkers*Perc_Initiële_Aantal_Nieuwe_Medewerkers"},{"type":"aux","name":"InitiÃ«le_Dossiers_in_Behandeling","units":"","eqn":"(Groei_Dossiers*(Basisaanbod_Dossiers/2)*Referentiedoorlooptijd_Afhandeling/Aantal_weken_per_jaar)"},{"type":"aux","name":"InitiÃ«le_Nieuwe_Meldingen","units":"","eqn":"(Groei_Dossiers*Basisaanbod_Dossiers*Referentiedoorlooptijd_Intake/Aantal_weken_per_jaar)*0+Initiële_Dossiers_in_Behandeling*1"},{"type":"aux","name":"Input","units":"Dimensionless","eqn":"1+STEP(Step_Height,Step_Time)+ (Pulse_Quantity/TIME_STEP)*PULSE(Pulse_Time,TIME_STEP)+ RAMP(Ramp_Slope,Ramp_Start_Time,Ramp_End_Time)+(STEP(1, Exponential_Growth_Time)*(exp(Exponential_Growth_Rate*(Time - Exponential_Growth_Time))-1))+ Sine_Amplitude*SIN(2*3.14159*Time/Sine_Period)+ STEP(1,Noise_Start_Time)*Pink_Noise"},{"type":"aux","name":"Intake","units":"Dossiers/Jaar","eqn":"MAX(0,Min(Meldingen/Minimale_Intaketijd,Beschikbare_Capaciteit_voor_Intake_in_Dossiers))"},{"type":"aux","name":"Intake_door_Ervaren_Medewerkers","units":"Dossiers/Jaar","eqn":"Intake*(1-Perc_van_Intakecap_door_Nieuwe_Medewerkers)"},{"type":"aux","name":"Intake_door_Nieuwe_Medewerkers","units":"Dossiers/Jaar","eqn":"Intake*Perc_van_Intakecap_door_Nieuwe_Medewerkers"},{"type":"aux","name":"Nieuwe_Meldingen","units":"Dossiers/Jaar","eqn":"Basisaanbod_Dossiers*Groei_Dossiers"},{"type":"aux","name":"Normale_Snelheid_van_Leren_Ervaren_Medewerkers","units":"Dmnl","eqn":"100*(1-(1-Tabel_voor_Effect_Coaching_op_Leersnelheid_Ervaren_Medewerkers(Aantal_Nieuwe_Medewerkers_per_Ervaren_Medewerkers ))+0.5*(Opleidingen_en_Zittingen_Ervaren_Medewerkers))"},{"type":"aux","name":"Normale_Snelheid_van_Leren_Nieuwe_Medewerkers","units":"Dmnl","eqn":"100*(1+0.5*Opleidingen_en_Zittingen_Nieuwe_Medewerkers+Tabel_voor_Effect_Coaching_op_Leersnelheid_Nieuwe_Medewerkers(Aantal_Nieuwe_Medewerkers_per_Ervaren_Medewerkers))"},{"type":"aux","name":"Onderhanden_Dossiers_(exclusief_Meldingen)_per_Medewerker","units":"Dossiers/Medewerker","eqn":"Dossiers_In_Behandeling/Totaal_Actueel_Aantal_Medewerkers"},{"type":"aux","name":"Onderhanden_Dossiers_per_Medewerker","units":"Dossiers/Medewerker","eqn":"(Dossiers_In_Behandeling+Meldingen)/Totaal_Actueel_Aantal_Medewerkers"},{"type":"aux","name":"Output_per_Medewerker","units":"Dossiers/(Jaar*Medewerker)","eqn":"Afleggen/Totaal_Actueel_Aantal_Medewerkers"},{"type":"aux","name":"Per_Cap_Toewijzing_Intake_Ervaren_Medewerkers","units":"Dimensionless","eqn":"Beschikbare_Cap_Ervaren_Medewerkers_voor_Intake/Beschikbare_Capaciteit_Ervaren_Medewerkers"},{"type":"aux","name":"Per_Cap_Toewijzing_Intake_Nieuwe_Medewerkers","units":"Dimensionless","eqn":"Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake/Beschikbare_Capaciteit_Nieuwe_Medewerkers"},{"type":"aux","name":"Perc_Uitbesteding","units":"1/Jaar","eqn":"Dossiers_Uitbesteden/Dossiers_In_Behandeling"},{"type":"aux","name":"Perc_van_Afhandelcap_door_Nieuwe_Medewerkers","units":"Dimensionless","eqn":"Beschikbare_Cap_Nieuwe_Medewerkers_voor_Afhandeling/Beschikbare_Capaciteit_voor_Afhandeling_in_Tijdseenheden"},{"type":"aux","name":"Perc_van_Intakecap_door_Nieuwe_Medewerkers","units":"Dimensionless","eqn":"Beschikbare_Cap_Nieuwe_Medewerkers_voor_Intake/Beschikbare_Capaciteit_voor_Intake_in_Tijdseenheden"},{"type":"aux","name":"Productiviteit_Ervaren_Medewerkers","units":"Dossiers/(Jaar*Medewerker)","eqn":"Referentieproductiviteit_Ervaren_Medewerkers*(Gemiddelde_Expertise_Ervaren_Medewerkers/\"Referentie-Expertise_Ervaren_medewerkers\")^Exponent_Leercurve_Ervaren"},{"type":"aux","name":"Productiviteit_Nieuwe_Medewerkers","units":"Dossiers/(Jaar*Medewerker)","eqn":"Referentieproductiviteit_Nieuwe_Medewerkers*(Gemiddelde_Expertise_Nieuwe_Medewerkers/\"Referentie-Expertise_Nieuwe_Medewerkers\")^Exponent_Leercurve"},{"type":"aux","name":"Pulse_Inhuur","units":"Dmnl","eqn":"Pulse_Inhuur_Omvang*PULSE( Pulse_Inhuur_Starttijd,TIME_STEP)"},{"type":"aux","name":"Referentie-Expertise_Ervaren_medewerkers","units":"Werkjaar","eqn":"Initiële_Totale_Expertise_Ervaren_Medewerkers/Initiële_Aantal_Ervaren_Medewerkers"},{"type":"aux","name":"Referentieproductiviteit_Ervaren_Medewerkers","units":"Dossiers/(Jaar*Medewerker)","eqn":"Tabel_voor_Effect_Medewerkertevredenheid_op_Referentieproductiviteit_Ervaren_Medewerkers(Medewerkertevredenheid)"},{"type":"aux","name":"Referentieproductiviteit_Nieuwe_Medewerkers","units":"Dossiers/(Jaar*Medewerker)","eqn":"Tabel_voor_Effect_Medewerkertevredenheid_op_Referentieproductiviteit(Medewerkertevredenheid)"},{"type":"aux","name":"Relatieve_Verouderingssnelheid_Expertise_Ervaren_Medewerkers","units":"1/Jaar","eqn":"Normale_Veroudering_Expertise_Ervaren_Medewerkers + STEP(Verandering_Veroudering_Expertise_Ervaren_Medewerkers,Verouderingstijd_Expertise_Ervaren_Medewerkers)"},{"type":"aux","name":"Relatieve_Verouderingssnelheid_Expertise_Nieuwe_Medewerkers","units":"1/Jaar","eqn":"Normale_Veroudering_Expertise_Nieuwe_Medewerkers + STEP(Verandering_Veroudering_Expertise_Nieuwe_Medewerkers,Verouderingstijd_Expertise_Nieuwe_Medewerkers)"},{"type":"aux","name":"Sterkte_Leercurve","units":"Dimensionless","eqn":"0.25-(((Normale_Snelheid_van_Leren_Nieuwe_Medewerkers-Snelheid_van_Leren_door_Nieuwe_Medewerkers)/Normale_Snelheid_van_Leren_Nieuwe_Medewerkers )*0.25)"},{"type":"aux","name":"Sterkte_Leercurve_Ervaren","units":"Dimensionless","eqn":"0.25-(((Normale_Snelheid_van_Leren_Ervaren_Medewerkers-Snelheid_van_Leren_door_Ervaren_Medewerkers)/Normale_Snelheid_van_Leren_Ervaren_Medewerkers)*0.25)"},{"type":"aux","name":"Toename_Expertise_door_Doorstroom","units":"Medewerker*Werkjaar/Jaar","eqn":"Doorstroom_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers*1.5"},{"type":"aux","name":"Toename_Expertise_door_Dossierervaring","units":"Medewerker*Werkjaar/Jaar","eqn":"Werkjaren_gewerkt_aan_dossiers_Nieuwe_Medewerkers+Werkjaren_gewerkt_aan_Intake_Nieuwe_Medewerkers"},{"type":"aux","name":"Toename_Expertise_door_Dossierervaring_Ervaren_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Werkjaren_gewerkt_aan_dossiers_Ervaren_Medewerkers+Werkjaren_gewerkt_aan_Intake_Ervaren_Medewerkers"},{"type":"aux","name":"Toename_Expertise_door_Ervaren_Inhuur","units":"Medewerker*Werkjaar/Jaar","eqn":"Inhuur_Ervaren_Medewerkers*Gemiddelde_Expertise_Ervaren_Inhuur"},{"type":"aux","name":"Toename_Expertise_door_Inhuur","units":"Medewerker*Werkjaar/Jaar","eqn":"Inhuur_Nieuwe_Medewerkers*Gemiddelde_Expertise_Nieuwe_Inhuur"},{"type":"aux","name":"Totaal_Actueel_Aantal_Medewerkers","units":"Medewerkers","eqn":"Nieuwe_Medewerkers+Ervaren_Medewerkers"},{"type":"aux","name":"Totale_Actuele_Doorlooptijd","units":"Weken","eqn":"Actuele_Doorlooptijd_Afhandeling+Actuele_Doorlooptijd_Intake"},{"type":"aux","name":"Totale_capaciteit_Ervaren_Medewerkers","units":"FTE/Jaar","eqn":"Productiviteit_Ervaren_Medewerkers*Ervaren_Medewerkers*((Basiswerkinhoud_Dossiers)/Omrekenfactor_van_Week_naar_FTE )"},{"type":"aux","name":"Totale_Capaciteit_Nieuwe_Medewerkers","units":"FTE/Jaar","eqn":"Productiviteit_Nieuwe_Medewerkers*Nieuwe_Medewerkers*((Basiswerkinhoud_Dossiers)/Omrekenfactor_van_Week_naar_FTE)"},{"type":"aux","name":"Totale_Referentiedoorlooptijd","units":"Weken","eqn":"Referentiedoorlooptijd_Afhandeling+Referentiedoorlooptijd_Intake"},{"type":"aux","name":"Verandering_Deel_Werkpakket_Intake","units":"1/Jaar","eqn":"(Werkpakket_Intake/(Werkpakket_Intake+Werkpakket_Afhandeling)-Deel_van_Werkpakket_voor_Intake)/Aanpassingtijd_Capaciteitsinzet_Intake"},{"type":"aux","name":"Verandering_in_Klanttevredenheid","units":"1/Jaar","eqn":"(Actuele_Klanttevredenheid-Klanttevredenheid)/Aanpassingstijd_Klanttevredenheid"},{"type":"aux","name":"Verandering_in_Perceptie_Werkdruk","units":"1/Jaar","eqn":"((Werkdrukindicator/Normale_Werkdruk)-Gepercipieerde_Werkdruk)/Perceptieinterval_Werkdruk"},{"type":"aux","name":"Verandering_Medewerker_tevredenheid","units":"1/Jaar","eqn":"(Actuele_Medewerker_tevredenheid-Medewerkertevredenheid)/Aanpassingstijd_Medewerker_tevredenheid"},{"type":"aux","name":"Verandering_Verloopperc_Ervaren_Medewerkers","units":"1/(Jaar*Jaar)","eqn":"(Actueel_Percentage_Ervaren_Medewerkers_met_Verloopplannen-Verloopperc_Ervaren_Medewerkers)/Aanpassingstijd_Verloopperc"},{"type":"aux","name":"Verandering_Verloopperc_Nieuwe_Medewerkers","units":"1/(Jaar*Jaar)","eqn":"(Actueel_Percentage_Nieuwe_Medewerkers_met_Verloopplannen-Verloopperc_Nieuwe_Medewerkers)/Aanpassingstijd_Verloopperc"},{"type":"aux","name":"Verlies_van_Expertise_door_Doorstroom","units":"Medewerker*Werkjaar/Jaar","eqn":"Doorstroom_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers*1.5"},{"type":"aux","name":"Verlies_van_Expertise_Ervaren_Medewerkers_door_Verloop","units":"Medewerker*Werkjaar/Jaar","eqn":"Verloop_Ervaren_Medewerkers*Gemiddelde_Expertise_Ervaren_Medewerkers"},{"type":"aux","name":"Verlies_van_Expertise_Nieuwe_Medewerkers_door_Verloop","units":"Medewerker*Werkjaar/Jaar","eqn":"Verloop_Nieuwe_Medewerkers*Gemiddelde_Expertise_Nieuwe_Medewerkers"},{"type":"aux","name":"Verloop_Ervaren_Medewerkers","units":"Medewerkers/Jaar","eqn":"Verloopperc_Ervaren_Medewerkers*Ervaren_Medewerkers"},{"type":"aux","name":"Verloop_Nieuwe_Medewerkers","units":"Medewerkers/Jaar","eqn":"Verloopperc_Nieuwe_Medewerkers*Nieuwe_Medewerkers"},{"type":"aux","name":"Verouderingssnelheid_Expertise_Ervaren_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Totale_Expertise_Ervaren_Medewerkers*Relatieve_Verouderingssnelheid_Expertise_Ervaren_Medewerkers"},{"type":"aux","name":"Verouderingssnelheid_Expertise_Nieuwe_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Totale_Expertise_Nieuwe_Medewerkers*Relatieve_Verouderingssnelheid_Expertise_Nieuwe_Medewerkers"},{"type":"aux","name":"Werkdrukindicator","units":"Dmnl","eqn":"Totale_Actuele_Doorlooptijd/Totale_Referentiedoorlooptijd"},{"type":"aux","name":"Werkjaren_gewerkt_aan_dossiers_Ervaren_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Dossiers_door_Ervaren_Medewerkers*(Gemiddelde_Werkinhoud_Dossier/Omrekenfactor_van_Week_naar_Werkjaar)"},{"type":"aux","name":"Werkjaren_gewerkt_aan_dossiers_Nieuwe_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Dossiers_door_Nieuwe_Medewerkers*(Gemiddelde_Werkinhoud_Dossier/Omrekenfactor_van_Week_naar_Werkjaar)"},{"type":"aux","name":"Werkjaren_gewerkt_aan_Intake_Ervaren_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Intake_door_Ervaren_Medewerkers*(Gemiddelde_Werkinhoud_Intake/Omrekenfactor_van_Week_naar_Werkjaar)"},{"type":"aux","name":"Werkjaren_gewerkt_aan_Intake_Nieuwe_Medewerkers","units":"Medewerker*Werkjaar/Jaar","eqn":"Intake_door_Nieuwe_Medewerkers*(Gemiddelde_Werkinhoud_Intake/Omrekenfactor_van_Week_naar_Werkjaar)"},{"type":"aux","name":"Werkpakket_Afhandeling","units":"Weken","eqn":"Dossiers_In_Behandeling*Gemiddelde_Werkinhoud_Dossier"},{"type":"aux","name":"Werkpakket_Intake","units":"Weken","eqn":"Meldingen*Gemiddelde_Werkinhoud_Intake"},{"type":"aux","name":"White_Noise","units":"Dimensionless","eqn":"Noise_Standard_Deviation*((24*Noise_Correlation_Time/TIME_STEP)^0.5*(RANDOM_0_1() - 0.5 ))"},{"type":"aux","name":"Groei_volgens_BU_Plan","units":"1/Jaar","eqn":""},{"type":"aux","name":"Tabel_voor_Effect_Coaching_op_Leersnelheid_Ervaren_Medewerkers","units":"Dmnl","eqn":""},{"type":"aux","name":"Tabel_voor_Effect_Coaching_op_Leers