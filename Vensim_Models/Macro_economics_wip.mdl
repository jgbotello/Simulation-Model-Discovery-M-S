{UTF-8}
Pdty Indicated Wages=
	(Income*Beta)/Employed Labor
	~	$/(Person*Year)
	~	(Effect of Unemployment on Wages*Test Switch + 1-Test \
		Switch)*(Income*Beta)/Employed Labor
	|

Time to Perceive Worker Pdty=
	0.25
	~	Years
	~		|

Max Effect of Inflation on Wages=
	2
	~	Dimensionless
	~	1.5
	|

Initial Variation in Ref Unempl Rate=
	1
	~	Dimensionless
	~		|

Initial Variation in Ref Wkr Pdty=
	0.99
	~	Dimensionless
	~		|

Initial Variation Perc Unemp Rate=
	1
	~	Dimensionless
	~		|

Max Effect of Worker Pdty on Wages=
	2
	~	Dimensionless
	~	1.5
	|

Initial Wages=
	30000
	~	$/Person/Year
	~		|

Rate of Change in Worker Pdty=
	Change in Worker Productiivity*Percent
	~	Percent/Year
	~		|

Effect of Pdty Expectations on Wages=
	2*(Max Effect of Worker Pdty on Wages-1)/(1+exp(-(Expected Chg in Worker Pdty)*Sensitivity of Worker Pdty on Wages\
		))+(
	2-Max Effect of Worker Pdty on Wages)
	~	Dimensionless
	~	2*(Max Effect of Wealth on Savings-1)/(1+exp(-(Perceived Wealth Ratio-1)*Sensitivity \
		of Wealth on Savings))+(
		2-Max Effect of Wealth on Savings)
	|

Initial Exp Chg in Unemployment=
	0
	~	Fraction/Year
	~		|

Expected Chg in Worker Pdty= INTEG (
	Expectations Adjustment Worker Pdty,
		Initial Expected Chg in Worker Pdty)
	~	Fraction/Year
	~		|

Initial Expected Chg in Worker Pdty=
	0.002
	~	Fraction/Year
	~		|

Adjustment of Pdty Expectations=
	(Perceived Worker Pdty - Reference Woker Productivity)/Time Horizon to Assess Worker Pdty
	~	Goods/Year/Person/Year
	~		|

Time Horizon to Assess Worker Pdty=
	2
	~	Years
	~		|

Expected Percent Chg of Worker Pdty=
	Expected Chg in Worker Pdty*Percent
	~	Percent/Year
	~		|

Sensitivity of Worker Pdty on Wages=
	3
	~	Years [0,20,0.5]
	~		|

Initial Variation in Perc Wkr Pdty=
	0.995
	~	Dimensionless
	~		|

Perceived Worker Pdty= INTEG (
	Worker Pdty Perception,
		Worker Productivity*Initial Variation in Perc Wkr Pdty)
	~	Percent
	~		|

Time to Adjust Expectations Pdty=
	2
	~	Years
	~		|

Worker Pdty Perception=
	(Worker Productivity - Perceived Worker Pdty)/Time to Perceive Worker Pdty
	~	Goods/Year/Person/Year
	~		|

Change in Worker Productiivity=
	(Perceived Worker Pdty - Reference Woker Productivity)/Reference Woker Productivity/\
		Time Horizon to Assess Worker Pdty
	~	Fraction/Year
	~		|

Reference Woker Productivity= INTEG (
	Adjustment of Pdty Expectations,
		Worker Productivity*Initial Variation in Ref Wkr Pdty)
	~	Goods/Year/Person
	~		|

Chg in Nominal Wages=
	Wages/Initial Wages
	~	Dimensionless
	~		|

Expectations Adjustment Worker Pdty=
	(Change in Worker Productiivity - Expected Chg in Worker Pdty)/Time to Adjust Expectations Pdty
	~	(Fraction/Year)/Year
	~		|

Worker Productivity=
	Production/Applied Labor
	~	Goods/Year/Person
	~		|

Effect of Inflaton Expectations on Wages=
	2*(Max Effect of Inflation on Wages-1)/(1+exp(-(Expected Money Inflation)*Sensitivity of Inlation on Wages\
		))+(
	2-Max Effect of Inflation on Wages)
	~	Dimensionless
	~	2*(Max Effect of Wealth on Savings-1)/(1+exp(-(Perceived Wealth Ratio-1)*Sensitivity \
		of Wealth on Savings))+(
		2-Max Effect of Wealth on Savings)
	|

Sensitivity of Inlation on Wages=
	3
	~	Years [0,20,0.5]
	~		|

Tax Transition=
	MIN(1,MAX(0,XIDZ( Time - Time to Change Gov Budget Growth Rate, Time to Stop Change in Gov Budget Growth Rate\
		-Time to Change Gov Budget Growth Rate,Default Tax Transition
	)))
	~	Dimensionless
	~		|

Time to Change Gov Budget Growth Rate=
	0
	~	Year
	~		|

Initial Tax Rate=
	20
	~	Percent
	~		|

Initial Final Tax Rate=
	20
	~	Percent
	~		|

Time to Adjut Final Tax Rate=
	10
	~	Years
	~		|

Time to Stop Change in Gov Budget Growth Rate=
	0
	~	Year
	~		|

Final Tax Rate= INTEG (
	Adjustment of Final Tax Rate,
		Initial Tax Rate)
	~	Percent
	~		|

Initial Working Population=
	1.75e+06
	~	People
	~		|

Default Tax Transition=
	1
	~	Dimensionless
	~		|

Adjustment of Final Tax Rate=
	((Gov Spending Share of Income - Final Tax Rate)/Time to Adjut Final Tax Rate)*IF THEN ELSE\
		(Tax Transition = 0, 0 , 1 )
	~	Percent/Year
	~		|

Adj of Norm Share of Work Pop in Labor Pool=
	(Constrained Share of Work Pop in Labor Pool - Normal Share of Working Pop in Labor Pool\
		)/Time to Adjust Norm Share of Work Pop in Labor Pool
	~	Percent/Year
	~		|

Maximum Share of Working Pop in Labor Pool=
	70
	~	Percent
	~		|

Sensitivity of Labor Pool to Chg in Unemployment=
	1.5
	~	Dimensionless
	~		|

Max Eff of Chg in Unemploy on Labor Pool=
	1.25
	~	Dimensionless
	~		|

