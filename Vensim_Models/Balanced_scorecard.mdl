{UTF-8}
Basiswerkinhoud Dossiers=
	0.5
	~	Weken/Dossier
	~	De gemiddelde hoeveelheid werk die gedaan moet worden om een dossier te \
		verwerken.
	|

Intake door Ervaren Medewerkers=
	Intake*(1-Perc van Intakecap door Nieuwe Medewerkers)
	~	Dossiers/Jaar
	~	Het aantal Meldingen dat per jaar door Ervaren Medewerkers wordt verwerkt \
		(Intake).
	|

Intake door Nieuwe Medewerkers=
	Intake*Perc van Intakecap door Nieuwe Medewerkers
	~	Dossiers/Jaar
	~	Het aantal Meldingen dat per jaar door Nieuwe Medewerkers wordt verwerkt \
		(Intake).
	|

Werkjaren gewerkt aan Intake Ervaren Medewerkers=
	Intake door Ervaren Medewerkers*(Gemiddelde Werkinhoud Intake/Omrekenfactor van Week naar Werkjaar\
		)
	~	Medewerker*Werkjaar/Jaar
	~	Het gemiddeld aantal werkjaren dat aan Intake gewerkt is door Ervaren \
		Medewerkers per jaar.
	|

Grens voor Uitbesteding=
	1000
	~	Weken
	~	Als de doorlooptijd langer wordt dan deze grens, dan gaat er uitbesteed \
		worden.
	|

Werkjaren gewerkt aan Intake Nieuwe Medewerkers=
	Intake door Nieuwe Medewerkers*(Gemiddelde Werkinhoud Intake/Omrekenfactor van Week naar Werkjaar\
		)
	~	Medewerker*Werkjaar/Jaar
	~	Het gemiddeld aantal werkjaren dat aan Intake gewerkt is door Nieuwe \
		Medewerkers per jaar.
	|

Gemiddelde Werkinhoud Intake=
	0.1
	~	Weken/Dossier
	~	Het aantal weken dat gemiddeld gewerkt moet worden aan een Intake.
	|

Aantal Nieuwe Medewerkers per Ervaren Medewerkers=
	Nieuwe Medewerkers/Ervaren Medewerkers
	~	Dmnl
	~	Een verhoudingsgetal dat aangeeft hoeveel nieuwe medewerkers ingewerkt \
		moeten worden door één ervaren medewerker.
	|

Tabel voor Effect Coaching op Leersnelheid Nieuwe Medewerkers(
	[(0,0)-(10,1)],(0,0),(0.1,0.29386),(0.733945,0.258772),(1.43731,0.197368),(2.23242,0.118421\
		),(3.5474,0.0701754),(4.89297,0.0526316),(5.01529,0.0526316),(6.6055,0.0350877),(9.96942\
		,0.00438596))
	~	Dmnl
	~	Een tabel/grafiek die aangeeft dat hoe minder Nieuwe Medewerkers ingewerkt \
		moeten worden door één Ervaren Medewerker, hoe hoger de snelheid van \
		leren van deze Nieuwe Medewerkers zal zijn.\!\!\!
	|

Normale Snelheid van Leren Nieuwe Medewerkers=
	100*(1+0.5*Opleidingen en Zittingen Nieuwe Medewerkers+Tabel voor Effect Coaching op Leersnelheid Nieuwe Medewerkers\
		(Aantal Nieuwe Medewerkers per Ervaren Medewerkers))
	~	Dmnl
	~	De normale snelheid waarmee medewerkers leren heeft een constante waarde \
		van 100 en kan worden verhoogd als zij opleidingen volgen en als zij door \
		veel ervaren medewerkers ingewerkt/gecoacht kunnen worden.
	|

Toename Expertise door Doorstroom=
	Doorstroom Medewerkers*Gemiddelde Expertise Nieuwe Medewerkers*1.5
	~	Medewerker*Werkjaar/Jaar
	~	De expertise van ervaren medewerkers neemt toe doordat nieuwe medewerkers \
		doorstromen en ervaren worden en hun expertise meenemen.
	|

Verlies van Expertise door Doorstroom=
	Doorstroom Medewerkers*Gemiddelde Expertise Nieuwe Medewerkers*1.5
	~	Medewerker*Werkjaar/Jaar
	~	De totale expertise van nieuwe medewerkers vermindert doordat nieuwe \
		medewerkers doorstromen en ervaren worden en hun expertise meenemen.
	|

Tabel voor Effect Coaching op Leersnelheid Ervaren Medewerkers(
	[(0,0)-(10,1)],(0,1),(10,0.8))
	~	Dmnl
	~	Een tabel/grafiek die aangeeft dat hoe meer Nieuwe Medewerkers ingewerkt \
		moeten worden door één Ervaren Medewerker, hoe lager de snelheid van \
		leren van deze Ervaren Medewerker zal zijn.\!\!
	|

Output per Medewerker=
	Afleggen/Totaal Actueel Aantal Medewerkers
	~	Dossiers/(Jaar*Medewerker)
	~	De output die per medewerker gerealiseerd wordt.
	|

Referentie Expertise van Klant=
	3
	~	Werkjaar
	~	De klant gaat er van uit dat medewerkers gemiddeld drie jaar ervaring \
		hebben.
	|

Gewicht van Opleidingen op Tevredenheid=
	3.33
	~	Dmnl
	~	Belang van de opleidingen van medewerkers in het bepalen van de \
		Medewerkertevredenheid.
	|

Tabel voor Effect van Opleidingen op Tevredenheid(
	[(0,0)-(1,1)],(0,0),(0.11315,0.557018),(0.195719,0.758772),(0.259939,0.877193),(0.333333\
		,0.938596),(0.41896,0.97807),(0.5,1.00439))
	~	Dmnl
	~	Een tabel/grafiek waarin de relatie tussen opleidingen (horizontale as) en \
		tevredenheid (verticale as) wordt weergegeven.\!\!
	|

********************************************************
	.Mdl
********************************************************~
		Business Balanced Scorecard Strategie Validatie-Model voor Stichting \
		Rechtsbijstand Interpolis. Minase, december 2001
	|

Totale Capaciteit Nieuwe Medewerkers=
	Productiviteit Nieuwe Medewerkers*Nieuwe Medewerkers*((Basiswerkinhoud Dossiers)/Omrekenfactor van Week naar FTE\
		)
	~	FTE/Jaar
	~	Totale Capaciteit van Nieuwe Medewerkers uitgedrukt in FTE's per jaar.
	|

Totale capaciteit Ervaren Medewerkers=
	Productiviteit Ervaren Medewerkers*Ervaren Medewerkers*((Basiswerkinhoud Dossiers)/Omrekenfactor van Week naar FTE
	)
	~	FTE/Jaar
	~	Totale Capaciteit van Ervaren Medewerkers uitgedrukt in FTE's per jaar.
	|

Dossiers Uitbesteden=
	MAX(0, (Dossiers In Behandeling*Aantal weken per jaar/Grens voor Uitbesteding)-Afleggen\
		)
	~	Dossiers/Jaar
	~	Het aantal Dossiers dat per jaar in weggewerkt wordt.
	|

Actuele Doorlooptijd Afhandeling=
	(Dossiers In Behandeling/(Afleggen+Dossiers Uitbesteden))*Aantal weken per jaar
	~	Weken
	~	De actuele verblijftijd van dossiers in behandeling, gemiddeld gezien.
	|

Toename Expertise door Dossierervaring=
	Werkjaren gewerkt aan dossiers Nieuwe Medewerkers+Werkjaren gewerkt aan Intake Nieuwe Medewerkers
	~	Werkjaar*Medewerker/Jaar
	~	Expertise groeit na inhuur vooral door ervaring in het afhandelen van \
		dossiers.
	|

Toename Expertise door Dossierervaring Ervaren Medewerkers=
	Werkjaren gewerkt aan dossiers Ervaren Medewerkers+Werkjaren gewerkt aan Intake Ervaren Medewerkers
	~	Medewerker*Werkjaar/Jaar
	~	Expertise groeit na inhuur vooral door ervaring in het afhandelen van \
		dossiers.
	|

Perc Uitbesteding=
	Dossiers Uitbesteden/Dossiers In Behandeling
	~	1/Jaar
	~	Het percentage van de Dossiers in Behandeling dat per jaar uitbesteed \
		wordt.
	|

Beschikbare Capaciteit voor Intake in Dossiers=
	Beschikbare Capaciteit voor Intake in Tijdseenheden/(Gemiddelde Werkinhoud Intake/Omrekenfactor van Week naar FTE\
		)
	~	Dossiers/Jaar
	~	Aantal Dossiers in Intake die Nieuwe en Ervaren Medewerkers per jaar \
		kunnen verwerken op basis van hun Beschikbare Capaciteit.
	|

Werkpakket Intake=
	Meldingen*Gemiddelde Werkinhoud Intake
	~	Weken
	~	De gemiddelde hoeveelheid werk (in weken) die verzet moet worden om de \
		voorraad Meldingen te verwerken.
	|

Totale Expertise Nieuwe Medewerkers= INTEG (
	Toename Expertise door Inhuur - 
	Verlies van Expertise Nieuwe Medewerkers door Verloop + Toename Expertise door Dossierervaring\
		 - Verouderingssnelheid Expertise Nieuwe Medewerkers-Verlies van Expertise door Doorstroom\
		,
		Initiële Totale Expertise Nieuwe Medewerkers)
	~	Medewerker*Werkjaar
	~	De totale expertise in aantal menswerkjaren voor de gehele populatie \
		nieuwe medewerkers
	|

"Referentie-Expertise Ervaren medewerkers"=
	Initiële Totale Expertise Ervaren Medewerkers/Initiële Aantal Ervaren Medewerkers
	~	Werkjaar
	~	Het referentieniveau van Expertise dat past bij de \
		Referentieproductiviteit.
	|

Normale Snelheid van Leren Ervaren Medewerkers=
	100*(1-(1-Tabel voor Effect Coaching op Leersnelheid Ervaren Medewerkers(Aantal Nieuwe Medewerkers per Ervaren Medewerkers
	))+0.5*(Opleidingen en Zittingen Ervaren Medewerkers))
	~	Dmnl
	~	De normale snelheid waarmee medewerkers leren heeft een constante waarde \
		van 100 en kan worden verhoogd als zij opleidingen volgen en kan worden \
		verlaagd als zij heel veel nieuwe medewerkers moeten inwerken/coachen.
	|

Verouderingssnelheid Expertise Nieuwe Medewerkers=
	Totale Expertise Nieuwe Medewerkers*Relatieve Verouderingssnelheid Expertise Nieuwe Medewerkers
	~	Medewerker*Werkjaar/Jaar
	~	De hoeveelheid expertise die de populatie nieuwe medewerkers kwijtraakt \
		per periode
	|

Sterkte Leercurve=
	0.25-(((Normale Snelheid van Leren Nieuwe Medewerkers-Snelheid van Leren door Nieuwe Medewerkers\
		)/Normale Snelheid van Leren Nieuwe Medewerkers
	)*0.25)
	~	Dimensionless
	~	De fractionele toename in productiviteit als expertise verdubbelt.
	|

Verouderingssnelheid Expertise Ervaren Medewerkers=
	Totale Expertise Ervaren Medewerkers*Relatieve Verouderingssnelheid Expertise Ervaren Medewerkers
	~	Medewerker*Werkjaar/Jaar
	~	De hoeveelheid expertise die de populatie ervaren medewerkers kwijtraakt \
		per periode.
	|

Totale Expertise Ervaren Medewerkers= INTEG (
	Toename Expertise door Ervaren Inhuur - 
	Verlies van Expertise Ervaren Medewerkers door Verloop + Toename Expertise door Dossierervaring Ervaren Medewerkers\
		 - Verouderingssnelheid Expertise Ervaren Medewerkers+Toename Expertise door Doorstroom\
		,
		Initiële Totale Expertise Ervaren Medewerkers)
	~	Werkjaar*Medewerker
	~	De totale expertise in aantal menswerkjaren voor de gehele populatie \
		nieuwe medewerkers.
	|

Initiële Nieuwe Meldingen=
	(Groei Dossiers*Basisaanbod Dossiers*Referentiedoorlooptijd Intake/Aantal weken per jaar\
		)*0+Initiële Dossiers in Behandeling*1
	~	Dossiers
	~	Het aantal Nieuwe Meldingen op tijdstip 0 (als de simulatie begint).
	|

Pulse Inhuur=
	Pulse Inhuur Omvang*PULSE( Pulse Inhuur Starttijd,TIME STEP)
	~	Dmnl
	~	Met Pulse Inhuur kan getest worden wat er met het systeem gebeurt als een \
		bepaald aantal Medewerkers tegelijkertijd aangenomen wordt op een zeker \
		tijdstip.
	|

Initiële Dossiers in Behandeling=
	(Groei Dossiers*(Basisaanbod Dossiers/2)*Referentiedoorlooptijd Afhandeling/Aantal weken per jaar\
		)
	~	Dossiers
	~	Het aantal Dossiers in Behandeling op tijdstip 0 (als de simulatie begint).
	|

Bijdrage Expertise in Klanttevredenheid=
	MAX(0, Min(((Gemiddelde Expertise-Referentie Expertise van Klant)/Referentie Expertise van Klant\
		), 1))
	~	Dmnl
	~	De gemiddelde expertise van medewerkers die door klanten opgemerkt wordt \
		t.o.v. de gemiddelde expertise van ervaren medewerkers die klanten graag \
		zouden willen hebben.
	|

Gewenst Aantal Medewerkers=
	Totaal Actueel Aantal Medewerkers*Effect van Werkdruk op Gewenst Medewerkerniveau+(Verloop Ervaren Medewerkers\
		+Verloop Nieuwe Medewerkers
	)*(1-Switch voor Reactief Aannamebeleid)
	~	Medewerkers/Jaar
	~	Het Gewenst Aantal Medewerkers is gebaseerd op het actuele aantal \
		medewerkers en naar boven of beneden aangepast op basis van de druk op \
		aannamebeleid.
	|

Effect van Opleidingen op Tevredenheid=
	Tabel voor Effect van Opleidingen op Tevredenheid((Opleidingen en Zittingen Ervaren Medewerkers\
		+Opleidingen en Zittingen Nieuwe Medewerkers
)/2)
	~	Dmnl
	~	Het gemiddelde percentage van de totale beschikbare capaciteit dat \
		medewerkers aan opleidingen en zittingen mogen besteden.
	|

Beschikbaarheidspercentage Ervaren Medewerkers=
	MAX(0,(Beschikbaarheidspercentage Exclusief Vakantie en Normaal Ziekteverzuim-Opleidingen en Zittingen Ervaren Medewerkers
-Effect Werkdruk op Ziekteverzuim))
	~	Dmnl
	~	Het percentage dat aangeeft hoeveel netto tijd ervaren medewerkers \
		beschikbaar zijn om aan dossiers te werken.
	|

Afleggen=
	Min((Dossiers In Behandeling/Minimale Afhandelingstijd),Beschikbare Capaciteit voor Afhandeling in Dossiers\
		)
	~	Dossiers/Jaar
	~	Het aantal Dossiers dat per jaar afgelegd wordt.
	|

Actuele Medewerker tevredenheid=
	Gewicht van Werkdruk op Tevredenheid*Effect van Werkdruk op Tevredenheid+Gewicht van Fit Dossiers op Tevredenheid\
		*Effect van Fit Dossiers op Tevredenheid+Gewicht van Opleidingen op Tevredenheid*Effect van Opleidingen op Tevredenheid
	~	Dmnl
	~	De mate van Medewerkertevredenheid die bepaald wordt door de \
		gepercipieerde werkdruk en de fit tussen (inhoud) dossiers en interesses \
		van medewerkers.
	|

Sterkte Leercurve Ervaren=
	0.25-(((Normale Snelheid van Leren Ervaren Medewerkers-Snelheid van Leren door Ervaren Medewerkers\
		)/Normale Snelheid van Leren Ervaren Medewerkers)*0.25)
	~	Dimensionless
	~	De fractionele toename in productiviteit als expertise verdubbelt.
	|

Initiëel deel werkpakket intake=
	0.25
	~	Dimensionless
	~		|

Beschikbaarheidspercentage Nieuwe Medewerkers=
	MAX(0,(Beschikbaarheidspercentage Exclusief Vakantie en Normaal Ziekteverzuim-Effect Werkdruk op Ziekteverzuim\
		-Opleidingen en Zittingen Nieuwe Medewerkers))
	~	Dmnl
	~	Het percentage dat aangeeft hoeveel netto tijd nieuwe medewerkers \
		beschikbaar zijn om aan dossiers te werken.
	|

Beschikbaarheidspercentage Exclusief Vakantie en Normaal Ziekteverzuim=
	0.8
	~	Dmnl
	~	Een gemiddeld ziekteverzuimpercentage van 5% en 40 vakantiedagen leveren \
		190 werkdagen per jaar op. Vergeleken met maximaal 240 werkdagen is dit \
		een beschikbaarheidspercentage van 80%.
	|

Opleidingen en Zittingen Nieuwe Medewerkers=
	0.1
	~	Dmnl
	~	Het beschikbaarheidspercentage wordt verminderd doordat werknemers \
		opleidingen volgen en zittingen bijwonen.
	|

Snelheid van Leren door Nieuwe Medewerkers=
	90
	~	Dmnl
	~	De snelheid waarmee nieuwe medewerkers leren. Dit kan een andere snelheid \
		zijn dan de normale snelheid.
	|

Opleidingen en Zittingen Ervaren Medewerkers=
	0.1
	~	Dmnl
	~	Het beschikbaarheidspercentage wordt verminderd doordat werknemers \
		opleidingen volgen en zittingen bijwonen.
	|

Snelheid van Leren door Ervaren Medewerkers=
	120
	~	Dmnl
	~	De snelheid waarmee ervaren medewerkers leren. Dit kan een andere snelheid \
		zijn dan de normale snelheid.
	|

Effect Werkdruk op Ziekteverzuim=
	Tabel voor Effect Werkdruk op Ziekteverzuim(Gepercipieerde Werkdruk)
	~	Dmnl
	~	Het percentage ziekteverzuim, dat veroorzaakt wordt door de gepercipieerde \
		werkdruk.
	|

Onderhanden Dossiers per Medewerker=
	(Dossiers In Behandeling+Meldingen)/Totaal Actueel Aantal Medewerkers
	~	Dossiers/Medewerker
	~	Het gemiddelde aantal dossiers (zowel Meldingen als Dossiers in \
		Behandeling) dat elke medewerker onderhanden heeft.
	|

Tabel voor Effect Werkdruk op Ziekteverzuim(
	[(0,0)-(10,0.15)],(0,0.05),(0.5,0.01),(1,0),(1.5,0.01),(2,0.05),(3.11927,0.0855263),\
		(5.29052,0.126096),(10,0.148026))
	~	Dmnl
	~	Een tabel/grafiek die de relatie tussen gepercipieerde werkdruk \
		(horizontale as) en ziekteverzuim (verticale as) weergeeft.\!\!\!
	|

"Onderhanden Dossiers (exclusief Meldingen) per Medewerker"=
	Dossiers In Behandeling/Totaal Actueel Aantal Medewerkers
	~	Dossiers/Medewerker
	~	Het gemiddelde aantal dossiers (alleen Dossiers in Behandeling) dat elke \
		medewerker onderhanden heeft.
	|

dimensie variabele=
	1
	~	Jaar
	~	Variabele die nodig is om de units van het model kloppend te maken
	|

Aanpassingstijd Klanttevredenheid=
	0.25
	~	Jaar
	~	Aanpassingstijd die klanten nodig hebben om een verandering in hun \
		tevredenheid op te merken of daadwerkelijk te voelen.
	|

Actuele Klanttevredenheid=
	Gewicht Exogene Variabele*Bijdrage Exogene Variabele in Klanttevredenheid+Gewicht Doorlooptijd\
		*Bijdrage Doorlooptijd in Klanttevredenheid+Gewicht Expertise*Bijdrage Expertise in Klanttevredenheid
	~	Dmnl
	~	De mate van Klanttevredenheid die bepaald wordt door een exogene \
		variabele, de doorlooptijd en de expertise van medewerkers.
	|

Bijdrage Doorlooptijd in Klanttevredenheid=
	MAX(0, Min(((Referentiedoorlooptijd van Klant-Totale Actuele Doorlooptijd)/Referentiedoorlooptijd van Klant\
		), 1))
	~	Dmnl
	~	Het verschil tussen de totale actuele doorlooptijd en de \
		referentiedoorlooptijd van de klant als percentage van de \
		referentiedoorlooptijd van de klant.
	|

Bijdrage Exogene Variabele in Klanttevredenheid=
	1
	~	Dmnl
	~	Een exogene variabele die een algemene mate van klant(on-)tevredenheid \
		uitdrukt (tussen 0 en 1).
	|

Gewicht Expertise=
	3.33
	~	Dmnl
	~	Belang van de expertise in het bepalen van de Klanttevredenheid.
	|

Gemiddelde Expertise=
	(Nieuwe Medewerkers*Gemiddelde Expertise Nieuwe Medewerkers+Ervaren Medewerkers*Gemiddelde Expertise Ervaren Medewerkers\
		)/(Nieuwe Medewerkers+Ervaren Medewerkers)
	~	Werkjaar
	~	Gemiddelde Expertise van alle medewerkers (zowel nieuw als ervaren).
	|

Gewicht Exogene Variabele=
	3.33
	~	Dmnl
	~	Belang van de exogene variabele in het bepalen van de Klanttevredenheid.
	|

Gewicht Doorlooptijd=
	3.33
	~	Dmnl
	~	Belang van de doorlooptijd in het bepalen van de Klanttevredenheid.
	|

Referentiedoorlooptijd van Klant=
	30
	~	Weken
	~	De doorlooptijd waar een klant op rekent.
	|

Normale Klanttevredenheid=
	5
	~	Dimensionless
	~	De Klanttevredenheid die als uitgangspunt wordt genomen, op tijdstip 0 \
		(als de simulatie begint).
	|

Klanttevredenheid= INTEG (
	Verandering in Klanttevredenheid,
		Normale Klanttevredenheid)
	~	Dmnl
	~	De mate waarin klanten tevreden zijn met de door SRB geleverde diensten.
	|

Verandering in Klanttevredenheid=
	(Actuele Klanttevredenheid-Klanttevredenheid)/Aanpassingstijd Klanttevredenheid
	~	1/Jaar
	~	De mate waarin de klanttevredenheid verandert per jaar.
	|

Effect van Fit Dossiers op Tevredenheid=
	1-Perc van Intakecap door Nieuwe Medewerkers
	~	Dmnl
	~	Het percentage van de intakecapaciteit dat door Ervaren Medewerkers wordt \
		ingevuld en dus het percentage van de Intake waarvoor een juiste fit wordt \
		gevonden.
	|

Gewicht van Fit Dossiers op Tevredenheid=
	3.33
	~	Dmnl
	~	Belang van de fit tussen dossiers en medewerkers in het bepalen van de \
		Medewerkertevredenheid.
	|

Tabel voor Effect Medewerkertevredenheid op Referentieproductiviteit(
	[(0,100)-(10,150)],(0.152905,100),(1.6208,102.193),(2.32416,104.386),(3.08869,108.04\
		),(4.25076,114.693),(5.29052,121.491),(5.8104,125.877),(6.23853,130.263),(7.00306,136.404\
		),(7.76758,143.421),(8.7156,147.588),(9.93884,149.561))
	~	Dossiers/(Jaar*Medewerker)
	~	Een tabel/grafiek waarin de relatie tussen medewerkertevredenheid \
		(horizontale as) en referentieproductiviteit van nieuwe medewerkers \
		(verticale as) wordt weergegeven.\!\!\!
	|

Tabel voor Effect Medewerkertevredenheid op Referentieproductiviteit Ervaren Medewerkers\
		(
	[(0,180)-(10,240)],(1,180),(2,182),(3,184),(4.34251,189.474),(5.10703,195.789),(6.02446\
		,203.509),(6.63609,210.175),(7.06422,217.895),(7.70642,229.825),(8.44037,236.491),(\
		9.14373,238.596),(9.90826,240))
	~	Dossiers/(Jaar*Medewerker)
	~	Een tabel/grafiek waarin de relatie tussen medewerkertevredenheid \
		(horizontale as) en referentieproductiviteit van ervaren medewerkers \
		(verticale as) wordt weergegeven.\!\!\!
	|

Gemiddelde verblijftijd Ervaren Medewerkers=
	Ervaren Medewerkers/Verloop Ervaren Medewerkers
	~	Jaar
	~	De gemiddelde verblijftijd van Ervaren Medewerkers (deze tijd wordt \
		beeindigd of door verloop).
	|

Initiële Totale Aantal Medewerkers=
	207
	~	Medewerkers
	~	Het totale aantal medewerkers (zowel nieuw als ervaren) dat in dienst is \
		op tijdstip 0 (als de simulatie begint).
	|

Perc Initiële Aantal Nieuwe Medewerkers=
	0.565
	~	Dmnl
	~	Het percentage van het Initiële Totale Aantal Medewerkers dat nieuw is en \
		dus behoort tot het Initiële Aantal Nieuwe Medewerkers.
	|

Beschikbare Capaciteit Nieuwe Medewerkers=
	Totale Capaciteit Nieuwe Medewerkers*Beschikbaarheidspercentage Nieuwe Medewerkers
	~	FTE/Jaar
	~	Netto Beschikbare Capaciteit Nieuwe Medewerkers (exclusief vergadertijd, \
		ziekte, vakantie, opleiding e.d.).
	|

Beschikbare Capaciteit Ervaren Medewerkers=
	Totale capaciteit Ervaren Medewerkers*Beschikbaarheidspercentage Ervaren Medewerkers
	~	FTE/Jaar
	~	Netto Beschikbare Capaciteit Ervaren Medewerkers (exclusief vergadertijd, \
		ziekte, vakantie, opleiding e.d.).
	|

Inhuur Nieuwe Medewerkers=
	MAX(0,DELAY3((Gewenst Aantal Medewerkers-(Totaal Actueel Aantal Medewerkers/dimensie variabele\
		)) , Inhuurtijd Nieuwe Medewerkers))
	~	Medewerkers/Jaar
	~	Het aantal Nieuwe Medewerkers dat per jaar in dienst treedt.
	|

Verandering Verloopperc Ervaren Medewerkers=
	(Actueel Percentage Ervaren Medewerkers met Verloopplannen-Verloopperc Ervaren Medewerkers\
		)/Aanpassingstijd Verloopperc
	~	1/(Jaar*Jaar)
	~	De verandering van het verlooppercentage van ervaren medewerkers per jaar.
	|

Per Cap Toewijzing Intake Ervaren Medewerkers=
	Beschikbare Cap Ervaren Medewerkers voor Intake/Beschikbare Capaciteit Ervaren Medewerkers
	~	Dimensionless
	~	Het Percentage van de totale capaciteit van Ervaren Medewerkers dat \
		besteed mag worden aan Intake.
	|

Per Cap Toewijzing Intake Nieuwe Medewerkers=
	Beschikbare Cap Nieuwe Medewerkers voor Intake/Beschikbare Capaciteit Nieuwe Medewerkers
	~	Dimensionless
	~	Het Percentage van de totale capaciteit van Nieuwe Medewerkers dat besteed \
		mag worden aan Intake.
	|

Referentieproductiviteit Nieuwe Medewerkers=
	Tabel voor Effect Medewerkertevredenheid op Referentieproductiviteit(Medewerkertevredenheid\
		)
	~	Dossiers/Medewerker/Jaar
	~	De Productiviteit die bereikt is als de Gemiddelde Expertise het \
		referentienivo bereikt.
	|

Beschikbare Cap Ervaren Medewerkers voor Intake=
	Min(Beschikbare Capaciteit Ervaren Medewerkers,(Deel van Werkpakket voor Intake*(Beschikbare Capaciteit Nieuwe Medewerkers\
		+Beschikbare Capaciteit Ervaren Medewerkers)*Nadruk Ervaren Medewerkers voor Intake\
		))
	~	FTE/Jaar
	~	Aantal Ervaren Medewerkers (in FTE's per jaar) dat zich bezighoudt met \
		Intake.
	|

Referentieproductiviteit Ervaren Medewerkers=
	Tabel voor Effect Medewerkertevredenheid op Referentieproductiviteit Ervaren Medewerkers\
		(Medewerkertevredenheid)
	~	Dossiers/Medewerker/Jaar
	~	De Productiviteit die bereikt is als de Gemiddelde Expertise het \
		referentienivo bereikt.
	|

Beschikbare Cap Nieuwe Medewerkers voor Intake=
	Min(Beschikbare Capaciteit Nieuwe Medewerkers,(Deel van Werkpakket voor Intake*(Beschikbare Capaciteit Nieuwe Medewerkers\
		+Beschikbare Capaciteit Ervaren Medewerkers)*(1-Nadruk Ervaren Medewerkers voor Intake\
		)))
	~	FTE/Jaar
	~	Aantal Nieuwe Medewerkers (in FTE's per jaar) dat zich bezighoudt met \
		Intake.
	|

Verloopperc Nieuwe Medewerkers= INTEG (
	+Verandering Verloopperc Nieuwe Medewerkers,
		Normaal Verloopperc Nieuwe Medewerkers)
	~	1/Jaar
	~	Het verlooppercentage van Nieuwe Medewerkers wordt bepaald door het \
		Normale Verlooppercentage maar ook door de impact van \
		medewerkertevredenheid
	|

Initiële Aantal Ervaren Medewerkers=
	Initiële Totale Aantal Medewerkers*(1-Perc Initiële Aantal Nieuwe Medewerkers)
	~	Medewerkers
	~	De intiële populatie Ervaren Medewerkers (= op tijdstip 0).
	|

Initiële Aantal Nieuwe Medewerkers=
	Initiële Totale Aantal Medewerkers*Perc Initiële Aantal Nieuwe Medewerkers
	~	Medewerkers
	~	De intiële populatie Nieuwe Medewerkers (= op tijdstip 0).
	|

Gemiddelde verblijftijd Nieuwe Medewerkers=
	Nieuwe Medewerkers/(Doorstroom Medewerkers+Verloop Nieuwe Medewerkers)
	~	Jaar
	~	De gemiddelde verblijftijd van Nieuwe Medewerkers (deze tijd wordt \
		beeindigd of door doorstroom naar Ervaren Medewerkers of door verloop).
	|

Verloopperc Ervaren Medewerkers= INTEG (
	Verandering Verloopperc Ervaren Medewerkers,
		Normaal Verloopperc Ervaren Medewerkers)
	~	1/Jaar
	~	Het verlooppercentage van Ervaren Medewerkers wordt bepaald door het \
		Normale Verlooppercentage maar ook door de impact van \
		medewerkertevredenheid
	|

Aanpassingstijd Verloopperc=
	0.25
	~	Jaar
	~	Aanpassingstijd die nodig is om een verandering in het verlooppercentage \
		op te merken en het verlooppercentage overeenkomstig aan te passen.
	|

Effect van Tevredenheid op Verloop=
	Tabel voor Effect van Tevredenheid op Verloop(Medewerkertevredenheid/Normale Medewerker tevredenheid\
		)
	~	Dimensionless
	~	Het Verloop is een functie van het quotient van de Medewerkertevredenheid \
		en de Normale Medewerkertevredenheid.
	|

Tabel voor Effect van Tevredenheid op Verloop(
	[(0,0)-(2,3)],(0,3),(0.5,1.5),(0.8,1.05),(1,1),(1.2,0.95),(1.5,0.5),(2,0.25))
	~	Dimensionless
	~	Een tabel/grafiek waarin de relatie tussen tevredenheid (horizontale as) \
		en verloop (verticale as) wordt weergegeven.\!\!
	|

Actueel Percentage Ervaren Medewerkers met Verloopplannen=
	Normaal Verloopperc Ervaren Medewerkers*Effect van Tevredenheid op Verloop
	~	1/Jaar
	~	Het percentage van Ervaren Medewerkers met verloopplannen wordt bepaald \
		door een normaal verlooppercentage en door de tevredenheid.
	|

Actueel Percentage Nieuwe Medewerkers met Verloopplannen=
	Normaal Verloopperc Nieuwe Medewerkers*Effect van Tevredenheid op Verloop
	~	1/Jaar
	~	Het percentage van Nieuwe Medewerkers met verloopplannen wordt bepaald \
		door een normaal verlooppercentage en door de tevredenheid.
	|

Verandering Verloopperc Nieuwe Medewerkers=
	(Actueel Percentage Nieuwe Medewerkers met Verloopplannen-Verloopperc Nieuwe Medewerkers\
		)/Aanpassingstijd Verloopperc
	~	1/(Jaar*Jaar)
	~	De verandering van het verlooppercentage van nieuwe medewerkers per jaar.
	|

Aanpassingstijd Medewerker tevredenheid=
	0.25
	~	Jaar
	~	Aanpassingstijd die medewerkers nodig hebben om een verandering in hun \
		tevredenheid op te merken of daadwerkelijk te voelen.
	|

Effect van Werkdruk op Tevredenheid=
	Tabel voor Effect van Werkdruk op Tevredenheid(Gepercipieerde Werkdruk/Gewenste Werkdruk Medewerker\
		)
	~	Dmnl
	~	De Medewerkertevredenheid is een functie van het quotient van de \
		gepercipieerde werkdruk en de gewenste werkdruk.
	|

Normale Medewerker tevredenheid=
	6.6
	~	Dimensionless
	~	De medewerkertevredenheid die als uitgangspunt wordt genomen, op tijdstip \
		0 (als de simulatie begint).
	|

Tabel voor Effect van Werkdruk op Tevredenheid(
	[(0,0)-(20,1)],(0,0.4),(0.5,0.6),(0.8,0.85),(1,0.9),(1.2,0.85),(1.5,0.6),(2,0.5),(3,\
		0.4),(20,0.35))
	~	Dimensionless
	~	Een tabel/grafiek waarin de relatie tussen werkdruk (horizontale as) en \
		tevredenheid (verticale as) wordt weergegeven.\!\!
	|

Druk op Aannamebeleid=
	Gepercipieerde Werkdruk/Managementnorm Werkdruk
	~	Dimensionless
	~	De druk om mensen aan te nemen wordt groter naarmate de gepercipieerde \
		werkdruk groter is dan de managementnorm.
	|

Effect van Werkdruk op Gewenst Medewerkerniveau=
	Switch voor Reactief Aannamebeleid*Tabel voor Effect van Werkdruk op Aannamebeleid(Druk op Aannamebeleid\
		) + (1-Switch voor Reactief Aannamebeleid
	)*Exogene Druk op Personeelsgroei
	~	1/Jaar
	~	Bij een reactief aannamebeleid is het effect van werkdruk op gewenst \
		medewerkerniveau een nonlineaire functie van de werkdruk.
	|

Medewerkertevredenheid= INTEG (
	+Verandering Medewerker tevredenheid,
		Normale Medewerker tevredenheid)
	~	Dimensionless
	~	De mate waarin medewerkers tevreden zijn met hun werk bij SRB.
	|

Gewenste Werkdruk Medewerker=
	0.8
	~	Dimensionless
	~	De werkdruk die medewerkers graag zouden willen waarnemen.
	|

Gewicht van Werkdruk op Tevredenheid=
	3.33
	~	Dimensionless
	~	Belang van de werkdruk van medewerkers in het bepalen van de \
		Medewerkertevredenheid.
	|

Verandering Medewerker tevredenheid=
	(Actuele Medewerker tevredenheid-Medewerkertevredenheid)/Aanpassingstijd Medewerker tevredenheid
	~	1/Jaar
	~	De mate waarin de medewerkertevredenheid verandert per jaar.
	|

Switch voor Reactief Aannamebeleid=
	1
	~	Dimensionless
	~	1 = Aannamebeleid wordt endogeen bepaald op basis van werkdruk. 0 = \
		Aannamebeleid wordt ook exogeen bepaald op basis van BU Plan.
	|

Tabel voor Effect van Werkdruk op Aannamebeleid(
	[(0,0)-(6,2.5)],(0,0.3),(0.5,0.75),(1,1),(1,1),(2,1.3),(3,1.6),(4,1.9),(5,2))
	~	1/Jaar
	~	De tabel laat zien wat de invloed is van de Druk op Aannamebeleid op het \
		Gewenst Medewerkerniveau. Hoe hoger de druk, hoe groter het Gewenst \
		Medewerkerniveau, maar als de druk heel hoog wordt, vlakt dit effect \
		af.\!\!\!
	|

Totaal Actueel Aantal Medewerkers=
	Nieuwe Medewerkers+Ervaren Medewerkers
	~	Medewerkers
	~		|

Totale Referentiedoorlooptijd=
	Referentiedoorlooptijd Afhandeling+Referentiedoorlooptijd Intake
	~	Weken
	~	Hoelang een dossier normaal gesproken in intake EN behandeling zou mogen \
		zijn, gemiddeld.
	|

Totale Actuele Doorlooptijd=
	Actuele Doorlooptijd Afhandeling+Actuele Doorlooptijd Intake
	~	Weken
	~	Tijd die nodig is om een dossier geheel af te handelen (som van \
		doorlooptijd Intake en doorlooptijd Afhandeling).
	|

Exogene Druk op Personeelsgroei=
	Groei volgens BU Plan(Time-2000)*(1+Pulse Inhuur)
	~	1/Jaar
	~	Exogene druk op personeelsgroei is gebaseerd op het BU Plan en kan \
		eventueel als test aangepast worden met een bepaalde grootte (pulse).
	|

Werkdrukindicator=
	Totale Actuele Doorlooptijd/Totale Referentiedoorlooptijd
	~	Dmnl
	~	Hoeveel werk er is t.o.v. hoeveel capaciteit er is om het af te handelen \
		in deze tijdsperiode
	|

Managementnorm Werkdruk=
	1
	~	Dmnl
	~	Wat het MT vindt dat een goede werkdruk is
	|

Aanpassingtijd Capaciteitsinzet Intake=
	0.1
	~	Jaar
	~	Hoe lang het duurt voordat er meer of minder mensen komen bij het \
		Intakeproces gezien de relatieve werklast daar.
	|

Aantal weken per jaar=
	50
	~	Weken/Jaar
	~	Omrekenfactor: een jaar bestaat uit 50 weken.
	|

Actuele Doorlooptijd Intake=
	(Meldingen/Intake)*Aantal weken per jaar
	~	Weken
	~	De actuele verblijftijd van dossiers inintake, gemiddeld gezien.
	|

Gepercipieerde Werkdruk= INTEG (
	Verandering in Perceptie Werkdruk,
		Normale Werkdruk)
	~	Dmnl
	~	De werkdruk die medewerkers waarnemen.
	|

Referentiedoorlooptijd Intake=
	2
	~	Week
	~	Hoelang een dossier normaal gesproken in intake zou mogen zijn, gemiddeld. \
		Hier dus 1 week. Dit gemiddelde kan heel wel betekenen dat sommige \
		dossiers langer in intake zijn, andere maar een dag (bv Pareto of 80-20 \
		verdeling).
	|

Perceptieinterval Werkdruk=
	0.125
	~	Jaar
	~	Hoe lang het duurt voordat medewerkers merken dat het echt drukker of \
		rustiger wordt
	|

Verandering in Perceptie Werkdruk=
	((Werkdrukindicator/Normale Werkdruk)-Gepercipieerde Werkdruk)/Perceptieinterval Werkdruk
	~	1/Jaar
	~	Verandering van de werkdruk die waargenomen wordt door medewerkers.
	|

Normale Werkdruk=
	0.8
	~	Dmnl
	~	De werkdruk die als uitgangspunt wordt genomen, op tijdstip 0 (als de \
		simulatie begint).
	|

Werkpakket Afhandeling=
	Dossiers In Behandeling*Gemiddelde Werkinhoud Dossier
	~	Weken
	~	De gemiddelde hoeveelheid werk (in weken) die verzet moet worden om de \
		voorraad Dossiers in Behandeling te verwerken.
	|

Deel van Werkpakket voor Intake= INTEG (
	Verandering Deel Werkpakket Intake,
		Initiëel deel werkpakket intake)
	~	Dmnl
	~	De relatieve werklast voor Intake (t.o.v. de totale hoeveelheid werklast \
		voor Intake en Afhandeling).
	|

Verandering Deel Werkpakket Intake=
	(Werkpakket Intake/(Werkpakket Intake+Werkpakket Afhandeling)-Deel van Werkpakket voor Intake\
		)/Aanpassingtijd Capaciteitsinzet Intake
	~	1/Jaar
	~	De verandering van de relatieve werklast voor Intake (t.o.v. de totale \
		hoeveelheid werklast voor Intake en Afhandeling).
	|

Nadruk Ervaren Medewerkers voor Intake=
	0.5
	~	Dmnl
	~	Het percentage van het Werkpakket Intake dat door Ervaren Medewerkers \
		wordt uitgevoerd (indien er voldoende ervaren medewerkers beschikbaar \
		zijn). Default = 0.5
	|

Inhuur Ervaren Medewerkers=
	MAX(0,DELAY3(Verloop Ervaren Medewerkers-Doorstroom Medewerkers,Inhuurtijd Ervaren Medewerkers\
		))
	~	Medewerkers/Jaar
	~	Het aantal Ervaren Medewerkers dat per jaar aangenomen wordt.
	|

Inhuurtijd Ervaren Medewerkers=
	0.5
	~	Jaar
	~	De tijd die het kost om ervaren  medewerkers te vinden. Initieel gezet op \
		6 maanden, of een half jaar
	|

Inhuurtijd Nieuwe Medewerkers=
	0.25
	~	Jaar
	~	De tijd die het kost om nieuwe medewerkers te vinden. Initieel gezet op 3 \
		maanden, of een kwart jaar
	|

Werkjaren gewerkt aan dossiers Nieuwe Medewerkers=
	Dossiers door Nieuwe Medewerkers*(Gemiddelde Werkinhoud Dossier/Omrekenfactor van Week naar Werkjaar\
		)
	~	Medewerker*Werkjaar/Jaar
	~	Het gemiddeld aantal werkjaren dat aan Dossiers gewerkt is door Nieuwe \
		Medewerkers per jaar.
	|

Omrekenfactor van Week naar Werkjaar=
	50
	~	Week/(Medewerker*Werkjaar)
	~	Een medewerker-werkjaar bestaat uit 50 weken.
	|

Dossiers door Nieuwe Medewerkers=
	Afleggen*Perc van Afhandelcap door Nieuwe Medewerkers
	~	Dossiers/Jaar
	~	Het aantal Dossiers dat per jaar door Nieuwe Medewerkers wordt afgelegd.
	|

Werkjaren gewerkt aan dossiers Ervaren Medewerkers=
	Dossiers door Ervaren Medewerkers*(Gemiddelde Werkinhoud Dossier/Omrekenfactor van Week naar Werkjaar\
		)
	~	Medewerker*Werkjaar/Jaar
	~	Het gemiddeld aantal werkjaren dat aan Dossiers gewerkt is door Ervaren \
		Medewerkers per jaar.
	|

Beschikbare Capaciteit voor Afhandeling in Dossiers=
	Beschikbare Capaciteit voor Afhandeling in Tijdseenheden/(Gemiddelde Werkinhoud Dossier\
		/Omrekenfactor van Week naar FTE)
	~	Dossiers/Jaar
	~	Aantal Dossiers in Afhandeling die Nieuwe en Ervaren Medewerkers per jaar \
		kunnen verwerken op basis van hun Beschikbare Capaciteit.
	|

Beschikbare Capaciteit voor Afhandeling in Tijdseenheden=
	Beschikbare Cap Ervaren Medewerkers voor Afhandeling+Beschikbare Cap Nieuwe Medewerkers voor Afhandeling
	~	FTE/Jaar
	~	Totale capaciteit van zowel Nieuwe als Ervaren Medewerkers (in FTE's per \
		jaar) die beschikbaar is voor Afhandeling.
	|

Gemiddelde Doorlooptijd Afhandeling=
	MAX(Minimale Afhandelingstijd,Dossiers In Behandeling/Beschikbare Capaciteit voor Afhandeling in Dossiers\
		)
	~	Jaar
	~	Gemiddelde Doorlooptijd Afhandeling die bepaald wordt door de Beschikbare \
		Capaciteit voor Afhandeling en het aantal Dossiers in Behandeling.
	|

Gemiddelde Doorlooptijd Intake=
	MAX(Minimale Intaketijd,Meldingen/Beschikbare Capaciteit voor Intake in Dossiers)
	~	Jaar
	~	Gemiddelde Doorlooptijd Intake die bepaald wordt door de Beschikbare \
		Capaciteit voor Intake en het aantal Meldingen dat op voorraad ligt.
	|

Basisaanbod Dossiers=
	48000
	~	Dossiers
	~		|

Omrekenfactor van Week naar FTE=
	50
	~	Weken/FTE
	~	1 FTE bestaat uit 50 (werk)weken.
	|

Meldingen= INTEG (
	+Nieuwe Meldingen-Intake-Meldingen afgewezen,
		Initiële Nieuwe Meldingen)
	~	Dossiers
	~	Het aantal Meldingen dat op een bepaald tijdstip op voorraad ligt.
	|

Intake=
	MAX(0,Min(Meldingen/Minimale Intaketijd,Beschikbare Capaciteit voor Intake in Dossiers\
		))
	~	Dossiers/Jaar
	~	Het aantal Dossiers dat per jaar in Behandeling wordt genomen.
	|

Referentiedoorlooptijd Afhandeling=
	25
	~	Week
	~	Hoelang een dossier normaal gesproken in behandeling zou mogen zijn, \
		gemiddeld. Dit gemiddelde kan heel wel betekenen dat sommige dossiers een \
		jaar in behandeling zijn, andere maar een dag (bv Pareto of 80-20 \
		verdeling).
	|

Groei volgens BU Plan(
	[(0,0)-(5,1.5)],(0,1),(1,1.18),(2,1.25),(3,1.3),(4,1.33),(5,1.35))
	~	1/Jaar
	~	Groei in Werkaanbod uit BU-plan (vertaald vanuit groeiplan \
		Medewerkers).\!\!\!
	|

Groei Dossiers=
	STEP(Exogene Groeivoet,Starttijd Groei)+Groei volgens BU Plan(Time-2000)
	~	1/Jaar
	~	Groei Dossiers komt overeen met gegevens uit het BU Plan maar kan ook \
		bepaald worden door een Exogene Groeivoet vanaf een bepaalde Starttijd.
	|

Nieuwe Meldingen=
	Basisaanbod Dossiers*Groei Dossiers
	~	Dossiers/Jaar
	~	Aantal Nieuwe Meldingen dat per jaar binnen komt.
	|

Beschikbare Cap Ervaren Medewerkers voor Afhandeling=
	Beschikbare Capaciteit Ervaren Medewerkers*(1-Per Cap Toewijzing Intake Ervaren Medewerkers\
		)
	~	FTE/Jaar
	~	Aantal Ervaren Medewerkers (in FTE's per jaar) dat zich bezighoudt met \
		Afhandeling.
	|

Beschikbare Cap Nieuwe Medewerkers voor Afhandeling=
	Beschikbare Capaciteit Nieuwe Medewerkers*(1-Per Cap Toewijzing Intake Nieuwe Medewerkers\
		)
	~	FTE/Jaar
	~	Aantal Nieuwe Medewerkers (in FTE's per jaar) dat zich bezighoudt met \
		Afhandeling.
	|

Beschikbare Capaciteit voor Intake in Tijdseenheden=
	Beschikbare Cap Ervaren Medewerkers voor Intake+Beschikbare Cap Nieuwe Medewerkers voor Intake
	~	FTE/Jaar
	~	Totale capaciteit van zowel Nieuwe als Ervaren Medewerkers (in FTE's per \
		jaar) die beschikbaar is voor Intake.
	|

Initiële Totale Expertise Ervaren Medewerkers=
	700
	~	Medewerker*Werkjaar
	~	Totale expertise ervaren medewerkers op tijdstip 0 (als simulatie begint).
	|

Dossiers door Ervaren Medewerkers=
	(1-Perc van Afhandelcap door Nieuwe Medewerkers)*Afleggen
	~	Dossiers/Jaar
	~	Het aantal Dossiers dat per jaar door Ervaren Medewerkers wordt afgelegd.
	|

Dossiers In Behandeling= INTEG (
	Intake-Afleggen-Dossiers Uitbesteden,
		Initiële Dossiers in Behandeling)
	~	Dossiers
	~	Het aantal Dossiers dat op een bepaald tijdstip in Behandeling is.
	|

Jaarlijkse doorstroom=
	0
	~	Medewerkers/Jaar
	~		|

Minimale Afhandelingstijd=
	0.04
	~	Jaar
	~	Tijd die minimaal nodig is voor Afhandeling ongeacht de Beschikbare \
		Capaciteit die er voor Afhandeling is. Hier gezet op twee weken
	|

Minimale Intaketijd=
	0.01
	~	Jaar
	~	Tijd die minimaal nodig is voor de Intake, ongeacht de Beschikbare \
		Capaciteit die er voor de Intake is. Is dus twee werkdagen
	|

Perc van Intakecap door Nieuwe Medewerkers=
	Beschikbare Cap Nieuwe Medewerkers voor Intake/Beschikbare Capaciteit voor Intake in Tijdseenheden
	~	Dimensionless
	~	Het Percentage van de totale Intakecapaciteit dat door Nieuwe Medewerkers \
		wordt ingevuld.
	|

Perc van Afhandelcap door Nieuwe Medewerkers=
	Beschikbare Cap Nieuwe Medewerkers voor Afhandeling/Beschikbare Capaciteit voor Afhandeling in Tijdseenheden
	~	Dimensionless
	~	Het Percentage van de totale Afhandelcapaciteit dat door Nieuwe \
		Medewerkers wordt ingevuld.
	|

Initiële Totale Expertise Nieuwe Medewerkers=
	175
	~	Werkjaar*Medewerker
	~	Totale Expertise van Nieuwe Medewerkers op tijdstip 0 (als de simulatie \
		begint).
	|

Doorstroom Medewerkers=
	Nieuwe Medewerkers/Groeitijd tot Ervaren Medewerker
	~	Medewerkers/Jaar
	~	Het aantal Nieuwe Medewerkers dat per jaar doorstroomt naar Ervaren \
		Medewerkers.
	|

Verlies van Expertise Nieuwe Medewerkers door Verloop=
	Verloop Nieuwe Medewerkers*Gemiddelde Expertise Nieuwe Medewerkers
	~	Medewerker*Werkjaar/Jaar
	~	Medewerkers die vertrekken nemen hun expertise met zich mee.
	|

Normaal Verloopperc Ervaren Medewerkers=
	0.12
	~	1/Jaar
	~	Het normale verlooppercentage van Ervaren Medewerkers.
	|

Ervaren Medewerkers= INTEG (
	Inhuur Ervaren Medewerkers+Doorstroom Medewerkers-Verloop Ervaren Medewerkers,
		Initiële Aantal Ervaren Medewerkers)
	~	Medewerkers
	~	Het aantal Ervaren Medewerkers dat op een bepaald tijdstip in dienst is.
	|

Groeitijd tot Ervaren Medewerker=
	3
	~	Jaar
	~	Het aantal dienstjaren dat nodig is om Ervaren te worden.
	|

Nieuwe Medewerkers= INTEG (
	Inhuur Nieuwe Medewerkers-Verloop Nieuwe Medewerkers-Doorstroom Medewerkers,
		Initiële Aantal Nieuwe Medewerkers)
	~	Medewerkers
	~	Aantal Nieuwe Medewerkers dat op een bepaald tijdstip in dienst is.
	|

Verloop Ervaren Medewerkers=
	Verloopperc Ervaren Medewerkers*Ervaren Medewerkers
	~	Medewerkers/Jaar
	~	Het aantal Ervaren Medewerkers dat per jaar verloopt.
	|

Gemiddelde Expertise Ervaren Medewerkers=
	Totale Expertise Ervaren Medewerkers/Ervaren Medewerkers
	~	Werkjaar
	~	De gemiddelde expertise van ervaren medewerkers
	|

Meldingen afgewezen=
	500
	~	Dossiers/Jaar
	~	Aantal Meldingen dat per jaar wordt afgewezen.
	|

Exponent Leercurve Ervaren=
	LN(1+Sterkte Leercurve Ervaren)/LN(2)
	~	Dimensionless
	~	De exponent in de leercurve. Berekend op basis van de sterkte van de \
		leercurve.
	|

Verouderingstijd Expertise Ervaren Medewerkers=
	0.25
	~	Jaar
	~	Het tijdstip waarop de normale veroudering van expertise verandert (door \
		een exogene input).
	|

Gemiddelde Expertise Ervaren Inhuur=
	Exogene Expertise Inhuur Ervaren Medewerkers
	~	Werkjaar
	~	hoeveel expertise ervaren medewerkers met zich meebrengen, exogeen bepaald
	|

Normale Veroudering Expertise Ervaren Medewerkers=
	0.1
	~	1/Jaar
	~	Het normale percentage waarmee de expertise van ervaren medewerkers per \
		jaar veroudert.
	|

Verlies van Expertise Ervaren Medewerkers door Verloop=
	Verloop Ervaren Medewerkers*Gemiddelde Expertise Ervaren Medewerkers
	~	Medewerker*Werkjaar/Jaar
	~	Medewerkers die vertrekken nemen hun expertise met zich mee.
	|

Verandering Veroudering Expertise Ervaren Medewerkers=
	0
	~	1/Jaar
	~	Een exogene verandering in de mate waarin de expertise van ervaren \
		medewerkers per jaar veroudert.
	|

Productiviteit Ervaren Medewerkers=
	Referentieproductiviteit Ervaren Medewerkers*(Gemiddelde Expertise Ervaren Medewerkers\
		/"Referentie-Expertise Ervaren medewerkers")^Exponent Leercurve Ervaren
	~	Dossiers/(Medewerker*Jaar)
	~	Productiviteit wordt bepaald door een standaard leercurve die doorlopen \
		wordt via een cumulatieve hoeveelheid werkervaring.
	|

Toename Expertise door Ervaren Inhuur=
	Inhuur Ervaren Medewerkers*Gemiddelde Expertise Ervaren Inhuur
	~	Medewerker*Werkjaar/Jaar
	~	De snelheid waarmee ervaren medewerkers expertise toevoegen aan de pool \
		van expertise
	|

Relatieve Verouderingssnelheid Expertise Ervaren Medewerkers=
	Normale Veroudering Expertise Ervaren Medewerkers + STEP(Verandering Veroudering Expertise Ervaren Medewerkers\
		,Verouderingstijd Expertise Ervaren Medewerkers)
	~	1/Jaar
	~	Bestaande kennis veroudert of wordt vergeten.
	|

Gemiddelde Werkinhoud Dossier=
	0.25
	~	Weken/Dossier
	~	Het aantal weken dat gemiddeld gewerkt moet worden aan een Dossier.
	|

Pulse Inhuur Omvang=
	0
	~	Dmnl
	~	Een percentage waarmee de Inhuur toe- of afneemt op een bepaalde starttijd.
	|

Pulse Inhuur Starttijd=
	2001
	~	Jaar
	~	Het tijdstip waarop de Pulse plaatsvindt.
	|

Verandering Veroudering Expertise Nieuwe Medewerkers=
	0
	~	1/Jaar
	~	Een exogene verandering in de mate waarin de expertise van nieuwe \
		medewerkers per jaar veroudert.
	|

Exponent Leercurve=
	LN(1+Sterkte Leercurve)/LN(2)
	~	Dimensionless
	~	De exponent in de leercurve. Berekend op basis van de sterkte van de \
		leercurve.
	|

Productiviteit Nieuwe Medewerkers=
	Referentieproductiviteit Nieuwe Medewerkers*(Gemiddelde Expertise Nieuwe Medewerkers\
		/"Referentie-Expertise Nieuwe Medewerkers")^Exponent Leercurve
	~	Dossiers/(Medewerker*Jaar)
	~	Productiviteit wordt bepaald door een standaard leercurve die doorlopen \
		wordt via een cumulatieve hoeveelheid werkervaring.
	|

Exogene Expertise Inhuur Ervaren Medewerkers=
	 Expertise Inhuur Nieuwe Medewerkers*Input
	~	Werkjaar
	~	Mogeljkheid om test inputs lost te laten op het model, zoals step, pulse, \
		sine wave, en random noise.
	|

Exogene Groeivoet=
	0
	~	1/Jaar
	~	De Exogene Groeivoet in Dossiers. Default 0
	|

Verouderingstijd Expertise Nieuwe Medewerkers=
	0.25
	~	Jaar
	~	Het tijdstip waarop de normale veroudering van expertise verandert (door \
		een exogene input).
	|

Relatieve Verouderingssnelheid Expertise Nieuwe Medewerkers=
	Normale Veroudering Expertise Nieuwe Medewerkers + STEP(Verandering Veroudering Expertise Nieuwe Medewerkers\
		,Verouderingstijd Expertise Nieuwe Medewerkers)
	~	1/Jaar
	~	Bestaande kennis veroudert of wordt vergeten.
	|

Starttijd Groei=
	0.25
	~	Jaar
	~	Het moment waarop de Exogene Groei begint.
	|

"Referentie-Expertise Nieuwe Medewerkers"=
	0.2
	~	Werkjaar
	~	Het referentieniveau van Expertise dat past bij de \
		Referentieproductiviteit.
	|

Normaal Verloopperc Nieuwe Medewerkers=
	0.1
	~	1/Jaar
	~	Het normale verlooppercentage van Nieuwe Medewerkers.
	|

Normale Veroudering Expertise Nieuwe Medewerkers=
	0.1
	~	1/Jaar
	~	Het normale percentage waarmee de expertise van nieuwe medewerkers per \
		jaar veroudert.
	|

Verloop Nieuwe Medewerkers=
	Verloopperc Nieuwe Medewerkers*Nieuwe Medewerkers
	~	Medewerkers/Jaar
	~	Het aantal Nieuwe Medewerkers dat per jaar verloopt.
	|

Exponential Growth Time=
	5
	~	Jaar
	~	The time for exogenous exponential growth to start
	|

Exponential Growth Rate=
	0
	~	1/Jaar
	~	The exogenous growth rate
	|

Gemiddelde Expertise Nieuwe Inhuur=
	Exogene Expertise Inhuur Ervaren Medewerkers
	~	Werkjaar
	~	De hoeveelheid expertise die nieuwe medewerkers met zich meebrengen, \
		exogeen bepaald.
	|

Pink Noise = INTEG(Change in Pink Noise,0)
	~	Dimensionless
	~	Pink Noise is first-order autocorrelated noise.  Pink noise provides a realistic \
		noise input to
		        models in which the next random shock depends in part on the previous \
		shocks.  The user
		        can specify the correlation time.  The mean is 0 and the standard deviation \
		is specified
		         by the user.
	|

Pulse Quantity=0
	~	Dimensionless*Jaar
	~	The quantity to be injected to customer orders, as a fraction of the base value of \
		Input. 
		        For example, to pulse in a quantity equal to 50% of the current value of \
		input, set to
		         .50.
	|

Change in Pink Noise = (White Noise - Pink Noise)/Noise Correlation Time
	~	1/Jaar
	~	Change in the pink noise value; Pink noise is a first order exponential smoothing \
		delay of the white
		         noise input.
	|

Ramp End Time=1e+09
	~	Jaar
	~	End time for the ramp input.
	|

Expertise Inhuur Nieuwe Medewerkers=
	0.2
	~	Werkjaar
	~	De initiële expertise van nieuwe medewerkers
	|

Input=
	1+STEP(Step Height,Step Time)+
	(Pulse Quantity/TIME STEP)*PULSE(Pulse Time,TIME STEP)+
	RAMP(Ramp Slope,Ramp Start Time,Ramp End Time)+(STEP(1, Exponential Growth Time)*(exp\
		(Exponential Growth Rate*(Time - Exponential Growth Time))-1))+
	Sine Amplitude*SIN(2*3.14159*Time/Sine Period)+
	  	STEP(1,Noise Start Time)*Pink Noise
	~	Dimensionless
	~	Input is een dimensieloze variabele die verschillende input-patronen kan \
		testen, zoals een step, pulse, sine wave, en random noise.
	|

Sine Period=50
	~	Jaar
	~	Period of sine wave in customer demand.  Set initially to 50 weeks (1 \
		Jaar).
	|

Noise Correlation Time = 4
	~	Jaar
	~	The correlation time constant for Pink Noise.
	|

Noise Standard Deviation = 0
	~	Dimensionless
	~	The standard deviation of the pink noise process.
	|

Noise Start Time = 5
	~	Jaar
	~	Start time for the random input.
	|

Ramp Slope=0
	~	1/Jaar
	~	Slope of the ramp input, as a fraction of the base value (per week).
	|

Pulse Time=5
	~	Jaar
	~	Time at which the pulse in Input occurs.
	|

Step Time=5
	~	Jaar
	~	Time for the step input.
	|

White Noise = Noise Standard Deviation*((24*Noise Correlation Time/TIME STEP)^0.5*(RANDOM 0 1\
		() - 0.5
))
	~	Dimensionless
	~	White noise input to the pink noise process.
	|

Ramp Start Time=5
	~	Jaar
	~	Start time for the ramp input.
	|

Step Height=0
	~	Dimensionless
	~	Height of step input to customer orders, as fraction of initial value.
	|

Sine Amplitude=0
	~	Dimensionless
	~	Amplitude of sine wave in customer orders (fraction of mean).
	|

Gemiddelde Expertise Nieuwe Medewerkers=
	Totale Expertise Nieuwe Medewerkers/Nieuwe Medewerkers
	~	Werkjaar
	~	De gemiddelde expertise van nieuwe medewerkers
	|

Toename Expertise door Inhuur=
	Inhuur Nieuwe Medewerkers*Gemiddelde Expertise Nieuwe Inhuur
	~	Werkjaar*Medewerker/Jaar
	~	De snelheid waarmee nieuwe medewerkers expertise toevoegen aan de pool van \
		Totale Expertise
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Paramaters
	|

FINAL TIME  = 2005
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2000
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.015625
	~	Year
	~	De tijd-stap voor de simulatie.
	|

