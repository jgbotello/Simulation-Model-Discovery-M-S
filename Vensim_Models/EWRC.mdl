{UTF-8}
People Returning=
	IF THEN ELSE(People Receiving Items >0, HH Size*House Refurbishment, 0)
	~	people/Day
	~	This is based on the rate at which houses are drying out
	|

Event Displacing People=
	IF THEN ELSE(Time > 10, Flooding*HH Size, 0)
	~	people/Day
	~		|

Event Generator= INTEG (
	-Event,
		1)
	~	Dmnl
	~	This is whether an event occurs are not
	|

Counter Rate=
	IF THEN ELSE(People Item Supply>0, 1, 0)
	~	Dmnl
	~		|

Intervention=
	IF THEN ELSE((People Receiving Items - People Needing Relief Items) > 200 , 1 , -1)
	~	
	~		|

Funding Rate=
	Donations * Event Occured
	~	
	~		|

Counter= INTEG (
	Counter Rate,
		0)
	~	Dmnl
	~		|

House Refurbishment=
	DELAY FIXED( Flooded Households/Time to Dry, Time to Dry, 0)
	~	house/Day
	~	This is the rate at which houses recover from the flooding
	|

Flooding=
	IF THEN ELSE(Event > 0.5, Households at Risk * Event * 0.8, 0)
	~	house/Day
	~	If an event occurs it causes this flow to be start.
	|

Credibility Rate=
	IF THEN ELSE(Decision to act Counter > 0, Intervention * Event Occured , 0)
	~	credibility
	~	Organizational feedback would impact credibility of early warning systems, \
		which would ultimately affect overally credibility.
	|

Decision Rate=
	Decision to Act
	~	
	~		|

Flooded Households= INTEG (
	Flooding-House Refurbishment,
		0)
	~	house
	~	The number of physical houses that are damaged
	|

Decision to act Counter= INTEG (
	Decision Rate,
		0)
	~	
	~		|

Time to Dry=
	165
	~	Day
	~	An estimated time for house to dry up and functions ordinarily.
	|

Early Warning Prepared Items=
	IF THEN ELSE(Relief Items Available- (People Receiving Items/People per Item) > 0 :AND:\
		 Counter < 1, Relief Items Available
	/Time early items, 0)
	~	tent/Day
	~	At time zero, 'Early Warning Tents' adds X number of tents/day into the \
		rate. It is calculated by subtracting 'early Warning Tents' from 'People \
		in Tents'
	|

Event=
	IF THEN ELSE(Time = 60, 1, 0)
	~	
	~		|

Event Occured= INTEG (
	Event,
		0)
	~	
	~		|

Households at Risk= INTEG (
	-Flooding-House Refurbishment,
		People at Risk/HH Size)
	~	house
	~	The number of houses being considered. Both the physical (households) and \
		people are being considered.
	|

Stockpile Supply=
	IF THEN ELSE( HQ Budget > 50000, HQ Budget*0.01 * Event Occured, 0)
	~	tent/Day
	~	If RCHQ Budget is greater than 50000, then 1% of that budget will be spent \
		on stockpiling tents in storage. Otherwise, it's going to be naught.
	|

Usual Cost=
	5
	~	
	~		|

Illness=
	People Needing Relief Items * 0.01
	~	
	~		|

Continental Relief Item Rate=
	Continental Relief Item Storage/Reg Transp Delay
	~	tent/Day
	~	The flow rate of tents from continental warehouse to regional warehouse. \
		Delay depends on transportation mode
	|

Sick People= INTEG (
	Illness,
		0
		)
	~	
	~		|

Urgent Cost=
	15
	~	
	~		|

Forecast Magnitude(
	[(0,0)-(365,1)],(0,0.8),(10,0.8),(20,0.8),(60,0.8),(61,0),(365,0))
	~	Dmnl
	~	A forecast variation for weather - this variable is created randomly.
	|

Interpretation=
	Forecast Magnitude ( Time)
	~	Dmnl
	~	An interpretation process for forecasting and its impact on the region.
	|

Relief Item Acquisition=
	(Early Warning Relief Items * Usual Cost ) + ( Stockpile Supply * Urgent Cost)
	~	$
	~	Cost of providing Tents. If relief items are purchased in advance, it \
		costs less than if they need to be purchased after an emergency
	|

Magnitude Comparison=
	IF THEN ELSE( Interpretation > Event Magnitude Threshold, 1, 0)
	~	Dmnl
	~		|

People Needing Relief Items= INTEG (
	Event Displacing People-Illness-People Item Supply,
		0)
	~	people
	~	This is the number of people who need tent housing
	|

Change in probability due to unusual conditions=
	RANDOM NORMAL( 0.8, 1 , 0.9, 0.1, 0.6) * 10 / Forecast Lead Time
	~	Dmnl
	~	A situation that would occur unexpectedly.
	|

Forecasted Probability=
	Change in probability due to unusual conditions + Probability on a normal day
	~	Dmnl
	~	Based on observations, forecasted probability can be induced. This is the \
		probability for  the event (or any natural disaster).
	|

Item Provision Rate=
	IF THEN ELSE(People Needing Relief Items>10 :AND: Local Relief Items>0, Labor Capacity\
		 / Time per Item Provision,0)
	~	tent/Day
	~	A inflow rate of mounted tents. That is, How many tents are being mounted \
		based on how many people require tents, time spent on mounting tent (time \
		per tent), and labor capacity.
	|

People Item Supply=
	IF THEN ELSE( People Needing Relief Items > 0, (Early Warning Prepared Items + Item Provision Rate\
		)*People per Item, 0)
	~	people/Day
	~	The rate at which tents can be provided per unit time. This is influence \
		by 'early warning tents' or 'normal supply rate'
	|

Forecast Warning=
	IF THEN ELSE(Magnitude Comparison = 1 :AND: Probability Comparison = 1, 1, 0)
	~	
	~		|

HQ Budget= INTEG (
	Funding Rate-Operating Expense-Relief Item Acquisition,
		300000)
	~	$
	~	A large sum of money allocated for providing tent stockpiles.
	|

Decision to Act=
	IF THEN ELSE( (Forecast Warning = 1 :AND: (People at Risk * Expected Cost Per Person\
		/HQ Budget) < 1), 1,  0)
	~	Dmnl
	~	From estimated observations, 'decision to act' will kick in if forecasted \
		magnitude and probabilities are indicating imminent disaster. This would \
		also be influenced by credibility of organizations.
	|

Donations=
	50*Credibility In Early Warning System
	~	
	~		|

Expected Cost Per Person=
	0
	~	$ [0,20000]
	~	depending on when the action occurs, if pre-disaster and if post-disaster
	|

Early Warning Relief Items=
	IF THEN ELSE( Time <60 :AND: Decision to Act = 1, Item Provision, 0)
	~	tent/Day
	~	A rate at which tents are being mounted based on early warning system.
	|

Maintenance Cost=
	(10*Continental Relief Item Storage+9*Local Relief Items+8*Regional Relief Item Storage\
		+5*External Labor+2.5*Local Labor) * 0.001
	~	
	~		|

Operating Expense=
	Maintenance Cost
	~	
	~		|

Labor Capacity=
	External Labor +Local Labor
	~	people
	~	A number of people who will be employed in mounting tents.
	|

Local Labor=
	10
	~	people
	~	Local people who will mount tents.
	|

Relief Items Available= INTEG (
	Early Warning Relief Items+Item Provision Rate,
		1)
	~	tent
	~	The number of tents that can be prepared in advance
	|

Countdown to Event=
	IF THEN ELSE(Time < 49, 1, 0)
	~	Day/Day
	~	This is the rate at which the stock of datas before the event occurs
	|

Time early items=
	1
	~	Day [1,1]
	~	Nominal unit of time to ensure this makes sense. X number of people in \
		tents can be added to the rate, when the are set up in advance
	|

People per Item=
	5
	~	people/tent
	~	The number of people that can be housed per tent
	|

Item Provision=
	15
	~	tent
	~	A number of tents that will be mounted based on early warning. If a \
		warning issued, then for one warning, 10 tents will be mounted.
	|

People Receiving Items= INTEG (
	People Item Supply-People Returning,
		0)
	~	people
	~	The number of people housed in tents
	|

HH Size=
	5
	~	people/house
	~	A number of household's size.
	|

External Labor=
	5
	~	people
	~	People from outside of the site who's going to mount tents.
	|

People at Risk= INTEG (
	People Returning-Event Displacing People,
		10000)
	~	people
	~	The number of people that area at risk. This is the product of the number \
		of houses times the average household size
	|

Event Magnitude Threshold=
	0.7
	~	Dmnl [0,1]
	~	A threshold for comparing a current forecast magnitude. This variable (or \
		threshold) is to judge whether it is worth trigger 'decision to act.'
	|

Probability Comparison=
	IF THEN ELSE(Forecasted Probability > Acceptable Prob Threshold, 1, 0)
	~	Dmnl
	~	Based on two probabilities, a comparison between acceptable threshold and \
		forecasted probability can hint whether we should act not or later (or do \
		nothing).
	|

Acceptable Prob Threshold=
	0.5
	~	Dmnl [0,1,0.1]
	~	Something that established based on experienced people's point of views \
		(or their expertise.)
	|

Credibility In Early Warning System= INTEG (
	Credibility Rate,
		0)
	~	credibility
	~	A credibility of early warning measured by the number of donating \
		countries (or donors).
	|

Forecast Lead Time= INTEG (
	-Countdown to Event,
		60)
	~	Day
	~	This needs to be revised to be a step function with three values
	|

Continental Relief Item Storage= INTEG (
	Stockpile Supply-Continental Relief Item Rate,
		0)
	~	tent
	~	The stock of emergency tents stored in a warehouse. This is typically \
		Dubai, for the region of Africa being considered
	|

Local Relief Item Rate=
	Regional Relief Item Storage/Local Transp Delay
	~	tent/Day
	~	The flow rate of tents from regional tent storage to locat tents (or \
		sites). Delay depends on transportation mode
	|

Reg Transp Delay=
	21
	~	Day
	~	A time that takes tents to mover from continental tent storage to regional \
		tent storage. Assumed 21 days.
	|

Regional Relief Item Storage= INTEG (
	Continental Relief Item Rate-Local Relief Item Rate,
		0)
	~	tent
	~	The number of tents stored in a regional warehouse
	|

Local Relief Items= INTEG (
	Local Relief Item Rate-Item Provision Rate,
		0)
	~	tent
	~	The number of tents locally available for workers to mount.
	|

Local Transp Delay=
	7
	~	Day
	~	A period for moving tents from regional tent storage to local sites. \
		Assumed 7 days.
	|

Time per Item Provision=
	1.5
	~	Day/tent [0,2,0.1]
	~		|

Probability on a normal day=
	0.05
	~	Dmnl [?,?,0.05]
	~	A regular estimated probability (or perhaps, seasonality?)
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 365
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Day [0,?]
	~	The time step for the simulation.
	|

